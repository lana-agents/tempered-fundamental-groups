import TemperedFundamentalGroups.SemiAnbd.RouteBAssembly
import Mathlib.RingTheory.Coprime.Lemmas

/-!
# Procyclic subgroups containing a cusp generator (MR13 C2, group side)

Route B (MR13 plan, run 18, next step 2) identifies the cusp inertia groups of `Π^Σ_{0,3}` inside
the vertex group `D_v`: at every finite level the stabiliser of a special point over a cusp is
cyclic (`P1ThreeCuspStab.exists_cusp_stabilisers_cyclic` in iut), so the cusp inertia is a closed
subgroup with cyclic images in all finite quotients containing the cusp generator. This file shows
that such a subgroup is **the closure of the subgroup generated by the cusp generator**, i.e. the
image of `ℤ^Σ` under `cuspInertiaSigma`: the cusp generator is primitive, as its image in the
abelianisation `(ℤ/m)^r` has a unit coordinate.

* **`RouteB.mem_zpowers_of_isCoprime`**: in a group, `g ∈ ⟨g ^ k⟩` if `k` is prime to the order;
* **`RouteB.exists_generator_of_isCyclic_map`**: a generator of a cyclic image `f(C)` lifts to `C`;
* **`RouteB.eq_topologicalClosure_zpowers`** (generic): in a profinite group `G`, let `c ∈ G` be
  such that for every open normal `N` there is `χ : G → ℤ/[G : N]` with open kernel and `χ(c)` a
  unit. Then a closed subgroup `C ∋ c` whose images in all finite quotients `G/N` are cyclic is
  the closure of `⟨c⟩`;
* **`RouteB.cuspCoord`**, **`RouteB.cuspCoord_cusp`**: the continuous character
  `Π^Σ_{g,r} → ℤ/m` (`m` a `Σ`-integer, `r ≥ 2`), the `j`-th coordinate of the abelianisation
  `cⱼ ↦ eⱼ − e_{j+1}` (pi1's `cuspAbHom`), with value `1` at `cⱼ`;
* **`RouteB.range_cuspInertiaSigma`**: the image of `ℤ^Σ` is the closure of `⟨cⱼ⟩`;
* **`RouteB.eq_range_cuspInertiaSigma_of_cyclic`**: in `Π^Σ_{g,r}` (`r ≥ 2`), a closed subgroup
  containing `cⱼ` with cyclic images in all finite quotients is the cusp inertia
  `cuspInertiaSigma P j (ℤ^Σ)`; **`RouteB.eq_range_cuspInertiaSigma_of_procyclic`**: the same for
  the closure of a procyclic subgroup `⟨γ⟩` containing `cⱼ`. For `Π^Σ_{0,3}` and `j = 2` this is
  the C2 statement "a procyclic closed subgroup containing `c₂` is `⟨c₂⟩`".
-/

open Pi1 Pi1.Profinite Pi1.SurfaceGroup Pi1.SurfaceGen Pi1.Profinite.ProSigmaCompletion

namespace TemperedFundamentalGroups

namespace RouteB

/-! ### Finite groups -/

/-- **`g ∈ ⟨g ^ k⟩` if `k` is prime to the order of `g`.** -/
theorem mem_zpowers_of_isCoprime {Q : Type*} [Group Q] {g : Q} {k : ℤ}
    (hk : IsCoprime k (orderOf g : ℤ)) : g ∈ Subgroup.zpowers (g ^ k) := by
  obtain ⟨u, v, huv⟩ := hk
  refine ⟨u, ?_⟩
  have h1 : g ^ (orderOf g : ℤ) = 1 := by rw [zpow_natCast, pow_orderOf_eq_one]
  change (g ^ k) ^ u = g
  have h2 : g ^ (v * (orderOf g : ℤ)) = 1 := by rw [mul_comm, zpow_mul, h1, one_zpow]
  calc (g ^ k) ^ u = g ^ (u * k + v * (orderOf g : ℤ)) := by
          rw [zpow_add, h2, mul_one, ← zpow_mul, mul_comm]
    _ = g := by rw [huv, zpow_one]

/-- A generator of a cyclic image `f(C)` lifts to `C`. -/
theorem exists_generator_of_isCyclic_map {G Q : Type*} [Group G] [Group Q] (f : G →* Q)
    {C : Subgroup G} (h : IsCyclic (C.map f)) :
    ∃ g ∈ C, ∀ x ∈ C, ∃ k : ℤ, f x = f g ^ k := by
  obtain ⟨γ, hγ⟩ := h.exists_generator
  obtain ⟨g, hg, hgγ⟩ := Subgroup.mem_map.mp γ.2
  refine ⟨g, hg, fun x hx ↦ ?_⟩
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hγ ⟨f x, Subgroup.mem_map_of_mem f hx⟩)
  refine ⟨k, ?_⟩
  have := congrArg Subtype.val hk
  rw [Subgroup.coe_zpow] at this
  rw [hgγ]
  exact this.symm

/-! ### The generic statement -/

section Generic

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- The index of `N ⊓ K` divides `[G : N] [G : K]` (`K` normal). -/
lemma index_inf_dvd (N K : Subgroup G) [K.Normal] : (N ⊓ K).index ∣ N.index * K.index := by
  rw [← Subgroup.relIndex_mul_index (inf_le_left : N ⊓ K ≤ N), inf_comm,
    Subgroup.inf_relIndex_right, mul_comm]
  exact mul_dvd_mul_left _ (Subgroup.relIndex_dvd_index_of_normal _ _)

omit [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- **The level step**: every element of `C` lies in `⟨c⟩ N`. -/
theorem exists_zpow_of_cyclic {c : G}
    (hχ : ∀ N : OpenNormalSubgroup G, ∃ χ : G →* Multiplicative (ZMod (N : Subgroup G).index),
      IsOpen (χ.ker : Set G) ∧ IsUnit (Multiplicative.toAdd (χ c)))
    {C : Subgroup G} (hc : c ∈ C)
    (hcyc : ∀ N : OpenNormalSubgroup G, IsCyclic (C.map (QuotientGroup.mk' (N : Subgroup G))))
    (N : OpenNormalSubgroup G) {x : G} (hx : x ∈ C) :
    ∃ j : ℤ, (c ^ j)⁻¹ * x ∈ N := by
  obtain ⟨χ, hχo, hχc⟩ := hχ N
  let K : OpenNormalSubgroup G :=
    { toSubgroup := χ.ker, isOpen' := hχo, isNormal' := χ.normal_ker }
  let N' : OpenNormalSubgroup G := N ⊓ K
  have hN'N : ∀ y ∈ (N' : Subgroup G), y ∈ (N : Subgroup G) := fun y hy ↦ hy.1
  have hN'K : ∀ y ∈ (N' : Subgroup G), χ y = 1 := fun y hy ↦ hy.2
  obtain ⟨g, -, hg⟩ := exists_generator_of_isCyclic_map (QuotientGroup.mk' (N' : Subgroup G))
    (hcyc N')
  obtain ⟨k, hk⟩ := hg c hc
  -- `χ c = χ g ^ k`
  have hχk : χ c = χ g ^ k := by
    have h0 : (g ^ k)⁻¹ * c ∈ (N' : Subgroup G) := by
      have h1 := hk.symm
      rw [← map_zpow, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at h1
      exact h1
    have := hN'K _ h0
    rw [map_mul, map_inv, map_zpow, inv_mul_eq_one] at this
    exact this.symm
  -- `k` is prime to the order of the image of `g`
  have hcop : IsCoprime k (orderOf (QuotientGroup.mk' (N' : Subgroup G) g) : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]
    by_contra hne
    obtain ⟨ℓ, hℓ, hℓd⟩ := Nat.exists_prime_and_dvd hne
    have hℓk : (ℓ : ℤ) ∣ k := Int.natCast_dvd.mpr (dvd_trans hℓd (Int.gcd_dvd_natAbs_left _ _))
    have hℓo : ℓ ∣ orderOf (QuotientGroup.mk' (N' : Subgroup G) g) := by
      have := dvd_trans hℓd
        (Int.gcd_dvd_natAbs_right k (orderOf (QuotientGroup.mk' (N' : Subgroup G) g) : ℤ))
      simpa using this
    have hℓN' : ℓ ∣ (N' : Subgroup G).index := dvd_trans hℓo (orderOf_dvd_natCard _)
    have hKm : (K : Subgroup G).index ∣ (N : Subgroup G).index := by
      change χ.ker.index ∣ _
      rw [Subgroup.index_ker]
      have := Subgroup.card_subgroup_dvd_card χ.range
      rwa [Nat.card_congr (Multiplicative.toAdd (α := ZMod (N : Subgroup G).index)),
        Nat.card_zmod] at this
    have hℓm : ℓ ∣ (N : Subgroup G).index := by
      have h1 : ℓ ∣ (N : Subgroup G).index * (N : Subgroup G).index := dvd_trans hℓN'
        (dvd_trans (index_inf_dvd (N : Subgroup G) (K : Subgroup G))
          (mul_dvd_mul_left _ hKm))
      rcases hℓ.dvd_mul.mp h1 with h | h <;> exact h
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    have hu := hχc.map (ZMod.castHom hℓm (ZMod ℓ))
    rw [hχk, toAdd_zpow, zsmul_eq_mul, map_mul, map_intCast,
      (ZMod.intCast_zmod_eq_zero_iff_dvd k ℓ).mpr hℓk, zero_mul] at hu
    exact not_isUnit_zero hu
  -- conclude in `G/N'`
  obtain ⟨i, hi⟩ := hg x hx
  obtain ⟨u, hu⟩ : QuotientGroup.mk' (N' : Subgroup G) g ∈
      Subgroup.zpowers (QuotientGroup.mk' (N' : Subgroup G) c) := by
    rw [hk]; exact mem_zpowers_of_isCoprime hcop
  have hu' : QuotientGroup.mk' (N' : Subgroup G) c ^ u = QuotientGroup.mk' (N' : Subgroup G) g := hu
  refine ⟨u * i, hN'N _ ?_⟩
  have h2 : QuotientGroup.mk' (N' : Subgroup G) (c ^ (u * i)) =
      QuotientGroup.mk' (N' : Subgroup G) x := by
    rw [hi, ← hu', ← zpow_mul, ← map_zpow]
  rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at h2
  exact h2

/-- **An element lying in `N ⊔ C` for every open normal `N` lies in the closure of `C`.** -/
theorem mem_topologicalClosure_of_forall_sup {C : Subgroup G} {x : G}
    (h : ∀ N : OpenNormalSubgroup G, x ∈ (N : Subgroup G) ⊔ C) : x ∈ C.topologicalClosure := by
  rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, mem_closure_iff]
  intro U hU hxU
  have hV : IsOpen ((fun y ↦ x * y) ⁻¹' U) := hU.preimage (continuous_const_mul x)
  obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hV
    (by simpa using hxU)
  haveI := N.isNormal'
  obtain ⟨n, hn, c, hc, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp (h N)
  refine ⟨c, ?_, hc⟩
  have hm : (n * c)⁻¹ * n⁻¹ * (n * c)⁻¹⁻¹ ∈ (N : Subgroup G) :=
    N.isNormal'.conj_mem _ ((N : Subgroup G).inv_mem hn) _
  have := hN hm
  simpa only [Set.mem_preimage, mul_inv_rev, inv_inv, mul_assoc, mul_inv_cancel_left,
    inv_mul_cancel_left] using this

/-- A closed subgroup contains every element lying in `N ⊔ C` for every open normal `N`. -/
theorem mem_of_forall_sup {C : Subgroup G} (hC : IsClosed (C : Set G)) {x : G}
    (h : ∀ N : OpenNormalSubgroup G, x ∈ (N : Subgroup G) ⊔ C) : x ∈ C := by
  exact Subgroup.topologicalClosure_minimal C le_rfl hC (mem_topologicalClosure_of_forall_sup h)

/-- **A closed subgroup containing a primitive element `c`, with cyclic images in all finite
quotients, is the closure of `⟨c⟩`.** Primitivity: for every open normal `N` some character
`χ : G → ℤ/[G : N]` with open kernel takes a unit value at `c`. -/
theorem eq_topologicalClosure_zpowers {c : G}
    (hχ : ∀ N : OpenNormalSubgroup G, ∃ χ : G →* Multiplicative (ZMod (N : Subgroup G).index),
      IsOpen (χ.ker : Set G) ∧ IsUnit (Multiplicative.toAdd (χ c)))
    {C : Subgroup G} (hC : IsClosed (C : Set G)) (hc : c ∈ C)
    (hcyc : ∀ N : OpenNormalSubgroup G, IsCyclic (C.map (QuotientGroup.mk' (N : Subgroup G)))) :
    C = (Subgroup.zpowers c).topologicalClosure := by
  refine le_antisymm (fun x hx ↦ mem_topologicalClosure_of_forall_sup fun N ↦ ?_)
    (Subgroup.topologicalClosure_minimal _ (Subgroup.zpowers_le.mpr hc) hC)
  obtain ⟨j, hj⟩ := exists_zpow_of_cyclic hχ hc hcyc N hx
  rw [sup_comm]
  simpa only [mul_inv_cancel_left] using
    Subgroup.mul_mem_sup (Subgroup.zpow_mem_zpowers c j) hj

omit [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- The closure of a procyclic subgroup has cyclic images in all finite quotients. -/
theorem isCyclic_map_topologicalClosure_zpowers (γ : G) (N : OpenNormalSubgroup G) :
    IsCyclic ((Subgroup.zpowers γ).topologicalClosure.map
      (QuotientGroup.mk' (N : Subgroup G))) := by
  have h : (Subgroup.zpowers γ).topologicalClosure.map (QuotientGroup.mk' (N : Subgroup G)) =
      Subgroup.zpowers (QuotientGroup.mk' (N : Subgroup G) γ) := by
    rw [← MonoidHom.map_zpowers]
    refine le_antisymm (fun q hq ↦ ?_) (Subgroup.map_mono (Subgroup.le_topologicalClosure _))
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hq
    rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe, mem_closure_iff] at hy
    obtain ⟨z, hzU, hz⟩ := hy {z | y⁻¹ * z ∈ (N : Subgroup G)}
      (N.isOpen.preimage (continuous_const_mul y⁻¹)) (by simp)
    refine ⟨z, hz, ?_⟩
    exact (QuotientGroup.eq.mpr hzU).symm
  rw [h]
  infer_instance

end Generic

/-! ### Cusp generators of `Π^Σ_{g,r}` -/

section Surface

variable {P : ℕ → Prop} {g r : ℕ}

/-- The `j`-th coordinate of the abelianisation `Π_{g,r} → (ℤ/m)^r` (`cuspAbHom`). -/
def cuspCoordDisc (m : ℕ) (j : Fin r) : SurfaceGroup g r →* Multiplicative (ZMod m) :=
  (AddMonoidHom.toMultiplicative (Pi.evalAddMonoidHom (fun _ : Fin r ↦ ZMod m) j)).comp
    (cuspAbHom m)

lemma cuspCoordDisc_cusp (m : ℕ) (hr : 1 < r) (j : Fin r) :
    cuspCoordDisc (g := g) m j (cusp j) = Multiplicative.ofAdd 1 := by
  have hj : finRotate r j ≠ j := by
    obtain ⟨r, rfl⟩ : ∃ r', r = r' + 2 := ⟨r - 2, by omega⟩
    rw [Ne, Fin.ext_iff, coe_finRotate]
    split_ifs with h
    · simp [h]
    · omega
  rw [cuspCoordDisc, MonoidHom.comp_apply, cuspAbHom, lift_cusp]
  simp only [AddMonoidHom.toMultiplicative_apply_apply, toAdd_ofAdd, Pi.evalAddMonoidHom_apply,
    Pi.sub_apply, Pi.single_eq_same, Pi.single_eq_of_ne' hj, sub_zero]

/-- **The continuous character `Π^Σ_{g,r} → ℤ/m`**, the `j`-th coordinate of the abelianisation
(`m` a `Σ`-integer). -/
noncomputable def cuspCoord {m : ℕ} [NeZero m] (hm : IsSigmaNat P m) (j : Fin r) :
    proSigma P g r →* Multiplicative (ZMod m) :=
  liftFinite (cuspCoordDisc m j)
    (by rwa [Nat.card_congr (Multiplicative.toAdd (α := ZMod m)), Nat.card_zmod])

lemma isOpen_ker_cuspCoord {m : ℕ} [NeZero m] (hm : IsSigmaNat P m) (j : Fin r) :
    IsOpen ((cuspCoord (g := g) hm j).ker : Set (proSigma P g r)) :=
  isOpen_liftFinite_fiber _ _ 1

lemma cuspCoord_cusp {m : ℕ} [NeZero m] (hm : IsSigmaNat P m) (hr : 1 < r) (j : Fin r) :
    cuspCoord (g := g) hm j (eta P (cusp j)) = Multiplicative.ofAdd 1 := by
  rw [cuspCoord, ProSigmaCompletion.liftFinite_eta, cuspCoordDisc_cusp m hr j]

/-- **The cusp inertia `ℤ^Σ → Π^Σ_{g,r}` has image the closure of `⟨cⱼ⟩`.** -/
theorem range_cuspInertiaSigma (j : Fin r) :
    (cuspInertiaSigma P (g := g) j).range =
      (Subgroup.zpowers (eta P (cusp j) : proSigma P g r)).topologicalClosure := by
  have hcont : Continuous (cuspInertiaSigma P (g := g) j) := continuous_map _
  have hcl : IsClosed ((cuspInertiaSigma P (g := g) j).range : Set (proSigma P g r)) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range hcont).isClosed
  have hgen : cuspInertiaSigma P (g := g) j (eta P (Multiplicative.ofAdd 1)) = eta P (cusp j) := by
    rw [cuspInertiaSigma, map_eta, zpowersHom_apply, toAdd_ofAdd, zpow_one]
  refine le_antisymm ?_ (Subgroup.topologicalClosure_minimal _
    (Subgroup.zpowers_le.mpr ⟨_, hgen⟩) hcl)
  rintro _ ⟨x, rfl⟩
  -- `x` is a limit of `eta (n)`, and `cuspInertiaSigma (eta n) = cⱼ ^ n`
  have hsub : Set.range (eta P (Γ := Multiplicative ℤ)) ⊆
      cuspInertiaSigma P (g := g) j ⁻¹'
        ((Subgroup.zpowers (eta P (cusp j) : proSigma P g r)).topologicalClosure : Set _) := by
    rintro _ ⟨n, rfl⟩
    refine Subgroup.le_topologicalClosure _ ⟨Multiplicative.toAdd n, ?_⟩
    rw [cuspInertiaSigma, map_eta, zpowersHom_apply, map_zpow]
  have hclosed : IsClosed (cuspInertiaSigma P (g := g) j ⁻¹'
      ((Subgroup.zpowers (eta P (cusp j) : proSigma P g r)).topologicalClosure : Set _)) :=
    (Subgroup.isClosed_topologicalClosure _).preimage hcont
  exact closure_minimal hsub hclosed (by rw [(denseRange_eta (P := P)).closure_range]; trivial)

/-- **C2, group side.** In `Π^Σ_{g,r}` (`r ≥ 2`), a closed subgroup containing the cusp
generator `cⱼ` whose images in all finite quotients are cyclic is the cusp inertia group
`cuspInertiaSigma P j (ℤ^Σ)`, the closure of `⟨cⱼ⟩`. -/
theorem eq_range_cuspInertiaSigma_of_cyclic (hr : 1 < r) (j : Fin r)
    {C : Subgroup (proSigma P g r)} (hC : IsClosed (C : Set (proSigma P g r)))
    (hc : eta P (cusp j) ∈ C)
    (hcyc : ∀ N : OpenNormalSubgroup (proSigma P g r),
      IsCyclic (C.map (QuotientGroup.mk' (N : Subgroup (proSigma P g r))))) :
    C = (cuspInertiaSigma P j).range := by
  rw [range_cuspInertiaSigma]
  refine eq_topologicalClosure_zpowers (fun N ↦ ?_) hC hc hcyc
  have hm : IsSigmaNat P (N : Subgroup (proSigma P g r)).index :=
    ProSigmaCompletion.isSigmaNat_index _ N.isOpen
  haveI : NeZero (N : Subgroup (proSigma P g r)).index := ⟨hm.1⟩
  refine ⟨cuspCoord hm j, isOpen_ker_cuspCoord hm j, ?_⟩
  rw [cuspCoord_cusp hm hr j, toAdd_ofAdd]
  exact isUnit_one

/-- **C2, group side (procyclic form).** In `Π^Σ_{g,r}` (`r ≥ 2`), the closure of a procyclic
subgroup `⟨γ⟩` containing `cⱼ` is the cusp inertia group — e.g. `j = 2` in `Π^Σ_{0,3}`. -/
theorem eq_range_cuspInertiaSigma_of_procyclic (hr : 1 < r) (j : Fin r) (γ : proSigma P g r)
    (hc : eta P (cusp j) ∈ (Subgroup.zpowers γ).topologicalClosure) :
    (Subgroup.zpowers γ).topologicalClosure = (cuspInertiaSigma P j).range :=
  eq_range_cuspInertiaSigma_of_cyclic hr j (Subgroup.isClosed_topologicalClosure _) hc
    (isCyclic_map_topologicalClosure_zpowers γ)

end Surface

end RouteB

end TemperedFundamentalGroups
