import TemperedFundamentalGroups.SemiAnbd.OneGonSigmaKernel
import TemperedFundamentalGroups.Topology.Hopfian

/-!
# `Π^Σ_{1,1}` is the pro-`Σ` HNN extension of `Π^Σ_{0,3}` (Route B, item B2)

The stable `1`-gon `G^Σ` of the Tate curve is a loop of groups: vertex group `Π^Σ_{0,3}`
(generators `c₀, c₁, c₂`, `c₀ c₁ c₂ = 1`), edge group `ℤ^Σ`, branches `b₀ = ⟨c₀⟩`, `b₁ = ⟨c₁⁻¹⟩`
(`oneGonB₀`, `oneGonB₁`). Its pro-`Σ` fundamental group is the pro-`Σ` HNN extension
`Π^Σ_{0,3} *_{ℤ^Σ}`, generated by `Π^Σ_{0,3}` and a stable letter `t` with
`t b₀(x) t⁻¹ = b₁(x)`. We show that `Π^Σ_{1,1}` (generators `a, b, c`, `[a, b] c = 1`)
**has the universal property of this pro-`Σ` HNN extension**, with

* the vertex map `vtxSigma : Π^Σ_{0,3} → Π^Σ_{1,1}`, `c₀ ↦ b`, `c₁ ↦ a b⁻¹ a⁻¹`,
  `c₂ ↦ [a, b] = c⁻¹` (discretely `Π_{1,1} = Π_{0,3} *_{c₀ ~ c₁⁻¹}`: the free group on `a, b`);
* the stable letter `tSigma = a`, with `tSigma_conj : t b₀(x) t⁻¹ = b₁(x)`;
* **`hnnLift`**: for a profinite pro-`Σ` group `H`, a continuous `β : Π^Σ_{0,3} → H` and `τ ∈ H`
  with `τ β(b₀ x) τ⁻¹ = β(b₁ x)` there is a continuous `Π^Σ_{1,1} → H` extending `β` along
  `vtxSigma` and sending `t ↦ τ` (`hnnLift_vtxSigma`, `hnnLift_tSigma`), unique
  (`hnnLift_unique`);
* **`vtxSigma_injective`**: the vertex group injects (for `Σ ∋ ℓ`), through the wreath quotients
  `Q ≀ ℤ/ℓ` of `SemiAnbd/LoopSigmaLevel.lean` ([SemiAnbd] Prop 2.5(i), pro-`Σ` form);
* `isTopFG_proSigma11`: `Π^Σ_{1,1}` is topologically finitely generated (input of Hopficity, B5).

This is the group-theoretic part of Route B (MR13 plan, run 8, (2)): the cusp of `E ∖ {O}`
corresponds to `c = [a, b]⁻¹ ↦ c₂⁻¹`, i.e. `vtxSigma c₂ = c⁻¹`.

Generic: `ProSigmaCompletion.liftPro` (universal property of the pro-`Σ` completion for profinite
pro-`Σ` targets), `ProSigmaCompletion.hom_ext'`.
-/

universe u

open Pi1 Pi1.Profinite Pi1.SurfaceGroup Pi1.SurfaceGen CategoryTheory

namespace Pi1.Profinite.ProSigmaCompletion

variable {P : ℕ → Prop} {Γ : Type u} [Group Γ]
  {H : Type u} [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H]
  [TotallyDisconnectedSpace H]
  (hH : ∀ M : Subgroup H, IsOpen (M : Set H) → M.Normal → IsSigmaNat P M.index)

/-- **The universal property of the pro-`Σ` completion** for profinite pro-`Σ` targets. -/
noncomputable def liftPro (f : Γ →* H) : ProSigmaCompletion P Γ →* H :=
  MaxProSigma.lift hH
    (ProfiniteGrp.ProfiniteCompletion.lift (P := ProfiniteGrp.of H)
      (GrpCat.ofHom f)).hom.toMonoidHom
    (ProfiniteGrp.ProfiniteCompletion.lift (P := ProfiniteGrp.of H) (GrpCat.ofHom f)).hom.continuous

theorem continuous_liftPro (f : Γ →* H) : Continuous (liftPro (P := P) hH f) :=
  MaxProSigma.continuous_lift _ _ _

@[simp] theorem liftPro_eta (f : Γ →* H) (x : Γ) : liftPro (P := P) hH f (eta P x) = f x :=
  ConcreteCategory.congr_hom
    (ProfiniteGrp.ProfiniteCompletion.lift_eta (P := ProfiniteGrp.of H) (GrpCat.ofHom f)) x

omit [IsTopologicalGroup H] [CompactSpace H] [TotallyDisconnectedSpace H] in
/-- Continuous homomorphisms out of `Γ^Σ` into a Hausdorff group are determined on `Γ`. -/
theorem hom_ext' [T2Space H] {φ ψ : ProSigmaCompletion P Γ →* H} (hφ : Continuous φ)
    (hψ : Continuous ψ) (h : φ.comp (eta P) = ψ.comp (eta P)) : φ = ψ :=
  MonoidHom.ext fun x ↦ congrFun ((denseRange_eta (P := P) (Γ := Γ)).equalizer hφ hψ
    (funext fun y ↦ DFunLike.congr_fun h y)) x

end Pi1.Profinite.ProSigmaCompletion

namespace TemperedFundamentalGroups

namespace OneOneHNN

open ProSigmaCompletion

/-- `a = a₀ ∈ Π_{1,1}`. -/
abbrev a : SurfaceGroup 1 1 := genA 0
/-- `b = b₀ ∈ Π_{1,1}`. -/
abbrev b : SurfaceGroup 1 1 := genB 0

lemma relation11 : a * b * a⁻¹ * b⁻¹ * cusp 0 = 1 := by
  have h := SurfaceGroup.relation (g := 1) (r := 1)
  simpa [SurfaceGen.commProd, SurfaceGen.ordProd] using h

lemma relation03 : cusp (g := 0) (r := 3) 0 * cusp 1 * cusp 2 = 1 := by
  have h := SurfaceGroup.relation (g := 0) (r := 3)
  simp only [SurfaceGen.commProd, SurfaceGen.ordProd, List.ofFn_succ, List.ofFn_zero,
    List.prod_cons, List.prod_nil, one_mul, mul_one] at h
  rw [mul_assoc]; exact h

/-- **The vertex map** `Π_{0,3} → Π_{1,1}`: `c₀ ↦ b`, `c₁ ↦ a b⁻¹ a⁻¹`, `c₂ ↦ a b a⁻¹ b⁻¹`. -/
def vtx : SurfaceGroup 0 3 →* SurfaceGroup 1 1 :=
  SurfaceGroup.lift Fin.elim0 Fin.elim0 ![b, a * b⁻¹ * a⁻¹, a * b * a⁻¹ * b⁻¹] (by
    simp only [SurfaceGen.commProd, SurfaceGen.ordProd, List.ofFn_succ, List.ofFn_zero,
      List.prod_cons, List.prod_nil, one_mul]
    simp [mul_assoc])

@[simp] lemma vtx_c0 : vtx (cusp 0) = b := by simp [vtx]
@[simp] lemma vtx_c1 : vtx (cusp 1) = a * b⁻¹ * a⁻¹ := by simp [vtx]
@[simp] lemma vtx_c2 : vtx (cusp 2) = a * b * a⁻¹ * b⁻¹ := by simp [vtx]

lemma vtx_c2' : vtx (cusp 2) = (cusp 0)⁻¹ := by
  rw [vtx_c2, eq_inv_iff_mul_eq_one]; exact relation11

variable (P : ℕ → Prop)

/-- **The vertex map** `Π^Σ_{0,3} → Π^Σ_{1,1}`. -/
noncomputable def vtxSigma : proSigma P 0 3 →* proSigma P 1 1 := ProSigmaCompletion.map vtx

/-- **The stable letter** `t = a ∈ Π^Σ_{1,1}`. -/
noncomputable def tSigma : proSigma P 1 1 := eta P a

theorem continuous_vtxSigma : Continuous (vtxSigma P) := ProSigmaCompletion.continuous_map _

theorem vtxSigma_eta (x : SurfaceGroup 0 3) : vtxSigma P (eta P x) = eta P (vtx x) := map_eta _ _

/-- **The HNN relation** `t b₀(x) t⁻¹ = b₁(x)` in `Π^Σ_{1,1}`. -/
theorem tSigma_conj (x : ProSigmaCompletion P (Multiplicative ℤ)) :
    tSigma P * vtxSigma P (oneGonB₀ P x) * (tSigma P)⁻¹ = vtxSigma P (oneGonB₁ P x) := by
  let φ : ProSigmaCompletion P (Multiplicative ℤ) →* proSigma P 1 1 :=
    (MulAut.conj (tSigma P)).toMonoidHom.comp ((vtxSigma P).comp (oneGonB₀ P))
  let ψ : ProSigmaCompletion P (Multiplicative ℤ) →* proSigma P 1 1 :=
    (vtxSigma P).comp (oneGonB₁ P)
  have hφ : Continuous φ := ((continuous_const.mul continuous_id).mul continuous_const).comp
    ((continuous_vtxSigma P).comp (ProSigmaCompletion.continuous_map _))
  have hψ : Continuous ψ := (continuous_vtxSigma P).comp (ProSigmaCompletion.continuous_map _)
  have h := hom_ext' (P := P) hφ hψ (MonoidHom.ext_mint (by
    change tSigma P * vtxSigma P (oneGonB₀ P (eta P (Multiplicative.ofAdd 1))) * (tSigma P)⁻¹ =
      vtxSigma P (oneGonB₁ P (eta P (Multiplicative.ofAdd 1)))
    simp only [oneGonB₀, oneGonB₁, map_eta, zpowersHom_apply, toAdd_ofAdd, zpow_one, oneGonGen,
      vtxSigma_eta, map_inv, vtx_c0, vtx_c1, tSigma]
    simp only [← map_inv, ← map_mul]
    exact congrArg (eta P) (by group)))
  exact DFunLike.congr_fun h x

/-! ### The universal property -/

section Lift

variable {P} {H : Type} [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H]
  [TotallyDisconnectedSpace H]
  (hH : ∀ M : Subgroup H, IsOpen (M : Set H) → M.Normal → IsSigmaNat P M.index)
  (β : proSigma P 0 3 →* H) (hβ : Continuous β) (τ : H)
  (hτ : ∀ x, τ * β (oneGonB₀ P x) * τ⁻¹ = β (oneGonB₁ P x))

/-- The discrete homomorphism `Π_{1,1} → H`: `a ↦ τ`, `b ↦ β(c₀)`, `c ↦ [τ, β(c₀)]⁻¹`. -/
noncomputable def discLift : SurfaceGroup 1 1 →* H :=
  SurfaceGroup.lift ![τ] ![β (eta P (cusp 0))]
    ![(τ * β (eta P (cusp 0)) * τ⁻¹ * (β (eta P (cusp 0)))⁻¹)⁻¹]
    (by simp [SurfaceGen.commProd, SurfaceGen.ordProd])

/-- **The universal property of `Π^Σ_{1,1}` as a pro-`Σ` HNN extension of `Π^Σ_{0,3}`.** -/
noncomputable def hnnLift : proSigma P 1 1 →* H := liftPro hH (discLift β τ)

theorem continuous_hnnLift : Continuous (hnnLift hH β τ) := continuous_liftPro _ _

@[simp] theorem hnnLift_tSigma : hnnLift hH β τ (tSigma P) = τ := by
  simp [hnnLift, tSigma, discLift]

include hβ hτ in
@[simp] theorem hnnLift_vtxSigma (π : proSigma P 0 3) : hnnLift hH β τ (vtxSigma P π) = β π := by
  have hc1 : β (eta P (cusp 1)) = (τ * β (eta P (cusp 0)) * τ⁻¹)⁻¹ := by
    have := hτ (eta P (Multiplicative.ofAdd 1))
    simp only [oneGonB₀, oneGonB₁, map_eta, zpowersHom_apply, toAdd_ofAdd, zpow_one,
      oneGonGen, map_inv] at this
    rw [this, inv_inv]
  have hc2 : β (eta P (cusp 2)) = τ * β (eta P (cusp 0)) * τ⁻¹ * (β (eta P (cusp 0)))⁻¹ := by
    have h3 := congrArg (fun x ↦ β (eta P x)) relation03
    simp only [map_mul, map_one] at h3
    rw [eq_inv_of_mul_eq_one_right h3, hc1]
    group
  have h := hom_ext' (P := P) (φ := (hnnLift hH β τ).comp (vtxSigma P)) (ψ := β)
    ((continuous_hnnLift hH β τ).comp (continuous_vtxSigma P)) hβ
    (SurfaceGroup.hom_ext (fun i ↦ i.elim0) (fun i ↦ i.elim0) fun j ↦ by
      fin_cases j
      · change hnnLift hH β τ (vtxSigma P (eta P (cusp 0))) = β (eta P (cusp 0))
        rw [vtxSigma_eta, hnnLift, liftPro_eta, vtx_c0]
        simp [discLift]
      · change hnnLift hH β τ (vtxSigma P (eta P (cusp 1))) = β (eta P (cusp 1))
        rw [vtxSigma_eta, hnnLift, liftPro_eta, vtx_c1, hc1, map_mul, map_mul, map_inv, map_inv]
        simp only [discLift, SurfaceGroup.lift_genA, SurfaceGroup.lift_genB,
          Matrix.cons_val_zero]
        group
      · change hnnLift hH β τ (vtxSigma P (eta P (cusp 2))) = β (eta P (cusp 2))
        rw [vtxSigma_eta, hnnLift, liftPro_eta, vtx_c2, hc2, map_mul, map_mul, map_mul, map_inv,
          map_inv]
        simp only [discLift, SurfaceGroup.lift_genA, SurfaceGroup.lift_genB,
          Matrix.cons_val_zero])
  exact DFunLike.congr_fun h π

include hβ hτ in
/-- **Uniqueness** in the universal property. -/
theorem hnnLift_unique [T2Space H] (φ : proSigma P 1 1 →* H) (hφ : Continuous φ)
    (h1 : ∀ π, φ (vtxSigma P π) = β π) (h2 : φ (tSigma P) = τ) : φ = hnnLift hH β τ := by
  have e1 : φ (eta P b) = β (eta P (cusp 0)) := by
    have := h1 (eta P (cusp 0))
    rwa [vtxSigma_eta, vtx_c0] at this
  have e2 : hnnLift hH β τ (eta P b) = β (eta P (cusp 0)) := by
    have := hnnLift_vtxSigma hH β hβ τ hτ (eta P (cusp 0))
    rwa [vtxSigma_eta, vtx_c0] at this
  have ha1 : φ (eta P a) = τ := h2
  have ha2 : hnnLift hH β τ (eta P a) = τ := hnnLift_tSigma hH β τ
  refine hom_ext' (P := P) hφ (continuous_hnnLift hH β τ) (SurfaceGroup.hom_ext ?_ ?_ ?_)
  · intro i; fin_cases i
    change φ (eta P a) = hnnLift hH β τ (eta P a)
    rw [ha1, ha2]
  · intro i; fin_cases i
    change φ (eta P b) = hnnLift hH β τ (eta P b)
    rw [e1, e2]
  · intro j; fin_cases j
    change φ (eta P (cusp 0)) = hnnLift hH β τ (eta P (cusp 0))
    rw [eq_inv_of_mul_eq_one_right relation11]
    simp only [map_inv, map_mul]
    rw [ha1, ha2, e1, e2]

end Lift

/-! ### The vertex group injects -/

section Inj

open LoopTower OneGonSigmaLevel

variable {P}

theorem vtxSigma_injective {ℓ : ℕ} (hℓ : ℓ.Prime) (hP : P ℓ) :
    Function.Injective (vtxSigma P) := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  rw [injective_iff_map_eq_one]
  intro π hπ
  by_contra hne
  obtain ⟨N, hN⟩ := oneGon_sep π hne
  haveI : Finite (levelQuot N) := by
    haveI := N.1.finiteIndex_of_finite_quotient
    exact Subgroup.finite_quotient_of_finiteIndex
  have hQ : IsSigmaNat P (Nat.card (levelQuot N)) :=
    ProSigmaCompletion.isSigmaNat_index N.1 N.2.2.1
  letI : TopologicalSpace (Wreath (levelQuot N) ℓ) := ⊥
  haveI : DiscreteTopology (Wreath (levelQuot N) ℓ) := ⟨rfl⟩
  have hW := isSigmaNat_card_wreath (levelQuot N) ℓ hQ hℓ hP
  have hH : ∀ M : Subgroup (Wreath (levelQuot N) ℓ), IsOpen (M : Set (Wreath (levelQuot N) ℓ)) →
      M.Normal → IsSigmaNat P M.index := fun M _ _ ↦ hW.of_dvd (Subgroup.index_dvd_card (H := M))
  -- `β = inl ∘ (χᵢ)ᵢ`, through the discrete quotient `Π ⧸ K`
  let K := levelK P ℓ N
  haveI : DiscreteTopology (levelQuot K) := QuotientGroup.discreteTopology K.2.2.1
  let β : proSigma P 0 3 →* Wreath (levelQuot N) ℓ := (fBar P ℓ N).comp (QuotientGroup.mk' K.1)
  have hβ : Continuous β := by
    have h1 : Continuous (QuotientGroup.mk' K.1 : proSigma P 0 3 → levelQuot K) :=
      continuous_quot_mk
    exact (continuous_of_discreteTopology (f := fun q : levelQuot K ↦ fBar P ℓ N q)).comp h1
  let τ : Wreath (levelQuot N) ℓ := SemidirectProduct.inr (Multiplicative.ofAdd 1)
  have hτ : ∀ x, τ * β (oneGonB₀ P x) * τ⁻¹ = β (oneGonB₁ P x) := fun x ↦ by
    change τ * SemidirectProduct.inl (chiPi P ℓ N (oneGonB₀ P x)) * τ⁻¹ =
      SemidirectProduct.inl (chiPi P ℓ N (oneGonB₁ P x))
    rw [chiPi_branch₁]
    exact SemidirectProduct.ext (by simp [τ]) (by simp [τ])
  have h1 := hnnLift_vtxSigma hH β hβ τ hτ π
  rw [hπ, map_one] at h1
  have h2 : chiPi P ℓ N π = 1 := SemidirectProduct.inl_injective (h1.symm.trans (map_one _).symm)
  have h3 := congrFun h2 0
  change chi P ℓ N 0 π = 1 at h3
  rw [chi_zero, QuotientGroup.eq_one_iff] at h3
  exact hN h3

end Inj

/-- `Π^Σ_{1,1}` is topologically finitely generated. -/
theorem isTopFG_proSigma11 : IsTopFG (proSigma P 1 1) := by
  classical
  haveI : Group.FG (SurfaceGroup 1 1) := by
    refine ⟨⟨{a, b, cusp 0}, ?_⟩⟩
    rw [eq_top_iff, ← PresentedGroup.closure_range_of, Subgroup.closure_le]
    rintro _ ⟨s, rfl⟩
    apply Subgroup.subset_closure
    rcases s with i | i | i <;> fin_cases i <;> simp [a, b, genA, genB, cusp]
  exact isTopFG_proSigmaCompletion

end OneOneHNN

end TemperedFundamentalGroups
