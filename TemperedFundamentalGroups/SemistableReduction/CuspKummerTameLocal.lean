import Mathlib

/-!
# The local tame Kummer form of a finite flat algebra over a complete DVR-like ring (S6, local)

Let `T` be a local ring whose maximal ideal is generated by a non-zero-divisor `s` and which is
`(s)`-adically Hausdorff, and let `B` be a local, finite, flat `T`-algebra.

* **`bijective_liftAlgHom_of_root`**: if `y ∈ 𝔪_B` with `yᵉ = s` and `B = T + yB`, then
  `T[Y]/(Yᵉ − s) → B`, `Y ↦ y`, is bijective (spanning: Nakayama; injectivity: the coefficients
  of a relation are divisible by every power of `s`).
* **`exists_pow_eq_of_complete`**: if moreover `B` is `𝔪_T B`-adically complete, `𝔪_B` is nil
  modulo `𝔪_T B`, `e` is invertible in `T`, the residue field of `B` is reached from `T` and the
  residue field of `T` has `e`-th roots, then every unit of `B` is an `e`-th power
  (Newton's method modulo `𝔪_T B`, then Hensel's lemma).
* **`nonempty_algEquiv_adjoinRoot`**: if `𝔪_B = (π)` and `s = u πᵉ` with `u` a unit, then
  `B ≃ₐ[T] T[Y]/(Yᵉ − s)`.
-/

open Polynomial IsLocalRing

namespace SemistableReduction

namespace FormalKummer

section Basis

variable {T B : Type*} [CommRing T] [IsLocalRing T] [CommRing B] [IsLocalRing B] [Algebra T B]

/-- `yᵏ` is not divisible by `yᵉ` for `k < e` if `y` is a regular non-unit. -/
theorem not_pow_dvd_pow {y : B} (hy : y ∈ maximalIdeal B) (hreg : IsSMulRegular B y) {k e : ℕ}
    (hk : k < e) : ¬ y ^ e ∣ y ^ k := by
  rintro ⟨c, hc⟩
  have h1 : y ^ k * 1 = y ^ k * (y ^ (e - k) * c) := by
    rw [mul_one, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hk.le, hc]
  have h2 : (1 : B) = y ^ (e - k) * c := (hreg.pow k) h1
  have h3 : IsUnit (y ^ (e - k)) := IsUnit.of_mul_eq_one c h2.symm
  rw [isUnit_pow_iff (by omega)] at h3
  exact (mem_maximalIdeal _).mp hy h3

omit [IsLocalRing T] [IsLocalRing B] in
/-- `B = T[y] + yⁿ B` if `B = T + y B`. -/
theorem exists_aeval_add {y : B} (hres : ∀ b : B, ∃ t : T, ∃ c : B, b = algebraMap T B t + y * c) :
    ∀ (n : ℕ) (b : B), ∃ p : T[X], ∃ c : B, b = aeval y p + y ^ n * c := by
  intro n
  induction n with
  | zero => intro b; exact ⟨0, b, by simp⟩
  | succ n ih =>
    intro b
    obtain ⟨p, c, hc⟩ := ih b
    obtain ⟨t, c', hc'⟩ := hres c
    refine ⟨p + C t * X ^ n, c', ?_⟩
    rw [hc, hc', map_add, map_mul, map_pow, aeval_C, aeval_X]
    ring

variable {s : T} (hmax : maximalIdeal T = Ideal.span {s}) {y : B} (hy : y ∈ maximalIdeal B)
  (hreg : IsSMulRegular B y) {e : ℕ} (hye : y ^ e = algebraMap T B s)
include hmax hy hreg hye

/-- If `yᵏ ∑_{i<m} tᵢ yⁱ` is divisible by `yᵉ = s` (with `m + k ≤ e`), all `tᵢ` lie in `𝔪_T`. -/
theorem coeff_mem_of_dvd (m : ℕ) : ∀ (k : ℕ) (t : ℕ → T), m + k ≤ e →
    y ^ e ∣ y ^ k * ∑ i ∈ Finset.range m, algebraMap T B (t i) * y ^ i →
    ∀ i < m, t i ∈ maximalIdeal T := by
  induction m with
  | zero => intro _ _ _ _ i hi; omega
  | succ m ih =>
    intro k t hmk hdvd
    rw [Finset.sum_range_succ', pow_zero, mul_one] at hdvd
    set S := ∑ i ∈ Finset.range m, algebraMap T B (t (i + 1)) * y ^ i with hS
    have hS' : ∑ i ∈ Finset.range m, algebraMap T B (t (i + 1)) * y ^ (i + 1) = y * S := by
      rw [hS, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ ↦ by ring
    rw [hS'] at hdvd
    have ht0 : t 0 ∈ maximalIdeal T := by
      by_contra h
      have hu : IsUnit (algebraMap T B (t 0)) := (notMem_maximalIdeal.mp h).map _
      have hU : IsUnit (y * S + algebraMap T B (t 0)) := by
        rw [← notMem_maximalIdeal]
        intro hU
        have : algebraMap T B (t 0) ∈ maximalIdeal B := by
          have := Ideal.sub_mem _ hU (Ideal.mul_mem_right S _ hy)
          rwa [add_sub_cancel_left] at this
        exact (notMem_maximalIdeal.mpr hu) this
      obtain ⟨c, hc⟩ := hdvd
      refine not_pow_dvd_pow hy hreg (k := k) (e := e) (by omega) ⟨c * ↑hU.unit⁻¹, ?_⟩
      rw [← mul_assoc, ← hc, mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [hmax, Ideal.mem_span_singleton'] at ht0
    obtain ⟨a, ha⟩ := ht0
    have hdvd' : y ^ e ∣ y ^ (k + 1) * S := by
      have h1 : y ^ (k + 1) * S = y ^ k * (y * S + algebraMap T B (t 0)) -
          y ^ e * (y ^ k * algebraMap T B a) := by
        rw [← ha, map_mul, hye]
        ring
      rw [h1]
      exact dvd_sub hdvd (dvd_mul_right _ _)
    have ih' := ih (k + 1) (fun i ↦ t (i + 1)) (by omega) hdvd'
    intro i hi
    rcases i with _ | i
    · rw [← ha, hmax]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self s)
    · exact ih' i (by omega)

variable [IsHausdorff (maximalIdeal T) T] (hsreg : IsSMulRegular B (algebraMap T B s))
include hsreg

/-- **Linear independence of `1, y, …, y^{e-1}`** over `T`. -/
theorem coeff_eq_zero_of_sum_eq_zero (t : ℕ → T)
    (ht : ∑ i ∈ Finset.range e, algebraMap T B (t i) * y ^ i = 0) :
    ∀ i < e, t i = 0 := by
  have key : ∀ n : ℕ, ∀ t : ℕ → T,
      ∑ i ∈ Finset.range e, algebraMap T B (t i) * y ^ i = 0 →
      ∀ i < e, t i ∈ maximalIdeal T ^ n := by
    intro n
    induction n with
    | zero => intro _ _ _ _; simp
    | succ n ih =>
      intro t ht
      have hm := coeff_mem_of_dvd hmax hy hreg hye e 0 t (by omega)
        (by rw [ht, mul_zero]; exact dvd_zero _)
      have : ∀ i, ∃ a : T, i < e → t i = s * a := by
        intro i
        by_cases hi : i < e
        · obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hmax ▸ hm i hi)
          exact ⟨a, fun _ ↦ by rw [← ha, mul_comm]⟩
        · exact ⟨0, fun h ↦ absurd h hi⟩
      choose a ha using this
      have h1 : algebraMap T B s *
          ∑ i ∈ Finset.range e, algebraMap T B (a i) * y ^ i = algebraMap T B s * 0 := by
        rw [mul_zero, ← ht, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i hi ↦ ?_
        rw [ha i (Finset.mem_range.mp hi), map_mul, mul_assoc]
      have h2 := ih a (hsreg h1)
      intro i hi
      rw [ha i hi, pow_succ']
      exact Ideal.mul_mem_mul (hmax ▸ Ideal.mem_span_singleton_self s) (h2 i hi)
  intro i hi
  refine IsHausdorff.haus ‹_› (t i) fun n ↦ ?_
  rw [SModEq.zero, smul_eq_mul, Ideal.mul_top]
  exact key n t ht i hi

/-- **The basis lemma**: if `y ∈ 𝔪_B` is regular with `yᵉ = s` and `B = T + yB`, then
`T[Y]/(Yᵉ − s) → B`, `Y ↦ y` is bijective. -/
theorem bijective_liftAlgHom_of_root [Module.Finite T B] (he : 0 < e)
    (hres : ∀ b : B, ∃ t : T, ∃ c : B, b = algebraMap T B t + y * c)
    (h : (X ^ e - C s).eval₂ (Algebra.ofId T B : T →+* B) y = 0) :
    Function.Bijective (AdjoinRoot.liftAlgHom (X ^ e - C s) (Algebra.ofId T B) y h) := by
  set g : T[X] := X ^ e - C s with hg
  have hmon : g.Monic := monic_X_pow_sub_C s he.ne'
  have hdeg : g.natDegree = e := natDegree_X_pow_sub_C
  have hg1 : g ≠ 1 := by
    intro h1
    rw [h1, natDegree_one] at hdeg
    omega
  set φ := AdjoinRoot.liftAlgHom g (Algebra.ofId T B) y h with hφ
  have hφmk (p : T[X]) : φ (AdjoinRoot.mk g p) = aeval y p := rfl
  constructor
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [← AdjoinRoot.mk_leftInverse hmon (AdjoinRoot.mk g p), AdjoinRoot.modByMonicHom_mk] at hx ⊢
    set r := p %ₘ g with hr
    have hrdeg : r.natDegree < e := hdeg ▸ natDegree_modByMonic_lt p hmon hg1
    rw [hφmk, aeval_eq_sum_range' hrdeg] at hx
    simp_rw [Algebra.smul_def] at hx
    have h0 := coeff_eq_zero_of_sum_eq_zero hmax hy hreg hye hsreg (fun i ↦ r.coeff i) hx
    have : r = 0 := by
      ext i
      rw [coeff_zero]
      by_cases hi : i < e
      · exact h0 i hi
      · exact coeff_eq_zero_of_natDegree_lt (by omega)
    rw [this, map_zero]
  · have htop : (⊤ : Submodule T B) ≤ LinearMap.range φ.toLinearMap := by
      refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := maximalIdeal T)
        Module.Finite.fg_top (jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge ?_
      intro b _
      obtain ⟨p, c, hc⟩ := exists_aeval_add hres e b
      rw [hc, hye, ← Algebra.smul_def]
      refine Submodule.add_mem_sup ⟨AdjoinRoot.mk g p, rfl⟩ ?_
      exact Submodule.smul_mem_smul (hmax ▸ Ideal.mem_span_singleton_self s) Submodule.mem_top
    intro b
    obtain ⟨x, hx⟩ := htop Submodule.mem_top (x := b)
    exact ⟨x, hx⟩

end Basis

section Root

variable {T B : Type*} [CommRing T] [IsLocalRing T] [CommRing B] [IsLocalRing B] [Algebra T B]

/-- **`e`-th roots of units** in a complete local `T`-algebra whose maximal ideal is nil modulo
`𝔪_T B`, if `e` is invertible and the residue fields have `e`-th roots. -/
theorem exists_pow_eq_of_complete [IsAdicComplete ((maximalIdeal T).map (algebraMap T B)) B]
    {e : ℕ} (he : 0 < e) (heu : IsUnit (e : T))
    (hroot : ∀ t : T, ∃ t' : T, t' ^ e - t ∈ maximalIdeal T)
    (hres : ∀ b : B, ∃ t : T, b - algebraMap T B t ∈ maximalIdeal B)
    (hnil : ∀ x ∈ maximalIdeal B, ∃ n : ℕ, x ^ n ∈ (maximalIdeal T).map (algebraMap T B))
    {u : B} (hu : IsUnit u) : ∃ v : B, v ^ e = u := by
  set I := (maximalIdeal T).map (algebraMap T B) with hI
  have hIle : I ≤ maximalIdeal B := by
    have := IsAdicComplete.le_jacobson_bot I (R := B)
    rwa [jacobson_eq_maximalIdeal ⊥ bot_ne_top] at this
  obtain ⟨t, ht⟩ := hres u
  obtain ⟨t', ht'⟩ := hroot t
  set a₀ := algebraMap T B t' with ha₀def
  have hdiff : a₀ ^ e - u ∈ maximalIdeal B := by
    have h1 : algebraMap T B (t' ^ e - t) ∈ maximalIdeal B := hIle (Ideal.mem_map_of_mem _ ht')
    have : a₀ ^ e - u = algebraMap T B (t' ^ e - t) - (u - algebraMap T B t) := by
      rw [ha₀def, map_sub, map_pow]
      ring
    rw [this]
    exact Ideal.sub_mem _ h1 ht
  have ha₀ : IsUnit a₀ := by
    have : IsUnit (a₀ ^ e) := by
      by_contra h
      have h' : a₀ ^ e ∈ maximalIdeal B := (mem_maximalIdeal _).mpr h
      have : u ∈ maximalIdeal B := by
        have := Ideal.sub_mem _ h' hdiff
        rwa [sub_sub_cancel] at this
      exact (notMem_maximalIdeal.mpr hu) this
    exact (isUnit_pow_iff he.ne').mp this
  have heB : IsUnit (e : B) := by
    have := heu.map (algebraMap T B)
    rwa [map_natCast] at this
  -- Newton's method modulo `I`
  set P : (B ⧸ I)[X] := X ^ e - C (Ideal.Quotient.mk I u) with hP
  have hPx (x : B) : aeval (Ideal.Quotient.mk I x) P = Ideal.Quotient.mk I (x ^ e - u) := by
    rw [hP, map_sub, map_pow, aeval_X, aeval_C, map_sub, map_pow]
    rfl
  have hPd (x : B) : aeval (Ideal.Quotient.mk I x) (derivative P) =
      Ideal.Quotient.mk I ((e : B) * x ^ (e - 1)) := by
    rw [hP, derivative_sub, derivative_C, sub_zero, derivative_X_pow, map_mul, map_mul, map_pow,
      aeval_C, aeval_X, map_pow, map_natCast]
    rfl
  have hP1 : IsNilpotent (aeval (Ideal.Quotient.mk I a₀) P) := by
    obtain ⟨n, hn⟩ := hnil _ hdiff
    exact ⟨n, by rw [hPx, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hn⟩
  have hP2 : IsUnit (aeval (Ideal.Quotient.mk I a₀) (derivative P)) := by
    rw [hPd]
    exact (heB.mul (ha₀.pow _)).map _
  obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := existsUnique_nilpotent_sub_and_aeval_eq_zero hP1 hP2
  obtain ⟨r₀, rfl⟩ := Ideal.Quotient.mk_surjective r
  have hr₀ : IsUnit r₀ := by
    obtain ⟨n, hn⟩ := hr1
    rw [← map_sub, ← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hn
    have hm : a₀ - r₀ ∈ maximalIdeal B :=
      (maximalIdeal.isMaximal B).isPrime.mem_of_pow_mem n (hIle hn)
    by_contra h
    have h' : r₀ ∈ maximalIdeal B := (mem_maximalIdeal _).mpr h
    have : a₀ ∈ maximalIdeal B := by
      have := Ideal.add_mem _ hm h'
      rwa [sub_add_cancel] at this
    exact (notMem_maximalIdeal.mpr ha₀) this
  have hmon : (X ^ e - C u : B[X]).Monic := monic_X_pow_sub_C u he.ne'
  have hev : (X ^ e - C u : B[X]).eval r₀ ∈ I := by
    rw [hPx, Ideal.Quotient.eq_zero_iff_mem] at hr2
    simpa using hr2
  have hder : IsUnit (Ideal.Quotient.mk I ((derivative (X ^ e - C u : B[X])).eval r₀)) := by
    have : (derivative (X ^ e - C u : B[X])).eval r₀ = (e : B) * r₀ ^ (e - 1) := by
      simp [derivative_X_pow]
    rw [this]
    exact (heB.mul (hr₀.pow _)).map _
  obtain ⟨v, hv, -⟩ := HenselianRing.is_henselian (I := I) _ hmon r₀ hev hder
  refine ⟨v, ?_⟩
  have := hv.eq_zero
  simpa [sub_eq_zero] using this

/-- **The local tame Kummer form**: a local, finite, flat, `𝔪_T B`-adically complete
`T`-algebra `B` with `𝔪_B = (π)`, `s = u πᵉ` (`u` a unit), residue field reached from `T`,
`e` invertible and `e`-th roots in the residue field of `T` is `T[Y]/(Yᵉ − s)`. -/
theorem nonempty_algEquiv_adjoinRoot [IsHausdorff (maximalIdeal T) T] [Module.Finite T B]
    [Module.Flat T B] [IsAdicComplete ((maximalIdeal T).map (algebraMap T B)) B]
    {s : T} (hmax : maximalIdeal T = Ideal.span {s}) (hs : IsSMulRegular T s)
    {e : ℕ} (he : 0 < e) (heu : IsUnit (e : T))
    (hroot : ∀ t : T, ∃ t' : T, t' ^ e - t ∈ maximalIdeal T)
    (hres : ∀ b : B, ∃ t : T, b - algebraMap T B t ∈ maximalIdeal B)
    {π : B} (hπ : maximalIdeal B = Ideal.span {π}) {u : B} (hu : IsUnit u)
    (hsπ : algebraMap T B s = u * π ^ e) :
    Nonempty (AdjoinRoot (X ^ e - C s) ≃ₐ[T] B) := by
  have hsm : s ∈ maximalIdeal T := hmax ▸ Ideal.mem_span_singleton_self s
  have hnil : ∀ x ∈ maximalIdeal B, ∃ n : ℕ,
      x ^ n ∈ (maximalIdeal T).map (algebraMap T B) := by
    intro x hx
    rw [hπ, Ideal.mem_span_singleton'] at hx
    obtain ⟨b, rfl⟩ := hx
    refine ⟨e, ?_⟩
    have : (b * π) ^ e = (b ^ e * ↑hu.unit⁻¹) * algebraMap T B s := by
      rw [hsπ, mul_pow, ← mul_assoc, mul_assoc (b ^ e), IsUnit.val_inv_mul, mul_one]
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hsm)
  obtain ⟨v, hv⟩ := exists_pow_eq_of_complete he heu hroot hres hnil hu
  have hvu : IsUnit v := (isUnit_pow_iff he.ne').mp (hv ▸ hu)
  have hπm : π ∈ maximalIdeal B := hπ ▸ Ideal.mem_span_singleton_self π
  set y := v * π with hy
  have hye : y ^ e = algebraMap T B s := by rw [hy, mul_pow, hv, hsπ]
  have hym : y ∈ maximalIdeal B := Ideal.mul_mem_left _ _ hπm
  have hsreg : IsSMulRegular B (algebraMap T B s) := hs.of_flat
  have hyreg : IsSMulRegular B y := by
    have h1 : IsSMulRegular B (y ^ (e - 1) * y) := by
      rw [← pow_succ, Nat.sub_add_cancel he, hye]
      exact hsreg
    exact h1.of_mul
  have hres' : ∀ b : B, ∃ t : T, ∃ c : B, b = algebraMap T B t + y * c := by
    intro b
    obtain ⟨t, ht⟩ := hres b
    rw [hπ, Ideal.mem_span_singleton'] at ht
    obtain ⟨a, ha⟩ := ht
    refine ⟨t, a * ↑hvu.unit⁻¹, ?_⟩
    have hvv : v * ↑hvu.unit⁻¹ = 1 := IsUnit.mul_val_inv hvu
    rw [hy]
    linear_combination -ha - a * π * hvv
  have h : (X ^ e - C s).eval₂ (Algebra.ofId T B : T →+* B) y = 0 := by
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, hye]
    exact sub_self _
  exact ⟨(AlgEquiv.ofBijective _
    (bijective_liftAlgHom_of_root hmax hym hyreg hye hsreg he hres' h))⟩

end Root

end FormalKummer

end SemistableReduction
