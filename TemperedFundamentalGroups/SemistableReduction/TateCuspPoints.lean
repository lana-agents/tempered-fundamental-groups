import TemperedFundamentalGroups.SemistableReduction.FormalPoints
import TemperedFundamentalGroups.SemistableReduction.CuspInput
import TemperedFundamentalGroups.SemistableReduction.TateGlue0

/-!
# The marked points of the Tate cusp chart (MR12 T2 S5.5)

On the special fibre `R̄ = Rc/J` of the cusp chart `Rc = T0[1/(1 + h)]` the zero set of the
coordinate `s̄ = h̄` is finite: **`TateTwoChart.isArtinianRing_cusp`** — `R̄/(s̄)` is Artinian,
being a finite algebra over `O[h]/(ker θ, h) ≅ k` (it is the image of `T0`, finite over `O[h]`,
since `1 + h` becomes `1`). So `FormalPoints.Pts s̄` is a finite set of points with
`⨅ 𝔪 ≤ √(s̄)` (`FormalPoints.iInf_le_radical`): the index data of the cusp factors.
-/

universe u

open Polynomial

namespace SemistableReduction

namespace TateTwoChart

noncomputable section

variable {O : Type u} [CommRing O] {k : Type u} [Field k] (θ : O →+* k) (π b₄ t κ : O)

/-- The cusp chart `Rc = T0[1/(1 + h)]`. -/
abbrev RcT : Type u := CuspTower.Rc (T0 π b₄ t κ) (TateGlue0.c0 π b₄ t κ)

/-- The special fibre of the cusp chart. -/
abbrev RsC : Type u := EtaleTower.Ts θ (RcT π b₄ t κ)

/-- The coordinate `s̄ = h̄` on the special fibre of the cusp chart. -/
abbrev sbarC : RsC θ π b₄ t κ :=
  Ideal.Quotient.mk _ (CuspTower.sC (T0 π b₄ t κ) (TateGlue0.c0 π b₄ t κ) (h0 π b₄ t κ))

/-- `R̄/(s̄)`. -/
abbrev SC : Type u := RsC θ π b₄ t κ ⧸ Ideal.span {sbarC θ π b₄ t κ}

/-- `T0 → R̄/(s̄)`. -/
def toSC : T0 π b₄ t κ →+* SC θ π b₄ t κ :=
  (Ideal.Quotient.mk _).comp ((Ideal.Quotient.mk _).comp (algebraMap _ (RcT π b₄ t κ)))

lemma toSC_h0 : toSC θ π b₄ t κ (h0 π b₄ t κ) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self _)

lemma toSC_c0 : toSC θ π b₄ t κ (TateGlue0.c0 π b₄ t κ) = 1 := by
  change toSC θ π b₄ t κ (1 + h0 π b₄ t κ) = 1
  rw [map_add, map_one, toSC_h0, add_zero]

lemma toSC_surjective : Function.Surjective (toSC θ π b₄ t κ) := by
  intro y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Submonoid.powers (TateGlue0.c0 π b₄ t κ)) r
  obtain ⟨n, hn⟩ := s.2
  refine ⟨a, ?_⟩
  have h := congrArg (fun x ↦ (Ideal.Quotient.mk (Ideal.span {sbarC θ π b₄ t κ}))
    (Ideal.Quotient.mk (AdmissibleLift.J θ (R := RcT π b₄ t κ)) x))
    (IsLocalization.mk'_spec (RcT π b₄ t κ) a s)
  simp only [map_mul] at h
  have hs : (Ideal.Quotient.mk (Ideal.span {sbarC θ π b₄ t κ}))
      (Ideal.Quotient.mk (AdmissibleLift.J θ (R := RcT π b₄ t κ))
        (algebraMap _ (RcT π b₄ t κ) s.1)) = 1 := by
    change toSC θ π b₄ t κ s.1 = 1
    rw [← hn, map_pow, toSC_c0, one_pow]
  rw [hs, mul_one] at h
  exact h.symm

/-- **`R̄/(s̄)` is Artinian**: the zero set of `s̄` on the special fibre of the cusp chart is
finite. -/
theorem isArtinianRing_cusp (hθ : Function.Surjective θ) :
    IsArtinianRing (SC θ π b₄ t κ) := by
  let φ : T0 π b₄ t κ →ₐ[O[X]] SC θ π b₄ t κ :=
    { toSC θ π b₄ t κ with commutes' := fun _ ↦ rfl }
  haveI : Module.Finite O[X] (SC θ π b₄ t κ) := by
    refine Module.Finite.of_surjective φ.toLinearMap ?_
    intro y
    obtain ⟨a, ha⟩ := toSC_surjective θ π b₄ t κ y
    exact ⟨a, ha⟩
  refine FormalPoints.isArtinianRing_of_finite θ (SC θ π b₄ t κ) hθ (fun o ho ↦ ?_) ?_
  · change (Ideal.Quotient.mk (Ideal.span {sbarC θ π b₄ t κ}))
      (Ideal.Quotient.mk (AdmissibleLift.J θ (R := RcT π b₄ t κ))
        (algebraMap (T0 π b₄ t κ) (RcT π b₄ t κ) (AdjoinRoot.of (G0 π b₄ t κ) (C o)))) = 0
    rw [of_C, ← IsScalarTower.algebraMap_apply,
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_map_of_mem _ (RingHom.mem_ker.2 ho)), map_zero]
  · change toSC θ π b₄ t κ (AdjoinRoot.of (G0 π b₄ t κ) X) = 0
    exact toSC_h0 θ π b₄ t κ

variable {θ π b₄ t κ} in
/-- **The points of `h̄ = 0` on the special fibre of the cusp chart are `k`-rational if `b̄₆` is a
square** (S5.7: replaces the algebraically closed residue field on the cusp side). At such a point
`h = 0`, `π = 0` and the cubic relation becomes `z (z + κt − κr) (z + κt + κr) = 0` with
`r² = b₆` (since `κ (t² − b₆) = 1`), so `z ≡ 0, κ(r − t), −κ(t + r)`; the residue field is
generated by `z`. -/
theorem surjective_mk_comp_cusp {b₆ : O} (hκ : κ * (t ^ 2 - b₆) = 1) (hπ : θ π = 0)
    {r : O} (hr : θ r ^ 2 = θ b₆)
    (𝔪 : Ideal (RcT π b₄ t κ)) [𝔪.IsMaximal] (hJ : AdmissibleLift.J θ (R := RcT π b₄ t κ) ≤ 𝔪)
    (hs : CuspTower.sC (T0 π b₄ t κ) (TateGlue0.c0 π b₄ t κ) (h0 π b₄ t κ) ∈ 𝔪) :
    Function.Surjective ((Ideal.Quotient.mk 𝔪).comp (algebraMap O (RcT π b₄ t κ))) := by
  letI := Ideal.Quotient.field 𝔪
  set ι := (Ideal.Quotient.mk 𝔪).comp (algebraMap O (RcT π b₄ t κ)) with hι
  set q := (Ideal.Quotient.mk 𝔪).comp (algebraMap (T0 π b₄ t κ) (RcT π b₄ t κ)) with hq
  have hO (o : O) : q (algebraMap O (T0 π b₄ t κ) o) = ι o := by
    rw [hq, hι, RingHom.comp_apply, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply]
  have hker (o : O) (ho : θ o = 0) : ι o = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (hJ (Ideal.mem_map_of_mem _ (RingHom.mem_ker.2 ho)))
  have hh : q (h0 π b₄ t κ) = 0 := Ideal.Quotient.eq_zero_iff_mem.2 hs
  -- the cubic relation at the point
  have hz : q (z0 π b₄ t κ) * (q (z0 π b₄ t κ) + ι κ * ι t - ι κ * ι r) *
      (q (z0 π b₄ t κ) + ι κ * ι t + ι κ * ι r) = 0 := by
    have h := congrArg q (eq0 π b₄ t κ)
    simp only [map_add, map_sub, map_mul, map_pow, map_one, map_zero, hO, hh, hker π hπ,
      map_ofNat] at h
    have h1 : ι r ^ 2 - ι b₆ = 0 := by
      rw [← map_pow, ← map_sub]
      exact hker _ (by rw [map_sub, map_pow, hr, sub_self])
    have h2 : ι κ * (ι t ^ 2 - ι b₆) = 1 := by
      rw [← map_pow, ← map_sub, ← map_mul, hκ, map_one]
    linear_combination h + ι κ * q (z0 π b₄ t κ) * h2 -
      ι κ ^ 2 * q (z0 π b₄ t κ) * h1
  have hzS : q (z0 π b₄ t κ) ∈ ι.range := by
    rcases mul_eq_zero.1 hz with hz | hz
    · rcases mul_eq_zero.1 hz with hz | hz
      · rw [hz]; exact zero_mem _
      · exact ⟨κ * r - κ * t, by rw [map_sub, map_mul, map_mul]; linear_combination -hz⟩
    · exact ⟨-(κ * t) - κ * r, by
        rw [map_sub, map_neg, map_mul, map_mul]; linear_combination -hz⟩
  -- every element of `T0` reaches the range of `O`
  have hT : ∀ a : T0 π b₄ t κ, q a ∈ ι.range := by
    intro a
    induction a using AdjoinRoot.induction_on with
    | ih p =>
    induction p using Polynomial.induction_on' with
    | add p p' hp hp' => rw [map_add, map_add]; exact add_mem hp hp'
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X, map_mul,
        map_pow]
      refine mul_mem ?_ (pow_mem hzS n)
      induction c using Polynomial.induction_on' with
      | add c c' hc hc' => rw [map_add, map_add]; exact add_mem hc hc'
      | monomial n o =>
        have hX : q (AdjoinRoot.of (G0 π b₄ t κ) X) ∈ ι.range := by
          change q (h0 π b₄ t κ) ∈ ι.range
          rw [hh]
          exact zero_mem _
        rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow, of_C, hO]
        exact mul_mem ⟨o, rfl⟩ (pow_mem hX n)
  intro y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨⟨a, c⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Submonoid.powers (TateGlue0.c0 π b₄ t κ)) x
  obtain ⟨n, hn⟩ := c.2
  obtain ⟨o, ho⟩ := hT a
  refine ⟨o, ?_⟩
  have h := congrArg (Ideal.Quotient.mk 𝔪) (IsLocalization.mk'_spec (RcT π b₄ t κ) a c)
  have hc : Ideal.Quotient.mk 𝔪 (algebraMap (T0 π b₄ t κ) (RcT π b₄ t κ) c.1) = 1 := by
    have hc0 : q (TateGlue0.c0 π b₄ t κ) = 1 := by
      change q (1 + h0 π b₄ t κ) = 1
      rw [map_add, map_one, hh, add_zero]
    change q c.1 = 1
    rw [← hn, map_pow, hc0, one_pow]
  rw [map_mul, hc, mul_one] at h
  exact ho.trans h.symm

end

end TateTwoChart

end SemistableReduction
