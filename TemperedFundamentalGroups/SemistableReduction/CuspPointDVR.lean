import TemperedFundamentalGroups.SemistableReduction.AdmissibleCusp
import TemperedFundamentalGroups.SemistableReduction.TameChart

/-!
# The points of an admissible covering over its marked points are regular (MR13 C2)

Let `cov` be an admissible covering (`Admissible.Covering`) of a Noetherian chart `R` over a field
`k` **without nodes** (`IsEmpty cov.ι`), with marked points `V(f)` and formal coordinate
`ψ(X) = f` there, so that `R̂ ⊗_R C ≅ ∏ᵢ (R̂/(1 − δᵢ))[t']/(t'^{eᵢ} − f)` (`cov.kummer`, `R̂` the
`f`-adic completion, `C = cov.C`). Then:

* **`Admissible.Covering.isSMulRegular_f`**: if `f` is a nonzerodivisor on `R`, it is one on `C`
  (`f` is regular on the cusp factors, `AdmissibleLift.noTorsion_CPiece`, and the kernel of
  `C → R̂ ⊗_R C` lies in `⋂ₙ fⁿ C = 0`, Krull);
* **`Admissible.Covering.maximalIdeal_eq_span`**: at a prime `𝔪 ∋ f` of `C` over which `f` is a
  uniformizer of the base (`hU`: every `r ∈ R` with `r ∈ 𝔪` satisfies `g r ∈ f R` for some
  `g ∉ 𝔪`), the maximal ideal of `C_𝔪` is principal, generated by (a lift of) the root `t'`;
* **`Admissible.Covering.isDiscreteValuationRing_atPrime`**: hence `C_𝔪` is a discrete valuation
  ring (`IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span`).

The proof works modulo `f²`: `C/(f²) ≅ (R̂ ⊗_R C)/(f²)` (`Covering.Ψ`, from the evaluation
`R̂ → R/(f²)`), in which every element of a factor is `r + t' w` with `r` from `R̂` (hence from
`R` modulo `f²`) and `t'^{eᵢ} = f`; the idempotents of the factors are `0` or `1` in the local
ring `C_𝔪/(f²)`.

This is the input "`C0` localized at a special point over a cusp is a discrete valuation ring" of
MR12's I5(c) (`StabilizerCyclic.isCyclic_of_faithful`) for MR13's special cusp stabilisers.
-/

universe u

open Polynomial TensorProduct IsLocalRing

namespace SemistableReduction

namespace Admissible

namespace Covering

noncomputable section

variable {k : Type u} [Field k] {R : Type u} [CommRing R] [Algebra k R] {f : R}
  {φ : Node k (0 : k) →ₐ[k] Hat f} {ψ : k[X] →ₐ[k] Hat f} (cov : Covering φ ψ)

/-- The target of the formal Kummer isomorphism `cov.kummer`. -/
abbrev KT : Type u := ((j : cov.ι) → KummerPiece φ (cov.idem j) (cov.e_pos j)) ×
  ((i : cov.κ) → CuspPiece ψ (cov.cidem i) (cov.ce i))

/-- `C → R̂ ⊗_R C ≅ KT`. -/
def toKT : cov.C →+* cov.KT :=
  cov.kummer.toAlgHom.toRingHom.comp
    (Algebra.TensorProduct.includeRight : cov.C →ₐ[R] Hat f ⊗[R] cov.C).toRingHom

/-- The ideal `(fⁿ)` of `C`. -/
abbrev Jn (n : ℕ) : Ideal cov.C := Ideal.span {algebraMap R cov.C f ^ n}

lemma le_comap_Jn (n : ℕ) :
    Ideal.span {f} ^ n ≤ (cov.Jn n).comap (Algebra.ofId R cov.C) := by
  rw [Ideal.span_singleton_pow, Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.mem_comap.2 (by rw [map_pow]; exact Ideal.subset_span rfl)

/-- `R̂ → R/(fⁿ) → C/(fⁿ)`. -/
def hatQ (n : ℕ) : Hat f →ₐ[R] cov.C ⧸ cov.Jn n :=
  (Ideal.quotientMapₐ (cov.Jn n) (Algebra.ofId R cov.C) (cov.le_comap_Jn n)).comp
    (AdicCompletion.evalₐ (Ideal.span {f}) n)

lemma exists_hatQ_eq (n : ℕ) (h : Hat f) :
    ∃ r : R, cov.hatQ n h = Ideal.Quotient.mk _ (algebraMap R cov.C r) := by
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.span {f}) n h)
  refine ⟨r, ?_⟩
  rw [hatQ, AlgHom.comp_apply, ← hr, Ideal.quotient_map_mkₐ]
  rfl

/-- `R̂ ⊗_R C → C/(fⁿ)`. -/
def β (n : ℕ) : Hat f ⊗[R] cov.C →ₐ[R] cov.C ⧸ cov.Jn n :=
  Algebra.TensorProduct.lift (cov.hatQ n) (Ideal.Quotient.mkₐ R (cov.Jn n))
    (fun _ _ ↦ Commute.all _ _)

/-- `Ψ : KT ≅ R̂ ⊗_R C → C/(fⁿ)`. -/
def Ψ (n : ℕ) : cov.KT →+* cov.C ⧸ cov.Jn n :=
  (cov.β n).toRingHom.comp cov.kummer.symm.toAlgHom.toRingHom

lemma Ψ_toKT (n : ℕ) (c : cov.C) : cov.Ψ n (cov.toKT c) = Ideal.Quotient.mk _ c := by
  change cov.β n (cov.kummer.symm (cov.kummer (1 ⊗ₜ[R] c))) = _
  rw [AlgEquiv.symm_apply_apply, β, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  rfl

lemma Ψ_algebraMap (n : ℕ) (h : Hat f) :
    cov.Ψ n (algebraMap (Hat f) cov.KT h) = cov.hatQ n h := by
  have e : cov.kummer.symm (algebraMap (Hat f) cov.KT h) = h ⊗ₜ[R] (1 : cov.C) := by
    rw [AlgEquiv.commutes, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
  change cov.β n (cov.kummer.symm (algebraMap (Hat f) cov.KT h)) = _
  rw [e, β, Algebra.TensorProduct.lift_tmul, map_one, mul_one]

lemma Ψ_surjective (n : ℕ) : Function.Surjective (cov.Ψ n) := fun x ↦ by
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact ⟨cov.toKT c, cov.Ψ_toKT n c⟩

lemma toKT_algebraMap (r : R) :
    cov.toKT (algebraMap R cov.C r) = algebraMap (Hat f) cov.KT (algebraMap R (Hat f) r) := by
  have e : (Algebra.TensorProduct.includeRight : cov.C →ₐ[R] Hat f ⊗[R] cov.C)
      (algebraMap R cov.C r) = algebraMap (Hat f) (Hat f ⊗[R] cov.C) (algebraMap R (Hat f) r) := by
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R (Hat f) (Hat f ⊗[R] cov.C)]
  change cov.kummer (Algebra.TensorProduct.includeRight (algebraMap R cov.C r)) = _
  rw [e, AlgEquiv.commutes]

/-! ### The idempotents and the root in `KT` -/

variable [IsEmpty cov.ι]

instance : Subsingleton ((j : cov.ι) → KummerPiece φ (cov.idem j) (cov.e_pos j)) :=
  ⟨fun _ _ ↦ funext fun j ↦ isEmptyElim j⟩

open scoped Classical in
/-- The idempotent of the cusp factor `i`. -/
def eI (i : cov.κ) : cov.KT := (1, Pi.single i 1)

/-- The roots `t'` of all cusp factors. -/
def πT : cov.KT := (0, fun _ ↦ AdjoinRoot.root _)

lemma sum_eI : ∑ i, cov.eI i = 1 := by
  refine Prod.ext (Subsingleton.elim _ _) ?_
  rw [Prod.snd_sum]
  funext j
  classical
  simp [eI, Finset.sum_apply]

lemma eI_mul_self (i : cov.κ) : cov.eI i * cov.eI i = cov.eI i := by
  classical
  refine Prod.ext (Subsingleton.elim _ _) ?_
  funext j
  simp only [eI, Prod.snd_mul, Pi.mul_apply]
  rcases eq_or_ne j i with rfl | hj
  · simp only [Pi.single_eq_same, mul_one]
  · simp only [Pi.single_eq_of_ne hj, mul_zero]

lemma eI_mul_πT_pow (hψ : ψ X = algebraMap R (Hat f) f) (i : cov.κ) :
    cov.eI i * cov.πT ^ cov.ce i =
      cov.eI i * algebraMap (Hat f) cov.KT (algebraMap R (Hat f) f) := by
  classical
  refine Prod.ext (Subsingleton.elim _ _) ?_
  funext j
  simp only [eI, πT, Prod.snd_mul, Prod.pow_snd, Pi.mul_apply, Pi.pow_apply]
  rcases eq_or_ne j i with rfl | hj
  · simp only [Pi.single_eq_same, one_mul]
    have h0 := AdjoinRoot.mk_self (f := (X ^ cov.ce j - Polynomial.C
      (Ideal.Quotient.mk (Ideal.span {1 - cov.cidem j}) (ψ X)) :
        (Hat f ⧸ Ideal.span {1 - cov.cidem j})[X]))
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    rw [h0]
    exact congrArg (fun z : Hat f ↦ AdjoinRoot.of (X ^ cov.ce j - Polynomial.C
      (Ideal.Quotient.mk (Ideal.span {1 - cov.cidem j}) (ψ X)))
        (Ideal.Quotient.mk (Ideal.span {1 - cov.cidem j}) z)) hψ
  · simp only [Pi.single_eq_of_ne hj, zero_mul]

lemma exists_decomp (z : cov.KT) (i : cov.κ) :
    ∃ (h : Hat f) (w : cov.KT),
      cov.eI i * z = cov.eI i * (algebraMap (Hat f) cov.KT h + cov.πT * w) := by
  classical
  obtain ⟨p, hp⟩ := AdjoinRoot.mk_surjective (z.2 i)
  obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective (p.coeff 0)
  refine ⟨h, (0, Pi.single i (AdjoinRoot.mk _ (Polynomial.divX p))), ?_⟩
  refine Prod.ext (Subsingleton.elim _ _) ?_
  funext j
  simp only [eI, πT, Prod.snd_mul, Prod.snd_add, Pi.mul_apply, Pi.add_apply]
  rcases eq_or_ne j i with rfl | hj
  · simp only [Pi.single_eq_same, one_mul]
    rw [← hp]
    conv_lhs => rw [← Polynomial.X_mul_divX_add p]
    rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, ← hh, add_comm]
    rfl
  · simp only [Pi.single_eq_of_ne hj, zero_mul]

/-! ### `f` is a nonzerodivisor on `C` -/

lemma eq_zero_of_mul_f
    (hreg : ∀ y : Hat f, algebraMap R (Hat f) f * y = 0 → y = 0) (z : cov.KT)
    (hz : algebraMap (Hat f) cov.KT (algebraMap R (Hat f) f) * z = 0) : z = 0 := by
  refine Prod.ext (Subsingleton.elim _ _) ?_
  funext i
  have hzi := congrFun (congrArg Prod.snd hz) i
  simp only [Prod.snd_mul, Pi.mul_apply, Prod.snd_zero, Pi.zero_apply] at hzi
  have h := AdmissibleLift.noTorsion_CPiece (f := f) (δ := cov.cidem i) (t := ψ X) (e := cov.ce i)
    (cov.ce_pos i) (cov.isIdempotentElem_cidem i) hreg (z.2 i)
  exact h hzi

/-- **`f` is a nonzerodivisor on an admissible covering without nodes** whose coordinate at the
marked points is `f`, if it is one on the (Noetherian) chart. -/
theorem isSMulRegular_f [IsNoetherianRing R]
    (hf : IsSMulRegular R f) (c : cov.C) (hc : algebraMap R cov.C f * c = 0) : c = 0 := by
  have hreg : ∀ y : Hat f, algebraMap R (Hat f) f * y = 0 → y = 0 := fun y hy ↦ by
    have h := (isSMulRegular_algebraMap_iff (R := R) (A := Hat f) (M := Hat f)).mpr
      (hf.of_flat (S := Hat f))
    exact h (show algebraMap R (Hat f) (algebraMap R R f) * y =
      algebraMap R (Hat f) (algebraMap R R f) * 0 by
        simp only [Algebra.algebraMap_self, RingHom.id_apply, hy, mul_zero])
  have h0 : cov.toKT c = 0 := cov.eq_zero_of_mul_f hreg _ (by
    rw [← cov.toKT_algebraMap, ← map_mul, hc, map_zero])
  have hn : ∀ n, c ∈ cov.Jn n := fun n ↦ by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← cov.Ψ_toKT n, h0, map_zero]
  haveI := cov.finite
  have hmem : c ∈ (⨅ i : ℕ, (Ideal.span {f}) ^ i • ⊤ : Submodule R cov.C) := by
    refine Submodule.mem_iInf _ |>.2 fun n ↦ ?_
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.1 (hn n)
    rw [← hd, mul_comm, ← map_pow, ← Algebra.smul_def]
    exact Submodule.smul_mem_smul
      (by rw [Ideal.span_singleton_pow]; exact Ideal.mem_span_singleton_self _)
      Submodule.mem_top
  obtain ⟨⟨r, hr⟩, hrc⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff (Ideal.span {f}) c).1 hmem
  obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.1 hr
  rw [← hrc, Algebra.smul_def, map_mul, mul_assoc, hc, mul_zero]

/-! ### The maximal ideal at a point over a marked point -/

variable {cov} in
/-- An idempotent modulo an ideal `I ⊆ 𝔪` of a local ring is `0` or `1` modulo `I`. -/
lemma mem_or_one_sub_mem {A : Type*} [CommRing A] [IsLocalRing A] {I : Ideal A}
    {x : A} (hx : x * x - x ∈ I) : x ∈ I ∨ 1 - x ∈ I := by
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self x with h | h
  · right
    obtain ⟨u, rfl⟩ := h
    have : (1 - (u : A)) = -(↑u⁻¹ * ((u : A) * u - u)) := by
      rw [mul_sub, ← mul_assoc, Units.inv_mul, one_mul]
      ring
    rw [this]
    exact I.neg_mem (I.mul_mem_left _ hx)
  · left
    obtain ⟨u, hu⟩ := h
    have : x = -(↑u⁻¹ * (x * x - x)) := by
      have e : x * x - x = -((1 - x) * x) := by ring
      rw [e, ← hu, mul_neg, ← mul_assoc, Units.inv_mul, one_mul, neg_neg]
    rw [this]
    exact I.neg_mem (I.mul_mem_left _ hx)

variable [IsNoetherianRing R]

omit [IsNoetherianRing R] in
/-- **At a prime `𝔪 ∋ f` of `C` over which `f` is a uniformizer of the base, the maximal ideal of
`C_𝔪` is principal**, generated by (a lift of) the roots `t'` of the cusp factors. -/
theorem maximalIdeal_eq_span (hψ : ψ X = algebraMap R (Hat f) f) (𝔪 : Ideal cov.C) [𝔪.IsPrime]
    (hf𝔪 : algebraMap R cov.C f ∈ 𝔪)
    (hU : ∀ r : R, algebraMap R cov.C r ∈ 𝔪 → ∃ g s : R, algebraMap R cov.C g ∉ 𝔪 ∧ g * r = f * s) :
    ∃ π : cov.C, π ∈ 𝔪 ∧ maximalIdeal (Localization.AtPrime 𝔪) =
      Ideal.span {algebraMap cov.C (Localization.AtPrime 𝔪) π} := by
  classical
  set A := Localization.AtPrime 𝔪
  set ρ := algebraMap cov.C A
  have hmax : ∀ c : cov.C, ρ c ∈ maximalIdeal A ↔ c ∈ 𝔪 := fun c ↦
    IsLocalization.AtPrime.to_map_mem_maximal_iff A 𝔪 c
  set IA : Ideal A := (cov.Jn 2).map ρ with hIA
  have hIA_le : IA ≤ maximalIdeal A := by
    rw [hIA, Ideal.map_le_iff_le_comap, Ideal.span_le, Set.singleton_subset_iff]
    exact (hmax _).2 (by rw [sq]; exact Ideal.mul_mem_left _ _ hf𝔪)
  have hρJ : ∀ c, Ideal.Quotient.mk (cov.Jn 2) c = 0 → ρ c ∈ IA := fun c hc ↦
    Ideal.mem_map_of_mem _ (Ideal.Quotient.eq_zero_iff_mem.1 hc)
  have hIAf : IA ≤ Ideal.span {ρ (algebraMap R cov.C f)} := by
    rw [hIA, Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff, map_pow,
      sq]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  -- lifts of the idempotents and of the roots
  choose e he using fun i ↦ Ideal.Quotient.mk_surjective (cov.Ψ 2 (cov.eI i))
  obtain ⟨π', hπ'⟩ := Ideal.Quotient.mk_surjective (cov.Ψ 2 cov.πT)
  -- some idempotent is `1` modulo `f²` at `𝔪`
  have hidem : ∀ i, ρ (e i) ∈ IA ∨ 1 - ρ (e i) ∈ IA := fun i ↦ by
    refine mem_or_one_sub_mem ?_
    have : Ideal.Quotient.mk (cov.Jn 2) (e i * e i - e i) = 0 := by
      rw [map_sub, map_mul, he, ← map_mul, cov.eI_mul_self, sub_self]
    have h := hρJ _ this
    rwa [map_sub, map_mul] at h
  obtain ⟨i₀, hi₀⟩ : ∃ i, 1 - ρ (e i) ∈ IA := by
    by_contra hne
    push Not at hne
    have hall : ∀ i, ρ (e i) ∈ IA := fun i ↦ (hidem i).resolve_right (hne i)
    have hsum : Ideal.Quotient.mk (cov.Jn 2) (1 - ∑ i, e i) = 0 := by
      rw [map_sub, map_one, map_sum, Finset.sum_congr rfl fun i _ ↦ he i, ← map_sum, cov.sum_eI,
        map_one, sub_self]
    have h1 := hρJ _ hsum
    rw [map_sub, map_one, map_sum] at h1
    have h2 : (1 : A) ∈ IA := by
      have := IA.add_mem h1 (IA.sum_mem (t := Finset.univ) fun i _ ↦ hall i)
      rwa [sub_add_cancel] at this
    exact (maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).2 (hIA_le h2))
  -- modulo `IA`, `ρ (e i₀) = 1`
  have hmod : ∀ c : cov.C, ρ (e i₀ * c) - ρ c ∈ IA := fun c ↦ by
    have : ρ (e i₀ * c) - ρ c = -((1 - ρ (e i₀)) * ρ c) := by rw [map_mul]; ring
    rw [this]
    exact IA.neg_mem (IA.mul_mem_right _ hi₀)
  -- `f ≡ π^e` modulo `IA`
  have hpow : ρ (algebraMap R cov.C f) - ρ π' ^ cov.ce i₀ ∈ IA := by
    have h : Ideal.Quotient.mk (cov.Jn 2)
        (e i₀ * π' ^ cov.ce i₀ - e i₀ * algebraMap R cov.C f) = 0 := by
      have key : cov.Ψ 2 (cov.eI i₀ * cov.πT ^ cov.ce i₀ -
          cov.eI i₀ * cov.toKT (algebraMap R cov.C f)) = 0 := by
        rw [cov.toKT_algebraMap, cov.eI_mul_πT_pow hψ, sub_self, map_zero]
      simp only [map_sub, map_mul, map_pow] at key
      rw [← he, ← hπ', cov.Ψ_toKT] at key
      simp only [map_sub, map_mul, map_pow]
      exact key
    have h1 := hρJ _ h
    have h2 := hmod (π' ^ cov.ce i₀)
    have h3 := hmod (algebraMap R cov.C f)
    have : ρ (algebraMap R cov.C f) - ρ π' ^ cov.ce i₀ =
        (ρ (e i₀ * π' ^ cov.ce i₀) - ρ π' ^ cov.ce i₀) - (ρ (e i₀ * algebraMap R cov.C f) -
          ρ (algebraMap R cov.C f)) - ρ (e i₀ * π' ^ cov.ce i₀ - e i₀ * algebraMap R cov.C f) := by
      rw [map_sub]; ring
    rw [this]
    rw [map_pow] at h2
    exact IA.sub_mem (IA.sub_mem h2 h3) h1
  -- `f ∈ (π)` in `A` and `π ∈ 𝔪`
  have hIAsp : IA = Ideal.span {ρ (algebraMap R cov.C f) ^ 2} := by
    rw [hIA, Ideal.map_span, Set.image_singleton, map_pow]
  have hfm : ρ (algebraMap R cov.C f) ∈ maximalIdeal A := (hmax _).2 hf𝔪
  obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton'.1 (hIAsp ▸ hpow)
  set a := ρ (algebraMap R cov.C f) * a' with ha_def
  have ha : ρ (algebraMap R cov.C f) - ρ π' ^ cov.ce i₀ = ρ (algebraMap R cov.C f) * a := by
    rw [← ha', ha_def]; ring
  have hunit : IsUnit (1 - a) :=
    (isUnit_or_isUnit_one_sub_self a).resolve_left fun h ↦
      (mem_maximalIdeal _).1 (Ideal.mul_mem_right _ _ hfm) h
  have hfπ : ρ (algebraMap R cov.C f) * (1 - a) = ρ π' ^ cov.ce i₀ := by
    rw [mul_sub, mul_one, ← ha]; ring
  have hfspan : ρ (algebraMap R cov.C f) ∈ Ideal.span {ρ π'} := by
    obtain ⟨u, hu⟩ := hunit
    have : ρ (algebraMap R cov.C f) = ρ π' ^ cov.ce i₀ * ↑u⁻¹ := by
      rw [← hfπ, ← hu, mul_assoc, Units.mul_inv, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _
      (Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) _ (cov.ce_pos i₀))
  have hπm : π' ∈ 𝔪 := by
    have h : ρ π' ^ cov.ce i₀ ∈ maximalIdeal A := by
      rw [← hfπ]; exact Ideal.mul_mem_right _ _ hfm
    exact (hmax _).1 ((maximalIdeal.isMaximal A).isPrime.mem_of_pow_mem _ h)
  refine ⟨π', hπm, le_antisymm (fun x hx ↦ ?_) ?_⟩
  · obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl x
    change IsLocalization.mk' A c s = x at hcs
    subst hcs
    have hc : c ∈ 𝔪 := by
      have : ρ c = IsLocalization.mk' A c s * ρ s := by rw [IsLocalization.mk'_spec]
      rw [← hmax, this]
      exact Ideal.mul_mem_right _ _ hx
    -- decomposition `e i₀ c ≡ e i₀ (h + π w)`
    obtain ⟨h, w, hhw⟩ := cov.exists_decomp (cov.toKT c) i₀
    obtain ⟨r, hr⟩ := cov.exists_hatQ_eq 2 h
    obtain ⟨w', hw'⟩ := Ideal.Quotient.mk_surjective (cov.Ψ 2 w)
    have hdec : Ideal.Quotient.mk (cov.Jn 2)
        (e i₀ * c - e i₀ * (algebraMap R cov.C r + π' * w')) = 0 := by
      have key : cov.Ψ 2 (cov.eI i₀ * cov.toKT c -
          cov.eI i₀ * (algebraMap (Hat f) cov.KT h + cov.πT * w)) = 0 := by
        rw [hhw, sub_self, map_zero]
      simp only [map_sub, map_mul, map_add] at key
      rw [← he, cov.Ψ_toKT, cov.Ψ_algebraMap, hr, ← hπ', ← hw'] at key
      simp only [map_sub, map_mul, map_add]
      exact key
    have h1 := hρJ _ hdec
    have h2 := hmod c
    have h3 := hmod (algebraMap R cov.C r + π' * w')
    have hcong : ρ c - (ρ (algebraMap R cov.C r) + ρ π' * ρ w') ∈ IA := by
      have : ρ c - (ρ (algebraMap R cov.C r) + ρ π' * ρ w') =
          ρ (e i₀ * c - e i₀ * (algebraMap R cov.C r + π' * w')) -
            (ρ (e i₀ * c) - ρ c) + (ρ (e i₀ * (algebraMap R cov.C r + π' * w')) -
              ρ (algebraMap R cov.C r + π' * w')) := by
        simp only [map_sub, map_add, map_mul]; ring
      rw [this]
      exact IA.add_mem (IA.sub_mem h1 h2) h3
    have hIAπ : IA ≤ Ideal.span {ρ π'} := hIAf.trans (Ideal.span_le.2 (by
      rw [Set.singleton_subset_iff]; exact hfspan))
    -- `r ∈ 𝔪`, hence `r ∈ (f) ⊆ (π)` in `A`
    have hr𝔪 : algebraMap R cov.C r ∈ 𝔪 := by
      rw [← hmax]
      have : ρ (algebraMap R cov.C r) = ρ c - ρ π' * ρ w' -
          (ρ c - (ρ (algebraMap R cov.C r) + ρ π' * ρ w')) := by ring
      rw [this]
      exact (maximalIdeal A).sub_mem ((maximalIdeal A).sub_mem ((hmax _).2 hc)
        (Ideal.mul_mem_right _ _ ((hmax _).2 hπm))) (hIA_le hcong)
    obtain ⟨g, s', hg, hgr⟩ := hU r hr𝔪
    have hgu : IsUnit (ρ (algebraMap R cov.C g)) := by
      by_contra h
      exact hg ((hmax _).1 ((mem_maximalIdeal _).2 h))
    have hrspan : ρ (algebraMap R cov.C r) ∈ Ideal.span {ρ π'} := by
      obtain ⟨u, hu⟩ := hgu
      have : ρ (algebraMap R cov.C r) =
          ↑u⁻¹ * ρ (algebraMap R cov.C s') * ρ (algebraMap R cov.C f) := by
        have e1 : ρ (algebraMap R cov.C g) * ρ (algebraMap R cov.C r) =
            ρ (algebraMap R cov.C f) * ρ (algebraMap R cov.C s') := by
          rw [← map_mul, ← map_mul, ← map_mul, ← map_mul, hgr]
        rw [← hu] at e1
        calc ρ (algebraMap R cov.C r) = ↑u⁻¹ * (↑u * ρ (algebraMap R cov.C r)) := by
              rw [← mul_assoc, Units.inv_mul, one_mul]
          _ = _ := by rw [e1]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ hfspan
    have hcspan : ρ c ∈ Ideal.span {ρ π'} := by
      have : ρ c = (ρ c - (ρ (algebraMap R cov.C r) + ρ π' * ρ w')) +
          ρ (algebraMap R cov.C r) + ρ π' * ρ w' := by ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.add_mem _ (hIAπ hcong) hrspan)
        (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
    have : IsLocalization.mk' A c s = ρ c * IsLocalization.mk' A 1 s := by
      rw [← IsLocalization.mk'_one (M := 𝔪.primeCompl) A c, ← IsLocalization.mk'_mul, mul_one,
        one_mul]
    rw [this]
    exact Ideal.mul_mem_right _ _ hcspan
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact (hmax _).2 hπm

/-- **`C_𝔪` is a discrete valuation ring** at a prime `𝔪 ∋ f` of `C` over which `f` is a
uniformizer of the base, if `f` is a nonzerodivisor on the chart. -/
theorem isDiscreteValuationRing_atPrime (hψ : ψ X = algebraMap R (Hat f) f)
    (hf : IsSMulRegular R f) (𝔪 : Ideal cov.C) [𝔪.IsPrime] (hf𝔪 : algebraMap R cov.C f ∈ 𝔪)
    (hU : ∀ r : R, algebraMap R cov.C r ∈ 𝔪 → ∃ g s : R, algebraMap R cov.C g ∉ 𝔪 ∧ g * r = f * s) :
    ∃ _ : IsDomain (Localization.AtPrime 𝔪), IsDiscreteValuationRing (Localization.AtPrime 𝔪) := by
  obtain ⟨π, -, hm⟩ := cov.maximalIdeal_eq_span hψ 𝔪 hf𝔪 hU
  haveI := cov.finite
  haveI : IsNoetherianRing cov.C :=
    isNoetherian_of_tower R (isNoetherian_of_isNoetherianRing_of_finite R cov.C)
  have hfreg : IsSMulRegular cov.C (algebraMap R cov.C f) := fun x y hxy ↦ by
    have h := cov.isSMulRegular_f hf (x - y) (by rw [mul_sub, sub_eq_zero]; exact hxy)
    exact sub_eq_zero.1 h
  have hfA := Localization.AtPrime.isSMulRegular_algebraMap 𝔪 hfreg
  have hf_mem : algebraMap cov.C (Localization.AtPrime 𝔪) (algebraMap R cov.C f) ∈
      Ideal.span {algebraMap cov.C (Localization.AtPrime 𝔪) π} := by
    rw [← hm]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔪) 𝔪 _).2 hf𝔪
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.1 hf_mem
  have hπreg : IsSMulRegular (Localization.AtPrime 𝔪)
      (algebraMap cov.C (Localization.AtPrime 𝔪) π) := by
    intro x y hxy
    have hxy' : algebraMap cov.C (Localization.AtPrime 𝔪) π * x =
        algebraMap cov.C (Localization.AtPrime 𝔪) π * y := hxy
    apply hfA
    change _ * x = _ * y
    rw [← hb, mul_assoc, mul_assoc, hxy']
  exact ⟨IsLocalRing.isDomain_of_maximalIdeal_eq_span hm hπreg,
    IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span hm hπreg⟩

end

