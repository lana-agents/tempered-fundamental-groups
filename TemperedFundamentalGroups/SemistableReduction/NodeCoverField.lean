import Mathlib

/-!
# The field-theoretic core of the prime-to-`p` covers of a node

Let `K ⊆ E` be a finite field extension generated by an element `X` with `X ^ M ∈ K`, of degree
exactly `[E : K] = M = q M'`. This is the extension `k(W_1) / k(W_M)`, `x = X ^ M`, of the
function fields of the punctured spectra of the node of thickness `1` over the node of thickness
`M` (step (3) of the lemma "S4-local" in the MR12 plan, a special case of [MzkExt] Thm. 3.3 with
Lemmas 3.1 and 3.2). We show:

* `NodeCover.finrank_adjoin_pow_eq`: the intermediate field `F = K⟮X ^ q⟯` has degree exactly
  `M'` over `K`, and `[E : F] = q`.
* `NodeCover.le_adjoin_pow_of_isGalois`: every subextension `L ⊆ E` which is Galois over `K` of
  degree prime to `q` lies in `F`. Indeed `[L F : F]` divides both `[L : K]` (restriction of
  automorphisms, `IntermediateField.restrictRestrictAlgEquivMapHom_injective`) and
  `[E : F] = q`.
* `NodeCover.eq_adjoin_pow_of_isPrimitiveRoot`: if `E = K⟮ξ⟯`, `ξ ^ n ∈ K`, `[E : K] = n` and `K`
  contains a primitive `n`-th root of unity (a cyclic Kummer extension), every intermediate field
  of degree `e` is `K⟮ξ ^ (n / e)⟯`.
* `NodeCover.eq_adjoin_pow_of_isGalois`: combining the two, a Galois subextension `L ⊆ E` of
  degree `e` prime to `q`, when `K` contains a primitive `M'`-th root of unity, satisfies
  `e ∣ M'` and `L = K⟮X ^ (q · (M' / e))⟯`, i.e. `L = K(x ^ {1 / e})`.

No separability of `E / K` is needed: in the application `q` is the `p`-part of the thickness `M`
(`p` the residue characteristic), so `E / K` may be inseparable in equal characteristic.

## References

* [MzkExt] S. Mochizuki, *Extending families of curves over log regular schemes*, J. reine angew.
  Math. 511 (1999), Thm. 3.3 and Lemmas 3.1, 3.2.
* [Mzk1] S. Mochizuki, *Semi-graphs of anabelioids*, §3.12 (the case `M` invertible).
-/

open IntermediateField Module Polynomial

namespace SemistableReduction.NodeCover

variable {K E : Type*} [Field K] [Field E] [Algebra K E]

/-- If `α ^ n ∈ K` with `0 < n`, then `[K⟮α⟯ : K] ≤ n`. -/
theorem finrank_adjoin_le_of_pow_eq {n : ℕ} (hn : 0 < n) {α : E} {a : K}
    (ha : α ^ n = algebraMap K E a) : finrank K K⟮α⟯ ≤ n := by
  have hint : IsIntegral K α := ⟨X ^ n - C a, monic_X_pow_sub_C a hn.ne', by simp [ha]⟩
  rw [adjoin.finrank hint]
  calc (minpoly K α).natDegree ≤ (X ^ n - C a : K[X]).natDegree :=
        natDegree_le_of_dvd (minpoly.dvd K α (by simp [ha])) (X_pow_sub_C_ne_zero hn a)
    _ = n := natDegree_X_pow_sub_C

/-- If `E = K⟮X⟯`, then `E = K⟮X ^ q⟯⟮X⟯`. -/
theorem adjoin_adjoin_pow_eq_top {X : E} (hX : K⟮X⟯ = ⊤) (q : ℕ) : K⟮X ^ q⟯⟮X⟯ = ⊤ := by
  rw [← restrictScalars_eq_top_iff (K := K), adjoin_simple_adjoin_simple, eq_top_iff, ← hX]
  exact adjoin.mono _ _ _ (by simp)

/-- If `E = K⟮X⟯` and `0 < q`, then `[E : K⟮X ^ q⟯] ≤ q`. -/
theorem finrank_le_of_adjoin_eq_top {q : ℕ} (hq : 0 < q) {X : E} (hX : K⟮X⟯ = ⊤) :
    finrank K⟮X ^ q⟯ E ≤ q := by
  rw [← finrank_top', ← adjoin_adjoin_pow_eq_top hX q]
  exact finrank_adjoin_le_of_pow_eq hq (a := ⟨X ^ q, mem_adjoin_simple_self K _⟩) rfl

/-- If `L, F` are intermediate fields of a finite extension `E / K` with `L / K` Galois and
`L ⊔ F = E`, then `[E : F]` divides `[L : K]`. -/
theorem finrank_dvd_of_sup_eq_top [FiniteDimensional K E] (L F : IntermediateField K E)
    [IsGalois K L] (h : L ⊔ F = ⊤) : finrank F E ∣ finrank K L := by
  have : IsGalois F E := IsGalois.sup_right L F h
  rw [← IsGalois.card_aut_eq_finrank F E, ← IsGalois.card_aut_eq_finrank K L]
  exact Subgroup.card_dvd_of_injective _ (restrictRestrictAlgEquivMapHom_injective L F h)

variable [FiniteDimensional K E] {q M' : ℕ} {X : E} {x : K}

/-- Let `E = K⟮X⟯` with `X ^ (q M') ∈ K` and `[E : K] = q M'`. Then `F = K⟮X ^ q⟯` has degree
`M'` over `K` and `[E : F] = q`. -/
theorem finrank_adjoin_pow_eq (hq : 0 < q) (hM' : 0 < M') (hx : X ^ (q * M') = algebraMap K E x)
    (hX : K⟮X⟯ = ⊤) (hE : finrank K E = q * M') :
    finrank K K⟮X ^ q⟯ = M' ∧ finrank K⟮X ^ q⟯ E = q := by
  have hF : finrank K K⟮X ^ q⟯ ≤ M' :=
    finrank_adjoin_le_of_pow_eq hM' (by rw [← pow_mul, hx])
  have hEF := finrank_le_of_adjoin_eq_top hq hX
  have h1 := finrank_mul_finrank K K⟮X ^ q⟯ E
  rw [hE] at h1
  have h2 : M' ≤ finrank K K⟮X ^ q⟯ := by
    refine Nat.le_of_mul_le_mul_left ?_ hq
    calc q * M' = finrank K K⟮X ^ q⟯ * finrank K⟮X ^ q⟯ E := h1.symm
      _ ≤ finrank K K⟮X ^ q⟯ * q := Nat.mul_le_mul_left _ hEF
      _ = q * finrank K K⟮X ^ q⟯ := mul_comm _ _
  have h3 : finrank K K⟮X ^ q⟯ = M' := le_antisymm hF h2
  refine ⟨h3, Nat.eq_of_mul_eq_mul_left hM' ?_⟩
  calc M' * finrank K⟮X ^ q⟯ E = finrank K K⟮X ^ q⟯ * finrank K⟮X ^ q⟯ E := by rw [h3]
    _ = M' * q := by rw [h1, mul_comm]

/-- **The field lemma, Galois part** (step (3) of "S4-local"). Let `E = K⟮X⟯` with
`X ^ (q M') ∈ K` and `[E : K] = q M'`. Every intermediate field `L` which is Galois over `K` of
degree prime to `q` is contained in `K⟮X ^ q⟯`. -/
theorem le_adjoin_pow_of_isGalois (hq : 0 < q) (hM' : 0 < M')
    (hx : X ^ (q * M') = algebraMap K E x) (hX : K⟮X⟯ = ⊤) (hE : finrank K E = q * M')
    (L : IntermediateField K E) [IsGalois K L] (hL : Nat.Coprime (finrank K L) q) :
    L ≤ K⟮X ^ q⟯ := by
  set F := K⟮X ^ q⟯
  obtain ⟨hF, -⟩ := finrank_adjoin_pow_eq hq hM' hx hX hE
  let C : IntermediateField K E := L ⊔ F
  let L' : IntermediateField K C := restrict (le_sup_left : L ≤ C)
  let F' : IntermediateField K C := restrict (le_sup_right : F ≤ C)
  have h₁ : L' ⊔ F' = ⊤ := by
    rw [← lift_inj, lift_top, lift_sup, lift_restrict, lift_restrict]
  have : IsGalois K L' := IsGalois.of_algEquiv (restrict_algEquiv _)
  have hL' : finrank K L' = finrank K L := (restrict_algEquiv _).toLinearEquiv.finrank_eq.symm
  have hF' : finrank K F' = M' := by
    rw [← hF]
    exact (restrict_algEquiv _).toLinearEquiv.finrank_eq.symm
  have hd₁ : finrank F' C ∣ finrank K L := hL' ▸ finrank_dvd_of_sup_eq_top L' F' h₁
  have hd₂ : finrank F' C ∣ q := by
    have e₁ := finrank_mul_finrank K F' C
    have e₂ := finrank_mul_finrank K C E
    rw [hE, ← e₁, hF', mul_assoc, mul_comm q] at e₂
    exact ⟨_, Nat.eq_of_mul_eq_mul_left hM' e₂.symm⟩
  have h1 : finrank F' C = 1 := (Nat.Coprime.coprime_dvd_left hd₁ hL).eq_one_of_dvd hd₂
  have htop : F' = ⊤ :=
    eq_of_le_of_finrank_eq' le_top (by rw [h1, IntermediateField.finrank_top])
  calc L ≤ C := le_sup_left
    _ = lift (⊤ : IntermediateField K C) := by rw [lift_top]
    _ = lift F' := by rw [htop]
    _ = F := lift_restrict _

/-- **The cyclic Kummer field lemma** (step (4) of "S4-local"). Let `E = K⟮ξ⟯` with
`ξ ^ n ∈ K`, `[E : K] = n`, and let `K` contain a primitive `n`-th root of unity. Then every
intermediate field `L` is `K⟮ξ ^ (n / [L : K])⟯`. -/
theorem eq_adjoin_pow_of_isPrimitiveRoot {n : ℕ} {ζ : K} (hζ : IsPrimitiveRoot ζ n) {ξ : E}
    {a : K} (ha : ξ ^ n = algebraMap K E a) (hξ : K⟮ξ⟯ = ⊤) (hE : finrank K E = n)
    (L : IntermediateField K E) : L = K⟮ξ ^ (n / finrank K L)⟯ := by
  have hn : 0 < n := hE ▸ finrank_pos
  have : NeZero n := ⟨hn.ne'⟩
  have hK : (primitiveRoots (finrank K E) K).Nonempty :=
    ⟨ζ, by rw [hE, mem_primitiveRoots hn]; exact hζ⟩
  have h3 : ∃ α : E, α ^ finrank K E ∈ Set.range (algebraMap K E) ∧ K⟮α⟯ = ⊤ :=
    ⟨ξ, ⟨a, by rw [hE, ha]⟩, hξ⟩
  have h4 : IsGalois K E ∧ IsCyclic Gal(E/K) := ((isCyclic_tfae K E hK).out 2 0).mp h3
  have : IsGalois K E := h4.1
  set e := finrank K L
  set d := finrank L E
  have hed : e * d = n := hE ▸ finrank_mul_finrank K L E
  have he : 0 < e := finrank_pos
  have hd : 0 < d := finrank_pos
  have hnd : n / e = d := by rw [← hed, Nat.mul_div_cancel_left d he]
  rw [hnd]
  have hle : K⟮ξ ^ d⟯ ≤ L := by
    rw [adjoin_simple_le_iff]
    by_cases hξ0 : ξ = 0
    · rw [hξ0, zero_pow hd.ne']
      exact L.zero_mem
    rw [← IsGalois.fixedField_fixingSubgroup L, mem_fixedField_iff]
    intro σ hσ
    have hσd : σ ^ d = 1 := by
      have h := pow_card_eq_one' (G := L.fixingSubgroup) (x := ⟨σ, hσ⟩)
      rw [IsGalois.card_fixingSubgroup_eq_finrank] at h
      exact congr_arg Subtype.val h
    have hpow : (σ ξ * ξ⁻¹) ^ n = 1 := by
      rw [mul_pow, ← map_pow, ha, AlgEquiv.commutes, ← ha, inv_pow,
        mul_inv_cancel₀ (pow_ne_zero _ hξ0)]
    obtain ⟨i, -, hi⟩ :=
      (hζ.map_of_injective (algebraMap K E).injective).eq_pow_of_pow_eq_one hpow
    set c := algebraMap K E ζ ^ i
    have hσξ : σ ξ = c * ξ := by rw [hi, mul_assoc, inv_mul_cancel₀ hξ0, mul_one]
    have hiter : ∀ m : ℕ, (σ ^ m) ξ = c ^ m * ξ := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, map_pow, hσξ]
        have hc : σ c = c := by simp only [c, ← map_pow, AlgEquiv.commutes]
        rw [hc]
        ring
    have hcd : c ^ d = 1 := by
      have h := hiter d
      rw [hσd, AlgEquiv.one_apply] at h
      exact (mul_eq_right₀ hξ0).mp h.symm
    rw [map_pow, hσξ, mul_pow, hcd, one_mul]
  refine (eq_of_le_of_finrank_le hle ?_).symm
  have h1 := finrank_mul_finrank K K⟮ξ ^ d⟯ E
  have h2 := finrank_le_of_adjoin_eq_top hd hξ
  refine Nat.le_of_mul_le_mul_right ?_ hd
  calc e * d = finrank K K⟮ξ ^ d⟯ * finrank K⟮ξ ^ d⟯ E := by rw [hed, h1, hE]
    _ ≤ finrank K K⟮ξ ^ d⟯ * d := Nat.mul_le_mul_left _ h2

/-- **The field lemma of "S4-local"** (steps (3) and (4)). Let `E = K⟮X⟯` with
`X ^ (q M') = x ∈ K` and `[E : K] = q M'`, and let `K` contain a primitive `M'`-th root of unity.
Every intermediate field `L` which is Galois over `K` of degree `e` prime to `q` satisfies
`e ∣ M'` and `L = K⟮X ^ (q · (M' / e))⟯`, i.e. `L = K(x ^ {1 / e})`. -/
theorem eq_adjoin_pow_of_isGalois (hq : 0 < q) (hM' : 0 < M') {ζ : K}
    (hζ : IsPrimitiveRoot ζ M') (hx : X ^ (q * M') = algebraMap K E x) (hX : K⟮X⟯ = ⊤)
    (hE : finrank K E = q * M') (L : IntermediateField K E) [IsGalois K L]
    (hL : Nat.Coprime (finrank K L) q) :
    finrank K L ∣ M' ∧ L = K⟮X ^ (q * (M' / finrank K L))⟯ := by
  set F := K⟮X ^ q⟯
  have hLF := le_adjoin_pow_of_isGalois hq hM' hx hX hE L hL
  obtain ⟨hF, -⟩ := finrank_adjoin_pow_eq hq hM' hx hX hE
  let L' : IntermediateField K F := restrict hLF
  have hL' : finrank K L' = finrank K L := (restrict_algEquiv _).toLinearEquiv.finrank_eq.symm
  let ξ : F := ⟨X ^ q, mem_adjoin_simple_self K _⟩
  have hξ : K⟮ξ⟯ = ⊤ := by
    rw [← lift_inj, lift_adjoin_simple, lift_top]
  have ha : ξ ^ M' = algebraMap K F x := Subtype.ext (by simp [ξ, ← pow_mul, hx])
  have hdvd : finrank K L ∣ M' := by
    rw [← hL', ← hF]
    exact Dvd.intro _ (finrank_mul_finrank K L' F)
  refine ⟨hdvd, ?_⟩
  have h := eq_adjoin_pow_of_isPrimitiveRoot hζ ha hξ hF L'
  rw [hL'] at h
  calc L = lift L' := (lift_restrict hLF).symm
    _ = lift K⟮ξ ^ (M' / finrank K L)⟯ := by rw [← h]
    _ = K⟮X ^ (q * (M' / finrank K L))⟯ := by
      rw [lift_adjoin_simple]
      simp [ξ, pow_mul]

end SemistableReduction.NodeCover
