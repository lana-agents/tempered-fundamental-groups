import TemperedFundamentalGroups.SemistableReduction.Node

/-!
# The function fields of the nodes and the degree of the Kummer map

Let `O` be a domain with fraction field `K` and `c ∈ O` nonzero. The node `Node O c` embeds into
the rational function field `K(T)` via `u ↦ T`, `v ↦ c / T` (`Node.toRatFunc c 1`), and this
makes `K(T)` its fraction field (`Node.isFractionRing_ratFunc`). For `0 < M` the node
`Node O (c ^ M)` embeds via `u ↦ T ^ M`, `v ↦ c ^ M / T ^ M` into the intermediate field
`K(T ^ M) = K⟮T ^ M⟯`, which is its fraction field (`Node.isFractionRing_adjoin_pow`), compatibly
with the Kummer map `u ↦ u ^ M`, `v ↦ v ^ M` (`Node.algebraMap_toAdjoinPow`).

Hence the extension of function fields `k(W_1) / k(W_M)` of the Kummer map of step (1) of the
lemma "S4-local" (MR12 plan) is `K(T) / K(T ^ M)`: it is generated by `T` with
`T ^ M = u` (`Node.adjoin_X_eq_top`) and has degree exactly `M`
(`Node.finrank_adjoin_X_pow`, from Mathlib's `RatFunc.finrank_eq_max_natDegree`), for every
`M ≥ 1`, also when `M` is divisible by the residue characteristic.

## References

* [MzkExt] S. Mochizuki, *Extending families of curves over log regular schemes*, J. reine angew.
  Math. 511 (1999), Thm. 3.3.
-/

open Polynomial IntermediateField
open scoped LaurentPolynomial

namespace SemistableReduction.Node

variable {O : Type*} [CommRing O] [IsDomain O]

local notation "K" => FractionRing O

/-- The ring map `K[T;T⁻¹] → K(T)`, `T ↦ T`. -/
noncomputable def laurentToRatFunc : K[T;T⁻¹] →+* RatFunc K :=
  IsLocalization.Away.lift (X : K[X]) (g := algebraMap K[X] (RatFunc K))
    (isUnit_iff_ne_zero.mpr (RatFunc.algebraMap_ne_zero X_ne_zero))

lemma laurentToRatFunc_toLaurent (p : K[X]) :
    laurentToRatFunc (O := O) (toLaurent p) = algebraMap K[X] (RatFunc K) p := by
  rw [← LaurentPolynomial.algebraMap_eq_toLaurent, laurentToRatFunc, IsLocalization.Away.lift,
    IsLocalization.lift_eq]

lemma laurentToRatFunc_C (a : K) :
    laurentToRatFunc (O := O) (LaurentPolynomial.C a) = RatFunc.C a := by
  rw [← Polynomial.toLaurent_C, laurentToRatFunc_toLaurent, RatFunc.algebraMap_C]

lemma laurentToRatFunc_T (n : ℤ) :
    laurentToRatFunc (O := O) (LaurentPolynomial.T n) = RatFunc.X ^ n := by
  have hnat : ∀ m : ℕ, laurentToRatFunc (O := O) (LaurentPolynomial.T m) = RatFunc.X ^ m := by
    intro m
    rw [← Polynomial.toLaurent_X_pow, laurentToRatFunc_toLaurent, map_pow, RatFunc.algebraMap_X]
  obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
  · rw [hnat, zpow_natCast]
  · have h : laurentToRatFunc (O := O) (LaurentPolynomial.T (-m)) *
        laurentToRatFunc (LaurentPolynomial.T m) = 1 := by
      rw [← map_mul, ← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero,
        map_one]
    rw [zpow_neg, zpow_natCast, ← hnat]
    exact eq_inv_of_mul_eq_one_left h

lemma laurentToRatFunc_injective : Function.Injective (laurentToRatFunc (O := O)) := by
  rw [injective_iff_map_eq_zero]
  intro f hf
  obtain ⟨n, f', hf'⟩ := LaurentPolynomial.exists_T_pow f
  have h1 : algebraMap K[X] (RatFunc K) f' = 0 := by
    rw [← laurentToRatFunc_toLaurent, hf', map_mul, hf, zero_mul]
  rw [map_eq_zero_iff _ (RatFunc.algebraMap_injective K)] at h1
  have h2 : f * LaurentPolynomial.T n = 0 := by rw [← hf', h1, map_zero]
  exact ((LaurentPolynomial.isUnit_T _).mul_left_eq_zero).mp h2

variable (c : O)

/-- The ring map `Node O c → K(T)`, `u ↦ T ^ k`, `v ↦ c / T ^ k`. -/
noncomputable def toRatFunc (k : ℕ) : Node O c →+* RatFunc K :=
  laurentToRatFunc.comp (laurent c k).toRingHom

@[simp] lemma toRatFunc_u (k : ℕ) : toRatFunc c k (u c) = RatFunc.X ^ k := by
  simp [toRatFunc, laurentToRatFunc_T]

@[simp] lemma toRatFunc_v (k : ℕ) :
    toRatFunc c k (v c) = RatFunc.C (algebraMap O K c) * (RatFunc.X ^ k)⁻¹ := by
  simp [toRatFunc, laurentToRatFunc_T, laurentToRatFunc_C]

@[simp] lemma toRatFunc_algebraMap (k : ℕ) (r : O) :
    toRatFunc c k (algebraMap O (Node O c) r) = algebraMap K (RatFunc K) (algebraMap O K r) := by
  simp [toRatFunc, LaurentPolynomial.algebraMap_apply, laurentToRatFunc_C,
    RatFunc.algebraMap_eq_C]

lemma toRatFunc_aeval_u (k : ℕ) (q : O[X]) :
    toRatFunc c k (aeval (u c) q) =
      aeval ((RatFunc.X : RatFunc K) ^ k) (q.map (algebraMap O K)) := by
  rw [aeval_def, hom_eval₂, aeval_def, eval₂_map, toRatFunc_u]
  congr 1
  ext r
  simp

variable {c}

theorem toRatFunc_injective (hc : c ≠ 0) {k : ℕ} (hk : 0 < k) :
    Function.Injective (toRatFunc c k) :=
  laurentToRatFunc_injective.comp (laurent_injective hc hk)

variable (c) in
lemma toRatFunc_comp_kummer (M : ℕ) :
    (toRatFunc c 1).comp (kummer c M).toRingHom = toRatFunc (c ^ M) M := by
  rw [toRatFunc, toRatFunc, ← laurent_comp_kummer]
  rfl

/-- Clearing denominators: `p (T ^ k)` is a quotient of two elements of the node. -/
lemma exists_aeval_eq_div (k : ℕ) (p : K[X]) :
    ∃ x y : Node O c,
      aeval ((RatFunc.X : RatFunc K) ^ k) p = toRatFunc c k x / toRatFunc c k y := by
  obtain ⟨b, hb, hq⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors O) p
  refine ⟨aeval (u c) (IsLocalization.integerNormalization (nonZeroDivisors O) p),
    algebraMap O _ b, ?_⟩
  have hb0 : algebraMap K (RatFunc K) (algebraMap O K b) ≠ 0 := by
    rw [map_ne_zero_iff _ (algebraMap K (RatFunc K)).injective,
      map_ne_zero_iff _ (IsFractionRing.injective O K)]
    exact nonZeroDivisors.ne_zero hb
  rw [toRatFunc_aeval_u, hq, toRatFunc_algebraMap, Algebra.smul_def, map_mul,
    Polynomial.algebraMap_apply, aeval_C, mul_div_cancel_left₀ _ hb0]

section Fraction

variable (c)

/-- `K(T)` as an algebra over the node `Node O c` via `u ↦ T`, `v ↦ c / T`. Not an instance. -/
noncomputable abbrev ratFuncAlgebra : Algebra (Node O c) (RatFunc K) := (toRatFunc c 1).toAlgebra

variable {c}

/-- **`K(T)` is the fraction field of the node** `Node O c` (`u ↦ T`, `v ↦ c / T`). -/
theorem isFractionRing_ratFunc (hc : c ≠ 0) :
    letI := ratFuncAlgebra c
    IsFractionRing (Node O c) (RatFunc K) := by
  letI := ratFuncAlgebra c
  have : FaithfulSMul (Node O c) (RatFunc K) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (toRatFunc_injective hc one_pos)
  refine IsFractionRing.of_field _ _ fun z ↦ ?_
  obtain ⟨x₁, y₁, h₁⟩ := exists_aeval_eq_div (c := c) 1 z.num
  obtain ⟨x₂, y₂, h₂⟩ := exists_aeval_eq_div (c := c) 1 z.denom
  refine ⟨x₁ * y₂, y₁ * x₂, ?_⟩
  rw [pow_one, RatFunc.aeval_X_left_eq_algebraMap] at h₁ h₂
  change z = toRatFunc c 1 (x₁ * y₂) / toRatFunc c 1 (y₁ * x₂)
  rw [← RatFunc.num_div_denom z, h₁, h₂, map_mul, map_mul, div_div_div_eq]

variable (c) {M : ℕ}

/-- The image of `Node O (c ^ M)` lies in `K(T ^ M)`. -/
lemma toRatFunc_mem_adjoin (x : Node O (c ^ M)) :
    toRatFunc (c ^ M) M x ∈ K⟮(RatFunc.X : RatFunc K) ^ M⟯ := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C r =>
    rw [show (Ideal.Quotient.mk _ (MvPolynomial.C r) : Node O (c ^ M)) = algebraMap O _ r from
      rfl, toRatFunc_algebraMap]
    exact IntermediateField.algebraMap_mem _ _
  | add p q hp hq => rw [map_add, map_add]; exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul]
    refine mul_mem hp ?_
    fin_cases i
    · exact (toRatFunc_u (c ^ M) M).symm ▸ mem_adjoin_simple_self K _
    · refine (toRatFunc_v (c ^ M) M).symm ▸ mul_mem ?_ (inv_mem (mem_adjoin_simple_self K _))
      rw [← RatFunc.algebraMap_eq_C]
      exact IntermediateField.algebraMap_mem _ _

/-- The ring map `Node O (c ^ M) → K(T ^ M)`, `u ↦ T ^ M`, `v ↦ c ^ M / T ^ M`. -/
noncomputable def toAdjoinPow (M : ℕ) : Node O (c ^ M) →+* K⟮(RatFunc.X : RatFunc K) ^ M⟯ :=
  (toRatFunc (c ^ M) M).codRestrict _ (toRatFunc_mem_adjoin c)

/-- Compatibility with the Kummer map: `Node O (c ^ M) → K(T ^ M) ⊆ K(T)` is
`Node O (c ^ M) → Node O c → K(T)`. -/
@[simp] lemma algebraMap_toAdjoinPow (x : Node O (c ^ M)) :
    algebraMap K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K) (toAdjoinPow c M x) =
      toRatFunc c 1 (kummer c M x) := by
  change toRatFunc (c ^ M) M x = _
  rw [← toRatFunc_comp_kummer]
  rfl

/-- `K(T ^ M)` as an algebra over `Node O (c ^ M)`. Not an instance. -/
noncomputable abbrev adjoinPowAlgebra (M : ℕ) :
    Algebra (Node O (c ^ M)) K⟮(RatFunc.X : RatFunc K) ^ M⟯ :=
  (toAdjoinPow c M).toAlgebra

variable {c}

/-- **`K(T ^ M)` is the fraction field of the node** `Node O (c ^ M)`
(`u ↦ T ^ M`, `v ↦ c ^ M / T ^ M`). -/
theorem isFractionRing_adjoin_pow (hc : c ≠ 0) (hM : 0 < M) :
    letI := adjoinPowAlgebra c M
    IsFractionRing (Node O (c ^ M)) K⟮(RatFunc.X : RatFunc K) ^ M⟯ := by
  letI := adjoinPowAlgebra c M
  have hinj : Function.Injective (toAdjoinPow c M) := fun x y h ↦
    toRatFunc_injective (pow_ne_zero M hc) hM (congr_arg Subtype.val h)
  have : FaithfulSMul (Node O (c ^ M)) K⟮(RatFunc.X : RatFunc K) ^ M⟯ :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  refine IsFractionRing.of_field _ _ fun z ↦ ?_
  obtain ⟨r, s, hrs⟩ := (mem_adjoin_simple_iff K (z : RatFunc K)).mp z.2
  obtain ⟨x₁, y₁, h₁⟩ := exists_aeval_eq_div (c := c ^ M) M r
  obtain ⟨x₂, y₂, h₂⟩ := exists_aeval_eq_div (c := c ^ M) M s
  refine ⟨x₁ * y₂, y₁ * x₂, Subtype.ext ?_⟩
  change (z : RatFunc K) = toRatFunc (c ^ M) M (x₁ * y₂) / toRatFunc (c ^ M) M (y₁ * x₂)
  rw [hrs, h₁, h₂, map_mul, map_mul, div_div_div_eq]

end Fraction

/-- `K(T) = K(T ^ M)(T)`. -/
theorem adjoin_X_eq_top (M : ℕ) :
    (K⟮(RatFunc.X : RatFunc K) ^ M⟯)⟮(RatFunc.X : RatFunc K)⟯ = ⊤ :=
  RatFunc.IntermediateField.adjoin_X _

/-- **The degree of the Kummer map on function fields**: `[K(T) : K(T ^ M)] = M`. -/
theorem finrank_adjoin_X_pow (M : ℕ) :
    Module.finrank K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K) = M := by
  rw [RatFunc.finrank_eq_max_natDegree, ← RatFunc.algebraMap_X, ← map_pow,
    RatFunc.num_algebraMap, RatFunc.denom_algebraMap, natDegree_X_pow, natDegree_one,
    Nat.max_zero]

end SemistableReduction.Node
