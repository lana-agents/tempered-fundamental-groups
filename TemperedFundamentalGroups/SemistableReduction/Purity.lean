import Mathlib

/-!
# Purity of the branch locus in dimension two (Zariski–Nagata)

Let `A` be a Noetherian integrally closed local domain whose maximal ideal is generated by two
elements `x, y` with `x` prime and `y ∉ (x)` (for instance a two-dimensional regular local ring
with a regular system of parameters `x, y`), let `L` be a finite separable extension of
`K = Frac A` and let `B` be the integral closure of `A` in `L`. If `B` is unramified over `A`
at every prime not lying over the maximal ideal of `A`, then `B` is étale over `A`.

This is the case `dim A = 2` of the purity theorem of Zariski–Nagata, SGA 1, Exp. X,
Théorème 3.1 / Corollaire 3.2, and we follow the "démonstration très simple dans le cas
particulier où dim A = 2" given there after Cor. 3.2: `B` normal ⇒ `B` has depth `≥ 2` ⇒
`B` is free over `A` ⇒ the ramification locus is the zero locus of the discriminant, a
principal ideal (SGA 1, Exp. I, 4.10) ⇒ it is empty since it is contained in the closed point.

We replace the depth argument by an elementary one:
* `A[1/x] ∩ A[1/a] = A` for every `a ∉ (x)` (`Purity.mem_range_of_pow_mul_mem`), hence every
  `a ∉ (x)` is a non-zero-divisor on `B/xB` (`Purity.exists_eq_smul_of_smul_eq_smul`);
* `A/(x)` is a discrete valuation ring (`Purity.isDiscreteValuationRing_quotient`), so the finite
  torsion-free `A/(x)`-module `B/xB` is free, and since `x` is `B`-regular, `B` is free over `A`
  (`Purity.free_of_maximalIdeal_eq_span_pair`, via `Module.free_quotSMulTop_iff_free`).

The discriminant part is the trace criterion over a field
(`Purity.formallyUnramified_iff_discr_ne_zero`: a finite algebra over a field is unramified iff
its trace form is nondegenerate, proved by passing to an algebraic closure), together with base
change of discriminants (`Purity.discr_baseChange`) and Krull's principal ideal theorem.

## Main results

* `Purity.free_of_maximalIdeal_eq_span_pair`: `B` is a free `A`-module.
* `Purity.formallyUnramified_iff_discr_ne_zero`: trace criterion for finite algebras over fields.
* `Purity.formallyUnramified_of_isUnit_discr`: a finite free algebra over a local ring with unit
  discriminant is unramified.
* `Purity.discr_notMem_of_formallyUnramified_fiber`: unramified fibre at `P` ⇒ `disc ∉ P`.
* `Purity.etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair`: if the fibres over
  all primes of height `≤ 1` are unramified, `B` is étale over `A`.
* `Purity.etale_of_isUnramifiedAt_of_maximalIdeal_eq_span_pair`: **purity in dimension two**.

## References

* [SGA 1] A. Grothendieck, *Revêtements étales et groupe fondamental*, Exp. X, §3,
  Théorème de pureté 3.1 (Zariski–Nagata) and Corollaire 3.2 (with the proof for `dim A = 2`);
  Exp. I, 4.10.
-/

open Polynomial IsLocalRing TensorProduct
open scoped Pointwise

namespace SemistableReduction.Purity

section intersection

variable {A : Type*} [CommRing A] [IsDomain A] {K : Type*} [Field K] [Algebra A K]
  [IsFractionRing A K]

/-- `A[1/x] ∩ A[1/a] = A` inside `K = Frac A`, for `x` prime and `a ∉ (x)`. -/
theorem mem_range_of_pow_mul_mem {x a : A} (hx : Prime x) (ha : a ∉ Ideal.span {x}) {c : K}
    (m : ℕ) (h₁ : algebraMap A K x ^ m * c ∈ Set.range (algebraMap A K))
    (h₂ : algebraMap A K a ^ m * c ∈ Set.range (algebraMap A K)) :
    c ∈ Set.range (algebraMap A K) := by
  obtain ⟨α, hα⟩ := h₁
  obtain ⟨β, hβ⟩ := h₂
  have hinj := IsFractionRing.injective A K
  have hab : a ^ m * α = x ^ m * β :=
    hinj (by rw [map_mul, map_mul, hα, hβ, map_pow, map_pow]; ring)
  have hxa : ¬ x ∣ a := fun h ↦ ha (Ideal.mem_span_singleton.mpr h)
  have hxa' : ¬ x ∣ a ^ m := fun h ↦ hxa (hx.dvd_of_dvd_pow h)
  obtain ⟨γ, rfl⟩ : x ^ m ∣ α :=
    (hx.pow_dvd_of_dvd_mul_left m hxa' ⟨β, hab⟩)
  refine ⟨γ, ?_⟩
  have hx0 : algebraMap A K x ^ m ≠ 0 :=
    pow_ne_zero _ ((map_ne_zero_iff _ hinj).mpr hx.ne_zero)
  apply mul_left_cancel₀ hx0
  rw [← hα, map_mul, map_pow]


section integral

variable {L : Type*} [Field L] [Algebra K L]

omit [IsDomain A] [Algebra A K] [IsFractionRing A K] in
/-- Scaling a root by a nonzero scalar `r` scales the roots of the minimal polynomial. -/
theorem minpoly_algebraMap_mul {r : K} (hr : r ≠ 0) {f : L} (hf : IsIntegral K f) :
    minpoly K (algebraMap K L r * f) = (minpoly K f).scaleRoots r := by
  have hrf : IsIntegral K (algebraMap K L r * f) := isIntegral_algebraMap.mul hf
  refine (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hrf)
    ((monic_scaleRoots_iff r).mpr (minpoly.monic hf))
    (minpoly.dvd _ _ (scaleRoots_aeval_eq_zero (minpoly.aeval K f))) ?_).symm
  rw [natDegree_scaleRoots]
  have h0 : aeval f ((minpoly K (algebraMap K L r * f)).scaleRoots r⁻¹) = 0 := by
    have := scaleRoots_aeval_eq_zero (r := r⁻¹) (minpoly.aeval K (algebraMap K L r * f))
    rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hr, map_one, one_mul] at this
  have := minpoly.min K f ((monic_scaleRoots_iff _).mpr (minpoly.monic hrf)) h0
  rw [degree_scaleRoots] at this
  exact natDegree_le_natDegree this

variable [Algebra A L] [IsScalarTower A K L]

variable (K) in
include K in
/-- If `x` is a prime of the integrally closed domain `A` and `a ∉ (x)`, an element `f` of an
extension field `L` of `K = Frac A` such that `x f` and `a f` are integral over `A` is itself
integral over `A`. This is the elementary form of `A = A[1/x] ∩ A[1/a]` used for the purity
theorem in dimension two. -/
theorem isIntegral_of_isIntegral_mul [IsIntegrallyClosed A] {x a : A} (hx : Prime x)
    (ha : a ∉ Ideal.span {x}) {f : L} (h₁ : IsIntegral A (algebraMap A L x * f))
    (h₂ : IsIntegral A (algebraMap A L a * f)) : IsIntegral A f := by
  have hinj := IsFractionRing.injective A K
  have ha0 : a ≠ 0 := by rintro rfl; exact ha (Ideal.zero_mem _)
  have hx0 : algebraMap A K x ≠ 0 := (map_ne_zero_iff _ hinj).mpr hx.ne_zero
  have ha0' : algebraMap A K a ≠ 0 := (map_ne_zero_iff _ hinj).mpr ha0
  have hfK : IsIntegral K f := by
    have h := (h₁.tower_top (A := K))
    rw [IsScalarTower.algebraMap_apply A K L] at h
    have := (isIntegral_algebraMap (x := (algebraMap A K x)⁻¹) (A := L)).mul h
    rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hx0, map_one, one_mul] at this
  have key : ∀ r : A, algebraMap A K r ≠ 0 → IsIntegral A (algebraMap A L r * f) → ∀ i,
      algebraMap A K r ^ ((minpoly K f).natDegree - i) * (minpoly K f).coeff i ∈
        Set.range (algebraMap A K) := by
    intro r hr h i
    have e := minpoly.isIntegrallyClosed_eq_field_fractions' K h
    rw [IsScalarTower.algebraMap_apply A K L, minpoly_algebraMap_mul hr hfK] at e
    have := congr_arg (fun p ↦ Polynomial.coeff p i) e
    simp only [coeff_scaleRoots, coeff_map] at this
    exact ⟨_, by rw [← this, mul_comm]⟩
  have hlift : minpoly K f ∈ Polynomial.lifts (algebraMap A K) := by
    rw [lifts_iff_coeff_lifts]
    intro i
    exact mem_range_of_pow_mul_mem hx ha _ (key x hx0 h₁ i) (key a ha0' h₂ i)
  obtain ⟨q, hq, -, hqm⟩ := lifts_and_natDegree_eq_and_monic hlift (minpoly.monic hfK)
  refine ⟨q, hqm, ?_⟩
  rw [← aeval_def, ← aeval_map_algebraMap K, hq, minpoly.aeval]

end integral

end intersection

section free

variable {A : Type*} [CommRing A] [IsDomain A] {K : Type*} [Field K] [Algebra A K]
  [IsFractionRing A K] {L : Type*} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  {B : Type*} [CommRing B] [Algebra A B] [Algebra B L] [IsScalarTower A B L]
  [IsIntegralClosure B A L]

omit [IsDomain A] in
include K in
theorem algebraMap_ne_zero_of_ne_zero {a : A} (ha : a ≠ 0) : algebraMap A L a ≠ 0 := by
  rw [IsScalarTower.algebraMap_apply A K L, _root_.map_ne_zero]
  exact (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr ha

variable (K L) in
include K L in
/-- **Key step.** For `x` prime and `a ∉ (x)` in the integrally closed domain `A`, the element
`a` is a non-zero-divisor on `B/xB`, where `B` is the integral closure of `A` in `L`:
if `a b = x c` then `b ∈ xB`. -/
theorem exists_eq_smul_of_smul_eq_smul [IsIntegrallyClosed A] {x a : A} (hx : Prime x)
    (ha : a ∉ Ideal.span {x}) {b c : B} (h : a • b = x • c) : ∃ b' : B, b = x • b' := by
  have hxL : algebraMap A L x ≠ 0 := algebraMap_ne_zero_of_ne_zero (K := K) hx.ne_zero
  set f := algebraMap B L b / algebraMap A L x
  have h₁ : algebraMap A L x * f = algebraMap B L b := mul_div_cancel₀ _ hxL
  have hL : algebraMap A L a * algebraMap B L b = algebraMap A L x * algebraMap B L c := by
    have := congr_arg (algebraMap B L) h
    simpa only [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply] using this
  have h₂ : algebraMap A L a * f = algebraMap B L c := by
    simp only [f, mul_div_assoc', hL, mul_div_cancel_left₀ _ hxL]
  have hint : ∀ z : B, IsIntegral A (algebraMap B L z) :=
    fun z ↦ IsIntegralClosure.isIntegral_iff.mpr ⟨z, rfl⟩
  have hf : IsIntegral A f :=
    isIntegral_of_isIntegral_mul K hx ha (h₁ ▸ hint b) (h₂ ▸ hint c)
  obtain ⟨b', hb'⟩ := IsIntegralClosure.isIntegral_iff (A := B).mp hf
  refine ⟨b', IsIntegralClosure.algebraMap_injective B A L ?_⟩
  rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, hb', h₁]

omit [IsDomain A] in
variable (K L) in
include K L in
/-- A nonzero element of `A` is a non-zero-divisor on `B`. -/
theorem isSMulRegular_of_ne_zero {x : A} (hx : x ≠ 0) : IsSMulRegular B x := by
  intro b c h
  apply IsIntegralClosure.algebraMap_injective B A L
  have := congr_arg (algebraMap B L) h
  simp only [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply] at this
  exact mul_left_cancel₀ (algebraMap_ne_zero_of_ne_zero (K := K) hx) this

variable (K L) in
include K L in
/-- `B/xB` is a torsion-free `A/(x)`-module. -/
theorem isTorsionFree_quotSMulTop [IsIntegrallyClosed A] {x : A} (hx : Prime x) :
    haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
    Module.IsTorsionFree (A ⧸ Ideal.span {x}) (QuotSMulTop x B) := by
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  refine .of_smul_eq_zero fun r m hrm ↦ ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  by_cases ha : a ∈ Ideal.span {x}
  · exact .inl (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
  right
  have hmem : a • b ∈ x • (⊤ : Submodule A B) := by
    rw [← Submodule.Quotient.mk_eq_zero]
    exact hrm
  obtain ⟨c, -, hc⟩ := Submodule.mem_smul_pointwise_iff_exists _ _ _ |>.mp hmem
  obtain ⟨b', rfl⟩ := exists_eq_smul_of_smul_eq_smul K L hx ha hc.symm
  rw [Submodule.Quotient.mk_eq_zero]
  exact Submodule.smul_mem_pointwise_smul _ _ _ trivial

variable [IsLocalRing A]

omit [IsDomain A] in
/-- If `maximalIdeal A = (x, y)` with `x` prime and `y ∉ (x)`, then `A/(x)` is a discrete
valuation ring. -/
theorem isDiscreteValuationRing_quotient [IsNoetherianRing A] {x y : A} (hx : Prime x)
    (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A = Ideal.span {x, y}) :
    haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
    haveI : IsLocalRing (A ⧸ Ideal.span {x}) :=
      .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    IsDiscreteValuationRing (A ⧸ Ideal.span {x}) := by
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  haveI : IsLocalRing (A ⧸ Ideal.span {x}) :=
    .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have hxm : x ∈ maximalIdeal A := hm ▸ Ideal.subset_span (by simp)
  have hym : y ∈ maximalIdeal A := hm ▸ Ideal.subset_span (by simp)
  have hmax : maximalIdeal (A ⧸ Ideal.span {x}) = Ideal.span {Ideal.Quotient.mk _ y} := by
    apply le_antisymm
    · intro z hz
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hz' : z ∈ maximalIdeal A := by
        by_contra hz'
        exact hz ((IsLocalRing.notMem_maximalIdeal.mp hz').map _)
      rw [hm, Ideal.mem_span_pair] at hz'
      obtain ⟨α, β, rfl⟩ := hz'
      rw [Ideal.mem_span_singleton']
      refine ⟨Ideal.Quotient.mk _ β, ?_⟩
      have : Ideal.Quotient.mk (Ideal.span {x}) x = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
      simp [this]
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective (u⁻¹ : (A ⧸ Ideal.span {x})ˣ).1
      have h1 : Ideal.Quotient.mk (Ideal.span {x}) (y * v - 1) = 0 := by
        rw [map_sub, map_mul, hv, ← hu, map_one, Units.mul_inv, sub_self]
      have h2 : y * v - 1 ∈ maximalIdeal A :=
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxm))
          (Ideal.Quotient.eq_zero_iff_mem.mp h1)
      have h3 : (1 : A) ∈ maximalIdeal A := by
        simpa using Ideal.sub_mem _ (Ideal.mul_mem_right v _ hym) h2
      exact (maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  have hnf : ¬ IsField (A ⧸ Ideal.span {x}) := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax, Ideal.span_singleton_eq_bot,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hy
  have hp : (maximalIdeal (A ⧸ Ideal.span {x})).IsPrincipal := ⟨⟨_, hmax⟩⟩
  exact ((IsDiscreteValuationRing.TFAE _ hnf).out 0 4).mpr hp

variable [IsNoetherianRing A] [IsIntegrallyClosed A] [FiniteDimensional K L]
  [Algebra.IsSeparable K L]

variable (K L) in
include K L in
/-- **Freeness in dimension two** (SGA 1, Exp. X, proof of Cor. 3.2 for `dim A = 2`).
Let `A` be a Noetherian integrally closed local domain whose maximal ideal is `(x, y)` with
`x` prime and `y ∉ (x)`, and let `B` be the integral closure of `A` in a finite separable
extension `L` of `K = Frac A`. Then `B` is a free `A`-module. -/
theorem free_of_maximalIdeal_eq_span_pair {x y : A} (hx : Prime x)
    (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A = Ideal.span {x, y}) : Module.Free A B := by
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : Module.FinitePresentation A B := Module.finitePresentation_of_finite A B
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  haveI : IsLocalRing (A ⧸ Ideal.span {x}) :=
    .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  haveI := isDiscreteValuationRing_quotient hx hy hm
  haveI := isTorsionFree_quotSMulTop (B := B) K L hx
  haveI : Module.Finite (A ⧸ Ideal.span {x}) (QuotSMulTop x B) :=
    .of_restrictScalars_finite A _ _
  have hxm : x ∈ (⊥ : Ideal A).jacobson := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, hm]
    exact Ideal.subset_span (by simp)
  exact (Module.free_quotSMulTop_iff_free A B hxm
    (isSMulRegular_of_ne_zero K L hx.ne_zero)).mp inferInstance

end free

section baseChange

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (T : Type*) [CommRing T]
  [Algebra A T]

/-- The trace is compatible with base change: `Tr_{T⊗B/T}(1 ⊗ b) = Tr_{B/A}(b)`. -/
theorem trace_one_tmul [Module.Free A B] [Module.Finite A B] (b : B) :
    Algebra.trace T (T ⊗[A] B) (1 ⊗ₜ b) = algebraMap A T (Algebra.trace A B b) := by
  rw [Algebra.trace_apply, Algebra.trace_apply, ← LinearMap.trace_baseChange]
  congr 1
  ext c
  simp

/-- The discriminant is compatible with base change. -/
theorem discr_baseChange {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Module.Basis ι A B) :
    Algebra.discr T (Algebra.TensorProduct.basis T b) = algebraMap A T (Algebra.discr A b) := by
  have : Module.Free A B := .of_basis b
  have : Module.Finite A B := .of_basis b
  rw [Algebra.discr_def, Algebra.discr_def, RingHom.map_det]
  congr 1
  ext i j
  simp [Algebra.traceMatrix_apply, Algebra.traceForm_apply, Algebra.TensorProduct.basis_apply,
    trace_one_tmul]

end baseChange

section field

variable (k : Type*) [Field k]

/-- The trace form of a commutative algebra is nondegenerate as soon as it is left-separating. -/
theorem traceForm_nondegenerate_of {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ x : S, (∀ y, Algebra.trace R S (x * y) = 0) → x = 0) :
    (Algebra.traceForm R S).Nondegenerate :=
  ⟨fun x hx ↦ h x fun y ↦ by simpa [Algebra.traceForm_apply] using hx y,
    fun y hy ↦ h y fun x ↦ by simpa [Algebra.traceForm_apply, mul_comm] using hy x⟩

/-- The trace of the split algebra `kᶥ` is the sum of the coordinates. -/
theorem trace_pi_eq_sum {ι : Type*} [Fintype ι] (v : ι → k) :
    Algebra.trace k (ι → k) v = ∑ i, v i := by
  classical
  rw [Algebra.trace_eq_matrix_trace (Pi.basisFun k ι), Matrix.trace]
  congr 1
  ext i
  simp [Algebra.leftMulMatrix_eq_repr_mul]

/-- The trace form of the split algebra `kᶥ` is nondegenerate. -/
theorem traceForm_pi_nondegenerate {ι : Type*} [Finite ι] :
    (Algebra.traceForm k (ι → k)).Nondegenerate := by
  classical
  have := Fintype.ofFinite ι
  refine traceForm_nondegenerate_of fun v hv ↦ ?_
  ext i
  have := hv (Pi.single i 1)
  rw [trace_pi_eq_sum] at this
  simpa [Pi.single_apply] using this

variable {k} {C D : Type*} [CommRing C] [CommRing D] [Algebra k C] [Algebra k D]

theorem traceForm_nondegenerate_of_algEquiv [Module.Finite k C] (e : C ≃ₐ[k] D)
    (h : (Algebra.traceForm k D).Nondegenerate) : (Algebra.traceForm k C).Nondegenerate := by
  refine traceForm_nondegenerate_of fun c hc ↦ ?_
  apply e.injective
  rw [map_zero]
  refine h.1 _ fun d ↦ ?_
  have := hc (e.symm d)
  rw [Algebra.traceForm_apply]
  rw [← Algebra.trace_eq_of_algEquiv e, map_mul, e.apply_symm_apply] at this
  exact this

/-- Over a field, the discriminant of a basis is nonzero iff the trace form is
nondegenerate. -/
theorem discr_ne_zero_iff_nondegenerate {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι k C) :
    Algebra.discr k b ≠ 0 ↔ (Algebra.traceForm k C).Nondegenerate := by
  rw [LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b, Algebra.discr_def,
    Algebra.traceMatrix_of_basis]

/-- A finite algebra over a field with nondegenerate trace form is reduced. -/
theorem isReduced_of_traceForm_nondegenerate [Module.Finite k C]
    (h : (Algebra.traceForm k C).Nondegenerate) : IsReduced C := by
  refine ⟨fun z hz ↦ h.1 z fun w ↦ ?_⟩
  rw [Algebra.traceForm_apply, mul_comm]
  exact (Algebra.isNilpotent_trace_of_isNilpotent (R := k)
    (Commute.isNilpotent_mul_left (Commute.all _ _) hz)).eq_zero

attribute [local instance] Ideal.Quotient.field in
/-- A finite reduced algebra over a perfect field is formally étale. -/
theorem formallyEtale_of_isReduced_of_perfectField [PerfectField k] [Module.Finite k C]
    [IsReduced C] : Algebra.FormallyEtale k C := by
  have : IsArtinianRing C := .of_finite k C
  have (I : MaximalSpectrum C) : Algebra.FormallyEtale k (C ⧸ I.asIdeal) := by
    have : Module.Finite k (C ⧸ I.asIdeal) := inferInstance
    have : Algebra.IsSeparable k (C ⧸ I.asIdeal) := inferInstance
    exact .of_isSeparable k _
  exact .of_equiv ((IsArtinianRing.equivPi C).restrictScalars k).symm

variable (k) in
/-- **Trace criterion.** A finite algebra `C` over a field `k` is (formally) unramified iff the
discriminant of some (equivalently, any) basis is nonzero, i.e. iff its trace form is
nondegenerate. -/
theorem formallyUnramified_iff_discr_ne_zero [Module.Finite k C] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (b : Module.Basis ι k C) :
    Algebra.FormallyUnramified k C ↔ Algebra.discr k b ≠ 0 := by
  let K := AlgebraicClosure k
  have hd := discr_baseChange K b
  have hiff : Algebra.discr k b ≠ 0 ↔ Algebra.discr K (Algebra.TensorProduct.basis K b) ≠ 0 := by
    rw [hd, _root_.map_ne_zero]
  rw [hiff, discr_ne_zero_iff_nondegenerate]
  constructor
  · intro _
    have : Algebra.FormallyEtale K (K ⊗[k] C) := .of_formallyUnramified_of_field K _
    have : IsArtinianRing (K ⊗[k] C) := .of_finite K _
    exact traceForm_nondegenerate_of_algEquiv
      (Algebra.FormallyEtale.equivPiOfIsSepClosed K (K ⊗[k] C)) (traceForm_pi_nondegenerate K)
  · intro h
    have : IsReduced (K ⊗[k] C) := isReduced_of_traceForm_nondegenerate h
    have : Algebra.FormallyEtale K (K ⊗[k] C) := formallyEtale_of_isReduced_of_perfectField
    exact .of_formallyUnramified_tensorProduct_of_faithfullyFlat K

end field

section discr

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- If the fibre `κ(P) ⊗_A B` of a finite free algebra is unramified, then the discriminant
of a basis of `B` does not lie in `P`. -/
theorem discr_notMem_of_formallyUnramified_fiber {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι A B) (P : Ideal A) [P.IsPrime]
    [Algebra.FormallyUnramified P.ResidueField (P.Fiber B)] :
    Algebra.discr A b ∉ P := by
  have : Module.Finite A B := .of_basis b
  have h := (formallyUnramified_iff_discr_ne_zero P.ResidueField
    (Algebra.TensorProduct.basis P.ResidueField b)).mp inferInstance
  rw [discr_baseChange, Ne, Ideal.algebraMap_residueField_eq_zero] at h
  exact h

/-- If `B` is unramified over `A` at every prime lying over `P`, then the fibre `κ(P) ⊗_A B` is
unramified over `κ(P)`. -/
theorem formallyUnramified_fiber_of_isUnramifiedAt (P : Ideal A) [P.IsPrime]
    (h : ∀ (Q : Ideal B) [Q.IsPrime], Q.LiesOver P → Algebra.IsUnramifiedAt A Q) :
    Algebra.FormallyUnramified P.ResidueField (P.Fiber B) := by
  rw [Algebra.formallyUnramified_iff_forall]
  intro q
  let Q : Ideal B := q.asIdeal.comap Algebra.TensorProduct.includeRight.toRingHom
  haveI : Q.IsPrime := Ideal.comap_isPrime _ _
  have hQ : Q.LiesOver P := by
    constructor
    rw [Ideal.over_def q.asIdeal P, Ideal.under, Ideal.under, Ideal.comap_comap]
    congr 1
    ext a
    simp
  have := h Q hQ
  exact Algebra.IsUnramifiedAt.residueField P Q q.asIdeal rfl

/-- **Discriminant criterion.** Let `A` be a local ring and `B` a finite free `A`-algebra
whose discriminant (with respect to some basis) is a unit. Then `B` is unramified over `A`. -/
theorem formallyUnramified_of_isUnit_discr [IsLocalRing A] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (b : Module.Basis ι A B) (hd : IsUnit (Algebra.discr A b)) :
    Algebra.FormallyUnramified A B := by
  have : Module.Finite A B := .of_basis b
  let k := ResidueField A
  have hk : Algebra.FormallyUnramified k (k ⊗[A] B) := by
    rw [formallyUnramified_iff_discr_ne_zero k (Algebra.TensorProduct.basis k b),
      discr_baseChange]
    exact (hd.map (algebraMap A k)).ne_zero
  let _ : Algebra B (k ⊗[A] B) := Algebra.TensorProduct.rightAlgebra
  have hs : Subsingleton (k ⊗[A] Ω[B⁄A]) :=
    (KaehlerDifferential.tensorKaehlerEquivBase A k B (k ⊗[A] B)).subsingleton
  have : Module.Finite A Ω[B⁄A] := .trans B _
  exact ⟨(IsLocalRing.subsingleton_tensorProduct (R := A)).mp hs⟩

end discr

section main

variable {A : Type*} [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
  [IsIntegrallyClosed A] {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  {L : Type*} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]
  {B : Type*} [CommRing B] [Algebra A B] [Algebra B L] [IsScalarTower A B L]
  [IsIntegralClosure B A L]

omit [IsNoetherianRing A] [IsIntegrallyClosed A] in
/-- If `maximalIdeal A = (x, y)` with `x` prime and `y ∉ (x)`, the maximal ideal has height
at least two. -/
theorem two_le_height_maximalIdeal {x y : A} (hx : Prime x) (hy : y ∉ Ideal.span {x})
    (hm : maximalIdeal A = Ideal.span {x, y}) :
    2 ≤ (maximalIdeal A).height := by
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  have h0 : (⊥ : Ideal A) < Ideal.span {x} := by
    rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
    exact hx.ne_zero
  have h1 : Ideal.span {x} < maximalIdeal A := by
    refine lt_of_le_of_ne (hm ▸ Ideal.span_mono (by simp)) fun h ↦ hy ?_
    rw [h, hm]
    exact Ideal.subset_span (by simp)
  have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
  have e1 := Ideal.height_add_one_le_of_lt_of_isPrime h1
  have : (1 : ℕ∞) ≤ (Ideal.span {x}).height := le_trans (by simp) e0
  calc (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ (Ideal.span {x}).height + 1 := by gcongr
    _ ≤ _ := e1

variable (K L) in
include K L in
/-- **Purity in dimension two, fibre form.** Let `A` be a Noetherian integrally closed local
domain whose maximal ideal is `(x, y)` with `x` prime and `y ∉ (x)`, `L` a finite separable
extension of `K = Frac A` and `B` the integral closure of `A` in `L`. If the fibre
`κ(P) ⊗_A B` is unramified over `κ(P)` for every prime `P` of height at most one, then `B` is
étale over `A`. -/
theorem etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair {x y : A}
    (hx : Prime x) (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A = Ideal.span {x, y})
    (hfib : ∀ (P : Ideal A) [P.IsPrime], P.height ≤ 1 →
      Algebra.FormallyUnramified P.ResidueField (P.Fiber B)) :
    Algebra.Etale A B := by
  classical
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : Module.Free A B := free_of_maximalIdeal_eq_span_pair K L hx hy hm
  let b := Module.Free.chooseBasis A B
  have hd : IsUnit (Algebra.discr A b) := by
    by_contra hnu
    obtain ⟨P, hP⟩ := (Ideal.span {Algebra.discr A b}).nonempty_minimalPrimes
      (by rwa [Ne, Ideal.span_singleton_eq_top])
    have := hP.1.1
    have := hfib P (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ P hP)
    exact discr_notMem_of_formallyUnramified_fiber b P
      (hP.1.2 (Ideal.mem_span_singleton_self _))
  have : Algebra.FormallyUnramified A B := formallyUnramified_of_isUnit_discr b hd
  have : Algebra.FinitePresentation A B :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  exact Algebra.Etale.of_formallyUnramified_of_flat

variable (K L) in
include K L in
/-- **Purity of the branch locus in dimension two** (Zariski–Nagata; SGA 1, Exp. X, Thm. 3.1
and Cor. 3.2, following the proof given there for `dim A = 2`).

Let `A` be a Noetherian integrally closed local domain whose maximal ideal is `(x, y)` with
`x` prime and `y ∉ (x)` (e.g. a two-dimensional regular local ring), `L` a finite separable
extension of `K = Frac A`, and `B` the integral closure of `A` in `L`. If `B` is unramified
over `A` at every prime of `B` not lying over the maximal ideal of `A`, then `B` is étale
over `A`. -/
theorem etale_of_isUnramifiedAt_of_maximalIdeal_eq_span_pair {x y : A} (hx : Prime x)
    (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A = Ideal.span {x, y})
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≠ maximalIdeal A →
      Algebra.IsUnramifiedAt A Q) :
    Algebra.Etale A B := by
  refine etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair K L hx hy hm
    fun P _ hle ↦ ?_
  have hPm : P ≠ maximalIdeal A := by
    rintro rfl
    have : (2 : ℕ∞) ≤ 1 := (two_le_height_maximalIdeal hx hy hm).trans hle
    norm_num at this
  exact formallyUnramified_fiber_of_isUnramifiedAt P fun Q _ hQP ↦
    hunr Q fun h ↦ hPm (hQP.over.trans h)

end main

end SemistableReduction.Purity
