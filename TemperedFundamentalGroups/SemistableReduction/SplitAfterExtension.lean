import Mathlib
import TemperedFundamentalGroups.SemistableReduction.CompleteFinite
import TemperedFundamentalGroups.SemistableReduction.EtaleLiftExists
import TemperedFundamentalGroups.SemistableReduction.EtaleLocalDomain

/-!
# Split form after a finite unramified constant extension

This file formalises steps (2) and (3) of the plan section "Continuation 20 (MR12 track agent,
2026-10-19): the residue field is finite" (`MR12-tfg-plan.md`): IUT's residue field `k` is finite
(hence perfect), not separably closed, and an admissible covering is only in *split form* after a
finite separable extension `k'/k`, which lifts to a finite étale (unramified) extension `O'/O`.
Here this is done for the étale parts of the coverings.

* (A) `exists_split_tensor`: a finite étale algebra `B` over a field `k` becomes split,
  `k' ⊗[k] B ≃ₐ[k'] k'ᵐ`, over a finite separable extension `k'/k`. Proof: by Mathlib's
  `Algebra.Etale.iff_exists_algEquiv_prod`, `B ≃ ∏ Lᵢ` with `Lᵢ/k` finite separable; embed the
  `Lᵢ` into a separable closure and take `k'` the normal closure of their compositum. Then every
  `b ∈ B` is a root of a monic polynomial over `k` splitting over `k'` (`SplitsIn`), so every
  residue field of the reduced Artinian ring `k' ⊗[k] B` is `k'`
  (`nonempty_algEquiv_pi_of_splitsIn`).
* (B) `exists_split_of_quot`: over a Noetherian `I`-adically complete ring `A`, a finite étale
  `C` with `C ⧸ IC ≃ ∏ (A ⧸ I) ⧸ (1 - ε̄ᵢ)` is `≃ ∏ A ⧸ (1 - εᵢ)` for idempotent lifts `εᵢ`
  (Hensel's lemma for `X² - X`, `exists_isIdempotentElem_lift`; `A ⧸ (1 - ε)` is étale,
  `formallyEtale_quotient`; uniqueness of étale lifts `CompleteFinite.finiteEtaleEquivOfQuot`).
* (C) `exists_split_after_extension`: for `A` a Noetherian `k`-algebra, `I`-adically complete
  with `A ⧸ I` finite étale over `k`, and `C` finite étale over `A`, there is a finite separable
  `k'/k` such that `(A ⊗[k] k') ⊗[A] C` (`= k' ⊗[k] C`) is a product of factors
  `(A ⊗[k] k') ⧸ (1 - εᵢ)`. The general form `exists_split_of_splitsIn` works for any finite
  étale `A'/A` receiving a field `k'` that splits `C ⧸ IC`: the residue fields of
  `(A' ⊗[A] C) ⧸ I` are then reached from the reduced Artinian ring `A' ⧸ IA'`
  (`surjective_residue`), which gives the split form modulo `I`
  (`exists_algEquiv_pi_quotient`, maximal ideals of a reduced Artinian ring are generated by
  `1 - ε`), and (B) lifts it.
* (D) `exists_unramified_lift`: over a complete Noetherian local ring `O`, a finite separable
  extension `k'` of the residue field is `O' ⧸ 𝔪O'` for a finite étale local `O`-algebra `O'`
  with maximal ideal `𝔪O'` (existence from `EtaleLiftExists.exists_finite_etale_lift`, Stacks
  Tag 09ZL); `isDiscreteValuationRing_unramified_lift`: if `O` is a DVR then so is `O'`, with the
  same uniformizer (`isDiscreteValuationRing_of_etale`).
-/

open Polynomial TensorProduct

universe u v w

namespace SemistableReduction.SplitAfterExtension

/-- A root of a monic polynomial which splits over `K` lies in the image of `K`. -/
theorem mem_range_of_splits {K F : Type*} [Field K] [Field F] (f : K →+* F) {q : K[X]}
    (hq : q.Splits) (hm : q.Monic) {y : F} (hy : q.eval₂ f y = 0) : y ∈ f.range := by
  rw [hq.eq_prod_roots_of_monic hm, eval₂_multiset_prod, Multiset.map_map,
    Multiset.prod_eq_zero_iff] at hy
  obtain ⟨a, -, ha⟩ := Multiset.mem_map.mp hy
  refine ⟨a, ?_⟩
  simp only [Function.comp_apply, eval₂_sub, eval₂_X, eval₂_C] at ha
  exact (sub_eq_zero.mp ha).symm

/-- `k'` splits `B`: every element of the `k`-algebra `B` is a root of a monic polynomial over
`k` which splits over `k'`. -/
def SplitsIn (k k' B : Type*) [Field k] [Field k'] [Algebra k k'] [CommRing B] [Algebra k B] :
    Prop :=
  ∀ b : B, ∃ p : k[X], p.Monic ∧ aeval b p = 0 ∧ (p.map (algebraMap k k')).Splits

/-- If `k'` splits `B`, then the residue fields of `k' ⊗[k] B` are `k'`. -/
theorem surjective_residue_of_splitsIn {k k' B : Type*} [Field k] [Field k'] [Algebra k k']
    [CommRing B] [Algebra k B] (h : SplitsIn k k' B) (𝔫 : Ideal (k' ⊗[k] B)) [𝔫.IsMaximal] :
    Function.Surjective (algebraMap k' (k' ⊗[k] B ⧸ 𝔫)) := by
  letI := Ideal.Quotient.field 𝔫
  have hB : ∀ b : B, Ideal.Quotient.mk 𝔫 (1 ⊗ₜ b) ∈ (algebraMap k' (k' ⊗[k] B ⧸ 𝔫)).range := by
    intro b
    obtain ⟨p, hm, hb, hs⟩ := h b
    refine mem_range_of_splits _ hs (hm.map _) ?_
    rw [← aeval_def]
    let f : B →ₐ[k] k' ⊗[k] B ⧸ 𝔫 :=
      (Ideal.Quotient.mkₐ k 𝔫).comp Algebra.TensorProduct.includeRight
    have : f b = Ideal.Quotient.mk 𝔫 (1 ⊗ₜ b) := rfl
    rw [← this, aeval_map_algebraMap, aeval_algHom_apply, hb, map_zero]
  suffices H : ∀ x, Ideal.Quotient.mk 𝔫 x ∈ (algebraMap k' (k' ⊗[k] B ⧸ 𝔫)).range by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact H x
  intro x
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul a b =>
    have : a ⊗ₜ[k] b = algebraMap k' (k' ⊗[k] B) a * (1 ⊗ₜ b) := by
      simp [Algebra.TensorProduct.algebraMap_apply]
    rw [this, map_mul]
    exact Subring.mul_mem _ (RingHom.mem_range_self _ a) (hB b)
  | add x y hx hy => rw [map_add]; exact Subring.add_mem _ hx hy

/-- **Splitting criterion**: if `k'` splits the finite étale `k`-algebra `B`, then
`k' ⊗[k] B ≃ k'ᵐ`. -/
theorem nonempty_algEquiv_pi_of_splitsIn {k k' B : Type*} [Field k] [Field k'] [Algebra k k']
    [CommRing B] [Algebra k B] [Module.Finite k B] [Algebra.Etale k B] (h : SplitsIn k k' B) :
    ∃ m : ℕ, Nonempty (k' ⊗[k] B ≃ₐ[k'] (Fin m → k')) := by
  haveI : IsArtinianRing (k' ⊗[k] B) := IsArtinianRing.of_finite k' _
  haveI : IsReduced (k' ⊗[k] B) := Algebra.FormallyUnramified.isReduced_of_field k' _
  letI _ (𝔫 : MaximalSpectrum (k' ⊗[k] B)) : Field (k' ⊗[k] B ⧸ 𝔫.asIdeal) :=
    Ideal.Quotient.field 𝔫.asIdeal
  let e𝔫 (𝔫 : MaximalSpectrum (k' ⊗[k] B)) : k' ≃ₐ[k'] (k' ⊗[k] B ⧸ 𝔫.asIdeal) :=
    AlgEquiv.ofBijective (Algebra.ofId k' _)
      ⟨(algebraMap k' _).injective, surjective_residue_of_splitsIn h 𝔫.asIdeal⟩
  haveI := Fintype.ofFinite (MaximalSpectrum (k' ⊗[k] B))
  let σ := Fintype.equivFin (MaximalSpectrum (k' ⊗[k] B))
  exact ⟨_, ⟨((IsArtinianRing.equivPi _).restrictScalars k').trans <|
    (AlgEquiv.piCongrRight fun 𝔫 ↦ (e𝔫 𝔫).symm).trans <|
    (AlgEquiv.piCongrLeft k' (fun _ ↦ k') σ.symm).symm⟩⟩

/-- **Existence of a splitting field**: a finite étale algebra over a field `k` is split by a
finite separable extension `k'/k`. -/
theorem exists_splitsIn (k : Type u) [Field k] (B : Type v) [CommRing B] [Algebra k B]
    [Algebra.Etale k B] :
    ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k'), FiniteDimensional k k' ∧
      Algebra.IsSeparable k k' ∧ SplitsIn k k' B := by
  classical
  obtain ⟨ι, _, L, _, _, e, hL⟩ := (Algebra.Etale.iff_exists_algEquiv_prod k B).1 inferInstance
  haveI := Fintype.ofFinite ι
  haveI (i : ι) : Module.Finite k (L i) := (hL i).1
  haveI (i : ι) : Algebra.IsSeparable k (L i) := (hL i).2
  let Ω := SeparableClosure k
  let φ (i : ι) : L i →ₐ[k] Ω := IsSepClosed.lift
  haveI (i : ι) : FiniteDimensional k (φ i).fieldRange := (φ i).toLinearMap.finiteDimensional_range
  let E : IntermediateField k Ω := ⨆ i, (φ i).fieldRange
  let k' := IntermediateField.normalClosure k E Ω
  refine ⟨k', inferInstance, inferInstance, inferInstance,
    Algebra.isSeparable_tower_bot_of_isSeparable k k' Ω, fun b ↦ ?_⟩
  let x (i : ι) : L i := e b i
  have hint (i : ι) : IsIntegral k (x i) := Algebra.IsIntegral.isIntegral _
  refine ⟨∏ i, minpoly k (x i), monic_prod_of_monic _ _ fun i _ ↦ minpoly.monic (hint i), ?_, ?_⟩
  · apply e.injective
    rw [map_zero, ← aeval_algHom_apply]
    funext i
    rw [Pi.zero_apply]
    change Pi.evalAlgHom k L i (aeval (e b) _) = 0
    rw [← aeval_algHom_apply, Pi.evalAlgHom_apply, map_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ i) (minpoly.aeval k (x i))
  · rw [Polynomial.map_prod]
    refine Splits.prod fun i _ ↦ ?_
    have hmem : φ i (x i) ∈ k' :=
      IntermediateField.le_normalClosure E
        ((le_iSup (fun i ↦ (φ i).fieldRange) i) ⟨x i, rfl⟩)
    let y : k' := ⟨φ i (x i), hmem⟩
    have : minpoly k (x i) = minpoly k y := by
      rw [IntermediateField.minpoly_eq y, minpoly.algHom_eq (φ i) (φ i).injective]
    rw [this]
    exact Normal.splits inferInstance y

/-- **(A) Splitting a finite étale algebra over a field**: for a finite étale algebra `B` over a
field `k` there are a finite separable extension `k'/k` and `m` with `k' ⊗[k] B ≃ₐ[k'] k'ᵐ`. -/
theorem exists_split_tensor (k : Type u) [Field k] (B : Type v) [CommRing B] [Algebra k B]
    [Module.Finite k B] [Algebra.Etale k B] :
    ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k'), FiniteDimensional k k' ∧
      Algebra.IsSeparable k k' ∧ ∃ m : ℕ, Nonempty (k' ⊗[k] B ≃ₐ[k'] (Fin m → k')) := by
  obtain ⟨k', _, _, h1, h2, h3⟩ := exists_splitsIn k B
  exact ⟨k', _, _, h1, h2, nonempty_algEquiv_pi_of_splitsIn h3⟩

/-- In a reduced Artinian ring every maximal ideal is generated by `1 - ε` for an idempotent
`ε` (the unit of the corresponding factor field). -/
theorem exists_isIdempotentElem_eq_span {R : Type*} [CommRing R] [IsArtinianRing R] [IsReduced R]
    (𝔪 : Ideal R) [h𝔪 : 𝔪.IsMaximal] :
    ∃ ε : R, IsIdempotentElem ε ∧ 𝔪 = Ideal.span {1 - ε} := by
  classical
  let M : MaximalSpectrum R := ⟨𝔪, h𝔪⟩
  let e := IsArtinianRing.equivPi R
  let ε := e.symm (Pi.single M 1)
  have hε : IsIdempotentElem ε := by
    have : IsIdempotentElem (Pi.single M 1 : Π N : MaximalSpectrum R, R ⧸ N.asIdeal) := by
      simp [IsIdempotentElem, ← Pi.single_mul]
    exact this.map e.symm
  have h1 : 1 - ε ∈ 𝔪 := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change e (1 - ε) M = 0
    simp [ε]
  refine ⟨ε, hε, le_antisymm (fun x hx ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).2 h1)⟩
  have hxε : x * ε = 0 := by
    apply e.injective
    rw [map_mul, map_zero]
    funext N
    simp only [ε, AlgEquiv.apply_symm_apply, Pi.mul_apply, Pi.zero_apply]
    by_cases hN : N = M
    · subst hN
      rw [Pi.single_eq_same, mul_one]
      exact Ideal.Quotient.eq_zero_iff_mem.2 hx
    · rw [Pi.single_eq_of_ne hN, mul_zero]
  have : x = x * (1 - ε) := by rw [mul_sub, hxε, mul_one, sub_zero]
  rw [this]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **Split form from trivial residue fields**: if `S` is a reduced Artinian `R`-algebra over a
reduced Artinian ring `R` and every residue field of `S` is reached from `R`, then `S` is a
finite product of factors `R ⧸ (1 - εᵢ)`, `εᵢ` idempotent. -/
theorem exists_algEquiv_pi_quotient (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [IsArtinianRing R] [IsReduced R] [IsArtinianRing S] [IsReduced S]
    (h : ∀ 𝔫 : Ideal S, 𝔫.IsMaximal → Function.Surjective (algebraMap R (S ⧸ 𝔫))) :
    ∃ (m : ℕ) (ε : Fin m → R), (∀ i, IsIdempotentElem (ε i)) ∧
      Nonempty (S ≃ₐ[R] Π i, R ⧸ Ideal.span {1 - ε i}) := by
  letI _ (𝔫 : MaximalSpectrum S) : Field (S ⧸ 𝔫.asIdeal) := Ideal.Quotient.field 𝔫.asIdeal
  have hs (𝔫 : MaximalSpectrum S) : Function.Surjective (Algebra.ofId R (S ⧸ 𝔫.asIdeal)) :=
    h 𝔫.asIdeal 𝔫.isMaximal
  haveI (𝔫 : MaximalSpectrum S) : (RingHom.ker (Algebra.ofId R (S ⧸ 𝔫.asIdeal))).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ (hs 𝔫)
  choose ε hε hspan using fun 𝔫 : MaximalSpectrum S ↦
    exists_isIdempotentElem_eq_span (RingHom.ker (Algebra.ofId R (S ⧸ 𝔫.asIdeal)))
  haveI := Fintype.ofFinite (MaximalSpectrum S)
  let σ := Fintype.equivFin (MaximalSpectrum S)
  refine ⟨_, fun i ↦ ε (σ.symm i), fun i ↦ hε _, ⟨?_⟩⟩
  exact ((IsArtinianRing.equivPi S).restrictScalars R).trans <|
    (AlgEquiv.piCongrRight fun 𝔫 ↦ (Ideal.quotientKerAlgEquivOfSurjective (hs 𝔫)).symm.trans
      (Ideal.quotientEquivAlgOfEq R (hspan 𝔫))).trans <|
    (AlgEquiv.piCongrLeft R (fun 𝔫 ↦ R ⧸ Ideal.span {1 - ε 𝔫}) σ.symm).symm

section Hensel

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- **Lifting idempotents along a complete ideal** (Hensel's lemma for `X² - X`, whose
derivative `2X - 1` squares to `1` at an idempotent). -/
theorem exists_isIdempotentElem_lift [IsAdicComplete I A] (e₀ : A ⧸ I)
    (he : IsIdempotentElem e₀) :
    ∃ e : A, IsIdempotentElem e ∧ Ideal.Quotient.mk I e = e₀ := by
  obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective e₀
  have hmon : (X ^ 2 - X : A[X]).Monic := by monicity!
  have h1 : (X ^ 2 - X : A[X]).eval a₀ ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [eval_sub, eval_pow, eval_X, map_sub, map_pow]
    rw [sq, he.eq, sub_self]
  have h2 : IsUnit (Ideal.Quotient.mk I ((derivative (X ^ 2 - X : A[X])).eval a₀)) := by
    have hd : Ideal.Quotient.mk I ((derivative (X ^ 2 - X : A[X])).eval a₀) =
        2 * Ideal.Quotient.mk I a₀ - 1 := by
      simp only [derivative_X_pow, derivative_X, eval_sub, eval_mul, eval_one, map_sub, map_mul,
        map_one]
      norm_num
      rw [map_ofNat]
    rw [hd]
    refine isUnit_iff_exists_inv.2 ⟨2 * Ideal.Quotient.mk I a₀ - 1, ?_⟩
    linear_combination (4 : A ⧸ I) * he.eq
  obtain ⟨a, ha, hsub⟩ := HenselianRing.is_henselian (I := I) _ hmon a₀ h1 h2
  refine ⟨a, ?_, Ideal.Quotient.eq.mpr hsub⟩
  have : a ^ 2 - a = 0 := by simpa using ha
  rw [IsIdempotentElem, ← sq]
  exact sub_eq_zero.mp this

/-- The quotient by `1 - ε` for an idempotent `ε` (the localization away from `ε`) is étale. -/
theorem formallyEtale_quotient {ε : A} (hε : IsIdempotentElem ε) :
    Algebra.FormallyEtale A (A ⧸ Ideal.span {1 - ε}) := by
  rw [Algebra.FormallyEtale.iff_of_surjective Ideal.Quotient.mk_surjective,
    Ideal.Quotient.algebraMap_eq, Ideal.mk_ker, IsIdempotentElem,
    Ideal.span_singleton_mul_span_singleton, hε.one_sub.eq]

/-- Reducing a factor `A ⧸ (1 - ε)` modulo `I`. -/
noncomputable def quotSpanEquiv (ε : A) :
    ((A ⧸ Ideal.span {1 - ε}) ⧸ I.map (algebraMap A (A ⧸ Ideal.span {1 - ε}))) ≃ₐ[A]
      (A ⧸ I) ⧸ Ideal.span {1 - Ideal.Quotient.mk I ε} :=
  (DoubleQuot.quotQuotEquivCommₐ A I (Ideal.span {1 - ε})).symm.trans
    (Ideal.quotientEquivAlgOfEq A (by
      rw [Ideal.map_span, Set.image_singleton, map_sub, map_one]
      rfl))

/-- Reducing a finite product of factors `A ⧸ (1 - εᵢ)` modulo `I`. -/
noncomputable def quotPiSpanEquiv {m : ℕ} (ε : Fin m → A) :
    ((Π i, A ⧸ Ideal.span {1 - ε i}) ⧸ I.map (algebraMap A (Π i, A ⧸ Ideal.span {1 - ε i})))
      ≃ₐ[A] Π i, (A ⧸ I) ⧸ Ideal.span {1 - Ideal.Quotient.mk I (ε i)} :=
  ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor _ I).restrictScalars A).trans <|
    (Algebra.TensorProduct.piRight A A (A ⧸ I) _).trans <|
      AlgEquiv.piCongrRight fun i ↦
        (((Algebra.TensorProduct.quotIdealMapEquivQuotTensor _ I).restrictScalars A).symm).trans
          (quotSpanEquiv I (ε i))

/-- **(B) Hensel splitting**: over a Noetherian `I`-adically complete ring `A`, a finite étale
`A`-algebra whose reduction modulo `I` is a product of factors `(A ⧸ I) ⧸ (1 - ε̄ᵢ)` (`ε̄ᵢ`
idempotent) is the product of the factors `A ⧸ (1 - εᵢ)` for idempotent lifts `εᵢ` of the
`ε̄ᵢ`. -/
theorem exists_split_of_quot [IsNoetherianRing A] [IsAdicComplete I A] (C : Type v) [CommRing C]
    [Algebra A C] [Module.Finite A C] [Algebra.Etale A C] {m : ℕ} (ε₀ : Fin m → A ⧸ I)
    (hε₀ : ∀ i, IsIdempotentElem (ε₀ i))
    (e₀ : (C ⧸ I.map (algebraMap A C)) ≃ₐ[A] Π i, (A ⧸ I) ⧸ Ideal.span {1 - ε₀ i}) :
    ∃ ε : Fin m → A, (∀ i, IsIdempotentElem (ε i)) ∧
      (∀ i, Ideal.Quotient.mk I (ε i) = ε₀ i) ∧
      Nonempty (C ≃ₐ[A] Π i, A ⧸ Ideal.span {1 - ε i}) := by
  choose ε hε hεmk using fun i ↦ exists_isIdempotentElem_lift I (ε₀ i) (hε₀ i)
  haveI (i : Fin m) := formallyEtale_quotient (hε i)
  haveI : Algebra.FormallyEtale A (Π i, A ⧸ Ideal.span {1 - ε i}) :=
    (Algebra.FormallyEtale.pi_iff _).2 inferInstance
  have hε' : (fun i ↦ Ideal.Quotient.mk I (ε i)) = ε₀ := funext hεmk
  subst hε'
  exact ⟨ε, hε, hεmk,
    ⟨CompleteFinite.finiteEtaleEquivOfQuot I (e₀.trans (quotPiSpanEquiv I ε).symm)⟩⟩

end Hensel

section Extension

variable (k : Type u) [Field k] {A : Type v} [CommRing A] [Algebra k A] (I : Ideal A)
  (C : Type w) [CommRing C] [Algebra A C] [Algebra k C] [IsScalarTower k A C]

/-- If `A ⧸ I` is finite étale over `k` and `C` is finite étale over `A`, then `C ⧸ IC` is
finite étale over `k`. -/
theorem finite_etale_quot [Module.Finite k (A ⧸ I)] [Algebra.Etale k (A ⧸ I)]
    [Module.Finite A C] [Algebra.Etale A C] :
    Module.Finite k (C ⧸ I.map (algebraMap A C)) ∧
      Algebra.Etale k (C ⧸ I.map (algebraMap A C)) := by
  haveI : IsScalarTower k (A ⧸ I) (C ⧸ I.map (algebraMap A C)) :=
    IsScalarTower.of_algebraMap_eq fun c ↦ by
      change Ideal.Quotient.mk _ (algebraMap k C c) =
        Ideal.Quotient.mk _ (algebraMap A C (algebraMap k A c))
      rw [← IsScalarTower.algebraMap_apply]
  haveI : Module.Finite A (C ⧸ I.map (algebraMap A C)) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ A _).toLinearMap Ideal.Quotient.mk_surjective
  haveI : Module.Finite (A ⧸ I) (C ⧸ I.map (algebraMap A C)) :=
    Module.Finite.of_restrictScalars_finite A (A ⧸ I) _
  haveI : Module.Finite k (C ⧸ I.map (algebraMap A C)) := Module.Finite.trans (A ⧸ I) _
  haveI : Algebra.FormallyEtale (A ⧸ I) (C ⧸ I.map (algebraMap A C)) :=
    .of_equiv (Algebra.TensorProduct.quotIdealMapEquivQuotTensor C I).symm
  haveI : Algebra.FormallyEtale k (C ⧸ I.map (algebraMap A C)) := .comp k (A ⧸ I) _
  exact ⟨inferInstance, ⟨inferInstance, Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩⟩

omit [Algebra k A] [Algebra k C] [IsScalarTower k A C] in
/-- A finite étale algebra over a field is reduced and Artinian. -/
theorem isArtinianRing_isReduced (S : Type*) [CommRing S] [Algebra k S] [Module.Finite k S]
    [Algebra.Etale k S] : IsArtinianRing S ∧ IsReduced S :=
  ⟨IsArtinianRing.of_finite k S, Algebra.FormallyUnramified.isReduced_of_field k S⟩

variable {k} {k' : Type*} [Field k'] [Algebra k k'] {A' : Type*} [CommRing A'] [Algebra A A']
  [Algebra k A'] [IsScalarTower k A A']

/-- The image of `C` in a residue field `F` of `(A' ⊗[A] C) ⧸ I` lies in the image of `A'`, if
`k'` splits `C ⧸ IC` and maps to `A'`. -/
theorem mem_range_residue (hsplit : SplitsIn k k' (C ⧸ I.map (algebraMap A C)))
    (j : k' →ₐ[k] A') (F : Type*) [Field F] [Algebra (A' ⊗[A] C) F] [Algebra k F] [Algebra A F]
    [IsScalarTower k A F] [IsScalarTower A (A' ⊗[A] C) F]
    (hI : ∀ a ∈ I, algebraMap A F a = 0) (c : C) :
    algebraMap (A' ⊗[A] C) F (1 ⊗ₜ c) ∈
      ((algebraMap (A' ⊗[A] C) F).comp (algebraMap A' (A' ⊗[A] C))).range := by
  let ψ : C →ₐ[A] F := (IsScalarTower.toAlgHom A (A' ⊗[A] C) F).comp
    Algebra.TensorProduct.includeRight
  have hψ : I.map (algebraMap A C) ≤ RingHom.ker ψ := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, ψ.commutes]
    exact hI a ha
  let g : k' →+* F := ((algebraMap (A' ⊗[A] C) F).comp (algebraMap A' (A' ⊗[A] C))).comp j
  have hg : g.comp (algebraMap k k') = ψ.toRingHom.comp (algebraMap k C) := by
    ext c
    change algebraMap (A' ⊗[A] C) F (algebraMap A' (A' ⊗[A] C) (j (algebraMap k k' c))) =
      ψ (algebraMap k C c)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply k A C, ψ.commutes,
      IsScalarTower.algebraMap_apply k A A', ← IsScalarTower.algebraMap_apply A A' (A' ⊗[A] C),
      ← IsScalarTower.algebraMap_apply A (A' ⊗[A] C) F]
  obtain ⟨p, hm, hp, hs⟩ := hsplit (Ideal.Quotient.mk _ c)
  have h0 : aeval c p ∈ I.map (algebraMap A C) := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← hp]
    exact (aeval_algHom_apply (Ideal.Quotient.mkₐ k (I.map (algebraMap A C))) c p).symm
  have hy : (p.map (algebraMap k k')).eval₂ g (ψ c) = 0 := by
    rw [eval₂_map, hg]
    change eval₂ (ψ.toRingHom.comp _) (ψ.toRingHom c) p = 0
    rw [← hom_eval₂]
    exact hψ h0
  obtain ⟨z, hz⟩ := mem_range_of_splits g hs (hm.map _) hy
  exact ⟨j z, hz⟩

/-- **Trivial residue fields after base change**: if `k'` splits `C ⧸ IC` and maps to `A'`,
then every residue field of `(A' ⊗[A] C) ⧸ I` is reached from `A' ⧸ I`. -/
theorem surjective_residue (hsplit : SplitsIn k k' (C ⧸ I.map (algebraMap A C)))
    (j : k' →ₐ[k] A')
    (𝔫 : Ideal ((A' ⊗[A] C) ⧸ (I.map (algebraMap A A')).map (algebraMap A' (A' ⊗[A] C))))
    [𝔫.IsMaximal] :
    Function.Surjective (algebraMap (A' ⧸ I.map (algebraMap A A')) (_ ⧸ 𝔫)) := by
  letI := Ideal.Quotient.field 𝔫
  let F := ((A' ⊗[A] C) ⧸ (I.map (algebraMap A A')).map (algebraMap A' (A' ⊗[A] C))) ⧸ 𝔫
  let φ : A' ⊗[A] C →+* F := algebraMap (A' ⊗[A] C) F
  have hφ : φ.comp (algebraMap A' (A' ⊗[A] C)) =
      (algebraMap (A' ⧸ I.map (algebraMap A A')) F).comp (Ideal.Quotient.mk _) := rfl
  have hI : ∀ a ∈ I, algebraMap A F a = 0 := by
    intro a ha
    rw [IsScalarTower.algebraMap_apply A (A' ⊗[A] C) F,
      IsScalarTower.algebraMap_apply A A' (A' ⊗[A] C)]
    change Ideal.Quotient.mk 𝔫 (Ideal.Quotient.mk _ _) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha)),
      map_zero]
  have hC (c : C) : φ (1 ⊗ₜ c) ∈ (algebraMap (A' ⧸ I.map (algebraMap A A')) F).range := by
    have := mem_range_residue I C hsplit j F hI c
    rw [hφ] at this
    obtain ⟨z, hz⟩ := this
    exact ⟨Ideal.Quotient.mk _ z, hz⟩
  suffices H : ∀ x : A' ⊗[A] C, φ x ∈ (algebraMap (A' ⧸ I.map (algebraMap A A')) F).range by
    intro y
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact H x
  intro x
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul a c =>
    have : a ⊗ₜ[A] c = algebraMap A' (A' ⊗[A] C) a * (1 ⊗ₜ c) := by
      simp [Algebra.TensorProduct.algebraMap_apply]
    rw [this, map_mul]
    refine Subring.mul_mem _ ?_ (hC c)
    rw [← RingHom.comp_apply, hφ]
    exact RingHom.mem_range_self _ _
  | add x y hx hy => rw [map_add]; exact Subring.add_mem _ hx hy

/-- **Split form after a finite étale base change** (general form of (C)): if `A'` is finite
étale over `A` and receives a field `k'` splitting `C ⧸ IC`, then `A' ⊗[A] C` is a product of
factors `A' ⧸ (1 - εᵢ)`. -/
theorem exists_split_of_splitsIn [IsNoetherianRing A] [IsAdicComplete I A]
    [Module.Finite k (A ⧸ I)] [Algebra.Etale k (A ⧸ I)] [Module.Finite A C] [Algebra.Etale A C]
    [Module.Finite A A'] [Algebra.Etale A A'] (j : k' →ₐ[k] A')
    (hsplit : SplitsIn k k' (C ⧸ I.map (algebraMap A C))) :
    ∃ (m : ℕ) (ε : Fin m → A'), (∀ i, IsIdempotentElem (ε i)) ∧
      Nonempty (A' ⊗[A] C ≃ₐ[A'] Π i, A' ⧸ Ideal.span {1 - ε i}) := by
  haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing A A'
  haveI : IsAdicComplete (I.map (algebraMap A A')) A' :=
    CompleteFinite.isAdicComplete_map_of_finite I A'
  obtain ⟨_, _⟩ := finite_etale_quot k I A'
  obtain ⟨_, _⟩ := isArtinianRing_isReduced k (A' ⧸ I.map (algebraMap A A'))
  obtain ⟨_, _⟩ := finite_etale_quot k (I.map (algebraMap A A')) (A' ⊗[A] C)
  obtain ⟨_, _⟩ := isArtinianRing_isReduced k
    ((A' ⊗[A] C) ⧸ (I.map (algebraMap A A')).map (algebraMap A' (A' ⊗[A] C)))
  obtain ⟨m, ε₀, hε₀, ⟨e₀⟩⟩ := exists_algEquiv_pi_quotient (A' ⧸ I.map (algebraMap A A'))
    ((A' ⊗[A] C) ⧸ (I.map (algebraMap A A')).map (algebraMap A' (A' ⊗[A] C)))
    (fun 𝔫 _ ↦ surjective_residue I C hsplit j 𝔫)
  obtain ⟨ε, hε, -, ⟨e⟩⟩ :=
    exists_split_of_quot (I.map (algebraMap A A')) (A' ⊗[A] C) ε₀ hε₀ (e₀.restrictScalars A')
  exact ⟨m, ε, hε, ⟨e⟩⟩

end Extension

/-- **(C) Split form after a finite separable constant extension**: let `k` be a field, `A` a
Noetherian `k`-algebra, complete for an ideal `I` with `A ⧸ I` finite étale over `k`, and `C` a
finite étale `A`-algebra. Then there is a finite separable extension `k'/k` such that the base
change of `C` to `A' = A ⊗[k] k'` (i.e. `k' ⊗[k] C`) is a finite product of factors
`A' ⧸ (1 - εᵢ)`, `εᵢ` idempotent. -/
theorem exists_split_after_extension (k : Type u) [Field k] {A : Type v} [CommRing A]
    [Algebra k A] [IsNoetherianRing A] (I : Ideal A) [IsAdicComplete I A]
    [Module.Finite k (A ⧸ I)] [Algebra.Etale k (A ⧸ I)]
    (C : Type w) [CommRing C] [Algebra A C] [Algebra k C] [IsScalarTower k A C]
    [Module.Finite A C] [Algebra.Etale A C] :
    ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k'), FiniteDimensional k k' ∧
      Algebra.IsSeparable k k' ∧ ∃ (m : ℕ) (ε : Fin m → A ⊗[k] k'),
        (∀ i, IsIdempotentElem (ε i)) ∧
        Nonempty ((A ⊗[k] k') ⊗[A] C ≃ₐ[A ⊗[k] k'] Π i, (A ⊗[k] k') ⧸ Ideal.span {1 - ε i}) := by
  obtain ⟨_, _⟩ := finite_etale_quot k I C
  obtain ⟨k', _, _, hfin, hsep, hsplit⟩ := exists_splitsIn k (C ⧸ I.map (algebraMap A C))
  haveI := Algebra.FormallyEtale.of_isSeparable k k'
  haveI : Algebra.Etale k k' :=
    ⟨inferInstance, Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩
  obtain ⟨m, ε, hε, he⟩ :=
    exists_split_of_splitsIn I C (A' := A ⊗[k] k') Algebra.TensorProduct.includeRight hsplit
  exact ⟨k', _, _, hfin, hsep, m, ε, hε, he⟩

open IsLocalRing

/-- **(D) Unramified lift of a residue field extension**: over a complete Noetherian local ring
`O`, a finite separable extension `k'` of the residue field is the residue field of a finite
étale local `O`-algebra `O'` whose maximal ideal is `𝔪O'`. -/
theorem exists_unramified_lift {O : Type u} [CommRing O] [IsLocalRing O] [IsNoetherianRing O]
    [IsAdicComplete (maximalIdeal O) O] (k' : Type*) [Field k'] [Algebra (ResidueField O) k']
    [Algebra O k'] [IsScalarTower O (ResidueField O) k'] [FiniteDimensional (ResidueField O) k']
    [Algebra.IsSeparable (ResidueField O) k'] :
    ∃ (O' : Type u) (_ : CommRing O') (_ : Algebra O O'), Module.Finite O O' ∧
      Algebra.Etale O O' ∧ ∃ _ : IsLocalRing O',
        maximalIdeal O' = (maximalIdeal O).map (algebraMap O O') ∧
        Nonempty ((O' ⧸ (maximalIdeal O).map (algebraMap O O')) ≃ₐ[O] k') := by
  haveI := Algebra.FormallyEtale.of_isSeparable (ResidueField O) k'
  haveI : Algebra.Etale (ResidueField O) k' :=
    ⟨inferInstance, Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩
  letI : Algebra (O ⧸ maximalIdeal O) k' := ‹Algebra (ResidueField O) k'›
  haveI : IsScalarTower O (O ⧸ maximalIdeal O) k' := ‹IsScalarTower O (ResidueField O) k'›
  haveI : Algebra.Etale (O ⧸ maximalIdeal O) k' := ‹Algebra.Etale (ResidueField O) k'›
  haveI : Module.Finite (O ⧸ maximalIdeal O) k' := ‹FiniteDimensional (ResidueField O) k'›
  obtain ⟨O', _, _, hfin, het, ⟨e⟩⟩ :=
    EtaleLiftExists.exists_finite_etale_lift (maximalIdeal O) (S₀ := k')
  have hmax : ((maximalIdeal O).map (algebraMap O O')).IsMaximal := by
    rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
    exact MulEquiv.isField (Field.toIsField k') e.toMulEquiv
  have huniq : ∀ M : Ideal O', M.IsMaximal → M = (maximalIdeal O).map (algebraMap O O') := by
    intro M hM
    have : (M.comap (algebraMap O O')).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal M
    have hle : (maximalIdeal O).map (algebraMap O O') ≤ M :=
      Ideal.map_le_iff_le_comap.2 (IsLocalRing.eq_maximalIdeal this).ge
    exact (hmax.eq_of_le hM.ne_top hle).symm
  haveI : IsLocalRing O' := IsLocalRing.of_unique_max_ideal ⟨_, hmax, huniq⟩
  exact ⟨O', _, _, hfin, het, inferInstance, huniq _ (maximalIdeal.isMaximal O'), ⟨e⟩⟩

/-- **An étale local algebra over a DVR with maximal ideal `𝔪O'` is a DVR** (unramified
extensions of DVRs): `O'` is a domain (local rings of étale algebras over normal domains are
domains, `isDomain_localization_of_etale`), its maximal ideal is generated by a uniformizer `ϖ`
of `O`, and `ϖ ≠ 0` in `O'` by flatness. -/
theorem isDiscreteValuationRing_of_etale {O O' : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [CommRing O'] [Algebra O O'] [IsNoetherianRing O']
    [IsLocalRing O'] [Algebra.Etale O O']
    (h : maximalIdeal O' = (maximalIdeal O).map (algebraMap O O')) :
    ∃ _ : IsDomain O', IsDiscreteValuationRing O' := by
  haveI : IsDomain O' := by
    haveI := isDomain_localization_of_etale O (maximalIdeal O')
    exact (IsLocalization.atUnits O' (maximalIdeal O').primeCompl
      (S := Localization.AtPrime (maximalIdeal O'))
      fun _ hy ↦ IsLocalRing.notMem_maximalIdeal.mp hy).toRingEquiv.injective.isDomain _
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hspan : maximalIdeal O' = Ideal.span {algebraMap O O' ϖ} := by
    rw [h, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hnf : ¬ IsField O' := by
    intro hF
    have h0 : maximalIdeal O' = ⊥ := (isField_iff_maximalIdeal_eq).1 hF
    have h1 : algebraMap O O' ϖ = 0 := by
      rw [← Ideal.mem_bot, ← h0, hspan]
      exact Ideal.mem_span_singleton_self _
    have hreg : IsSMulRegular O' ϖ :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero)
    apply one_ne_zero (α := O')
    apply hreg
    change ϖ • (1 : O') = ϖ • 0
    rw [smul_zero, Algebra.smul_def, h1, zero_mul]
  have hp : (maximalIdeal O').IsPrincipal := ⟨⟨_, hspan⟩⟩
  exact ⟨inferInstance, ((IsDiscreteValuationRing.TFAE O' hnf).out 4 0).1 hp⟩

/-- **(D) for a complete DVR**: a finite separable extension `k'` of the residue field of a
complete discrete valuation ring `O` is the residue field of a finite étale `O`-algebra `O'`
which is again a discrete valuation ring with maximal ideal `𝔪O'` (same uniformizer). -/
theorem isDiscreteValuationRing_unramified_lift {O : Type u} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (maximalIdeal O) O] (k' : Type*) [Field k']
    [Algebra (ResidueField O) k'] [Algebra O k'] [IsScalarTower O (ResidueField O) k']
    [FiniteDimensional (ResidueField O) k'] [Algebra.IsSeparable (ResidueField O) k'] :
    ∃ (O' : Type u) (_ : CommRing O') (_ : Algebra O O'), Module.Finite O O' ∧
      Algebra.Etale O O' ∧ ∃ (_ : IsDomain O') (_ : IsLocalRing O'), IsDiscreteValuationRing O' ∧
        maximalIdeal O' = (maximalIdeal O).map (algebraMap O O') ∧
        Nonempty ((O' ⧸ (maximalIdeal O).map (algebraMap O O')) ≃ₐ[O] k') := by
  obtain ⟨O', _, _, hfin, het, _, hmax, he⟩ := exists_unramified_lift (O := O) k'
  haveI : IsNoetherianRing O' := Algebra.FiniteType.isNoetherianRing O O'
  obtain ⟨h1, h2⟩ := isDiscreteValuationRing_of_etale hmax
  exact ⟨O', _, _, hfin, het, h1, inferInstance, h2, hmax, he⟩

end SemistableReduction.SplitAfterExtension
