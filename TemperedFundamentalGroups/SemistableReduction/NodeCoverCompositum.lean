import TemperedFundamentalGroups.SemistableReduction.NodeCoverField

/-!
# Galois covers of a node after an étale base change: the field step

Let `K₀ ⊆ K₁` be fields and `X ∈ K₁` with `X ^ (q M') = x ∈ K₀` (in the application `K₀` is the
function field `K(T ^ M)` of the node of thickness `M = q M'` and `K₁ = K(T)` that of the regular
node, `X = T`). Let `E` be an intermediate field of a field `F` over `K₀` such that `F` is a
`K₁`-algebra, generated over `E` by the image `T` of `X` with `[F : E] = q M'` (in the
application `E` is the function field of an étale neighbourhood of the closed point of the node
of thickness `M` and `F = E K₁`). Let `L / K₀` be finite Galois of degree prime to `q` which
embeds into `F` over `K₀` (this embedding is what the étale-local splitting of the cover over
the regular node provides) and let `E` contain a primitive `M'`-th root of unity.

* `NodeCover.tensor_algEquiv_pi_of_algHom`: then `E ⊗_{K₀} L` is a finite product of copies of
  `E ⊗_{K₀} K₀(X ^ n)` with `n = q (M' / e)`, `e ∣ M'`: after the base change to `E` the cover
  `L` becomes a product of Kummer covers `x = (X ^ n) ^ e`.

Proof: the compositum `C = E(roots of p) ⊆ F` (`p` a separable polynomial with splitting field
`L`) is Galois over `E`; every factor of the product of fields `E ⊗_{K₀} L` is a splitting field
of `p` over `E`, hence `E`-isomorphic to `C`; counting degrees, `[C : E]` divides `[L : K₀]`, so
it is prime to `q`, and the field lemma `NodeCover.eq_adjoin_pow_of_isGalois` gives
`C = E(T ^ n)`, which is `E ⊗_{K₀} K₀(X ^ n)` by a degree count.

## References

* [MzkExt] S. Mochizuki, *Extending families of curves over log regular schemes*, J. reine angew.
  Math. 511 (1999), Thm. 3.3 and Lemmas 3.1, 3.2.
-/

open IntermediateField Module Polynomial TensorProduct

namespace SemistableReduction.NodeCover

section Splitting

variable {K₀ F : Type*} [Field K₀] [Field F] [Algebra K₀ F] (E : Type*) [Field E] [Algebra K₀ E]
  [Algebra E F] [IsScalarTower K₀ E F] {L : Type*} [Field L] [Algebra K₀ L]

/-- A separable polynomial over `K₀` whose splitting field is `L` splits in `F` if `L` embeds
into `F`; then the field generated over `E` by its roots is a splitting field over `E`. -/
theorem isSplittingField_adjoin_rootSet {p : K₀[X]} [p.IsSplittingField K₀ L] (ι : L →ₐ[K₀] F) :
    (p.map (algebraMap K₀ E)).IsSplittingField E
      (adjoin E ((p.map (algebraMap K₀ E)).rootSet F)) := by
  apply adjoin_rootSet_isSplittingField
  rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq, ← ι.comp_algebraMap,
    ← Polynomial.map_map]
  exact (IsSplittingField.splits L p).map _

/-- A field `A` which is a quotient of `E ⊗_{K₀} L` is a splitting field over `E` of every
polynomial whose splitting field over `K₀` is `L`. -/
theorem isSplittingField_of_surjective {p : K₀[X]} [p.IsSplittingField K₀ L]
    {A : Type*} [Field A] [Algebra E A] (f : E ⊗[K₀] L →ₐ[E] A) (hf : Function.Surjective f) :
    (p.map (algebraMap K₀ E)).IsSplittingField E A := by
  letI : Algebra K₀ A := ((algebraMap E A).comp (algebraMap K₀ E)).toAlgebra
  have : IsScalarTower K₀ E A := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let g : L →ₐ[K₀] A :=
    (f.restrictScalars K₀).comp Algebra.TensorProduct.includeRight
  have hsplit : (p.map (algebraMap K₀ A)).Splits := by
    rw [← g.comp_algebraMap, ← Polynomial.map_map]
    exact (IsSplittingField.splits L p).map _
  refine ⟨by rwa [Polynomial.map_map, ← IsScalarTower.algebraMap_eq], ?_⟩
  -- the image of `L` lies in the subalgebra generated by the roots
  have hroots : (p.map (algebraMap K₀ E)).rootSet A = p.rootSet A := by
    ext y
    simp [Polynomial.mem_rootSet', Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
  have hL : ∀ l : L, g l ∈ Algebra.adjoin E ((p.map (algebraMap K₀ E)).rootSet A) := by
    intro l
    have h1 : Algebra.adjoin K₀ (p.rootSet A) = g.range :=
      IsSplittingField.adjoin_rootSet_eq_range L p g
    have h2 : g l ∈ Algebra.adjoin K₀ (p.rootSet A) := by rw [h1]; exact ⟨l, rfl⟩
    rw [hroots]
    have h3 : Algebra.adjoin K₀ (p.rootSet A) ≤
        (Algebra.adjoin E (p.rootSet A)).restrictScalars K₀ :=
      Algebra.adjoin_le Algebra.subset_adjoin
    exact h3 h2
  rw [eq_top_iff]
  rintro y -
  obtain ⟨z, rfl⟩ := hf y
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a l =>
    have : f (a ⊗ₜ[K₀] l) = a • g l := by
      have h : a ⊗ₜ[K₀] l = a • ((1 : E) ⊗ₜ[K₀] l) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h, map_smul]
      rfl
    rw [this]
    exact Subalgebra.smul_mem _ (hL l) a
  | add z w hz hw => rw [map_add]; exact add_mem hz hw

end Splitting

section Product

variable {K₀ F : Type*} [Field K₀] [Field F] [Algebra K₀ F] (E : Type*) [Field E] [Algebra K₀ E]
  [Algebra E F] [IsScalarTower K₀ E F] {L : Type*} [Field L] [Algebra K₀ L]
  [FiniteDimensional K₀ L] [Algebra.IsSeparable K₀ L]

/-- If `L / K₀` is the splitting field of `p` and embeds into `F`, then `E ⊗_{K₀} L` is a
finite product of copies of the field `E(roots of p) ⊆ F`. -/
theorem exists_algEquiv_pi_adjoin_rootSet {p : K₀[X]} [p.IsSplittingField K₀ L]
    (ι : L →ₐ[K₀] F) :
    ∃ r : ℕ, Nonempty (E ⊗[K₀] L ≃ₐ[E]
      (Fin r → adjoin E ((p.map (algebraMap K₀ E)).rootSet F))) := by
  classical
  have : Algebra.FormallyEtale K₀ L := Algebra.FormallyEtale.of_isSeparable K₀ L
  obtain ⟨I, _, Ai, _, _, e, -⟩ :=
    (Algebra.FormallyEtale.iff_exists_algEquiv_prod E (E ⊗[K₀] L)).mp inferInstance
  have := isSplittingField_adjoin_rootSet E (p := p) ι
  have hAi : ∀ i, (p.map (algebraMap K₀ E)).IsSplittingField E (Ai i) := fun i ↦
    isSplittingField_of_surjective E ((Pi.evalAlgHom E Ai i).comp e.toAlgHom)
      ((Function.surjective_eval i).comp e.surjective)
  let f : ∀ i, Ai i ≃ₐ[E] adjoin E ((p.map (algebraMap K₀ E)).rootSet F) := fun i ↦
    (IsSplittingField.algEquiv (Ai i) (p.map (algebraMap K₀ E))).trans
      (IsSplittingField.algEquiv _ (p.map (algebraMap K₀ E))).symm
  have := Fintype.ofFinite I
  exact ⟨Fintype.card I, ⟨(e.trans (AlgEquiv.piCongrRight f)).trans
    (AlgEquiv.piCongrLeft' E (fun _ ↦ adjoin E ((p.map (algebraMap K₀ E)).rootSet F))
      (Fintype.equivFin I))⟩⟩

end Product

section Main

variable {K₀ K₁ F : Type*} [Field K₀] [Field K₁] [Field F] [Algebra K₀ K₁] [Algebra K₀ F]
  [Algebra K₁ F] [IsScalarTower K₀ K₁ F] (E : Type*) [Field E] [Algebra K₀ E] [Algebra E F]
  [IsScalarTower K₀ E F] [FiniteDimensional E F]

/-- **Kummer subfields after base change.** Let `n e = M`, `X ^ M = x ∈ K₀`, and let `T` be the
image of `X` in `F`. If `[E(T ^ n) : E] = e`, then `E ⊗_{K₀} K₀(X ^ n) ≃ E(T ^ n)`. -/
noncomputable def tensorAdjoinPowEquiv {n e M : ℕ} (hne : n * e = M) (he : 0 < e) {X : K₁}
    {x : K₀} (hx : X ^ M = algebraMap K₀ K₁ x)
    (hC : finrank E E⟮algebraMap K₁ F X ^ n⟯ = e) :
    E ⊗[K₀] K₀⟮X ^ n⟯ ≃ₐ[E] E⟮algebraMap K₁ F X ^ n⟯ := by
  classical
  let g : K₀⟮X ^ n⟯ →ₐ[K₀] F := (IsScalarTower.toAlgHom K₀ K₁ F).comp K₀⟮X ^ n⟯.val
  let φ : E ⊗[K₀] K₀⟮X ^ n⟯ →ₐ[E] F :=
    Algebra.TensorProduct.lift (Algebra.ofId E F) g fun _ _ ↦ Commute.all _ _
  have hint : IsIntegral E (algebraMap K₁ F X ^ n) := Algebra.IsIntegral.isIntegral _
  have hrange : φ.range = (E⟮algebraMap K₁ F X ^ n⟯).toSubalgebra := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨z, rfl⟩
      change φ z ∈ (E⟮algebraMap K₁ F X ^ n⟯).toSubalgebra
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a y =>
        have hy : g y ∈ (E⟮algebraMap K₁ F X ^ n⟯).restrictScalars K₀ := by
          have h1 : IsScalarTower.toAlgHom K₀ K₁ F y ∈
              (K₀⟮X ^ n⟯).map (IsScalarTower.toAlgHom K₀ K₁ F) := ⟨y, y.2, rfl⟩
          rw [IntermediateField.adjoin_map, Set.image_singleton] at h1
          refine (adjoin_le_iff.mpr ?_) h1
          rintro _ rfl
          rw [IsScalarTower.coe_toAlgHom', map_pow]
          exact mem_adjoin_simple_self E _
        have : φ (a ⊗ₜ y) = algebraMap E F a * g y := by simp [φ]
        rw [this]
        exact mul_mem (IntermediateField.algebraMap_mem _ a) hy
      | add z w hz hw => rw [map_add]; exact add_mem hz hw
    · rw [adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic, Algebra.adjoin_le_iff,
        Set.singleton_subset_iff]
      refine ⟨1 ⊗ₜ ⟨X ^ n, mem_adjoin_simple_self K₀ _⟩, ?_⟩
      simp [φ, g]
  have hdom : finrank E (E ⊗[K₀] K₀⟮X ^ n⟯) ≤ e := by
    rw [Module.finrank_baseChange]
    exact finrank_adjoin_le_of_pow_eq he (a := x) (by rw [← pow_mul, hne, hx])
  have hrk : finrank E (LinearMap.range φ.toLinearMap) = e := by
    rw [← hC]
    have : LinearMap.range φ.toLinearMap = Subalgebra.toSubmodule φ.range := rfl
    rw [this, hrange]
    rfl
  have hint₀ : IsIntegral K₀ (X ^ n) :=
    ⟨Polynomial.X ^ e - Polynomial.C x, monic_X_pow_sub_C x he.ne', by
      simp [← pow_mul, hne, hx]⟩
  have : FiniteDimensional K₀ K₀⟮X ^ n⟯ := adjoin.finiteDimensional hint₀
  have hinj : Function.Injective φ := by
    have h := LinearMap.finrank_range_add_finrank_ker φ.toLinearMap
    have hker : finrank E (LinearMap.ker φ.toLinearMap) = 0 := by omega
    rw [Submodule.finrank_eq_zero] at hker
    exact LinearMap.ker_eq_bot.mp hker
  exact (AlgEquiv.ofInjective φ hinj).trans (Subalgebra.equivOfEq _ _ hrange)

variable {L : Type*} [Field L] [Algebra K₀ L] [FiniteDimensional K₀ L] [IsGalois K₀ L]

/-- **Prime-to-`q` Galois covers become Kummer after base change** (the field step of "S4-local"
over an étale neighbourhood). Let `X ^ (q M') = x ∈ K₀`, let `F` be generated over its
intermediate field `E` by the image `T` of `X`, of degree `[F : E] = q M'`, and let `K₀` contain
a primitive `M'`-th root of unity. If `L / K₀` is finite Galois of degree prime to `q` and embeds
into `F` over `K₀`, then for some `e ∣ M'`, `E ⊗_{K₀} L` is a finite product of copies of
`E ⊗_{K₀} K₀(X ^ (q (M' / e)))`. -/
theorem tensor_algEquiv_pi_of_algHom {q M' : ℕ} (hq : 0 < q) (hM' : 0 < M') {ζ : K₀}
    (hζ : IsPrimitiveRoot ζ M') {X : K₁} {x : K₀} (hx : X ^ (q * M') = algebraMap K₀ K₁ x)
    (hX : E⟮algebraMap K₁ F X⟯ = ⊤) (hF : finrank E F = q * M')
    (hL : (finrank K₀ L).Coprime q) (ι : L →ₐ[K₀] F) :
    ∃ e, e ∣ M' ∧ ∃ r : ℕ,
      Nonempty (E ⊗[K₀] L ≃ₐ[E] (Fin r → E ⊗[K₀] K₀⟮X ^ (q * (M' / e))⟯)) := by
  classical
  obtain ⟨p, hp, hpL⟩ := IsGalois.is_separable_splitting_field K₀ L
  set C := adjoin E ((p.map (algebraMap K₀ E)).rootSet F) with hCdef
  have := isSplittingField_adjoin_rootSet E (p := p) ι
  have : IsGalois E C := IsGalois.of_separable_splitting_field (p := p.map (algebraMap K₀ E))
    hp.map
  obtain ⟨r, ⟨eqv⟩⟩ := exists_algEquiv_pi_adjoin_rootSet E (p := p) ι
  -- the degree of `C` divides `[L : K₀]`
  have hdim : finrank K₀ L = r * finrank E C := by
    rw [← Module.finrank_baseChange (R := E), eqv.toLinearEquiv.finrank_eq,
      Module.finrank_pi_fintype, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      smul_eq_mul]
  have hC : (finrank E C).Coprime q :=
    Nat.Coprime.coprime_dvd_left (Dvd.intro_left _ hdim.symm) hL
  have hx' : algebraMap K₁ F X ^ (q * M') = algebraMap E F (algebraMap K₀ E x) := by
    rw [← map_pow, hx, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  obtain ⟨hdvd, hCeq⟩ := eq_adjoin_pow_of_isGalois hq hM'
    (hζ.map_of_injective (algebraMap K₀ E).injective) hx' hX hF C hC
  refine ⟨finrank E C, hdvd, r, ⟨eqv.trans (AlgEquiv.piCongrRight fun _ ↦
    (IntermediateField.equivOfEq hCeq).trans
      (tensorAdjoinPowEquiv E (e := finrank E C) ?_ finrank_pos hx ?_).symm)⟩⟩
  · rw [mul_assoc, Nat.div_mul_cancel hdvd]
  · rw [← hCeq]

end Main

end SemistableReduction.NodeCover
