local notation "R" => Localization.AtPrime (cuspIdeal O)
local notation "R_e" => Localization.AtPrime (KPoly.ideal O e)
local notation "𝕂" => 𝔎⟮(RatFunc.X : RatFunc 𝔎) ^ e⟯

