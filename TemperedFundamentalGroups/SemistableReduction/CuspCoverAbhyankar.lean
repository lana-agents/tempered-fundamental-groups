section Abhyankar

variable (L : Type u) [Field L]
  [Algebra (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L]
  [FiniteDimensional (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L]
  [IsGalois (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L] (L₁ : Type u) [Field L₁]
  [Algebra (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L₁]
  [Algebra (RatFunc (FractionRing O)) L₁] [Algebra L L₁]
  [@IsScalarTower (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯
    (RatFunc (FractionRing O)) L₁ _ _ Algebra.toSMul]
  [@IsScalarTower (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L L₁ _ _
    Algebra.toSMul]
  [Algebra (Localization.AtPrime (KPoly.ideal O e)) L₁]
  [IsScalarTower (Localization.AtPrime (KPoly.ideal O e)) (RatFunc (FractionRing O)) L₁]
  [FiniteDimensional (RatFunc (FractionRing O)) L₁]
  [Algebra.IsSeparable (RatFunc (FractionRing O)) L₁]

local notation "𝔱R" => Ideal.span {algebraMap O[X] (Localization.AtPrime (cuspIdeal O)) X}
local notation "𝔻" => Localization.AtPrime 𝔱R
local notation "𝔱D" =>
  algebraMap (Localization.AtPrime (cuspIdeal O)) 𝔻
    (algebraMap O[X] (Localization.AtPrime (cuspIdeal O)) X)
local notation "ℙ" => Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}
local notation "𝔹₁" => integralClosure R_e L₁
local notation "𝕄" => Algebra.algebraMapSubmonoid 𝔹₁ (Ideal.primeCompl 𝔱R)
local notation "𝔹'" => Localization 𝕄
local notation "𝕪" => algebraMap (RatFunc 𝔎) L₁ RatFunc.X

set_option synthInstance.maxHeartbeats 200000 in
-- Instance search through the intermediate fields of `K(T)` is slow.
set_option maxHeartbeats 1000000 in
-- Many localizations and algebra structures.
/-- **Abhyankar's lemma at the horizontal divisor `(t')`.** Let `L / K(T ^ e)` be Galois of
degree dividing `e` and `L₁` a field generated by `L` and `K(T)`. Then the normalisation `B₁` of
`R_e` in `L₁` is unramified over `R_e` at every prime `Q` over `(t')`. -/
theorem isUnramifiedAt_t' [CharZero O] {ϖ : O} (hϖ : Irreducible ϖ) (hd : finrank 𝕂 L ∣ e)
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom 𝕂 L L₁) (IsScalarTower.toAlgHom 𝕂 (RatFunc 𝔎) L₁)))
    (Q : Ideal (integralClosure R_e L₁)) [Q.IsPrime]
    [hQP : Q.LiesOver (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y})] :
    Algebra.IsUnramifiedAt R_e Q := by
  classical
  letI := locAdjoinPowAlgebra O e
  letI := locRatFuncAlgebra' O e
  haveI := isScalarTower_loc_adjoinPow_ratFunc O e
  haveI := isFractionRing_loc_adjoinPow O e
  haveI : IsFractionRing R_e (RatFunc 𝔎) := isFractionRing_locE O e
  haveI : IsScalarTower R R_e (RatFunc 𝔎) := isScalarTower_loc O e
  haveI : IsNoetherianRing R_e := isNoetherianRing_locE O e
  haveI : IsIntegrallyClosed R_e := isIntegrallyClosed_locE O e
  haveI : IsNoetherianRing R := isNoetherianRing_loc O
  haveI := localKummer_finite O e
  haveI : Ideal.IsPrime ℙ := (Ideal.span_singleton_prime (prime_t' O e).ne_zero).mpr (prime_t' O e)
  -- `R` acting on `L₁` and `B₁`
  have hRL₁ : ∀ r : R, algebraMap R_e L₁ (algebraMap R R_e r) =
      algebraMap 𝕂 L₁ (algebraMap R 𝕂 r) := fun r ↦ by
    rw [IsScalarTower.algebraMap_apply R_e (RatFunc 𝔎) L₁,
      ← IsScalarTower.algebraMap_apply R R_e (RatFunc 𝔎),
      IsScalarTower.algebraMap_apply R 𝕂 (RatFunc 𝔎),
      ← IsScalarTower.algebraMap_apply 𝕂 (RatFunc 𝔎) L₁]
  letI : Algebra R L₁ := ((algebraMap 𝕂 L₁).comp (algebraMap R 𝕂)).toAlgebra
  haveI : @IsScalarTower R 𝕂 L₁ _ Algebra.toSMul _ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : IsScalarTower R R_e L₁ := IsScalarTower.of_algebraMap_eq fun r ↦ (hRL₁ r).symm
  letI : Algebra R 𝔹₁ := ((algebraMap R_e 𝔹₁).comp (algebraMap R R_e)).toAlgebra
  haveI : IsScalarTower R R_e 𝔹₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : IsScalarTower R 𝔹₁ L₁ := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change algebraMap R L₁ r = algebraMap 𝔹₁ L₁ (algebraMap R_e 𝔹₁ (algebraMap R R_e r))
    rw [← IsScalarTower.algebraMap_apply R_e 𝔹₁ L₁, ← IsScalarTower.algebraMap_apply]
  have hRinj : Function.Injective (algebraMap R L₁) :=
    (algebraMap 𝕂 L₁).injective.comp (IsFractionRing.injective R 𝕂)
  -- the discrete valuation ring `D = R_(t)`
  haveI : Ideal.IsPrime 𝔱R := (Ideal.span_singleton_prime (prime_t O).ne_zero).mpr (prime_t O)
  have hmD : maximalIdeal 𝔻 = Ideal.span {𝔱D} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton]
  have htD0 : 𝔱D ≠ 0 := fun h ↦ (prime_t O).ne_zero
    (IsLocalization.injective 𝔻 (Ideal.primeCompl_le_nonZeroDivisors 𝔱R)
      (h.trans (map_zero _).symm))
  have hreg : IsSMulRegular 𝔻 𝔱D :=
    IsLeftRegular.isSMulRegular fun a b h ↦ mul_left_cancel₀ htD0 h
  haveI : IsNoetherianRing 𝔻 :=
    IsLocalization.isNoetherianRing (Ideal.primeCompl 𝔱R) 𝔻 inferInstance
  haveI : IsDiscreteValuationRing 𝔻 :=
    IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span hmD hreg
  have htD : Irreducible 𝔱D := IsLocalRing.irreducible_of_maximalIdeal_eq_span hmD hreg
  -- `D` acting on the fields
  letI : Algebra 𝔻 𝕂 := (locLift 𝔱R 𝕂).toAlgebra
  obtain ⟨hRD𝕂, hD𝕂⟩ := isFractionRing_locLift 𝔱R 𝕂
  letI : Algebra 𝔻 L := ((algebraMap 𝕂 L).comp (algebraMap 𝔻 𝕂)).toAlgebra
  haveI : IsScalarTower 𝔻 𝕂 L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  letI : Algebra 𝔻 L₁ := ((algebraMap 𝕂 L₁).comp (algebraMap 𝔻 𝕂)).toAlgebra
  haveI : @IsScalarTower 𝔻 𝕂 L₁ _ Algebra.toSMul _ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : IsScalarTower 𝔻 L L₁ := IsScalarTower.of_algebraMap_eq fun x ↦
    IsScalarTower.algebraMap_apply 𝕂 L L₁ (algebraMap 𝔻 𝕂 x)
  haveI : IsScalarTower R 𝔻 L₁ := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change algebraMap 𝕂 L₁ (algebraMap R 𝕂 r) =
      algebraMap 𝕂 L₁ (algebraMap 𝔻 𝕂 (algebraMap R 𝔻 r))
    rw [← IsScalarTower.algebraMap_apply R 𝔻 𝕂]
  -- the residue field of `D` has characteristic zero; tameness
  have hϖD : algebraMap R 𝔻 (algebraMap O[X] R (C ϖ)) ∉ maximalIdeal 𝔻 := by
    intro h
    have h' : algebraMap O[X] R (C ϖ) ∈ (maximalIdeal 𝔻).comap (algebraMap R 𝔻) := h
    rw [← Ideal.under_def, Localization.AtPrime.under_maximalIdeal] at h'
    exact C_notMem_span_t hϖ.ne_zero h'
  let fD : O →+* 𝔻 ⧸ maximalIdeal 𝔻 :=
    (Ideal.Quotient.mk _).comp ((algebraMap R 𝔻).comp ((algebraMap O[X] R).comp C))
  haveI : CharZero (𝔻 ⧸ maximalIdeal 𝔻) := charZero_of_map_ne_zero fD hϖ (by
    change Ideal.Quotient.mk _ (algebraMap R 𝔻 (algebraMap O[X] R (C ϖ))) ≠ 0
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
    exact hϖD)
  have heD : IsUnit (e : 𝔻) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
    exact Nat.cast_ne_zero.mpr (NeZero.ne e)
  have htame := Abhyankar.tame_of_isGalois (O := 𝔻) (K := 𝕂) (L := L)
    (by rw [ringExpChar.eq_one]; exact Nat.coprime_one_right _)
  have hcard : Nat.card Gal(L/𝕂) = finrank 𝕂 L := IsGalois.card_aut_eq_finrank 𝕂 L
  have htame' : ∀ (𝔓 : Ideal (integralClosure 𝔻 L)) [𝔓.IsPrime]
      [𝔓.LiesOver (maximalIdeal 𝔻)], 𝔓.ramificationIdx 𝔻 ∣ e ∧
        Algebra.IsSeparable (𝔻 ⧸ maximalIdeal 𝔻) (integralClosure 𝔻 L ⧸ 𝔓) := fun 𝔓 _ _ ↦ by
    obtain ⟨h1, h2⟩ := htame 𝔓
    exact ⟨h1.trans (by rw [hcard]; exact hd), h2⟩
  -- `B' = B₁[(R ∖ (t))⁻¹]`, the integral closure of `D` in `L₁`
  have hMne : ∀ m ∈ 𝕄, algebraMap 𝔹₁ L₁ m ≠ 0 := by
    rintro _ ⟨r, hr, rfl⟩ h
    rw [← IsScalarTower.algebraMap_apply R 𝔹₁ L₁] at h
    exact hr (by rw [hRinj (h.trans (map_zero _).symm)]; exact Ideal.zero_mem 𝔱R)
  have hMunit : ∀ m : 𝕄, IsUnit (algebraMap 𝔹₁ L₁ m) := fun m ↦ IsUnit.mk0 _ (hMne m m.2)
  letI : Algebra 𝔹' L₁ := (IsLocalization.lift (M := 𝕄) (S := 𝔹') hMunit).toAlgebra
  have hB'L₁ : ∀ b : 𝔹₁, algebraMap 𝔹' L₁ (algebraMap 𝔹₁ 𝔹' b) = algebraMap 𝔹₁ L₁ b :=
    IsLocalization.lift_eq hMunit
  haveI : IsScalarTower 𝔹₁ 𝔹' L₁ := IsScalarTower.of_algebraMap_eq fun b ↦ (hB'L₁ b).symm
  haveI : IsScalarTower 𝔻 𝔹' L₁ := by
    refine IsScalarTower.of_algebraMap_eq' (IsLocalization.ringHom_ext (Ideal.primeCompl 𝔱R)
      (RingHom.ext fun r ↦ ?_))
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply R 𝔻 𝔹', IsScalarTower.algebraMap_apply R 𝔹₁ 𝔹', hB'L₁,
      ← IsScalarTower.algebraMap_apply R 𝔹₁ L₁, ← IsScalarTower.algebraMap_apply R 𝔻 L₁]
  have hM0 : 𝕄 ≤ nonZeroDivisors 𝔹₁ := fun m hm ↦
    mem_nonZeroDivisors_of_ne_zero fun h ↦ hMne m hm (by rw [h, map_zero])
  haveI : IsDomain 𝔹' := IsLocalization.isDomain_localization hM0
  have hB₁inj : Function.Injective (algebraMap 𝔹₁ L₁) := Subtype.val_injective
  have hB'inj : Function.Injective (algebraMap 𝔹' L₁) :=
    (IsLocalization.lift_injective_iff (M := 𝕄) (S := 𝔹') hMunit).mpr fun x y ↦
      ⟨fun h ↦ by rw [IsLocalization.injective 𝔹' hM0 h], fun h ↦ by rw [hB₁inj h]⟩
  haveI : IsIntegralClosure 𝔹' 𝔻 L₁ := by
    refine ⟨hB'inj, fun {x} ↦ ⟨fun hx ↦ ?_, ?_⟩⟩
    · obtain ⟨⟨r, hr⟩, hrx⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Ideal.primeCompl 𝔱R) (Rₘ := 𝔻) x hx
      have hrx' : IsIntegral R_e (r • x) := hrx.tower_top
      refine ⟨IsLocalization.mk' 𝔹' (⟨r • x, hrx'⟩ : 𝔹₁)
        (⟨algebraMap R 𝔹₁ r, r, hr, rfl⟩ : 𝕄), ?_⟩
      change IsLocalization.lift hMunit _ = x
      rw [IsLocalization.lift_mk'_spec]
      change r • x = algebraMap 𝔹₁ L₁ (algebraMap R 𝔹₁ r) * x
      rw [← IsScalarTower.algebraMap_apply R 𝔹₁ L₁, Algebra.smul_def]
    · rintro ⟨y, rfl⟩
      obtain ⟨⟨b, ⟨_, r, hr, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective 𝕄 y
      have hb0 : IsIntegral R (algebraMap 𝔹₁ L₁ b) := isIntegral_trans _ b.2
      have hb : IsIntegral 𝔻 (algebraMap 𝔹₁ L₁ b) := hb0.tower_top
      have hval : algebraMap 𝔹' L₁
          (IsLocalization.mk' 𝔹' b (⟨algebraMap R 𝔹₁ r, r, hr, rfl⟩ : 𝕄)) =
          algebraMap 𝔻 L₁ (IsLocalization.mk' 𝔻 (1 : R) (⟨r, hr⟩ : (Ideal.primeCompl 𝔱R))) *
            algebraMap 𝔹₁ L₁ b := by
        change IsLocalization.lift hMunit _ = _
        rw [IsLocalization.lift_mk'_spec]
        change _ = algebraMap 𝔹₁ L₁ (algebraMap R 𝔹₁ r) * _
        rw [← IsScalarTower.algebraMap_apply R 𝔹₁ L₁, IsScalarTower.algebraMap_apply R 𝔻 L₁,
          ← mul_assoc, ← map_mul, mul_comm (algebraMap R 𝔻 r), IsLocalization.mk'_spec,
          map_one, map_one, one_mul]
      rw [hval]
      exact isIntegral_algebraMap.mul hb
  -- the prime `𝔔 = Q B'` over the maximal ideal of `D`
  have hcomap : Ideal.comap (algebraMap R R_e) ℙ = 𝔱R := comap_span_t' hϖ
  have hdisj : Disjoint (𝕄 : Set 𝔹₁) Q := by
    rw [Set.disjoint_left]
    rintro _ ⟨r, hr, rfl⟩ hQ
    apply hr
    rw [← hcomap, SetLike.mem_coe, Ideal.mem_comap, hQP.over, Ideal.under_def, Ideal.mem_comap]
    exact hQ
  haveI : (Q.map (algebraMap 𝔹₁ 𝔹')).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint 𝕄 𝔹' Q ‹_› hdisj
  have htQ : algebraMap R 𝔹₁ (algebraMap O[X] R X) ∈ Q := by
    have h : algebraMap O[X] R X ∈ Ideal.comap (algebraMap R R_e) ℙ := by
      rw [hcomap]; exact Ideal.mem_span_singleton_self _
    rw [Ideal.mem_comap, hQP.over, Ideal.under_def, Ideal.mem_comap] at h
    exact h
  haveI : (Q.map (algebraMap 𝔹₁ 𝔹')).LiesOver (maximalIdeal 𝔻) := by
    constructor
    refine le_antisymm ?_ (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance))
    rw [hmD, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.under_def,
      Ideal.mem_comap, ← IsScalarTower.algebraMap_apply R 𝔻 𝔹',
      IsScalarTower.algebraMap_apply R 𝔹₁ 𝔹']
    exact Ideal.mem_map_of_mem _ htQ
  -- Abhyankar's lemma over `D`
  have hy : 𝕪 ^ e = algebraMap 𝔻 L₁ 𝔱D := by
    change _ = algebraMap 𝕂 L₁ (algebraMap 𝔻 𝕂 (algebraMap R 𝔻 (algebraMap O[X] R X)))
    rw [← IsScalarTower.algebraMap_apply R 𝔻 𝕂, algebraMap_loc_adjoinPow,
      IsScalarTower.algebraMap_apply 𝕂 (RatFunc 𝔎) L₁, ← map_pow]
    congr 1
    change _ = (toAdjoinPow O e X : RatFunc 𝔎)
    rw [coe_toAdjoinPow, toRatFunc_X]
  have hyB' : algebraMap 𝔹' L₁
      (algebraMap 𝔹₁ 𝔹' (algebraMap R_e 𝔹₁ (algebraMap (KPoly O e) R_e KPoly.Y))) = 𝕪 := by
    rw [hB'L₁, ← IsScalarTower.algebraMap_apply R_e 𝔹₁ L₁,
      IsScalarTower.algebraMap_apply R_e (RatFunc 𝔎) L₁, algebraMap_locE_ratFunc]
    change algebraMap (RatFunc 𝔎) L₁ (toRatFunc O 1 X) = _
    rw [toRatFunc_X, pow_one]
  have : FiniteDimensional 𝕂 (RatFunc 𝔎) := Module.finite_of_finrank_pos
    (by rw [Node.finrank_adjoin_X_pow (O := O) e]; exact Nat.pos_of_neZero e)
  have hF : Algebra.adjoin L {𝕪} = ⊤ := adjoin_eq_top_of_surjective
    (algebra_adjoin_eq_top (Node.adjoin_X_eq_top (O := O) e)) hgen
  have hmax := Abhyankar.maximalIdeal_atPrime_eq_span (K := 𝕂) (L := L)
    (B := integralClosure 𝔻 L) (F := L₁) (B' := 𝔹') htD heD hy hF htame'
    (Q.map (algebraMap 𝔹₁ 𝔹')) _ hyB'
  have hmaxQ : maximalIdeal (Localization.AtPrime Q) =
      Ideal.span {algebraMap 𝔹₁ _ (algebraMap R_e 𝔹₁ (algebraMap (KPoly O e) R_e KPoly.Y))} :=
    maximalIdeal_eq_span_of_localization 𝕄 Q hdisj _ hmax
  -- conclusion
  haveI : Module.Finite R_e 𝔹₁ := IsIntegralClosure.finite R_e (RatFunc 𝔎) L₁ 𝔹₁
  haveI : Algebra.IsIntegral R_e 𝔹₁ := Algebra.IsIntegral.of_finite _ _
  letI := Localization.AtPrime.algebraOfLiesOver ℙ Q
  rw [Algebra.isUnramifiedAt_iff_map_eq R_e ℙ Q]
  refine ⟨?_, ?_⟩
  · haveI : CharZero (Ideal.ResidueField ℙ) := charZero_of_map_ne_zero
      ((algebraMap R_e (Ideal.ResidueField ℙ)).comp (algebraMap O R_e)) hϖ (by
        rw [RingHom.comp_apply, Ne, Ideal.algebraMap_residueField_eq_zero,
          IsScalarTower.algebraMap_apply O (KPoly O e) R_e]
        exact C_notMem_span_t' hϖ.ne_zero)
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  · rw [Ideal.map_span, Set.image_singleton, hmaxQ,
      IsScalarTower.algebraMap_apply R_e 𝔹₁ (Localization.AtPrime Q)]

end Abhyankar

section Purity

variable (L : Type u) [Field L]
  [Algebra (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L]
  [FiniteDimensional (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L] (L₁ : Type u)
  [Field L₁] [Algebra (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L₁]
  [Algebra (RatFunc (FractionRing O)) L₁] [Algebra L L₁]
  [@IsScalarTower (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯
    (RatFunc (FractionRing O)) L₁ _ _ Algebra.toSMul]
  [@IsScalarTower (FractionRing O)⟮(RatFunc.X : RatFunc (FractionRing O)) ^ e⟯ L L₁ _ _
    Algebra.toSMul]
  [Algebra (Localization.AtPrime (KPoly.ideal O e)) L₁]
  [IsScalarTower (Localization.AtPrime (KPoly.ideal O e)) (RatFunc (FractionRing O)) L₁]
  [FiniteDimensional (RatFunc (FractionRing O)) L₁]
  [Algebra.IsSeparable (RatFunc (FractionRing O)) L₁]

set_option synthInstance.maxHeartbeats 200000 in
-- Instance search through the intermediate field `K(T ^ e) ⊆ K(T)` is slow.
/-- **Purity on the Kummer cover of the cusp** (the hypothesis `hEt` of the generic "S4-local").
Let `L / K(T ^ e)` be Galois of degree dividing `e` whose normalisation `B` over `R` is unramified
at all primes over primes of `R` other than the cusp point and the horizontal divisor `(t)`, and
let `L₁` be a field generated by `L` and `K(T)`. Then the normalisation of `R_e` in `L₁` is étale
over `R_e`. -/
theorem etale_integralClosure [IsGalois 𝕂 L] [CharZero O] {ϖ : O} (hϖ : Irreducible ϖ)
    (hd : finrank 𝕂 L ∣ e) [Algebra R L] [IsScalarTower R 𝕂 L]
    (B : Type u) [CommRing B] [Algebra R B] [Algebra B L] [IsScalarTower R B L]
    [IsIntegralClosure B R L]
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap R B) ≠ maximalIdeal R →
      Q.comap (algebraMap R B) ≠ Ideal.span {algebraMap O[X] R X} → Algebra.IsUnramifiedAt R Q)
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom 𝕂 L L₁) (IsScalarTower.toAlgHom 𝕂 (RatFunc 𝔎) L₁))) :
    Algebra.Etale R_e (integralClosure R_e L₁) := by
  letI := locAdjoinPowAlgebra O e
  haveI := isFractionRing_loc_adjoinPow O e
  letI := locRatFuncAlgebra' O e
  haveI := isScalarTower_loc_adjoinPow_ratFunc O e
  haveI : IsFractionRing R_e (RatFunc 𝔎) := isFractionRing_locE O e
  haveI : IsScalarTower R R_e (RatFunc 𝔎) := isScalarTower_loc O e
  haveI : IsNoetherianRing R_e := isNoetherianRing_locE O e
  haveI : IsIntegrallyClosed R_e := isIntegrallyClosed_locE O e
  haveI : IsNoetherianRing R := isNoetherianRing_loc O
  haveI : IsIntegrallyClosed R := isIntegrallyClosed_loc O
  haveI := localKummer_finite O e
  have hx := prime_t' O e
  have hy := C_notMem_span_t' (e := e) hϖ.ne_zero
  have hm := maximalIdeal_locE_eq_span (e := e) hϖ
  refine Purity.etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair (RatFunc 𝔎) L₁
    hx hy hm fun P _ hP ↦ ?_
  refine Purity.formallyUnramified_fiber_of_isUnramifiedAt P fun Q _ hQ ↦ ?_
  by_cases hPt : P = Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}
  · subst hPt
    exact isUnramifiedAt_t' L L₁ hϖ hd hgen Q
  have hPm : P ≠ maximalIdeal R_e := by
    rintro rfl
    have := (Purity.two_le_height_maximalIdeal hx hy hm).trans hP
    norm_num at this
  have hpm : (P.comap (algebraMap R R_e)) ≠ maximalIdeal R := by
    intro h
    haveI : (P.comap (algebraMap R R_e)).IsMaximal := h ▸ maximalIdeal.isMaximal R
    exact hPm (IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_of_isIntegral_of_isMaximal_comap P this))
  have hp := height_le_one_of_ne_maximalIdeal hϖ (P.comap (algebraMap R R_e)) hpm
  have hpt : ¬ Ideal.span {algebraMap O[X] R X} ≤ (P.comap (algebraMap R R_e)) := by
    intro hle
    apply hPt
    have ht : algebraMap (KPoly O e) R_e KPoly.Y ∈ P := by
      have h1 : algebraMap R R_e (algebraMap O[X] R X) ∈ P :=
        hle (Ideal.mem_span_singleton_self _)
      rw [localKummer_algebraMap, ← KPoly.Y_pow, map_pow] at h1
      exact ‹P.IsPrime›.mem_of_pow_mem _ h1
    have hle' : Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y} ≤ P :=
      (Ideal.span_singleton_le_iff_mem _).mpr ht
    by_contra hne
    have hlt := lt_of_le_of_ne hle' (Ne.symm hne)
    haveI : (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).IsPrime :=
      (Ideal.span_singleton_prime hx.ne_zero).mpr hx
    have h0 : (⊥ : Ideal R_e) < Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y} := by
      rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
      exact hx.ne_zero
    have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
    have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    have : (1 : ℕ∞) ≤ (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).height :=
      le_trans (by simp) e0
    have : (2 : ℕ∞) ≤ 1 := by
      calc (2 : ℕ∞) = 1 + 1 := by norm_num
        _ ≤ (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).height + 1 := by gcongr
        _ ≤ P.height := e1
        _ ≤ 1 := hP
    norm_num at this
  refine NodeCover.isUnramifiedAt_of_baseChange (A := R) (A' := R_e) (K := 𝕂) (K' := RatFunc 𝔎)
    (L := L) (B := B) (L₁ := L₁) (B₁ := integralClosure R_e L₁) (P.comap (algebraMap R R_e))
    hgen hp
    (fun Q' _ hQ' ↦ hunr Q' ?_ ?_) Q ?_
  · intro h
    rw [h] at hQ'
    exact hpm (le_antisymm (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) hQ')
  · intro h
    rw [h] at hQ'
    exact hpt hQ'
  · exact congrArg (Ideal.comap (algebraMap R R_e)) hQ.over.symm

end Purity

end Setting

end SemistableReduction.Cusp
