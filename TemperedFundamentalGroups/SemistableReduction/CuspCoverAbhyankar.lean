/-! ### `R_e` is a regular local ring with the parameters `t', ϖ` -/

omit [NeZero e] in
variable (O e) in
theorem isNoetherianRing_locE : IsNoetherianRing R_e := isNoetherianRing_loc O

omit [NeZero e] in
variable (O e) in
theorem isIntegrallyClosed_locE : IsIntegrallyClosed R_e := isIntegrallyClosed_loc O

omit [NeZero e] in
variable (O e) in
theorem prime_t' : Prime (algebraMap (KPoly O e) R_e KPoly.Y) := prime_t O

omit [NeZero e] in
theorem C_notMem_span_t' {ϖ : O} (hϖ : ϖ ≠ 0) :
    algebraMap (KPoly O e) R_e (C ϖ : O[X]) ∉
      Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y} :=
  C_notMem_span_t hϖ

omit [NeZero e] in
theorem maximalIdeal_locE_eq_span {ϖ : O} (hϖ : Irreducible ϖ) :
    maximalIdeal R_e = Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y,
      algebraMap (KPoly O e) R_e (C ϖ : O[X])} :=
  maximalIdeal_loc_eq_span hϖ

omit [NeZero e] in
/-- A prime of `R` other than the closed point containing `t` is `(t)`. -/
theorem eq_span_t_of_le {ϖ : O} (hϖ : Irreducible ϖ) (𝔭 : Ideal R) [𝔭.IsPrime]
    (hle : Ideal.span {algebraMap O[X] R X} ≤ 𝔭) (hm : 𝔭 ≠ maximalIdeal R) :
    𝔭 = Ideal.span {algebraMap O[X] R X} := by
  haveI := isNoetherianRing_loc O
  have h1 := height_le_one_of_ne_maximalIdeal hϖ 𝔭 hm
  by_contra hne
  have hlt : Ideal.span {algebraMap O[X] R X} < 𝔭 := lt_of_le_of_ne hle (Ne.symm hne)
  haveI : (Ideal.span {algebraMap O[X] R X}).IsPrime :=
    (Ideal.span_singleton_prime (prime_t O).ne_zero).mpr (prime_t O)
  have h0 : (⊥ : Ideal R) < Ideal.span {algebraMap O[X] R X} := by
    rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
    exact (prime_t O).ne_zero
  have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
  have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have : (1 : ℕ∞) ≤ (Ideal.span {algebraMap O[X] R X}).height := le_trans (by simp) e0
  have : (2 : ℕ∞) ≤ 1 := by
    calc (2 : ℕ∞) = 1 + 1 := by norm_num
      _ ≤ (Ideal.span {algebraMap O[X] R X}).height + 1 := by gcongr
      _ ≤ 𝔭.height := e1
      _ ≤ 1 := h1
  norm_num at this

/-- The horizontal divisor `(t')` of `R_e` lies over the horizontal divisor `(t)` of `R`. -/
theorem comap_span_t' {ϖ : O} (hϖ : Irreducible ϖ) :
    (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).comap (algebraMap R R_e) =
      Ideal.span {algebraMap O[X] R X} := by
  haveI := localKummer_finite O e
  have hP := prime_t' O e
  haveI : (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).IsPrime :=
    (Ideal.span_singleton_prime hP.ne_zero).mpr hP
  refine eq_span_t_of_le hϖ _ ?_ fun h ↦ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
      localKummer_algebraMap, ← KPoly.Y_pow, map_pow]
    exact Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) _ (Nat.pos_of_neZero e)
  · haveI : ((Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).comap
        (algebraMap R R_e)).IsMaximal := h ▸ maximalIdeal.isMaximal R
    have hPmax : (Ideal.span {algebraMap (KPoly O e) R_e KPoly.Y}).IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ this
    apply C_notMem_span_t' (e := e) hϖ.ne_zero
    rw [IsLocalRing.eq_maximalIdeal hPmax, maximalIdeal_locE_eq_span hϖ]
    exact Ideal.subset_span (by simp)

