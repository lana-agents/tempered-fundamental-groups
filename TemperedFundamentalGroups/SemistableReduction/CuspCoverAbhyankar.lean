import TemperedFundamentalGroups.SemistableReduction.CuspCoverBase
import TemperedFundamentalGroups.SemistableReduction.TameChart

/-!
# Purity and Abhyankar's lemma on the Kummer cover of the cusp (MR12 T2 S3)

Let `O` be a discrete valuation ring of characteristic zero (`CharZero O`, i.e. `char K = 0`
for `K = Frac O`; the residue characteristic is arbitrary) with uniformizer `ϖ`,
`R = O[t]_{(ϖ, t)}` the local ring of the cusp chart at the cusp point, `R_e = O[t']_{(ϖ, t')}`
with the Kummer map `t ↦ t' ^ e`, and `K(T ^ e) ⊆ K(T)` their fraction fields
(`CuspCoverBase`). Let `L / K(T ^ e)` be finite Galois of degree dividing `e`, whose
normalisation `B` over `R` is unramified at every prime over a prime of `R` other than the
cusp point `𝔪` and the horizontal divisor `(t)`.

**`Cusp.etale_integralClosure`**: for every field `L₁` generated by `L` and `K(T)` (a factor
of `L ⊗ K(T)`), the normalisation of `R_e` in `L₁` is étale over `R_e`. This is the hypothesis
`hEt` of the generic "S4-local" `NodeCover.exists_etale_tensor_algEquiv_pi_of_etale`. Proof:
purity on the regular local ring `R_e` (`𝔪 = (t', ϖ)`,
`Purity.etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair`) reduces to the
height-one primes `P` of `R_e`:

* `P ≠ (t')`: `P` lies over a prime of `R` of height `≤ 1` all of whose generizations are
  neither `𝔪` nor `(t)`, so normalised base change (`NodeCover.isUnramifiedAt_of_baseChange`)
  applies;
* `P = (t')` (`Cusp.isUnramifiedAt_t'`): Abhyankar's lemma
  (`Abhyankar.maximalIdeal_atPrime_eq_span`) over the discrete valuation ring `D = R_(t)` with
  uniformizer `t` (residue field `K`, of characteristic zero, so `L` is tame at `(t)`,
  `Abhyankar.tame_of_isGalois`, with ramification indices dividing `[L : K(T ^ e)] ∣ e`), applied
  to the localization `B' = B₁[(R ∖ (t))⁻¹]` of the normalisation `B₁` of `R_e` in `L₁`, which is
  the integral closure of `D` in `L₁`; the conclusion `𝔔 B'_𝔔 = (t')` is transported to `B₁_Q`
  (`Cusp.maximalIdeal_eq_span_of_localization`), and the residue field extension is separable
  since `κ(P) ⊇ K` has characteristic zero (`Cusp.charZero_of_map_ne_zero`).

The characteristic-zero hypothesis is used only for the tameness and separability at the
horizontal divisor `(t)` (whose residue field is `K`).
-/

open Polynomial IsLocalRing IntermediateField Module TensorProduct

universe u

namespace SemistableReduction.Cusp

section Generic

/-- A domain receiving a map from a discrete valuation ring of characteristic zero that does not
kill the uniformizer has characteristic zero. -/
theorem charZero_of_map_ne_zero {O k : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [CharZero O] [CommRing k] [IsDomain k] (f : O →+* k) {ϖ : O} (hϖ : Irreducible ϖ)
    (hf : f ϖ ≠ 0) : CharZero k := by
  refine charZero_of_inj_zero fun n hn ↦ ?_
  by_contra h0
  have hn0 : (n : O) ≠ 0 := Nat.cast_ne_zero.mpr h0
  obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hn0 hϖ
  have h : f (n : O) = 0 := by rw [map_natCast]; exact hn
  rw [hu, map_mul, map_pow] at h
  exact mul_ne_zero (u.isUnit.map f).ne_zero (pow_ne_zero _ hf) h

/-- If `Q` is a prime of `A` disjoint from a submonoid `M`, then `A_Q ≅ (M⁻¹ A)_{Q M⁻¹ A}`; hence
an element generating the maximal ideal of the latter generates that of the former. -/
theorem maximalIdeal_eq_span_of_localization {A : Type*} [CommRing A] (M : Submonoid A)
    (Q : Ideal A) [Q.IsPrime] (hM : Disjoint (M : Set A) Q) (y : A)
    [(Q.map (algebraMap A (Localization M))).IsPrime]
    (h : maximalIdeal (Localization.AtPrime (Q.map (algebraMap A (Localization M)))) =
      Ideal.span {algebraMap (Localization M) _ (algebraMap A (Localization M) y)}) :
    maximalIdeal (Localization.AtPrime Q) = Ideal.span {algebraMap A _ y} := by
  set Q' := Q.map (algebraMap A (Localization M))
  have hQ' : Q'.comap (algebraMap A (Localization M)) = Q :=
    IsLocalization.under_map_of_isPrime_disjoint M _ ‹_› hM
  have key : ∀ (I : Ideal A) [I.IsPrime], I = Q'.comap (algebraMap A (Localization M)) →
      IsLocalization.AtPrime (Localization.AtPrime Q') I := by
    rintro I _ rfl
    infer_instance
  haveI := key Q hQ'.symm
  let φ : Localization.AtPrime Q ≃ₐ[A] Localization.AtPrime Q' :=
    IsLocalization.algEquiv Q.primeCompl _ _
  have hφy : φ (algebraMap A _ y) =
      algebraMap (Localization M) _ (algebraMap A (Localization M) y) := by
    rw [AlgEquiv.commutes, IsScalarTower.algebraMap_apply A (Localization M)]
  have hmax : maximalIdeal (Localization.AtPrime Q) = (maximalIdeal _).comap φ := by
    haveI : ((maximalIdeal (Localization.AtPrime Q')).comap φ).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ φ.surjective
    exact (IsLocalRing.eq_maximalIdeal this).symm
  rw [hmax, h, ← hφy]
  ext x
  rw [Ideal.mem_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  exact map_dvd_iff φ

/-- A field `L₁` generated by `L` and `K_1 = K_M[X]` is generated over `L` by `X`. -/
theorem adjoin_eq_top_of_surjective {K_M K_1 L L₁ : Type*} [Field K_M] [Field K_1] [Field L]
    [Field L₁] [Algebra K_M K_1] [Algebra K_M L] [Algebra K_M L₁] [Algebra K_1 L₁] [Algebra L L₁]
    [IsScalarTower K_M K_1 L₁] [IsScalarTower K_M L L₁] {X : K_1}
    (hX : Algebra.adjoin K_M {X} = ⊤)
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K_M L L₁) (IsScalarTower.toAlgHom K_M K_1 L₁))) :
    Algebra.adjoin L {algebraMap K_1 L₁ X} = ⊤ := by
  rw [eq_top_iff]
  rintro z -
  obtain ⟨w, rfl⟩ := hgen z
  induction w using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul l k =>
    rw [Algebra.TensorProduct.productMap_apply_tmul, IsScalarTower.coe_toAlgHom',
      IsScalarTower.coe_toAlgHom']
    refine mul_mem (Subalgebra.algebraMap_mem _ l) ?_
    have hk : k ∈ Algebra.adjoin K_M {X} := by rw [hX]; exact Algebra.mem_top
    induction hk using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff.mp hx]
      exact Algebra.subset_adjoin rfl
    | algebraMap r =>
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply K_M L L₁]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  | add a b ha hb => rw [map_add]; exact add_mem ha hb

/-- `K_1 = K_M⟮X⟯` finite over `K_M` is `K_M[X]`. -/
theorem algebra_adjoin_eq_top {K_M K_1 : Type*} [Field K_M] [Field K_1] [Algebra K_M K_1]
    [FiniteDimensional K_M K_1] {X : K_1} (hX : K_M⟮X⟯ = ⊤) : Algebra.adjoin K_M {X} = ⊤ := by
  have hXalg : IsIntegral K_M X := .of_finite K_M X
  rw [← adjoin_simple_toSubalgebra_of_isAlgebraic hXalg.isAlgebraic, hX, top_toSubalgebra]

end Generic

