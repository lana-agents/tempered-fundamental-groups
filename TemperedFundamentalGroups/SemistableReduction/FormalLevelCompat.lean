import TemperedFundamentalGroups.SemistableReduction.FormalLevelAssemble
import TemperedFundamentalGroups.SemistableReduction.KummerUnfold
import TemperedFundamentalGroups.SemistableReduction.CompletionProdLevel

/-!
# Reduction of the level formal Kummer forms (MR12 T2 S6, step G2, compatibility)

The reduction `AdmissibleLift.pieceEquiv : N/K ≃ KummerPiece` of a lifted Kummer factor
`N = (R̂/(1 − ε̃)) ⊗_{O[u,v]/(uv − π^e)} O[s,t]/(st − π)` of the M2 lift, composed with a tensor map
`g ⊗ id : N' ⊗ O[s,t]/(st − π) → N`, is the reduction map `FormalLevel.redTensorMap` of `σ ∘ g`
(**`AdmissibleLift.pieceEquiv_mk_map`**). Applied to the level formal Kummer forms
(`FormalLevel.levelEquiv`, base changes of the chosen splittings `Φ`), this reduces the comparison
of the level-`n` forms with the formal Kummer form of the special fibre (the `kummer` field of the
covering, `FormalKummer.kummerEquivOf`) to the equality of maps `N₁ → R̂'` out of the étale
neighbourhoods, which holds by `FormalLevel.hatLift_unique`.
-/

universe u

open TensorProduct

namespace SemistableReduction

namespace FormalLevel

noncomputable section

section Res

variable {R : Type u} [CommRing R] {N₁ : Type u} [CommRing N₁] [Algebra R N₁]
  {R' : Type u} [CommRing R'] [Algebra R R'] {𝔪 : Ideal R'}

lemma resHat_mk (x : AdicCompletion 𝔪 R') :
    resHat 𝔪 x = Ideal.Quotient.factor (pow_one 𝔪).le (AdicCompletion.evalₐ 𝔪 1 x) := rfl

/-- **Residues commute with maps of completions.** -/
lemma resHat_map {S : Type u} [CommRing S] (g : R' →+* S) {𝔪S : Ideal S}
    (h : 𝔪.map g ≤ 𝔪S) (x : AdicCompletion 𝔪 R') :
    resHat 𝔪S (CompletionMap.map g h x) =
      Ideal.quotientMap 𝔪S g (Ideal.map_le_iff_le_comap.mp h) (resHat 𝔪 x) := by
  rw [resHat_mk, resHat_mk, CompletionMap.evalₐ_map]
  obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ 𝔪 1 x)
  rw [← hw]
  rfl

variable [Algebra.FormallyEtale R N₁]

/-- **Two maps `N₁ → R̂'` killing the residue of `𝔫` agree** (`N₁/𝔫` generated by `R`). -/
theorem hatHom_ext {𝔫 : Ideal N₁}
    (hsurj : Function.Surjective ((Ideal.Quotient.mk 𝔫).comp (algebraMap R N₁)))
    (g₁ g₂ : N₁ →ₐ[R] AdicCompletion 𝔪 R')
    (h₁ : ∀ z ∈ 𝔫, resHat 𝔪 (g₁ z) = 0) (h₂ : ∀ z ∈ 𝔫, resHat 𝔪 (g₂ z) = 0) : g₁ = g₂ := by
  set r : N₁ →ₐ[R] R' ⧸ 𝔪 := ((resHat 𝔪).restrictScalars R).comp g₁
  have hr : ∀ z, resHat 𝔪 (g₂ z) = r z := fun z ↦ by
    obtain ⟨a, ha⟩ := hsurj (Ideal.Quotient.mk 𝔫 z)
    have hz : z - algebraMap R N₁ a ∈ 𝔫 := by
      rw [← Ideal.Quotient.eq]
      exact ha.symm
    have e₁ := h₁ _ hz
    have e₂ := h₂ _ hz
    rw [map_sub, map_sub, sub_eq_zero] at e₁ e₂
    rw [e₂, AlgHom.commutes]
    change _ = resHat 𝔪 (g₁ z)
    rw [e₁, AlgHom.commutes]
  rw [hatLift_unique r g₁ (fun _ ↦ rfl), hatLift_unique r g₂ hr]

end Res

end

end FormalLevel

namespace FormalLevel

noncomputable section

open KummerEtale FormalKummer

attribute [local instance] KummerNormAtData.algO

variable {O : Type u} [CommRing O] {R : Type u} [CommRing R] [Algebra O R]
  {B : Type u} [CommRing B] [Algebra R B] {ϖ : O} {n M' : ℕ} {x y : R}
  (hxy : x * y = algebraMap O R (ϖ ^ n))
  {R' : Type u} [CommRing R'] [Algebra R R'] [Algebra O R'] [IsScalarTower O R R']
  [IsNoetherianRing R'] {f : R'} {ι : Type} [Fintype ι] [DecidableEq ι] {𝔪' : ι → Ideal R'}
  [∀ j, (𝔪' j).IsMaximal] (hinj : Function.Injective 𝔪') (hf : ∀ j, f ∈ 𝔪' j)
  (hrad : ⨅ j, 𝔪' j ≤ (Ideal.span {f}).radical)
  {𝔪 : ι → Ideal R} (D : ∀ j, KummerNormAtData ϖ n M' x y B (𝔪 j))
  (r : ∀ j, (D j).N₁ →ₐ[R] R' ⧸ 𝔪' j)
  (χ : ∀ p : (Σ j, Fin (D j).r),
    A (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2) →ₐ[O] FormalPatchLevel.Hat f)
  (hχ : ∀ p a, χ p a = algebraMap R (FormalPatchLevel.Hat f) (chart hxy (D p.1) p.2 a))
  (ε : ι → FormalPatchLevel.Hat f) (hε : ∀ j, ε j = CompletionProd.idem hinj hf hrad j)

/-- The map `N₁ → R̂'/(1 − εⱼ)` of the factor `p = (j, i)` of `levelEquiv`. -/
def levelHom (p : Σ j, Fin (D j).r) :
    letI := nodeAlgebra (D p.1).N₁ (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2)
      (huv_i (D p.1).huv (D p.1).hmd p.2)
    (D p.1).N₁ →ₐ[A (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2)]
      AdmissibleLift.LPiece f (χ p) (ε p.1) :=
  letI := fun i ↦ nodeAlgebra (D p.1).N₁ (ϖ ^ (D p.1).m i) ((D p.1).d i)
    (huv_i (D p.1).huv (D p.1).hmd i)
  letI := fun i ↦ hatAlg (𝔪' := 𝔪' p.1) hxy (D p.1) i
  (pieceIso hxy hinj hf hrad D χ hχ ε hε p).toAlgHom.comp
    (homA (hatLift (r p.1)) (fun i ↦ (chart hxy (D p.1) i).toRingHom)
      (fun i a ↦ algebraMap_N₁ hxy (D p.1) i a) (fun _ _ ↦ rfl) p.2)

omit [IsScalarTower O R R'] in
/-- **`levelEquiv` on `1 ⊗ b`**: the image of the splitting `Φ (1 ⊗ b)` under `levelHom ⊗ id`. -/
theorem levelEquiv_one_tmul (b : B) (p : Σ j, Fin (D j).r) :
    letI := nodeAlgebra (D p.1).N₁ (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2)
      (huv_i (D p.1).huv (D p.1).hmd p.2)
    levelEquiv hxy hinj hf hrad D r χ hχ ε hε ((1 : FormalPatchLevel.Hat f) ⊗ₜ b) p =
      Algebra.TensorProduct.map (levelHom hxy hinj hf hrad D r χ hχ ε hε p)
        (knodeEquiv (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2)).toAlgHom
        ((D p.1).Φ ((1 : (D p.1).N₁) ⊗ₜ b) p.2) := by
  obtain ⟨j, i⟩ := p
  letI := fun i ↦ hatAlg (𝔪' := 𝔪' j) hxy (D j) i
  letI := fun i ↦ nodeAlgebra (D j).N₁ (ϖ ^ (D j).m i) ((D j).d i)
    (huv_i (D j).huv (D j).hmd i)
  have h1 : hatEquivR (R := R) hinj hf hrad (1 : FormalPatchLevel.Hat f) j = 1 := by
    rw [map_one]; rfl
  change (Algebra.TensorProduct.congr (pieceIso hxy hinj hf hrad D χ hχ ε hε ⟨j, i⟩)
      (knodeEquiv _ _)) ((nodeEquiv hxy (D j) (r j))
        (hatEquivR (R := R) hinj hf hrad 1 j ⊗ₜ (b : B)) i) = _
  rw [h1, nodeEquiv, baseChangeEquiv_one_tmul, Algebra.TensorProduct.congr_apply,
    ← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id]
  rfl

end

end FormalLevel

namespace FormalLevel

noncomputable section

open KummerEtale FormalKummer AdmissibleLift

attribute [local instance] KummerNormAtData.algO algRN

variable {O : Type u} [CommRing O] {k : Type u} [Field k] {θ : O →+* k}
  [hθ : Fact (Function.Surjective θ)] {R : Type u} [CommRing R] [Algebra O R]
  {B : Type u} [CommRing B] [Algebra R B] [IsSepClosed k] [IsNoetherianRing R]
  {ϖ : O} {n M' : ℕ} {x y : R}
  (hxy : x * y = algebraMap O R (ϖ ^ n)) (hϖ : θ ϖ = 0) (hn0 : 0 < n)
  {ι : Type} [Fintype ι] [DecidableEq ι] (𝔪 : ι → Ideal R) [∀ j, (𝔪 j).IsMaximal]
  (hJ : ∀ j, J θ (R := R) ≤ 𝔪 j)
  (hres : ∀ j, Function.Surjective ((Ideal.Quotient.mk (𝔪 j)).comp (algebraMap O R)))
  (D : ∀ j, KummerNormAtData ϖ n M' x y B (𝔪 j)) {fk : Rs θ R}
  (hinjk : Function.Injective fun j ↦ sIdeal (θ := θ) (𝔪 j))
  (hfk : ∀ j, fk ∈ sIdeal (θ := θ) (𝔪 j))
  (hradk : ⨅ j, sIdeal (θ := θ) (𝔪 j) ≤ (Ideal.span {fk}).radical)
  (φ : Node k (0 : k) →ₐ[k] Admissible.Hat fk)
  (hφu : φ (Node.u _) = algebraMap (Rs θ R) _ (Ideal.Quotient.mk _ x))
  (hφv : φ (Node.v _) = algebraMap (Rs θ R) _ (Ideal.Quotient.mk _ y))
  {R' : Type u} [CommRing R'] [Algebra R R'] [Algebra O R'] [IsScalarTower O R R']
  [IsNoetherianRing R'] [Algebra k (R' ⧸ J θ (R := R'))]
  (e : Rs θ R ≃ₐ[k] R' ⧸ J θ (R := R'))
  (he : ∀ r : R, e (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (algebraMap R R' r))
  {f : R'} (hfe : e fk = fbar θ f)
  {𝔪' : ι → Ideal R'} [∀ j, (𝔪' j).IsMaximal] (hinj : Function.Injective 𝔪')
  (hf : ∀ j, f ∈ 𝔪' j) (hrad : ⨅ j, 𝔪' j ≤ (Ideal.span {f}).radical)
  (hm : ∀ j, (𝔪' j).map (red θ e) ≤ sIdeal (θ := θ) (𝔪 j))
  [∀ j, (sIdeal (θ := θ) (𝔪 j)).IsMaximal]

omit [IsSepClosed k] [IsNoetherianRing R] [IsScalarTower O R R'] [IsNoetherianRing R'] in
include he in
lemma red_algebraMap (r : R) : red θ e (algebraMap R R' r) = Ideal.Quotient.mk _ r := by
  change e.symm (Ideal.Quotient.mk _ (algebraMap R R' r)) = _
  rw [← he, AlgEquiv.symm_apply_apply]

/-- The reduction `R̂'_{𝔪' j} → R̄^_{𝔪 j}` of the node completions, as an `R`-algebra map. -/
def redHat (j : ι) : AdicCompletion (𝔪' j) R' →ₐ[R] Tn θ (𝔪 j) :=
  { CompletionMap.map (red θ e) (hm j) with
    commutes' := fun r ↦ by
      change CompletionMap.map (red θ e) (hm j) (algebraMap R' _ (algebraMap R R' r)) = _
      rw [CompletionMap.map_algebraMap, red_algebraMap e he]
      rfl }

variable (χ : ∀ p : (Σ j, Fin (D j).r),
    A (ϖ ^ (D p.1).m p.2) ((D p.1).d p.2) →ₐ[O] FormalPatchLevel.Hat f)
  (hχ : ∀ p a, χ p a = algebraMap R (FormalPatchLevel.Hat f) (chart hxy (D p.1) p.2 a))
  (ε : ι → FormalPatchLevel.Hat f) (hε : ∀ j, ε j = CompletionProd.idem hinj hf hrad j)

omit [IsSepClosed k] [∀ j, (𝔪 j).IsMaximal] [IsScalarTower O R R'] in
include hm he in
/-- **The reduction of the level pieces**: `R̂'_{𝔪' j} ≅ R̂'/(1 − εⱼ) → (R̂'/J)/(1 − Ê εⱼ) ≅
R̂/(1 − εⱼ) ≅ R̄^_{𝔪 j}` is the map of completions `redHat`. -/
theorem quotEquiv_σ_pieceIso (p : Σ j, Fin (D j).r)
    (hεψ : ψ θ f (ε p.1) = Admissible.hatEquiv e hfe (CompletionProd.idem hinjk hfk hradk p.1))
    (t : AdicCompletion (𝔪' p.1) R') :
    letI := hatAlg (𝔪' := 𝔪' p.1) hxy (D p.1) p.2
    CompletionProd.quotEquiv hinjk hfk hradk p.1
      ((Admissible.baseEquiv (h := hfe) (CompletionProd.idem hinjk hfk hradk p.1)).symm
        (σ θ f (Admissible.φT (h := hfe) φ) ((D p.1).hd p.2) (χ p) (ε p.1)
          (Admissible.hatEquiv e hfe (CompletionProd.idem hinjk hfk hradk p.1)) hεψ
          (pieceIso hxy hinj hf hrad D χ hχ ε hε p t))) =
      redHat 𝔪 e he hm p.1 t := by
  letI := hatAlg (𝔪' := 𝔪' p.1) hxy (D p.1) p.2
  obtain ⟨z, rfl⟩ := (CompletionProd.quotEquiv hinj hf hrad p.1).surjective t
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  have h1 : pieceIso hxy hinj hf hrad D χ hχ ε hε p
      (CompletionProd.quotEquiv hinj hf hrad p.1 (Ideal.Quotient.mk _ w)) =
      Ideal.Quotient.mk _ w := by
    rw [pieceIso, AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply,
      RingEquiv.symm_apply_apply]
    exact Ideal.quotEquivOfEq_mk _ w
  rw [h1, σ_mk]
  change CompletionProd.quotEquiv hinjk hfk hradk p.1
      ((Ideal.quotientEquiv _ _ (Admissible.hatEquiv e hfe).toRingEquiv _).symm
        (Ideal.Quotient.mk _ (ψ θ f w))) = _
  rw [Ideal.quotientEquiv_symm_mk, CompletionProd.quotEquiv_mk, CompletionProd.quotEquiv_mk]
  change _ = CompletionMap.map (red θ e) (hm p.1) _
  rw [AlgEquiv.toRingEquiv_symm, AlgEquiv.coe_ringEquiv, Admissible.hatEquiv_symm,
    Admissible.hatEquiv_apply, CompletionQuot.ψ_eq_map, CompletionMap.map_comp,
    CompletionMap.map_comp, CompletionMap.map_comp]
  exact CompletionMap.map_congr (by ext; rfl) _ _ _

end

end FormalLevel

namespace AdmissibleLift

noncomputable section

open KummerEtale

variable {O : Type u} [CommRing O] {k : Type u} [Field k] {θ : O →+* k}
  {R : Type u} [CommRing R] [Algebra O R] (f : R) [Algebra k (R ⧸ J θ)]
  (φ : Node k (0 : k) →ₐ[k] Admissible.Hat (fbar θ f)) {π : O} {e : ℕ} (he : 0 < e)
  (χ : A π e →ₐ[O] FormalPatchLevel.Hat f) (ε : FormalPatchLevel.Hat f)
  (εb : Admissible.Hat (fbar θ f)) (hε : ψ θ f ε = εb)
  (hθ : Function.Surjective θ) (hπ : θ π = 0)
  (hχ : ∀ a, ψ θ f (χ a) = φ (Admissible.nodeCongr he (Node.baseMap θ (hA hπ) a)))

include hχ in
lemma σ_algebraMap_A (a : A π e) :
    σ θ f φ he χ ε εb hε (algebraMap (A π e) (LPiece f χ ε) a) =
      algebraMap (A (0 : k) e) (Admissible.PieceBase φ εb he)
        (Node.baseMap θ (FormalKummer.θ_pow (d := e) hπ) a) := by
  rw [LPiece.algebraMap_A, σ_mk, hχ]
  rfl

/-- **The reduction of a tensor map into a lifted Kummer factor**: for an
`O[u,v]/(uv − π^e)`-algebra
map `g : N' → R̂/(1 − ε̃)`, `pieceEquiv ∘ (g ⊗ id)` is the reduction map of `σ ∘ g`. -/
theorem pieceEquiv_mk_map [IsNoetherianRing R] {N' : Type u} [CommRing N']
    [Algebra (A π e) N'] (g : N' →ₐ[A π e] LPiece f χ ε) (z : N' ⊗[A π e] KNode π e) :
    pieceEquiv f φ he χ ε εb hε hθ hπ hχ (Ideal.Quotient.mk _
      (Algebra.TensorProduct.map g (FormalLevel.knodeEquiv π e).toAlgHom z)) =
      FormalLevel.redTensorMap θ hπ ((σ θ f φ he χ ε εb hε).comp g.toRingHom) (fun a ↦ by
        rw [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]
        exact σ_algebraMap_A f φ he χ ε εb hε hπ hχ a) z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul x b =>
    rw [Algebra.TensorProduct.map_tmul, pieceEquiv_mk_tmul, FormalLevel.redTensorMap_tmul]
    rfl
  | add z w hz hw => rw [map_add, map_add, map_add, hz, hw, map_add]

end

end AdmissibleLift

end SemistableReduction
