import TemperedFundamentalGroups.SemistableReduction.CuspCoverAbhyankar
import TemperedFundamentalGroups.SemistableReduction.NodeCoverEtaleNbhdBase

/-!
# Purity and Abhyankar's lemma along a horizontal divisor, generic form

The generic form of `Cusp.isUnramifiedAt_t'` and `Cusp.etale_integralClosure`
(`CuspCoverAbhyankar`), for an integral extension `A ⊆ A'` of Noetherian integrally closed local
domains with `m_{A'} = (x, y)`, `x` prime, `y ∉ (x)`, and a prime `t ∈ A` with `t = x ^ e` in
`A'`, such that the residue field of `(t)` has characteristic zero (`(n : A) ∉ (t)` for `n ≠ 0`)
and `Frac A' = Frac A (x)`:

* `Cusp.comap_span_eq_of_pow`: `(x) ∩ A = (t)`;
* `Cusp.isUnramifiedAt_of_pow` (Abhyankar's lemma at `(x)`): for `L / Frac A` Galois of degree
  dividing `e` and `L₁` a field generated by `L` and `Frac A'`, the normalisation of `A'` in `L₁`
  is unramified at every prime over `(x)`;
* `Cusp.etale_integralClosure_of_pow` (purity, Abhyankar and base change): if moreover the
  normalisation of `A` in `L` is unramified at every prime over a prime of `A` other than the
  maximal ideal and `(t)`, the normalisation of `A'` in `L₁` is étale over `A'`.

For the cusp chart (`A = O[t]_{(ϖ, t)}`, `A' = O[t']_{(ϖ, t')}`, `t = t' ^ e`) these are the
statements of `CuspCoverAbhyankar`; they are needed for local rings étale over the cusp chart.
-/

open Polynomial IsLocalRing IntermediateField Module TensorProduct

universe u

namespace SemistableReduction.Cusp

section Comap

variable {A A' : Type u} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
  [CommRing A'] [IsDomain A'] [IsLocalRing A'] [IsNoetherianRing A'] [Algebra A A']
  [Algebra.IsIntegral A A'] [FaithfulSMul A A']

/-- **The divisor `(x)` lies over `(t)`** if `t` is prime in `A` and `t = x ^ e` in `A'`. -/
theorem comap_span_eq_of_pow {e : ℕ} (he : 0 < e) {t : A} (ht : Prime t) {x y : A'}
    (hx : Prime x) (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A' = Ideal.span {x, y})
    (htx : algebraMap A A' t = x ^ e) :
    (Ideal.span {x}).comap (algebraMap A A') = Ideal.span {t} := by
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  haveI : (Ideal.span {t}).IsPrime := (Ideal.span_singleton_prime ht.ne_zero).mpr ht
  have hne : Ideal.span {x} ≠ maximalIdeal A' := fun h ↦ hy (by
    rw [h, hm]; exact Ideal.subset_span (by simp))
  have h1 := NodeCover.EtaleNbhd.height_comap_le_one (R := A) hm (Ideal.span {x}) hne
  have hle : Ideal.span {t} ≤ (Ideal.span {x}).comap (algebraMap A A') := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, htx]
    exact Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) _ he
  by_contra hne'
  have hlt := lt_of_le_of_ne hle (Ne.symm hne')
  have h0 : (⊥ : Ideal A) < Ideal.span {t} := by
    rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
    exact ht.ne_zero
  have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
  have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have : (1 : ℕ∞) ≤ (Ideal.span {t}).height := le_trans (by simp) e0
  have : (2 : ℕ∞) ≤ 1 := by
    calc (2 : ℕ∞) = 1 + 1 := by norm_num
      _ ≤ (Ideal.span {t}).height + 1 := by gcongr
      _ ≤ _ := e1
      _ ≤ 1 := h1
  norm_num at this

end Comap

/-- If `(n : A) ∉ I` for all `n ≠ 0` and `Q` is a prime of an `A`-algebra `S` contracting into
`I`, then `S ⧸ Q`-algebras such as the residue field of `Q` have characteristic zero. -/
theorem charZero_of_comap_le {A S k : Type*} [CommRing A] [CommRing S] [Algebra A S]
    [CommRing k] (f : S →+* k) {I : Ideal A}
    (hchar : ∀ n : ℕ, n ≠ 0 → (n : A) ∉ I)
    (hle : (RingHom.ker f).comap (algebraMap A S) ≤ I) : CharZero k := by
  refine charZero_of_inj_zero fun n hn ↦ ?_
  by_contra h0
  apply hchar n h0
  apply hle
  rw [Ideal.mem_comap, RingHom.mem_ker, map_natCast, map_natCast]
  exact hn

section Abhyankar

variable {A : Type u} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
  {A' : Type u} [CommRing A'] [IsDomain A'] [IsNoetherianRing A'] [IsIntegrallyClosed A']
  [Algebra A A'] [Algebra.IsIntegral A A']
  (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
  (K' : Type u) [Field K'] [Algebra A' K'] [IsFractionRing A' K'] [Algebra K K'] [Algebra A K']
  [IsScalarTower A K K'] [IsScalarTower A A' K']
  (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
  (L₁ : Type u) [Field L₁] [Algebra K L₁] [Algebra K' L₁] [Algebra L L₁] [IsScalarTower K K' L₁]
  [IsScalarTower K L L₁] [Algebra A' L₁] [IsScalarTower A' K' L₁] [FiniteDimensional K' L₁]
  [Algebra.IsSeparable K' L₁]

local notation "𝔹₁" => integralClosure A' L₁

set_option maxHeartbeats 1000000 in
-- Many localizations and algebra structures.
omit [IsIntegrallyClosed A] in
/-- **Abhyankar's lemma at the divisor `(x)`**, generic form of `Cusp.isUnramifiedAt_t'`. Let
`t ∈ A` be prime with `t = x ^ e` in `A'`, `(x) ∩ A = (t)`, the residue field of `(t)` of
characteristic zero, `Frac A' = Frac A (x)`, `L / Frac A` Galois of degree dividing `e` and `L₁`
a field generated by `L` and `Frac A'`. Then the normalisation of `A'` in `L₁` is unramified over
`A'` at every prime over `(x)`. -/
theorem isUnramifiedAt_of_pow {e : ℕ} [NeZero e] {t : A} (ht : Prime t) {x : A'} (hx : Prime x)
    (htx : algebraMap A A' t = x ^ e)
    (hcomap : (Ideal.span {x}).comap (algebraMap A A') = Ideal.span {t})
    (hchar : ∀ n : ℕ, n ≠ 0 → (n : A) ∉ Ideal.span {t})
    (hX : Algebra.adjoin K {algebraMap A' K' x} = ⊤) (hd : finrank K L ∣ e)
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K L L₁) (IsScalarTower.toAlgHom K K' L₁)))
    (Q : Ideal (integralClosure A' L₁)) [Q.IsPrime]
    [hQP : Q.LiesOver (Ideal.span {x})] :
    Algebra.IsUnramifiedAt A' Q := by
  classical
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  haveI : (Ideal.span {t}).IsPrime := (Ideal.span_singleton_prime ht.ne_zero).mpr ht
  -- `A` acting on `L₁` and `𝔹₁`
  letI : Algebra A L₁ := ((algebraMap K L₁).comp (algebraMap A K)).toAlgebra
  haveI : IsScalarTower A K L₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hAL₁ : ∀ a : A, algebraMap A' L₁ (algebraMap A A' a) = algebraMap A L₁ a := fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A' K' L₁, ← IsScalarTower.algebraMap_apply A A' K',
      IsScalarTower.algebraMap_apply A K K', ← IsScalarTower.algebraMap_apply K K' L₁]
    rfl
  haveI : IsScalarTower A A' L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ (hAL₁ a).symm
  letI : Algebra A 𝔹₁ := ((algebraMap A' 𝔹₁).comp (algebraMap A A')).toAlgebra
  haveI : IsScalarTower A A' 𝔹₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : IsScalarTower A 𝔹₁ L₁ := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change algebraMap A L₁ r = algebraMap 𝔹₁ L₁ (algebraMap A' 𝔹₁ (algebraMap A A' r))
    rw [← IsScalarTower.algebraMap_apply A' 𝔹₁ L₁, ← IsScalarTower.algebraMap_apply]
  have hAinj : Function.Injective (algebraMap A L₁) :=
    (algebraMap K L₁).injective.comp (IsFractionRing.injective A K)
  -- the discrete valuation ring `D = A_(t)`
  set D := Localization.AtPrime (Ideal.span {t})
  set tD := algebraMap A D t
  have hmD : maximalIdeal D = Ideal.span {tD} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton]
  have htD0 : tD ≠ 0 := fun h ↦ ht.ne_zero
    (IsLocalization.injective D (Ideal.primeCompl_le_nonZeroDivisors (Ideal.span {t}))
      (h.trans (map_zero _).symm))
  have hreg : IsSMulRegular D tD :=
    IsLeftRegular.isSMulRegular fun a b h ↦ mul_left_cancel₀ htD0 h
  haveI : IsNoetherianRing D :=
    IsLocalization.isNoetherianRing (Ideal.primeCompl (Ideal.span {t})) D inferInstance
  haveI : IsDiscreteValuationRing D :=
    IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span hmD hreg
  have htD : Irreducible tD := IsLocalRing.irreducible_of_maximalIdeal_eq_span hmD hreg
  -- `D` acting on the fields
  letI : Algebra D K := (locLift (Ideal.span {t}) K).toAlgebra
  obtain ⟨hADK, hDK⟩ := isFractionRing_locLift (Ideal.span {t}) K
  letI : Algebra D L := ((algebraMap K L).comp (algebraMap D K)).toAlgebra
  haveI : IsScalarTower D K L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  letI : Algebra D L₁ := ((algebraMap K L₁).comp (algebraMap D K)).toAlgebra
  haveI : IsScalarTower D K L₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : IsScalarTower D L L₁ := IsScalarTower.of_algebraMap_eq fun x ↦
    IsScalarTower.algebraMap_apply K L L₁ (algebraMap D K x)
  haveI : IsScalarTower A D L₁ := IsScalarTower.of_algebraMap_eq fun r ↦ by
    change algebraMap K L₁ (algebraMap A K r) =
      algebraMap K L₁ (algebraMap D K (algebraMap A D r))
    rw [← IsScalarTower.algebraMap_apply A D K]
  -- the residue field of `D` has characteristic zero; tameness
  have hmDc : (maximalIdeal D).comap (algebraMap A D) = (Ideal.span {t}) := by
    rw [← Ideal.under_def, Localization.AtPrime.under_maximalIdeal]
  haveI : CharZero (D ⧸ maximalIdeal D) :=
    charZero_of_comap_le (S := D) (Ideal.Quotient.mk _) hchar (by
      rw [Ideal.mk_ker, hmDc])
  have heD : IsUnit (e : D) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
    exact Nat.cast_ne_zero.mpr (NeZero.ne e)
  have htame := Abhyankar.tame_of_isGalois (O := D) (K := K) (L := L)
    (by rw [ringExpChar.eq_one]; exact Nat.coprime_one_right _)
  have hcard : Nat.card Gal(L/K) = finrank K L := IsGalois.card_aut_eq_finrank K L
  have htame' : ∀ (𝔓 : Ideal (integralClosure D L)) [𝔓.IsPrime]
      [𝔓.LiesOver (maximalIdeal D)], 𝔓.ramificationIdx D ∣ e ∧
        Algebra.IsSeparable (D ⧸ maximalIdeal D) (integralClosure D L ⧸ 𝔓) := fun 𝔓 _ _ ↦ by
    obtain ⟨h1, h2⟩ := htame 𝔓
    exact ⟨h1.trans (by rw [hcard]; exact hd), h2⟩
  -- `B' = 𝔹₁[(A ∖ (t))⁻¹]`, the integral closure of `D` in `L₁`
  set Mm := Algebra.algebraMapSubmonoid 𝔹₁ (Ideal.primeCompl (Ideal.span {t}))
  set B' := Localization Mm
  have hMne : ∀ m ∈ Mm, algebraMap 𝔹₁ L₁ m ≠ 0 := by
    rintro _ ⟨r, hr, rfl⟩ h
    rw [← IsScalarTower.algebraMap_apply A 𝔹₁ L₁] at h
    exact hr (by rw [hAinj (h.trans (map_zero _).symm)]; exact Ideal.zero_mem (Ideal.span {t}))
  have hMunit : ∀ m : Mm, IsUnit (algebraMap 𝔹₁ L₁ m) := fun m ↦ IsUnit.mk0 _ (hMne m m.2)
  letI : Algebra B' L₁ := (IsLocalization.lift (M := Mm) (S := B') hMunit).toAlgebra
  have hB'L₁ : ∀ b : 𝔹₁, algebraMap B' L₁ (algebraMap 𝔹₁ B' b) = algebraMap 𝔹₁ L₁ b :=
    IsLocalization.lift_eq hMunit
  haveI : IsScalarTower 𝔹₁ B' L₁ := IsScalarTower.of_algebraMap_eq fun b ↦ (hB'L₁ b).symm
  haveI : IsScalarTower D B' L₁ := by
    refine IsScalarTower.of_algebraMap_eq' (IsLocalization.ringHom_ext
      (Ideal.primeCompl (Ideal.span {t}))
      (RingHom.ext fun r ↦ ?_))
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply A D B', IsScalarTower.algebraMap_apply A 𝔹₁ B', hB'L₁,
      ← IsScalarTower.algebraMap_apply A 𝔹₁ L₁, ← IsScalarTower.algebraMap_apply A D L₁]
  have hM0 : Mm ≤ nonZeroDivisors 𝔹₁ := fun m hm ↦
    mem_nonZeroDivisors_of_ne_zero fun h ↦ hMne m hm (by rw [h, map_zero])
  haveI : IsDomain B' := IsLocalization.isDomain_localization hM0
  have h𝔹₁inj : Function.Injective (algebraMap 𝔹₁ L₁) := Subtype.val_injective
  have hB'inj : Function.Injective (algebraMap B' L₁) :=
    (IsLocalization.lift_injective_iff (M := Mm) (S := B') hMunit).mpr fun x y ↦
      ⟨fun h ↦ by rw [IsLocalization.injective B' hM0 h], fun h ↦ by rw [h𝔹₁inj h]⟩
  haveI : IsIntegralClosure B' D L₁ := by
    refine ⟨hB'inj, fun {x} ↦ ⟨fun hx ↦ ?_, ?_⟩⟩
    · obtain ⟨⟨r, hr⟩, hrx⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Ideal.primeCompl (Ideal.span {t}))
          (Rₘ := D) x hx
      have hrx' : IsIntegral A' (r • x) := hrx.tower_top
      refine ⟨IsLocalization.mk' B' (⟨r • x, hrx'⟩ : 𝔹₁)
        (⟨algebraMap A 𝔹₁ r, r, hr, rfl⟩ : Mm), ?_⟩
      change IsLocalization.lift hMunit _ = x
      rw [IsLocalization.lift_mk'_spec]
      change r • x = algebraMap 𝔹₁ L₁ (algebraMap A 𝔹₁ r) * x
      rw [← IsScalarTower.algebraMap_apply A 𝔹₁ L₁, Algebra.smul_def]
    · rintro ⟨y, rfl⟩
      obtain ⟨⟨b, ⟨_, r, hr, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective Mm y
      have hb0 : IsIntegral A (algebraMap 𝔹₁ L₁ b) := by
        exact isIntegral_trans _ b.2
      have hb : IsIntegral D (algebraMap 𝔹₁ L₁ b) := hb0.tower_top
      have hval : algebraMap B' L₁
          (IsLocalization.mk' B' b (⟨algebraMap A 𝔹₁ r, r, hr, rfl⟩ : Mm)) =
          algebraMap D L₁
            (IsLocalization.mk' D (1 : A) (⟨r, hr⟩ : (Ideal.primeCompl (Ideal.span {t})))) *
            algebraMap 𝔹₁ L₁ b := by
        change IsLocalization.lift hMunit _ = _
        rw [IsLocalization.lift_mk'_spec]
        change _ = algebraMap 𝔹₁ L₁ (algebraMap A 𝔹₁ r) * _
        rw [← IsScalarTower.algebraMap_apply A 𝔹₁ L₁, IsScalarTower.algebraMap_apply A D L₁,
          ← mul_assoc, ← map_mul, mul_comm (algebraMap A D r), IsLocalization.mk'_spec,
          map_one, map_one, one_mul]
      rw [hval]
      exact isIntegral_algebraMap.mul hb
  -- the prime `𝔔 = Q B'` over the maximal ideal of `D`
  have hdisj : Disjoint (Mm : Set 𝔹₁) Q := by
    rw [Set.disjoint_left]
    rintro _ ⟨r, hr, rfl⟩ hQ
    apply hr
    rw [← hcomap, SetLike.mem_coe, Ideal.mem_comap, hQP.over, Ideal.under_def, Ideal.mem_comap]
    exact hQ
  haveI : (Q.map (algebraMap 𝔹₁ B')).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint Mm B' Q ‹_› hdisj
  have htQ : algebraMap A 𝔹₁ t ∈ Q := by
    have h : t ∈ Ideal.comap (algebraMap A A') (Ideal.span {x}) := by
      rw [hcomap]; exact Ideal.mem_span_singleton_self _
    rw [Ideal.mem_comap, hQP.over, Ideal.under_def, Ideal.mem_comap] at h
    exact h
  haveI : (Q.map (algebraMap 𝔹₁ B')).LiesOver (maximalIdeal D) := by
    constructor
    refine le_antisymm ?_ (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance))
    rw [hmD, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.under_def,
      Ideal.mem_comap, ← IsScalarTower.algebraMap_apply A D B',
      IsScalarTower.algebraMap_apply A 𝔹₁ B']
    exact Ideal.mem_map_of_mem _ htQ
  -- Abhyankar's lemma over `D`
  set y := algebraMap A' L₁ x
  have hy : y ^ e = algebraMap D L₁ tD := by
    rw [← IsScalarTower.algebraMap_apply A D L₁, ← hAL₁, htx, map_pow]
  have hyB' : algebraMap B' L₁ (algebraMap 𝔹₁ B' (algebraMap A' 𝔹₁ x)) = y := by
    rw [hB'L₁, ← IsScalarTower.algebraMap_apply A' 𝔹₁ L₁]
  have hF : Algebra.adjoin L {y} = ⊤ := by
    have h := adjoin_eq_top_of_surjective hX hgen
    rwa [← IsScalarTower.algebraMap_apply A' K' L₁] at h
  have hmax := Abhyankar.maximalIdeal_atPrime_eq_span (K := K) (L := L)
    (B := integralClosure D L) (F := L₁) (B' := B') htD heD hy hF htame'
    (Q.map (algebraMap 𝔹₁ B')) _ hyB'
  have hmaxQ : maximalIdeal (Localization.AtPrime Q) =
      Ideal.span {algebraMap 𝔹₁ _ (algebraMap A' 𝔹₁ x)} :=
    maximalIdeal_eq_span_of_localization Mm Q hdisj _ hmax
  -- conclusion
  haveI : Module.Finite A' 𝔹₁ := IsIntegralClosure.finite A' K' L₁ 𝔹₁
  haveI : Algebra.IsIntegral A' 𝔹₁ := Algebra.IsIntegral.of_finite _ _
  letI := Localization.AtPrime.algebraOfLiesOver (Ideal.span {x}) Q
  rw [Algebra.isUnramifiedAt_iff_map_eq A' (Ideal.span {x}) Q]
  refine ⟨?_, ?_⟩
  · haveI : CharZero (Ideal.ResidueField (Ideal.span {x})) :=
      charZero_of_comap_le (S := A') (algebraMap A' (Ideal.ResidueField (Ideal.span {x}))) hchar (by
        rw [Ideal.ker_algebraMap_residueField, hcomap])
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  · rw [Ideal.map_span, Set.image_singleton, hmaxQ,
      IsScalarTower.algebraMap_apply A' 𝔹₁ (Localization.AtPrime Q)]

end Abhyankar

section Purity

variable {A : Type u} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
  [IsLocalRing A] {A' : Type u} [CommRing A'] [IsDomain A'] [IsLocalRing A'] [IsNoetherianRing A']
  [IsIntegrallyClosed A'] [Algebra A A'] [Algebra.IsIntegral A A'] [FaithfulSMul A A']

/-- **Purity, Abhyankar and base change along a divisor `(x)` over `(t)`**, generic form of
`Cusp.etale_integralClosure`. Let `A ⊆ A'` be an integral extension of Noetherian integrally
closed local domains, `m_{A'} = (x, y)` with `x` prime and `y ∉ (x)`, `t ∈ A` prime with
`t = x ^ e` in `A'`, the residue field of `(t)` of characteristic zero, `Frac A' = Frac A (x)`,
`L / Frac A` Galois of degree dividing `e` whose normalisation `B` over `A` is unramified at all
primes over primes of `A` other than the maximal ideal and `(t)`, and `L₁` a field generated by
`L` and `Frac A'`. Then the normalisation of `A'` in `L₁` is étale over `A'`. -/
theorem etale_integralClosure_of_pow {e : ℕ} [NeZero e] {t : A} (ht : Prime t) {x y : A'}
    (hx : Prime x) (hy : y ∉ Ideal.span {x}) (hm : maximalIdeal A' = Ideal.span {x, y})
    (htx : algebraMap A A' t = x ^ e) (hchar : ∀ n : ℕ, n ≠ 0 → (n : A) ∉ Ideal.span {t})
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    (K' : Type u) [Field K'] [Algebra A' K'] [IsFractionRing A' K'] [Algebra K K'] [Algebra A K']
    [IsScalarTower A K K'] [IsScalarTower A A' K']
    (hX : Algebra.adjoin K {algebraMap A' K' x} = ⊤)
    (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (hd : finrank K L ∣ e)
    (B : Type u) [CommRing B] [Algebra A B] [Algebra B L] [IsScalarTower A B L]
    [IsIntegralClosure B A L]
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≠ maximalIdeal A →
      Q.comap (algebraMap A B) ≠ Ideal.span {t} → Algebra.IsUnramifiedAt A Q)
    (L₁ : Type u) [Field L₁] [Algebra K L₁] [Algebra K' L₁] [Algebra L L₁]
    [IsScalarTower K K' L₁] [IsScalarTower K L L₁] [Algebra A' L₁]
    [IsScalarTower A' K' L₁] [FiniteDimensional K' L₁] [Algebra.IsSeparable K' L₁]
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K L L₁) (IsScalarTower.toAlgHom K K' L₁))) :
    Algebra.Etale A' (integralClosure A' L₁) := by
  have hcomap := comap_span_eq_of_pow (Nat.pos_of_neZero e) ht hx hy hm htx
  refine Purity.etale_of_formallyUnramified_fiber_of_maximalIdeal_eq_span_pair K' L₁
    hx hy hm fun P _ hP ↦ ?_
  refine Purity.formallyUnramified_fiber_of_isUnramifiedAt P fun Q _ hQ ↦ ?_
  by_cases hPt : P = Ideal.span {x}
  · subst hPt
    exact isUnramifiedAt_of_pow K K' L L₁ ht hx htx hcomap hchar hX hd hgen Q
  have hPm : P ≠ maximalIdeal A' := by
    rintro rfl
    have := (Purity.two_le_height_maximalIdeal hx hy hm).trans hP
    norm_num at this
  have hpm : P.comap (algebraMap A A') ≠ maximalIdeal A :=
    NodeCover.EtaleNbhd.comap_ne_maximalIdeal P hPm
  have hp := NodeCover.EtaleNbhd.height_comap_le_one (R := A) hm P hPm
  have hpt : ¬ Ideal.span {t} ≤ P.comap (algebraMap A A') := by
    intro hle
    apply hPt
    have hxP : x ∈ P := by
      have h1 : algebraMap A A' t ∈ P := hle (Ideal.mem_span_singleton_self _)
      rw [htx] at h1
      exact ‹P.IsPrime›.mem_of_pow_mem _ h1
    have hle' : Ideal.span {x} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hxP
    by_contra hne
    have hlt := lt_of_le_of_ne hle' (Ne.symm hne)
    haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
    have h0 : (⊥ : Ideal A') < Ideal.span {x} := by
      rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
      exact hx.ne_zero
    have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
    have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    have : (1 : ℕ∞) ≤ (Ideal.span {x}).height := le_trans (by simp) e0
    have : (2 : ℕ∞) ≤ 1 := by
      calc (2 : ℕ∞) = 1 + 1 := by norm_num
        _ ≤ (Ideal.span {x}).height + 1 := by gcongr
        _ ≤ P.height := e1
        _ ≤ 1 := hP
    norm_num at this
  refine NodeCover.isUnramifiedAt_of_baseChange (A := A) (A' := A') (K := K) (K' := K')
    (L := L) (B := B) (L₁ := L₁) (B₁ := integralClosure A' L₁) (P.comap (algebraMap A A'))
    hgen hp (fun Q' _ hQ' ↦ hunr Q' ?_ ?_) Q ?_
  · intro h
    rw [h] at hQ'
    exact hpm (le_antisymm (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) hQ')
  · intro h
    rw [h] at hQ'
    exact hpt hQ'
  · exact congrArg (Ideal.comap (algebraMap A A')) hQ.over.symm

end Purity

end SemistableReduction.Cusp
