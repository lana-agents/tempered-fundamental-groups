import TemperedFundamentalGroups.SemistableReduction.FormalKummerChart
import TemperedFundamentalGroups.SemistableReduction.KummerTateChartDomain

/-!
# The two nodes of the special fibre of the Tate node chart (MR12 S5.3)

Let `NR = (A[S]/(S² + S − c))[1/D]` be the quadratic node chart of the Tate model over the node
ring `A = O[u,v]/(uv − ϖᵐ)` (`TateTwoChartNode.NR`), `θ : O → k` surjective onto a field with
`θ ϖ = 0`, and `m ≥ 1`. The special fibre `NR/J` (`J = (ker θ)·NR`) has two nodes, at
`u = v = 0`, `S = s_j` for the two roots `s₀ = 0`, `s₁ = −1` of `S² + S`:

* `evNode j : NR →+* k`, `u, v ↦ 0`, `S ↦ s_j`, `O ∋ o ↦ θ o` (surjective);
* `nodeIdeal j = ker (evNode j)`: maximal, containing `J`, with residue field `k` reached from
  `O` (`surjective_mk_comp_algebraMap`), lying over the closed point `(u, v, ϖ)` of the node
  (`comap_nodeIdeal`, for `ker θ = (ϖ)`), generated by `u, v, S − s_j` modulo `J`
  (`nodeIdeal_le`);
* on the special fibre: the two node ideals are distinct (`sIdeal_injective`), contain
  `f̄ = u + v` (`fbar_mem_sIdeal`), and their intersection lies in the radical of `(f̄)`
  (`iInf_sIdeal_le_radical`).
-/

universe u

open Polynomial

namespace SemistableReduction

open KummerEtale AdmissibleLift

namespace TateTwoChartNode

noncomputable section

variable {O : Type u} [CommRing O] {k : Type u} [Field k] {θ : O →+* k}
  {b₄ b₆ ϖ : O} {m : ℕ} {ε : O}

local notation "𝒩" => NR b₄ b₆ ϖ m ε

local notation "𝒬" => QuadNode.Q ϖ m (cN b₄ b₆ ϖ m ε)

local notation "𝒟" => AdjoinRoot.of (QuadraticEtale.poly (cN b₄ b₆ ϖ m ε)) (DN b₄ ϖ m)

/-- The two roots `0`, `−1` of `S² + S`, in `O`. -/
def sO : Fin 2 → O := ![0, -1]

variable (θ) in
/-- The two roots `0`, `−1` of `S² + S`, in `k`. -/
def sRoot (j : Fin 2) : k := θ (sO j)

variable (b₄ b₆ ϖ m ε) in
/-- The two roots `0`, `−1` of `S² + S`, in the node chart. -/
def sRoot' (j : Fin 2) : NR b₄ b₆ ϖ m ε := algebraMap O _ (sO j)

@[simp] lemma sRoot_zero : sRoot θ 0 = 0 := by simp [sRoot, sO]

@[simp] lemma sRoot_one : sRoot θ 1 = -1 := by simp [sRoot, sO]

@[simp] lemma sRoot'_zero : sRoot' b₄ b₆ ϖ m ε 0 = 0 := by simp [sRoot', sO]

@[simp] lemma sRoot'_one : sRoot' b₄ b₆ ϖ m ε 1 = -1 := by simp [sRoot', sO]

lemma sRoot_sq (j : Fin 2) : sRoot θ j ^ 2 + sRoot θ j = 0 := by
  fin_cases j <;> simp

/-! ### The evaluation maps -/

private lemma θ_eq_zero_of_mem_span (hϖ : θ ϖ = 0) (a : O) (ha : a ∈ Ideal.span {ϖ}) :
    θ a = 0 := by
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.1 ha
  rw [map_mul, hϖ, mul_zero]

private lemma dvd_ϖ_pow (hm : 1 ≤ m) : ϖ ∣ ϖ ^ m := dvd_pow_self ϖ (by omega)

variable (θ ϖ m) in
/-- The evaluation of the node ring at its closed point: `u, v ↦ 0`, `O → k` by `θ`. -/
def evA (hϖ : θ ϖ = 0) (hm : 1 ≤ m) : A ϖ m →+* k :=
  (Ideal.Quotient.lift _ θ (θ_eq_zero_of_mem_span hϖ)).comp
    (Node.residue ϖ (dvd_ϖ_pow hm)).toRingHom

lemma evA_u (hϖ : θ ϖ = 0) (hm : 1 ≤ m) : evA θ ϖ m hϖ hm (Node.u _) = 0 := by
  simp [evA, Node.residue]

lemma evA_v (hϖ : θ ϖ = 0) (hm : 1 ≤ m) : evA θ ϖ m hϖ hm (Node.v _) = 0 := by
  simp [evA, Node.residue]

lemma evA_algebraMap (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (o : O) :
    evA θ ϖ m hϖ hm (algebraMap O _ o) = θ o := by
  simp only [evA, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.lift_mk]

lemma evA_cN (hϖ : θ ϖ = 0) (hm : 1 ≤ m) : evA θ ϖ m hϖ hm (cN b₄ b₆ ϖ m ε) = 0 := by
  simp [cN, evA_u, evA_v]

lemma evA_DN (hϖ : θ ϖ = 0) (hm : 1 ≤ m) : evA θ ϖ m hϖ hm (DN b₄ ϖ m) = 1 := by
  simp [DN, evA_u]

private lemma eval₂_poly_sRoot (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    (QuadraticEtale.poly (cN b₄ b₆ ϖ m ε)).eval₂ (evA θ ϖ m hϖ hm) (sRoot θ j) = 0 := by
  simp only [QuadraticEtale.poly, eval₂_sub, eval₂_add, eval₂_pow, eval₂_X, eval₂_C,
    evA_cN, sub_zero]
  exact sRoot_sq j

variable (b₄ b₆ ϖ m ε) in
/-- The evaluation of `A[S]/(S² + S − c)` at the node `S = s_j`. -/
def evQ (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) : QuadNode.Q ϖ m (cN b₄ b₆ ϖ m ε) →+* k :=
  AdjoinRoot.lift (evA θ ϖ m hϖ hm) (sRoot θ j) (eval₂_poly_sRoot hϖ hm j)

lemma isUnit_evQ_D (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    IsUnit (evQ b₄ b₆ ϖ m ε hϖ hm j (AdjoinRoot.of _ (DN b₄ ϖ m))) := by
  rw [evQ, AdjoinRoot.lift_of, evA_DN]
  exact isUnit_one

variable (b₄ b₆ ϖ m ε) in
/-- **The evaluation at the node `j`**: `u, v ↦ 0`, `S ↦ s_j`, `O → k` by `θ`. -/
def evNode (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) : NR b₄ b₆ ϖ m ε →+* k :=
  IsLocalization.Away.lift (S := NR b₄ b₆ ϖ m ε) 𝒟 (isUnit_evQ_D (b₆ := b₆) (ε := ε) hϖ hm j)

lemma evNode_algebraMap_Q (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) (q : 𝒬) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (algebraMap 𝒬 𝒩 q) = evQ b₄ b₆ ϖ m ε hϖ hm j q :=
  IsLocalization.Away.lift_eq (S := 𝒩) 𝒟 _ q

lemma evNode_algebraMap_A (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) (a : A ϖ m) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (algebraMap (A ϖ m) 𝒩 a) = evA θ ϖ m hϖ hm a := by
  rw [IsScalarTower.algebraMap_apply (A ϖ m) 𝒬 𝒩, evNode_algebraMap_Q, evQ,
    AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of]

lemma evNode_algebraMap (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) (o : O) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (algebraMap O 𝒩 o) = θ o := by
  rw [IsScalarTower.algebraMap_apply O (A ϖ m) 𝒩, evNode_algebraMap_A, evA_algebraMap]

@[simp] lemma evNode_uR (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (uR b₄ b₆ ϖ m ε) = 0 := by
  rw [evNode_algebraMap_A, evA_u]

@[simp] lemma evNode_vR (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (vR b₄ b₆ ϖ m ε) = 0 := by
  rw [evNode_algebraMap_A, evA_v]

@[simp] lemma evNode_SR (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (SR b₄ b₆ ϖ m ε) = sRoot θ j := by
  rw [evNode_algebraMap_Q, evQ, AdjoinRoot.lift_root]

@[simp] lemma evNode_sRoot' (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    evNode b₄ b₆ ϖ m ε hϖ hm j (sRoot' b₄ b₆ ϖ m ε j) = sRoot θ j :=
  evNode_algebraMap hϖ hm j _

lemma evNode_surjective (hθ : Function.Surjective θ) (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    Function.Surjective (evNode b₄ b₆ ϖ m ε hϖ hm j) := fun x ↦ by
  obtain ⟨o, rfl⟩ := hθ x
  exact ⟨_, evNode_algebraMap hϖ hm j o⟩

/-! ### The node ideals -/

variable (b₄ b₆ ϖ m ε) in
/-- **The ideal of the node `j`** of the node chart: `u = v = 0`, `S = s_j`, `ϖ = 0`. -/
def nodeIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) : Ideal (NR b₄ b₆ ϖ m ε) :=
  RingHom.ker (evNode b₄ b₆ ϖ m ε hϖ hm j)

lemma isMaximal_nodeIdeal (hθ : Function.Surjective θ) (hϖ : θ ϖ = 0) (hm : 1 ≤ m)
    (j : Fin 2) : (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ (evNode_surjective hθ hϖ hm j)

lemma J_le_nodeIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    J θ (R := 𝒩) ≤ nodeIdeal b₄ b₆ ϖ m ε hϖ hm j := by
  rw [Ideal.map_le_iff_le_comap]
  intro o ho
  rw [Ideal.mem_comap, nodeIdeal, RingHom.mem_ker, evNode_algebraMap]
  exact ho

lemma surjective_mk_comp_algebraMap (hθ : Function.Surjective θ) (hϖ : θ ϖ = 0) (hm : 1 ≤ m)
    (j : Fin 2) : Function.Surjective
      ((Ideal.Quotient.mk (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j)).comp (algebraMap O 𝒩)) := by
  intro x
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨o, ho⟩ := hθ (evNode b₄ b₆ ϖ m ε hϖ hm j z)
  refine ⟨o, ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, nodeIdeal, RingHom.mem_ker, map_sub,
    evNode_algebraMap, ho, sub_self]

/-- **The node `j` lies over the closed point `(u, v, ϖ)` of the node ring.** -/
theorem comap_nodeIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (hker : RingHom.ker θ = Ideal.span {ϖ})
    (j : Fin 2) : (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j).comap (algebraMap (A ϖ m) 𝒩) =
      Node.closedPoint ϖ (ϖ ^ m) := by
  ext a
  rw [Ideal.mem_comap, nodeIdeal, RingHom.mem_ker, evNode_algebraMap_A,
    ← Node.ker_residue ϖ (dvd_ϖ_pow hm), RingHom.mem_ker]
  obtain ⟨o, ho⟩ := Ideal.Quotient.mk_surjective (Node.residue ϖ (dvd_ϖ_pow hm) a)
  have he : evA θ ϖ m hϖ hm a = θ o := by
    simp only [evA, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ← ho,
      Ideal.Quotient.lift_mk]
  rw [he, ← ho, ← RingHom.mem_ker, hker, Ideal.Quotient.eq_zero_iff_mem]

/-! ### Generators of the node ideals -/

variable (b₄ b₆ ϖ m ε) in
/-- The ideal `(u, v, S − s_j)` of the node chart. -/
def nodeGenIdeal (j : Fin 2) : Ideal (NR b₄ b₆ ϖ m ε) :=
  Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε, SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j}

/-- `z` is congruent to an element of `O` modulo `(u, v, S − s_j)`. -/
private def NodeCong (j : Fin 2) (z : 𝒩) : Prop :=
  ∃ o : O, z - algebraMap O 𝒩 o ∈ nodeGenIdeal b₄ b₆ ϖ m ε j

private lemma nodeCong_algebraMap (j : Fin 2) (o : O) : NodeCong j (algebraMap O 𝒩 o) :=
  ⟨o, by rw [sub_self]; exact zero_mem _⟩

private lemma nodeCong_add {j : Fin 2} {z w : 𝒩} (hz : NodeCong j z) (hw : NodeCong j w) :
    NodeCong j (z + w) := by
  obtain ⟨o, ho⟩ := hz
  obtain ⟨o', ho'⟩ := hw
  refine ⟨o + o', ?_⟩
  convert add_mem ho ho' using 1
  rw [map_add]; ring

private lemma nodeCong_mul {j : Fin 2} {z w : 𝒩} (hz : NodeCong j z) (hw : NodeCong j w) :
    NodeCong j (z * w) := by
  obtain ⟨o, ho⟩ := hz
  obtain ⟨o', ho'⟩ := hw
  refine ⟨o * o', ?_⟩
  have : z * w - algebraMap O 𝒩 (o * o') =
      (z - algebraMap O 𝒩 o) * w + algebraMap O 𝒩 o * (w - algebraMap O 𝒩 o') := by
    rw [map_mul]; ring
  rw [this]
  exact add_mem (Ideal.mul_mem_right _ _ ho) (Ideal.mul_mem_left _ _ ho')

private lemma nodeCong_pow {j : Fin 2} {z : 𝒩} (hz : NodeCong j z) (n : ℕ) :
    NodeCong j (z ^ n) := by
  induction n with
  | zero => rw [pow_zero, ← map_one (algebraMap O 𝒩)]; exact nodeCong_algebraMap j 1
  | succ n ih => rw [pow_succ]; exact nodeCong_mul ih hz

private lemma nodeCong_of_mem {j : Fin 2} {z : 𝒩} (hz : z ∈ nodeGenIdeal b₄ b₆ ϖ m ε j) :
    NodeCong j z :=
  ⟨0, by rwa [map_zero, sub_zero]⟩

lemma uR_mem (j : Fin 2) : uR b₄ b₆ ϖ m ε ∈ nodeGenIdeal b₄ b₆ ϖ m ε j :=
  Ideal.subset_span (Set.mem_insert _ _)

lemma vR_mem (j : Fin 2) : vR b₄ b₆ ϖ m ε ∈ nodeGenIdeal b₄ b₆ ϖ m ε j :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

lemma SR_sub_mem (j : Fin 2) :
    SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j ∈ nodeGenIdeal b₄ b₆ ϖ m ε j :=
  Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))

private lemma nodeCong_algebraMap_A (j : Fin 2) (a : A ϖ m) :
    NodeCong j (algebraMap (A ϖ m) 𝒩 a) := by
  obtain ⟨o, ho⟩ := Node.exists_sub_algebraMap_mem (ϖ ^ m) a
  have hle : Ideal.span {Node.u (ϖ ^ m), Node.v (ϖ ^ m)} ≤
      (nodeGenIdeal b₄ b₆ ϖ m ε j).comap (algebraMap (A ϖ m) 𝒩) := by
    rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact uR_mem j
    · exact vR_mem j
  refine ⟨o, ?_⟩
  have := hle ho
  rwa [Ideal.mem_comap, map_sub, ← IsScalarTower.algebraMap_apply] at this

private lemma nodeCong_algebraMap_Q (j : Fin 2) (q : 𝒬) : NodeCong j (algebraMap 𝒬 𝒩 q) := by
  induction q using AdjoinRoot.induction_on with
  | ih p =>
  induction p using Polynomial.induction_on with
  | C a =>
    rw [AdjoinRoot.mk_C, show algebraMap 𝒬 𝒩 (AdjoinRoot.of _ a) = algebraMap (A ϖ m) 𝒩 a from
      (IsScalarTower.algebraMap_apply (A ϖ m) 𝒬 𝒩 a).symm]
    exact nodeCong_algebraMap_A j a
  | add p q hp hq => rw [map_add, map_add]; exact nodeCong_add hp hq
  | monomial n a h =>
    rw [pow_succ, ← mul_assoc, map_mul, AdjoinRoot.mk_X, map_mul]
    refine nodeCong_mul h ⟨sO j, ?_⟩
    exact SR_sub_mem j

private lemma nodeCong_invSelf (j : Fin 2) :
    NodeCong j (IsLocalization.Away.invSelf (S := 𝒩) 𝒟) := by
  set d := algebraMap 𝒬 𝒩 𝒟
  set e := IsLocalization.Away.invSelf (S := 𝒩) 𝒟
  have hde : d * e = 1 := IsLocalization.Away.mul_invSelf _
  have hd : d = 1 + algebraMap O 𝒩 b₄ * uR b₄ b₆ ϖ m ε ^ 2 := by
    rw [show d = algebraMap (A ϖ m) 𝒩 (DN b₄ ϖ m) from
      (IsScalarTower.algebraMap_apply (A ϖ m) 𝒬 𝒩 _).symm]
    simp only [DN, map_add, map_one, map_mul, map_pow, ← IsScalarTower.algebraMap_apply]
  refine ⟨1, ?_⟩
  have : e - algebraMap O 𝒩 1 =
      -(e * algebraMap O 𝒩 b₄ * uR b₄ b₆ ϖ m ε) * uR b₄ b₆ ϖ m ε := by
    rw [map_one]; linear_combination hde - e * hd
  rw [this]
  exact Ideal.mul_mem_left _ _ (uR_mem j)

private lemma nodeCong (j : Fin 2) (z : 𝒩) : NodeCong j z := by
  obtain ⟨n, a, h⟩ := IsLocalization.Away.surj 𝒟 z
  have hde := IsLocalization.Away.mul_invSelf (S := 𝒩) 𝒟
  have : z = algebraMap 𝒬 𝒩 a * IsLocalization.Away.invSelf (S := 𝒩) 𝒟 ^ n := by
    rw [← h, mul_assoc, ← mul_pow, hde, one_pow, mul_one]
  rw [this]
  exact nodeCong_mul (nodeCong_algebraMap_Q j a) (nodeCong_pow (nodeCong_invSelf j) n)

lemma genIdeal_le_nodeIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    nodeGenIdeal b₄ b₆ ϖ m ε j ≤ nodeIdeal b₄ b₆ ϖ m ε hϖ hm j := by
  rw [nodeGenIdeal, Ideal.span_le]
  rintro x (rfl | rfl | rfl) <;> simp [nodeIdeal]

/-- **The node ideal is generated by `u, v, S − s_j` modulo `J`.** -/
theorem nodeIdeal_le (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    nodeIdeal b₄ b₆ ϖ m ε hϖ hm j ≤
      Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε, SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j} ⊔
        J θ (R := 𝒩) := by
  intro z hz
  obtain ⟨o, ho⟩ := nodeCong j z
  have h1 := genIdeal_le_nodeIdeal hϖ hm j ho
  rw [nodeIdeal, RingHom.mem_ker, map_sub, evNode_algebraMap, RingHom.mem_ker.1 hz,
    zero_sub, neg_eq_zero] at h1
  have h2 : algebraMap O 𝒩 o ∈ J θ (R := 𝒩) := Ideal.mem_map_of_mem _ h1
  rw [show z = (z - algebraMap O 𝒩 o) + algebraMap O 𝒩 o by ring]
  exact add_mem (Ideal.mem_sup_left ho) (Ideal.mem_sup_right h2)

/-! ### The nodes on the special fibre -/

lemma comap_sIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    (FormalKummer.sIdeal (θ := θ) (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j)).comap
      (Ideal.Quotient.mk (J θ)) = nodeIdeal b₄ b₆ ϖ m ε hϖ hm j := by
  rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
  exact sup_eq_left.2 (J_le_nodeIdeal hϖ hm j)

lemma SR_mem_nodeIdeal_zero (hϖ : θ ϖ = 0) (hm : 1 ≤ m) :
    SR b₄ b₆ ϖ m ε ∈ nodeIdeal b₄ b₆ ϖ m ε hϖ hm 0 := by
  simp [nodeIdeal]

lemma SR_notMem_nodeIdeal_one (hϖ : θ ϖ = 0) (hm : 1 ≤ m) :
    SR b₄ b₆ ϖ m ε ∉ nodeIdeal b₄ b₆ ϖ m ε hϖ hm 1 := by
  simp [nodeIdeal]

/-- **The two nodes of the special fibre are distinct.** -/
theorem sIdeal_injective (hϖ : θ ϖ = 0) (hm : 1 ≤ m) :
    Function.Injective fun j ↦
      FormalKummer.sIdeal (θ := θ) (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j) := by
  have key : nodeIdeal b₄ b₆ ϖ m ε hϖ hm 0 ≠ nodeIdeal b₄ b₆ ϖ m ε hϖ hm 1 := fun h ↦
    SR_notMem_nodeIdeal_one hϖ hm (h ▸ SR_mem_nodeIdeal_zero hϖ hm)
  intro i j h
  have h' := congrArg (Ideal.comap (Ideal.Quotient.mk (J θ (R := 𝒩)))) h
  simp only [comap_sIdeal] at h'
  fin_cases i <;> fin_cases j
  · rfl
  · exact absurd h' key
  · exact absurd h'.symm key
  · rfl

lemma fR_mem_nodeIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    NodeChart.fR (π := ϖ) (e := m) 𝒩 ∈ nodeIdeal b₄ b₆ ϖ m ε hϖ hm j := by
  rw [nodeIdeal, RingHom.mem_ker, evNode_algebraMap_A, fA, map_add, evA_u, evA_v, add_zero]

/-- **`f̄ = u + v` vanishes at both nodes.** -/
theorem fbar_mem_sIdeal (hϖ : θ ϖ = 0) (hm : 1 ≤ m) (j : Fin 2) :
    fbar θ (NodeChart.fR (π := ϖ) (e := m) 𝒩) ∈
      FormalKummer.sIdeal (θ := θ) (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j) :=
  Ideal.mem_map_of_mem _ (fR_mem_nodeIdeal hϖ hm j)

/-- `x (S − s') ∈ (u, v) + J` for `x ∈ (u, v, S − s_j) + J` if `(S − s_j)(S − s') = S² + S`. -/
lemma mul_mem_uv (j : Fin 2) {s' x : 𝒩}
    (hs : (SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j) * (SR b₄ b₆ ϖ m ε - s') =
      SR b₄ b₆ ϖ m ε ^ 2 + SR b₄ b₆ ϖ m ε)
    (hx : x ∈ nodeGenIdeal b₄ b₆ ϖ m ε j ⊔ J θ (R := 𝒩)) :
    x * (SR b₄ b₆ ϖ m ε - s') ∈
      Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε} ⊔ J θ (R := 𝒩) := by
  set K := Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε} ⊔ J θ (R := 𝒩)
  have hu : uR b₄ b₆ ϖ m ε ∈ K := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv : vR b₄ b₆ ϖ m ε ∈ K :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hc : (SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j) * (SR b₄ b₆ ϖ m ε - s') ∈ K := by
    have hS := SR_sq b₄ b₆ ϖ m ε
    rw [algebraMap_cN] at hS
    have : (SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε j) * (SR b₄ b₆ ϖ m ε - s') =
        algebraMap O 𝒩 ε * (1 + algebraMap O 𝒩 b₄ * uR b₄ b₆ ϖ m ε ^ 2) * vR b₄ b₆ ϖ m ε +
          (algebraMap O 𝒩 b₆ * uR b₄ b₆ ϖ m ε) * uR b₄ b₆ ϖ m ε := by
      rw [hs, hS]; ring
    rw [this]
    exact add_mem (Ideal.mul_mem_left _ _ hv) (Ideal.mul_mem_left _ _ hu)
  have hle : nodeGenIdeal b₄ b₆ ϖ m ε j ⊔ J θ (R := 𝒩) ≤
      K.colon {SR b₄ b₆ ϖ m ε - s'} := by
    refine sup_le ?_ fun y hy ↦ ?_
    · rw [nodeGenIdeal, Ideal.span_le, Set.insert_subset_iff, Set.insert_subset_iff,
        Set.singleton_subset_iff]
      simp only [SetLike.mem_coe, Submodule.mem_colon_singleton, smul_eq_mul]
      exact ⟨Ideal.mul_mem_right _ _ hu, Ideal.mul_mem_right _ _ hv, hc⟩
    · rw [Submodule.mem_colon_singleton, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_sup_right hy)
  have := hle hx
  rwa [Submodule.mem_colon_singleton, smul_eq_mul] at this

lemma uv_le_radical (hϖ : θ ϖ = 0) (hm : 1 ≤ m) :
    Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε} ⊔ J θ (R := 𝒩) ≤
      (Ideal.span {NodeChart.fR (π := ϖ) (e := m) 𝒩} ⊔ J θ (R := 𝒩)).radical := by
  set L := Ideal.span {NodeChart.fR (π := ϖ) (e := m) 𝒩} ⊔ J θ (R := 𝒩)
  have hf : NodeChart.fR (π := ϖ) (e := m) 𝒩 = uR b₄ b₆ ϖ m ε + vR b₄ b₆ ϖ m ε := by
    rw [NodeChart.fR, fA, map_add]
  have hfL : uR b₄ b₆ ϖ m ε + vR b₄ b₆ ϖ m ε ∈ L :=
    hf ▸ Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  have hϖL : algebraMap O 𝒩 ϖ ^ m ∈ L := by
    refine Ideal.mem_sup_right ?_
    rw [← map_pow]
    refine Ideal.mem_map_of_mem _ ?_
    rw [RingHom.mem_ker, map_pow, hϖ, zero_pow (by omega)]
  have huv := uR_mul_vR b₄ b₆ ϖ m ε
  refine sup_le ?_ (le_sup_right.trans Ideal.le_radical)
  rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
  constructor
  · refine ⟨2, ?_⟩
    have : uR b₄ b₆ ϖ m ε ^ 2 = uR b₄ b₆ ϖ m ε * (uR b₄ b₆ ϖ m ε + vR b₄ b₆ ϖ m ε) -
        algebraMap O 𝒩 ϖ ^ m := by
      rw [← huv]; ring
    rw [this]
    exact sub_mem (Ideal.mul_mem_left _ _ hfL) hϖL
  · refine ⟨2, ?_⟩
    have : vR b₄ b₆ ϖ m ε ^ 2 = vR b₄ b₆ ϖ m ε * (uR b₄ b₆ ϖ m ε + vR b₄ b₆ ϖ m ε) -
        algebraMap O 𝒩 ϖ ^ m := by
      rw [← huv]; ring
    rw [this]
    exact sub_mem (Ideal.mul_mem_left _ _ hfL) hϖL

lemma mem_genIdeal_sup_of_mem (hϖ : θ ϖ = 0) (hm : 1 ≤ m) {z : 𝒩}
    (hz : Ideal.Quotient.mk (J θ (R := 𝒩)) z ∈
      ⨅ j, FormalKummer.sIdeal (θ := θ) (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j)) (j : Fin 2) :
    z ∈ nodeGenIdeal b₄ b₆ ϖ m ε j ⊔ J θ (R := 𝒩) := by
  refine nodeIdeal_le hϖ hm j ?_
  rw [← comap_sIdeal hϖ hm j]
  exact Ideal.mem_comap.2 (Ideal.mem_iInf.1 hz j)

lemma mem_uv_of_mem {z : 𝒩}
    (hz : ∀ j, z ∈ nodeGenIdeal b₄ b₆ ϖ m ε j ⊔ J θ (R := 𝒩)) :
    z ∈ Ideal.span {uR b₄ b₆ ϖ m ε, vR b₄ b₆ ϖ m ε} ⊔ J θ (R := 𝒩) := by
  have h0 := mul_mem_uv (s' := sRoot' b₄ b₆ ϖ m ε 1) 0
    (by rw [sRoot'_zero, sRoot'_one]; ring) (hz 0)
  have h1 := mul_mem_uv (s' := sRoot' b₄ b₆ ϖ m ε 0) 1
    (by rw [sRoot'_zero, sRoot'_one]; ring) (hz 1)
  have : z = z * (SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε 1) -
      z * (SR b₄ b₆ ϖ m ε - sRoot' b₄ b₆ ϖ m ε 0) := by
    rw [sRoot'_zero, sRoot'_one]; ring
  rw [this]
  exact sub_mem h0 h1

lemma map_le_span_fbar :
    (Ideal.span {NodeChart.fR (π := ϖ) (e := m) 𝒩} ⊔ J θ (R := 𝒩)).map
      (Ideal.Quotient.mk (J θ (R := 𝒩))) ≤
      Ideal.span {fbar θ (NodeChart.fR (π := ϖ) (e := m) 𝒩)} := by
  rw [Ideal.map_le_iff_le_comap]
  refine sup_le ?_ fun y hy ↦ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_comap.2 (Ideal.mem_span_singleton_self _)
  · refine Ideal.mem_comap.2 ?_
    rw [Ideal.Quotient.eq_zero_iff_mem.2 hy]
    exact zero_mem _

/-- **The two nodes cut out the zero locus of `f̄ = u + v`**: on the special fibre, the
intersection of the two node ideals lies in the radical of `(f̄)`. -/
theorem iInf_sIdeal_le_radical (hϖ : θ ϖ = 0) (hm : 1 ≤ m) :
    ⨅ j, FormalKummer.sIdeal (θ := θ) (nodeIdeal b₄ b₆ ϖ m ε hϖ hm j) ≤
      (Ideal.span {fbar θ (NodeChart.fR (π := ϖ) (e := m) 𝒩)}).radical := by
  intro x hx
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨n, hn⟩ := uv_le_radical hϖ hm (mem_uv_of_mem (mem_genIdeal_sup_of_mem hϖ hm hx))
  have h := map_le_span_fbar (θ := θ) (Ideal.mem_map_of_mem (Ideal.Quotient.mk (J θ (R := 𝒩))) hn)
  rw [map_pow (Ideal.Quotient.mk (J θ (R := 𝒩))) z n] at h
  exact ⟨n, h⟩

end

