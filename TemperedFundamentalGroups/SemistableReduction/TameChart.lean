import TemperedFundamentalGroups.SemistableReduction.TameAbhyankar
import TemperedFundamentalGroups.SemistableReduction.TateReduced

/-!
# Abhyankar's lemma at the generic points of the special fibre of a chart (T2, S1)

Let `T` be a Noetherian ring (a chart ring of a model over a discrete valuation ring `O` with
uniformizer `ϖ`) on which `ϖ` is a non-zero-divisor and whose special fibre `T ⧸ ϖ` is reduced.
At a prime `𝔭` minimal over `ϖ T` (a generic point of the special fibre) the local ring `T_𝔭` is
a discrete valuation ring with uniformizer `ϖ`, of the same residue characteristic as `O`; hence
the tame form of Abhyankar's lemma (`Abhyankar.tame_of_isGalois`,
`Abhyankar.etale_integralClosure_adjoinRoot_of_isGalois`) applies over `T_𝔭`.

* `IsLocalRing.exists_eq_pow_mul_of_maximalIdeal_eq_span`,
  **`IsLocalRing.isDomain_of_maximalIdeal_eq_span`**,
  **`IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span`**: a Noetherian local ring whose
  maximal ideal is generated by a non-zero-divisor `ϖ` is a discrete valuation ring with
  uniformizer `ϖ` (no domain hypothesis: every non-zero element is `ϖⁿ · unit` by Krull's
  intersection theorem).
* **`Localization.AtPrime.maximalIdeal_eq_span_of_isReduced`**: for `𝔭` minimal over `ϖ T` with
  `T ⧸ ϖ` reduced, `𝔭 T_𝔭 = ϖ T_𝔭`; **`Localization.AtPrime.isDiscreteValuationRing_of_isReduced`**,
  `Localization.AtPrime.irreducible_of_isReduced`.
* `ringExpChar_eq_of_injective`, **`Localization.AtPrime.ringExpChar_quotient_maximalIdeal`**: the
  residue characteristic of `T_𝔭` is that of the base `O` when `𝔭` lies over the maximal ideal.
* **`Abhyankar.tame_atPrime_of_isGalois`**, **`Abhyankar.etale_atPrime_of_isGalois`**: Abhyankar's
  lemma over `T_𝔭` for a Galois extension of `Frac T_𝔭` of degree prime to the residue
  characteristic of `O`.
* **`TateTwoChart.isDiscreteValuationRing_T0_atPrime`**, **`TateTwoChart.irreducible_T0_atPrime`**
  and the same for `T1`: the instantiation at the two Tate charts (special fibres reduced by
  `TateTwoChart.isReduced_T0_quot/isReduced_T1_quot`, `ϖ` regular since `T0`, `T1` are free over
  `O[X]`).

This is the step "Abhyankar's lemma at the generic points of the special fibre" of the proof of
[Mzk1] §3.13 (after a tamely ramified base change), used for the converse direction in
[SemiAnbd] Cor 3.11, proof ("Galois coverings of degree a `Σ`-integer are necessarily
admissible").
-/

open IsLocalRing Polynomial

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {ϖ : R}

/-- In a Noetherian local ring whose maximal ideal is `(ϖ)`, every non-zero element is `ϖⁿ · u`
with `u` a unit (Krull's intersection theorem). -/
theorem exists_eq_pow_mul_of_maximalIdeal_eq_span (hm : maximalIdeal R = Ideal.span {ϖ})
    {x : R} (hx : x ≠ 0) : ∃ (n : ℕ) (u : Rˣ), x = ϖ ^ n * u := by
  have hI : ⨅ i : ℕ, maximalIdeal R ^ i = ⊥ :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal R).ne_top
  have hex : ∃ n : ℕ, x ∉ maximalIdeal R ^ n := by
    by_contra! h
    exact hx (by simpa [hI] using (Ideal.mem_iInf.2 h : x ∈ ⨅ i : ℕ, maximalIdeal R ^ i))
  classical
  have hn : x ∉ maximalIdeal R ^ Nat.find hex := Nat.find_spec hex
  have hn0 : Nat.find hex ≠ 0 := by
    intro h0
    exact hn (by rw [h0, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top)
  obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  have hxk : x ∈ maximalIdeal R ^ k := by
    by_contra h
    exact Nat.find_min hex (show k < Nat.find hex by omega) h
  rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hxk
  obtain ⟨u, rfl⟩ := hxk
  have hu : IsUnit u := by
    by_contra hu
    apply hn
    rw [hk, hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton, pow_succ]
    have hu' : u ∈ maximalIdeal R := (mem_maximalIdeal u).2 hu
    rw [hm, Ideal.mem_span_singleton] at hu'
    exact mul_dvd_mul_left _ hu'
  exact ⟨k, hu.unit, rfl⟩

/-- **A Noetherian local ring whose maximal ideal is generated by a non-zero-divisor is a
domain.** -/
theorem isDomain_of_maximalIdeal_eq_span (hm : maximalIdeal R = Ideal.span {ϖ})
    (hϖ : IsSMulRegular R ϖ) : IsDomain R := by
  haveI : NoZeroDivisors R := by
    refine ⟨fun {a b} hab ↦ ?_⟩
    by_contra! h
    obtain ⟨n, u, rfl⟩ := exists_eq_pow_mul_of_maximalIdeal_eq_span hm h.1
    obtain ⟨m, v, rfl⟩ := exists_eq_pow_mul_of_maximalIdeal_eq_span hm h.2
    have h0 : ϖ ^ (n + m) • ((u * v : Rˣ) : R) = ϖ ^ (n + m) • 0 := by
      rw [smul_zero, smul_eq_mul, ← hab, Units.val_mul, pow_add]
      ring
    exact (u * v).ne_zero ((hϖ.pow (n + m)) h0)
  exact NoZeroDivisors.to_isDomain R

/-- **A Noetherian local ring whose maximal ideal is generated by a non-zero-divisor `ϖ` is a
discrete valuation ring** (with uniformizer `ϖ`, `irreducible_of_maximalIdeal_eq_span`). -/
theorem isDiscreteValuationRing_of_maximalIdeal_eq_span (hm : maximalIdeal R = Ideal.span {ϖ})
    (hϖ : IsSMulRegular R ϖ) :
    haveI := isDomain_of_maximalIdeal_eq_span hm hϖ
    IsDiscreteValuationRing R := by
  haveI := isDomain_of_maximalIdeal_eq_span hm hϖ
  refine IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization ⟨ϖ, ?_, fun {x} hx ↦ ?_⟩
  · have hϖ0 : ϖ ≠ 0 := by
      rintro rfl
      have h1 : (0 : R) • (1 : R) = (0 : R) • 0 := by simp
      exact one_ne_zero (hϖ h1)
    refine ⟨fun hu ↦ ?_, fun a b hab ↦ ?_⟩
    · have : ϖ ∈ maximalIdeal R := by rw [hm]; exact Ideal.mem_span_singleton_self ϖ
      exact (mem_maximalIdeal ϖ).1 this hu
    · by_contra! h
      have ha : a ∈ maximalIdeal R := (mem_maximalIdeal a).2 h.1
      have hb : b ∈ maximalIdeal R := (mem_maximalIdeal b).2 h.2
      rw [hm, Ideal.mem_span_singleton] at ha hb
      obtain ⟨c, rfl⟩ := ha
      obtain ⟨d, rfl⟩ := hb
      have h1 : ϖ * 1 = ϖ * (ϖ * (c * d)) := by rw [mul_one]; nth_rw 1 [hab]; ring
      have h2 : 1 = ϖ * (c * d) := mul_left_cancel₀ hϖ0 h1
      have : ϖ ∈ maximalIdeal R := by rw [hm]; exact Ideal.mem_span_singleton_self ϖ
      exact (mem_maximalIdeal ϖ).1 this (IsUnit.of_mul_eq_one (c * d) h2.symm)
  · obtain ⟨n, u, rfl⟩ := exists_eq_pow_mul_of_maximalIdeal_eq_span hm hx
    exact ⟨n, u, rfl⟩

theorem irreducible_of_maximalIdeal_eq_span (hm : maximalIdeal R = Ideal.span {ϖ})
    (hϖ : IsSMulRegular R ϖ) : Irreducible ϖ := by
  haveI := isDomain_of_maximalIdeal_eq_span hm hϖ
  haveI := isDiscreteValuationRing_of_maximalIdeal_eq_span hm hϖ
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).2 hm

end IsLocalRing

/-- Injective ring homomorphisms of domains preserve the exponential characteristic. -/
theorem ringExpChar_eq_of_injective {k k' : Type*} [CommRing k] [IsDomain k] [CommRing k']
    {f : k →+* k'} (hf : Function.Injective f) : ringExpChar k' = ringExpChar k := by
  haveI : ExpChar k (ringExpChar k) := ringExpChar.of_eq rfl
  haveI := expChar_of_injective_ringHom hf (ringExpChar k)
  exact ringExpChar.eq k' (ringExpChar k)

namespace Localization.AtPrime

variable {T : Type*} [CommRing T] {ϖ : T} (𝔭 : Ideal T) [𝔭.IsPrime]

/-- A non-zero-divisor stays one in the localization at a prime. -/
theorem isSMulRegular_algebraMap (hϖ : IsSMulRegular T ϖ) :
    IsSMulRegular (Localization.AtPrime 𝔭) (algebraMap T (Localization.AtPrime 𝔭) ϖ) := by
  have key : ∀ a : Localization.AtPrime 𝔭, algebraMap T _ ϖ * a = 0 → a = 0 := by
    intro a ha
    obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl a
    rw [← IsLocalization.mk'_one (M := 𝔭.primeCompl), ← IsLocalization.mk'_mul, one_mul,
      IsLocalization.mk'_eq_zero_iff] at ha
    obtain ⟨u, hu⟩ := ha
    rw [IsLocalization.mk'_eq_zero_iff]
    refine ⟨u, hϖ ?_⟩
    simp only [smul_eq_mul, mul_zero]
    rw [← hu]
    ring
  intro a b hab
  simp only [smul_eq_mul] at hab
  exact sub_eq_zero.1 (key _ (by rw [mul_sub, hab, sub_self]))

/-- **At a generic point of a reduced special fibre the uniformizer generates the maximal
ideal**: if `T ⧸ ϖ` is reduced and `𝔭` is minimal over `ϖ T`, then `𝔭 T_𝔭 = ϖ T_𝔭`. -/
theorem maximalIdeal_eq_span_of_isReduced (hred : IsReduced (T ⧸ Ideal.span {ϖ}))
    (hmin : 𝔭 ∈ (Ideal.span {ϖ}).minimalPrimes) :
    maximalIdeal (Localization.AtPrime 𝔭) =
      Ideal.span {algebraMap T (Localization.AtPrime 𝔭) ϖ} := by
  set S := Localization.AtPrime 𝔭
  set I : Ideal S := Ideal.span {algebraMap T S ϖ}
  have hϖ𝔭 : ϖ ∈ 𝔭 := hmin.1.2 (Ideal.mem_span_singleton_self ϖ)
  refine le_antisymm (fun r hr ↦ ?_) ?_
  · obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl r
    have ht : t ∈ 𝔭 := (IsLocalization.AtPrime.mk'_mem_maximal_iff S 𝔭 t s).1 hr
    -- `r` lies in every prime of `S` containing `ϖ`, hence in the radical of `I`.
    have hrad : IsLocalization.mk' S t s ∈ I.radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro J ⟨hIJ, hJ⟩
      have hq : (Ideal.comap (algebraMap T S) J).IsPrime := Ideal.comap_isPrime _ J
      have hϖq : ϖ ∈ Ideal.comap (algebraMap T S) J :=
        hIJ (Ideal.mem_span_singleton_self (algebraMap T S ϖ))
      have hle : Ideal.comap (algebraMap T S) J ≤ 𝔭 := fun x hx ↦
        (IsLocalization.AtPrime.to_map_mem_maximal_iff S 𝔭 x).1 (le_maximalIdeal hJ.ne_top hx)
      have h𝔭 : 𝔭 ≤ Ideal.comap (algebraMap T S) J :=
        hmin.2 ⟨hq, (Ideal.span_singleton_le_iff_mem _).2 hϖq⟩ hle
      exact (IsLocalization.mk'_mem_iff (M := 𝔭.primeCompl)).2 (h𝔭 ht)
    obtain ⟨n, hn⟩ := hrad
    rw [← IsLocalization.mk'_pow, Ideal.mem_span_singleton'] at hn
    obtain ⟨a, ha⟩ := hn
    obtain ⟨⟨c, s'⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl a
    rw [← IsLocalization.mk'_one (M := 𝔭.primeCompl) S ϖ, ← IsLocalization.mk'_mul, mul_one,
      IsLocalization.mk'_eq_iff_eq, IsLocalization.eq_iff_exists 𝔭.primeCompl] at ha
    obtain ⟨u, hu⟩ := ha
    -- `(u s' t)ⁿ⁺¹ ∈ (ϖ)`, so `u s' t ∈ (ϖ)` by reducedness of `T ⧸ ϖ`.
    have hmem : (u * s' * t : T) ^ (n + 1) ∈ Ideal.span {ϖ} := by
      rw [Ideal.mem_span_singleton]
      refine ⟨(u : T) ^ (n + 1) * s' ^ n * t * s ^ n * c, ?_⟩
      simp only [SubmonoidClass.coe_pow] at hu
      linear_combination (-((u : T) ^ n * s' ^ n * t)) * hu
    have hnil : IsNilpotent (Ideal.Quotient.mk (Ideal.span {ϖ}) (u * s' * t)) :=
      ⟨n + 1, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hmem⟩
    have h0 := hnil.eq_zero
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h0
    obtain ⟨d, hd⟩ := h0
    have hus : (u * s' : T) * s ∈ 𝔭.primeCompl :=
      𝔭.primeCompl.mul_mem (𝔭.primeCompl.mul_mem u.2 s'.2) s.2
    have : IsLocalization.mk' S t s = algebraMap T S ϖ * IsLocalization.mk' S d ⟨_, hus⟩ := by
      rw [← IsLocalization.mk'_one (M := 𝔭.primeCompl) S ϖ, ← IsLocalization.mk'_mul, one_mul,
        IsLocalization.mk'_eq_iff_eq]
      congr 1
      linear_combination (s : T) * hd
    change IsLocalization.mk' S t s ∈ I
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_singleton_le_iff_mem]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff S 𝔭 ϖ).2 hϖ𝔭

variable {𝔭}

variable [IsNoetherianRing T]

theorem isDomain_of_isReduced (hϖ : IsSMulRegular T ϖ) (hred : IsReduced (T ⧸ Ideal.span {ϖ}))
    (hmin : 𝔭 ∈ (Ideal.span {ϖ}).minimalPrimes) : IsDomain (Localization.AtPrime 𝔭) :=
  IsLocalRing.isDomain_of_maximalIdeal_eq_span (maximalIdeal_eq_span_of_isReduced 𝔭 hred hmin)
    (isSMulRegular_algebraMap 𝔭 hϖ)

/-- **The local ring of a chart at a generic point of a reduced special fibre is a discrete
valuation ring.** -/
theorem isDiscreteValuationRing_of_isReduced (hϖ : IsSMulRegular T ϖ)
    (hred : IsReduced (T ⧸ Ideal.span {ϖ})) (hmin : 𝔭 ∈ (Ideal.span {ϖ}).minimalPrimes) :
    haveI := isDomain_of_isReduced hϖ hred hmin
    IsDiscreteValuationRing (Localization.AtPrime 𝔭) :=
  IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span
    (maximalIdeal_eq_span_of_isReduced 𝔭 hred hmin) (isSMulRegular_algebraMap 𝔭 hϖ)

/-- **`ϖ` is a uniformizer of `T_𝔭`.** -/
theorem irreducible_of_isReduced (hϖ : IsSMulRegular T ϖ) (hred : IsReduced (T ⧸ Ideal.span {ϖ}))
    (hmin : 𝔭 ∈ (Ideal.span {ϖ}).minimalPrimes) :
    Irreducible (algebraMap T (Localization.AtPrime 𝔭) ϖ) :=
  IsLocalRing.irreducible_of_maximalIdeal_eq_span (maximalIdeal_eq_span_of_isReduced 𝔭 hred hmin)
    (isSMulRegular_algebraMap 𝔭 hϖ)

omit [IsNoetherianRing T] in
/-- **The residue characteristic of `T_𝔭` is that of the base** when `𝔭` lies over the maximal
ideal of the local base ring `O`. -/
theorem ringExpChar_quotient_maximalIdeal {O : Type*} [CommRing O] [IsLocalRing O] [Algebra O T]
    (h𝔭 : maximalIdeal O ≤ 𝔭.comap (algebraMap O T)) :
    ringExpChar (Localization.AtPrime 𝔭 ⧸ maximalIdeal (Localization.AtPrime 𝔭)) =
      ringExpChar (O ⧸ maximalIdeal O) := by
  have h : maximalIdeal O ≤ (maximalIdeal (Localization.AtPrime 𝔭)).comap
      (algebraMap O (Localization.AtPrime 𝔭)) := by
    rw [IsScalarTower.algebraMap_eq O T (Localization.AtPrime 𝔭), ← Ideal.comap_comap]
    convert h𝔭
    exact Localization.AtPrime.under_maximalIdeal
  have hle : (maximalIdeal (Localization.AtPrime 𝔭)).comap (algebraMap O (Localization.AtPrime 𝔭))
      ≤ maximalIdeal O :=
    le_maximalIdeal (Ideal.comap_ne_top _ (maximalIdeal.isMaximal _).ne_top)
  exact ringExpChar_eq_of_injective (Ideal.quotientMap_injective' (H := h) hle)

end Localization.AtPrime

namespace SemistableReduction

namespace Abhyankar

variable {O T : Type*} [CommRing O] [IsLocalRing O] [CommRing T] [IsNoetherianRing T]
  [Algebra O T] {ϖ : T} {𝔭 : Ideal T} [𝔭.IsPrime]
  (hϖ : IsSMulRegular T ϖ) (hred : IsReduced (T ⧸ Ideal.span {ϖ}))
  (hmin : 𝔭 ∈ (Ideal.span {ϖ}).minimalPrimes) (h𝔭 : maximalIdeal O ≤ 𝔭.comap (algebraMap O T))
  {K L : Type*} [Field K] [Algebra (Localization.AtPrime 𝔭) K]
  [IsFractionRing (Localization.AtPrime 𝔭) K]
  [Field L] [Algebra K L] [Algebra (Localization.AtPrime 𝔭) L]
  [IsScalarTower (Localization.AtPrime 𝔭) K L] [FiniteDimensional K L] [IsGalois K L]

include hϖ hred hmin h𝔭

/-- **Tameness at a generic point of the special fibre of a chart**: the hypothesis `htame` of
`Abhyankar.etale` over the discrete valuation ring `T_𝔭`, for a Galois extension of `Frac T_𝔭`
of order prime to the residue characteristic of the base `O`. -/
theorem tame_atPrime_of_isGalois
    (hq : (Nat.card Gal(L/K)).Coprime (ringExpChar (O ⧸ maximalIdeal O))) :
    haveI := Localization.AtPrime.isDomain_of_isReduced hϖ hred hmin
    ∀ (𝔓 : Ideal (integralClosure (Localization.AtPrime 𝔭) L)) [𝔓.IsPrime]
      [𝔓.LiesOver (maximalIdeal (Localization.AtPrime 𝔭))],
      𝔓.ramificationIdx (Localization.AtPrime 𝔭) ∣ Nat.card Gal(L/K) ∧
        Algebra.IsSeparable (Localization.AtPrime 𝔭 ⧸ maximalIdeal (Localization.AtPrime 𝔭))
          (integralClosure (Localization.AtPrime 𝔭) L ⧸ 𝔓) := by
  haveI := Localization.AtPrime.isDomain_of_isReduced hϖ hred hmin
  haveI := Localization.AtPrime.isDiscreteValuationRing_of_isReduced hϖ hred hmin
  refine tame_of_isGalois (K := K) ?_
  rwa [Localization.AtPrime.ringExpChar_quotient_maximalIdeal h𝔭]

/-- **Abhyankar's lemma at a generic point of the special fibre of a chart**: with
`e = |Gal(L/K)|` prime to the residue characteristic of `O` and `O' = T_𝔭[Y]/(Y ^ e - ϖ)`, the
integral closure of `O'` in `L[Y]/(Y ^ e - ϖ)` is étale over `O'`. -/
theorem etale_atPrime_of_isGalois
    (hq : (Nat.card Gal(L/K)).Coprime (ringExpChar (O ⧸ maximalIdeal O))) :
    haveI := Localization.AtPrime.isDomain_of_isReduced hϖ hred hmin
    letI := rootAlgebra _ (adjoinRoot_root_pow (L := L)
      (algebraMap T (Localization.AtPrime 𝔭) ϖ) (Nat.card Gal(L/K)))
    Algebra.Etale (RootOfUniformizer.Ring (algebraMap T (Localization.AtPrime 𝔭) ϖ)
        (Nat.card Gal(L/K)))
      (integralClosure (RootOfUniformizer.Ring (algebraMap T (Localization.AtPrime 𝔭) ϖ)
          (Nat.card Gal(L/K)))
        (AdjoinRoot (X ^ Nat.card Gal(L/K) - C (algebraMap (Localization.AtPrime 𝔭) L
          (algebraMap T (Localization.AtPrime 𝔭) ϖ))))) := by
  haveI := Localization.AtPrime.isDomain_of_isReduced hϖ hred hmin
  haveI := Localization.AtPrime.isDiscreteValuationRing_of_isReduced hϖ hred hmin
  refine etale_integralClosure_adjoinRoot_of_isGalois (K := K)
    (Localization.AtPrime.irreducible_of_isReduced hϖ hred hmin) ?_
  rwa [Localization.AtPrime.ringExpChar_quotient_maximalIdeal h𝔭]

end Abhyankar

end SemistableReduction

namespace SemistableReduction.TateTwoChart

variable {O : Type*} [CommRing O] [IsDomain O] [IsNoetherianRing O] (π b₄ t κ : O) {b₆ : O}
  (hκ : κ * (t ^ 2 - b₆) = 1) {ϖ : O} [(Ideal.span {ϖ}).IsMaximal] (hπ : ϖ ∣ π) (hϖ : ϖ ≠ 0)

omit [IsNoetherianRing O] [(Ideal.span {ϖ}).IsMaximal] in
include hϖ in
/-- `ϖ` is a non-zero-divisor on `T0` (free over `O[X]`). -/
theorem isSMulRegular_T0 : IsSMulRegular (T0 π b₄ t κ) (algebraMap O (T0 π b₄ t κ) ϖ) := by
  have hC : algebraMap O (T0 π b₄ t κ) ϖ = algebraMap O[X] (T0 π b₄ t κ) (C ϖ) := by
    rw [AdjoinRoot.algebraMap_eq, of_C]
  rw [hC]
  exact isSMulRegular_algebraMap_of_basis (AdjoinRoot.powerBasis' (monic_G0 π b₄ t κ)).basis
    (IsSMulRegular.of_ne_zero (C_ne_zero.2 hϖ))

omit [IsNoetherianRing O] [(Ideal.span {ϖ}).IsMaximal] in
include hϖ in
/-- `ϖ` is a non-zero-divisor on `T1` (free over `O[X]`). -/
theorem isSMulRegular_T1 : IsSMulRegular (T1 π b₄ t κ) (algebraMap O (T1 π b₄ t κ) ϖ) := by
  have hC : algebraMap O (T1 π b₄ t κ) ϖ = algebraMap O[X] (T1 π b₄ t κ) (C ϖ) := by
    rw [AdjoinRoot.algebraMap_eq, of_C]
  rw [hC]
  exact isSMulRegular_algebraMap_of_basis (AdjoinRoot.powerBasis' (monic_G1 π b₄ t κ)).basis
    (IsSMulRegular.of_ne_zero (C_ne_zero.2 hϖ))

omit [IsDomain O] [IsNoetherianRing O] in
include hκ hπ in
theorem isReduced_T0_quot' :
    IsReduced (T0 π b₄ t κ ⧸ Ideal.span {algebraMap O (T0 π b₄ t κ) ϖ}) := by
  have h := isReduced_T0_quot π b₄ t κ hκ ϖ hπ
  rwa [zero_add, pow_one, Ideal.map_span, Set.image_singleton] at h

omit [IsDomain O] [IsNoetherianRing O] in
include hκ hπ in
theorem isReduced_T1_quot' :
    IsReduced (T1 π b₄ t κ ⧸ Ideal.span {algebraMap O (T1 π b₄ t κ) ϖ}) := by
  have h := isReduced_T1_quot π b₄ t κ hκ ϖ hπ
  rwa [zero_add, pow_one, Ideal.map_span, Set.image_singleton] at h

variable {𝔭 : Ideal (T0 π b₄ t κ)} [𝔭.IsPrime]
  (hmin : 𝔭 ∈ (Ideal.span {algebraMap O (T0 π b₄ t κ) ϖ}).minimalPrimes)
  {𝔮 : Ideal (T1 π b₄ t κ)} [𝔮.IsPrime]
  (hmin' : 𝔮 ∈ (Ideal.span {algebraMap O (T1 π b₄ t κ) ϖ}).minimalPrimes)

include hκ hπ hϖ hmin

/-- **The chart `T0` at a generic point of the special fibre is a discrete valuation ring.** -/
theorem isDiscreteValuationRing_T0_atPrime :
    haveI := Localization.AtPrime.isDomain_of_isReduced (isSMulRegular_T0 π b₄ t κ hϖ)
      (isReduced_T0_quot' π b₄ t κ hκ hπ) hmin
    IsDiscreteValuationRing (Localization.AtPrime 𝔭) :=
  Localization.AtPrime.isDiscreteValuationRing_of_isReduced (isSMulRegular_T0 π b₄ t κ hϖ)
    (isReduced_T0_quot' π b₄ t κ hκ hπ) hmin

/-- `ϖ` is a uniformizer of `T0` at a generic point of the special fibre. -/
theorem irreducible_T0_atPrime :
    Irreducible (algebraMap (T0 π b₄ t κ) (Localization.AtPrime 𝔭)
      (algebraMap O (T0 π b₄ t κ) ϖ)) :=
  Localization.AtPrime.irreducible_of_isReduced (isSMulRegular_T0 π b₄ t κ hϖ)
    (isReduced_T0_quot' π b₄ t κ hκ hπ) hmin

omit hmin
include hmin'

/-- **The chart `T1` at a generic point of the special fibre is a discrete valuation ring.** -/
theorem isDiscreteValuationRing_T1_atPrime :
    haveI := Localization.AtPrime.isDomain_of_isReduced (isSMulRegular_T1 π b₄ t κ hϖ)
      (isReduced_T1_quot' π b₄ t κ hκ hπ) hmin'
    IsDiscreteValuationRing (Localization.AtPrime 𝔮) :=
  Localization.AtPrime.isDiscreteValuationRing_of_isReduced (isSMulRegular_T1 π b₄ t κ hϖ)
    (isReduced_T1_quot' π b₄ t κ hκ hπ) hmin'

/-- `ϖ` is a uniformizer of `T1` at a generic point of the special fibre. -/
theorem irreducible_T1_atPrime :
    Irreducible (algebraMap (T1 π b₄ t κ) (Localization.AtPrime 𝔮)
      (algebraMap O (T1 π b₄ t κ) ϖ)) :=
  Localization.AtPrime.irreducible_of_isReduced (isSMulRegular_T1 π b₄ t κ hϖ)
    (isReduced_T1_quot' π b₄ t κ hκ hπ) hmin'

end SemistableReduction.TateTwoChart
