import TemperedFundamentalGroups.SemistableReduction.NodeCover

/-!
# Base change from the node of thickness `M` to the regular node (MR12, gap G1)

Let `O` be a discrete valuation ring with uniformizer `s`, `R_M` the localization of the node
`Node O (s ^ M) = O[u, v] ⧸ (u v - s ^ M)` at its closed point `(u, v, s)` and `R_1` that of the
regular node `Node O s`. Step (1) of the lemma "S4-local" of the MR12 plan (the generalisation of
[Mzk1] §3.12 to arbitrary thickness, a special case of [MzkExt] Thm. 3.3) passes from a cover of
the punctured spectrum `W_M` of `R_M` to one of the punctured spectrum `W_1` of `R_1` by the
Kummer map `u ↦ u ^ M`, `v ↦ v ^ M` and normalised base change. This file provides that step
("gap G1"), so that the hypothesis `hunr` of `NodeCover.etale_of_isUnramifiedAt` is now a theorem.

## The local Kummer map

* `Node.localKummer : R_M →+* R_1` (with the algebra `Node.localKummerAlgebra`), induced by
  `Node.kummer s M`; it is local (`Node.isLocalHom_localKummer`), finite
  (`Node.localKummer_finite`: the closed point is the only prime over the closed point,
  `Node.primesOver_closedPoint`), injective (`Node.localKummer_injective`) and induces an
  isomorphism of residue fields (`Node.residueField_map_localKummer_bijective`).
* Primes of `R_1` other than the maximal ideal lie over primes of `R_M` other than the maximal
  ideal (`Node.comap_localKummer_ne_maximalIdeal`), and these have height `≤ 1`
  (`Node.height_le_one_of_ne_maximalIdeal`, Krull's height theorem: the closed point is minimal
  over `(u, v)`).
* `K(T ^ M)` and `K(T)`, `K = Frac O`, are fraction fields of `R_M` and `R_1`
  (`Node.isFractionRing_localToAdjoinPow`, `Node.isFractionRing_localToRatFunc`), compatibly with
  `Node.localKummer` (`Node.localToRatFunc_comp`, `Node.isScalarTower_localToRatFunc`).

## Normalised base change (gap G1)

* `NodeCover.isUnramifiedAt_of_baseChange`: let `A → A'` be an integral map of integrally closed
  domains (`A` Noetherian) with fraction fields `K → K'`, `B` the normalisation of `A` in a
  finite separable extension `L / K`, and `B₁` the normalisation of `A'` in a field `L₁`
  generated by `L` and `K'` (a factor of `L ⊗_K K'`). If `B` is unramified over `A` at all primes
  over primes contained in a prime `𝔭` of height `≤ 1`, then `B₁` is unramified over `A'` at
  every prime over `𝔭`. Proof: `B_𝔭` is finite étale over the Dedekind domain `A_𝔭`, so the
  normalisation commutes with the base change `A_𝔭 → K'`
  (`TensorProduct.toIntegralClosure_bijective_of_smooth`; étale over normal is normal,
  [SGA 1] Exp. I, Cor. 9.10); an idempotent of the reduced Artinian ring `B_𝔭 ⊗ K'` cutting out
  `L₁` (`NodeCover.exists_isIntegral_lift`) shows that `B₁` is generated by `B` over `A'` up to
  denominators in `A ∖ 𝔭` (`NodeCover.exists_mul_mem_adjoin`), and the Kähler differentials of
  `B₁ / A'` are then killed locally (`NodeCover.isUnramifiedAt_of_forall_exists_mul_mem`).
* `NodeCover.isUnramifiedAt_of_baseChange_node`: the node case `A = R_M`, `A' = R_1`: if `B` is
  unramified over `W_M`, then `B₁` is unramified over `W_1`.
* `NodeCover.etale_of_baseChange`: hence (purity on `R_1`, `NodeCover.etale_of_isUnramifiedAt`)
  `B₁` is étale over `R_1`.

The fraction fields `K_M`, `K_1` and the field `L₁` enter the node statements abstractly (with
`IsFractionRing` hypotheses), the algebra `R_M → R_1` being `Node.localKummerAlgebra` (a local
instance there). The primality of the two closed points is passed as instance arguments
`[(closedPoint s (s ^ M)).IsPrime] [(closedPoint s s).IsPrime]` (as in `Node.ThicknessOne`; both
hold by `Node.isMaximal_closedPoint`), and `0 < M` as `[NeZero M]`.

## References

* [SGA 1] A. Grothendieck, *Revêtements étales et groupe fondamental*, Exp. I, Cor. 9.10;
  Exp. X, Cor. 3.2, 3.3.
* [MzkExt] S. Mochizuki, *Extending families of curves over log regular schemes*, J. reine angew.
  Math. 511 (1999), Thm. 3.3, Lemmas 3.1, 3.2.
* [Mzk1] S. Mochizuki, *Semi-graphs of anabelioids*, §3.12.
-/

open IsLocalRing IntermediateField Polynomial TensorProduct

namespace SemistableReduction

namespace Node

section LocalKummer

variable {O : Type*} [CommRing O] (s : O) (M : ℕ) [NeZero M]
  [(closedPoint s (s ^ M)).IsPrime] [(closedPoint s s).IsPrime]

local notation "R_M" => Localization.AtPrime (closedPoint s (s ^ M))
local notation "R_1" => Localization.AtPrime (closedPoint s s)

/-- The local Kummer map `R_M → R_1` induced by `Node.kummer s M`. -/
noncomputable def localKummer : R_M →+* R_1 :=
  Localization.localRingHom _ _ (kummer s M).toRingHom
    (comap_kummer_closedPoint s (Nat.pos_of_neZero M)).symm

/-- `R_1` as an `R_M`-algebra via `Node.localKummer`. Not an instance. -/
noncomputable abbrev localKummerAlgebra : Algebra R_M R_1 := (localKummer s M).toAlgebra

/-- `Node.localKummer` restricts to `Node.kummer` on `Node O (s ^ M)`. -/
lemma localKummer_algebraMap (x : Node O (s ^ M)) :
    localKummer s M (algebraMap _ R_M x) = algebraMap _ R_1 (kummer s M x) :=
  Localization.localRingHom_to_map _ _ _ _ x

/-- `Node.localKummer` is a local homomorphism. -/
instance isLocalHom_localKummer : IsLocalHom (localKummer s M) :=
  Localization.isLocalHom_localRingHom _ _ _ _

/-- `Node.localKummer` is compatible with `Node.kummer`. -/
lemma localKummer_comp :
    (localKummer s M).comp (algebraMap _ R_M) = (algebraMap _ R_1).comp (kummer s M).toRingHom :=
  RingHom.ext (localKummer_algebraMap s M)

/-- `Node.localKummer` is `O`-linear. -/
lemma localKummer_algebraMap_O (c : O) :
    localKummer s M (algebraMap O R_M c) = algebraMap O R_1 c := by
  rw [IsScalarTower.algebraMap_apply O (Node O (s ^ M)) R_M, localKummer_algebraMap,
    AlgHom.commutes, ← IsScalarTower.algebraMap_apply]

omit [(closedPoint s (s ^ M)).IsPrime] in
/-- With the Kummer algebra structure, the closed point of `Node O s` is the only prime over the
closed point of `Node O (s ^ M)`. -/
theorem primesOver_closedPoint [(Ideal.span {s}).IsMaximal] :
    letI := kummerAlgebra s M
    (closedPoint s (s ^ M)).primesOver (Node O s) = {closedPoint s s} := by
  letI := kummerAlgebra s M
  ext Q
  simp only [Ideal.primesOver, Set.mem_setOf_eq, Set.mem_singleton_iff]
  constructor
  · rintro ⟨hQ, hQo⟩
    exact eq_closedPoint_of_comap_kummer s Q (M := M) hQo.over.symm
  · rintro rfl
    exact ⟨inferInstance, ⟨(comap_kummer_closedPoint s (Nat.pos_of_neZero M)).symm⟩⟩

/-- `R_1` is a finite `R_M`-module. -/
theorem localKummer_finite [(Ideal.span {s}).IsMaximal] :
    letI := localKummerAlgebra s M
    Module.Finite R_M R_1 := by
  letI := kummerAlgebra s M
  letI := localKummerAlgebra s M
  have : (closedPoint s s).LiesOver (closedPoint s (s ^ M)) :=
    ⟨(comap_kummer_closedPoint s (Nat.pos_of_neZero M)).symm⟩
  have : Localization.AtPrime.IsLiesOverAlgebra (closedPoint s (s ^ M)) (closedPoint s s) :=
    ⟨rfl⟩
  have := kummer_finite s (Nat.pos_of_neZero M)
  exact Localization.finite_of_primesOver_eq_singleton (primesOver_closedPoint s M)

/-- The local Kummer map `R_M → R_1` is injective. -/
theorem localKummer_injective [IsDomain O] [(Ideal.span {s}).IsMaximal] (hs : s ≠ 0) :
    Function.Injective (localKummer s M) := by
  letI := kummerAlgebra s M
  have : (closedPoint s s).LiesOver (closedPoint s (s ^ M)) :=
    ⟨(comap_kummer_closedPoint s (Nat.pos_of_neZero M)).symm⟩
  have := kummer_isIntegral s (Nat.pos_of_neZero M)
  have : FaithfulSMul (Node O (s ^ M)) (Node O s) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (kummer_injective hs (Nat.pos_of_neZero M))
  exact Localization.localRingHom_injective_of_primesOver_eq_singleton
    (primesOver_closedPoint s M)

omit [NeZero M] [(closedPoint s (s ^ M)).IsPrime] in
/-- Every element of `Node O s` has the residue of a constant in `R_1`. -/
lemma exists_residue_eq (x : Node O s) : ∃ c : O,
    IsLocalRing.residue R_1 (algebraMap _ R_1 x) =
      IsLocalRing.residue R_1 (algebraMap O R_1 c) := by
  obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem s x
  refine ⟨c, ?_⟩
  rw [← sub_eq_zero, ← map_sub, IsScalarTower.algebraMap_apply O (Node O s) R_1, ← map_sub,
    residue_eq_zero_iff, ← Localization.AtPrime.map_eq_maximalIdeal]
  exact Ideal.mem_map_of_mem _ (by rw [closedPoint_self]; exact hc)

/-- The local Kummer map induces an isomorphism of residue fields (both are `O ⧸ (s)`). -/
theorem residueField_map_localKummer_bijective :
    Function.Bijective (ResidueField.map (localKummer s M)) := by
  refine ⟨(ResidueField.map (localKummer s M)).injective, fun y ↦ ?_⟩
  obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective y
  obtain ⟨⟨x, t⟩, rfl⟩ := IsLocalization.mk'_surjective (closedPoint s s).primeCompl y
  obtain ⟨c, hc⟩ := exists_residue_eq s x
  obtain ⟨d, hd⟩ := exists_residue_eq s (t : Node O s)
  have ht : IsLocalRing.residue R_1 (algebraMap _ R_1 (t : Node O s)) ≠ 0 := by
    rw [Ne, residue_eq_zero_iff]
    exact fun h ↦ (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h))
      (IsLocalization.map_units R_1 t)
  refine ⟨IsLocalRing.residue R_M (algebraMap O R_M c) /
    IsLocalRing.residue R_M (algebraMap O R_M d), ?_⟩
  rw [map_div₀, ResidueField.map_residue, ResidueField.map_residue, localKummer_algebraMap_O,
    localKummer_algebraMap_O, ← hc, ← hd, div_eq_iff ht, ← map_mul, IsLocalization.mk'_spec]

omit [NeZero M] [(closedPoint s s).IsPrime] in
/-- `R_M` is a domain. -/
theorem isDomain_localization [IsDomain O] (hs : s ≠ 0) : IsDomain R_M := by
  have := Node.isDomain (pow_ne_zero M hs)
  exact IsLocalization.isDomain_of_atPrime R_M (closedPoint s (s ^ M))

omit [NeZero M] [(closedPoint s s).IsPrime] in
/-- `R_M` is integrally closed. -/
theorem isIntegrallyClosed_localization [IsDomain O] [IsIntegrallyClosed O] (hs : s ≠ 0) :
    IsIntegrallyClosed R_M := by
  have := Node.isDomain (pow_ne_zero M hs)
  have := Node.isIntegrallyClosed (pow_ne_zero M hs)
  exact isIntegrallyClosed_of_isLocalization R_M (closedPoint s (s ^ M)).primeCompl
    (closedPoint s (s ^ M)).primeCompl_le_nonZeroDivisors

omit [NeZero M] [(closedPoint s s).IsPrime] in
/-- `R_M` is Noetherian. -/
theorem isNoetherianRing_localization [IsNoetherianRing O] : IsNoetherianRing R_M :=
  IsLocalization.isNoetherianRing (closedPoint s (s ^ M)).primeCompl R_M inferInstance

/-- A prime of `R_1` other than the maximal ideal lies over a prime of `R_M` other than the
maximal ideal. -/
theorem comap_localKummer_ne_maximalIdeal [(Ideal.span {s}).IsMaximal] (P : Ideal R_1)
    [P.IsPrime] (hP : P ≠ maximalIdeal R_1) :
    P.comap (localKummer s M) ≠ maximalIdeal R_M := by
  intro h
  apply hP
  have hP₀ : (P.comap (algebraMap (Node O s) R_1)).comap (kummer s M) =
      closedPoint s (s ^ M) := by
    ext x
    rw [Ideal.mem_comap, Ideal.mem_comap, ← localKummer_algebraMap,
      ← IsLocalization.AtPrime.to_map_mem_maximal_iff R_M (closedPoint s (s ^ M)) x, ← h,
      Ideal.mem_comap]
  have := eq_closedPoint_of_comap_kummer s _ hP₀
  rw [← IsLocalization.map_under (closedPoint s s).primeCompl R_1 P]
  exact (congr_arg (Ideal.map (algebraMap (Node O s) R_1)) this).trans
    (Localization.AtPrime.map_eq_maximalIdeal)

omit [NeZero M] [(closedPoint s s).IsPrime] in
/-- The closed point of `R_M` has height at most two: it is minimal over `(u, v)`
(as `u v = s ^ M`). -/
theorem height_maximalIdeal_le_two [IsNoetherianRing O] :
    (maximalIdeal R_M).height ≤ 2 := by
  classical
  have := isNoetherianRing_localization s M
  set u' := algebraMap (Node O (s ^ M)) R_M (u (s ^ M))
  set v' := algebraMap (Node O (s ^ M)) R_M (v (s ^ M))
  have hmin : maximalIdeal R_M ∈ (Ideal.span ↑({u', v'} : Finset R_M)).minimalPrimes := by
    rw [Finset.coe_insert, Finset.coe_singleton]
    have hle : Ideal.span {u', v'} ≤ maximalIdeal R_M := by
      rw [Ideal.span_le]
      rintro y (rfl | rfl) <;>
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_M _ _).mpr
          (by first | exact u_mem_closedPoint s | exact v_mem_closedPoint s)
    refine ⟨⟨inferInstance, hle⟩, fun q ⟨hq, hIq⟩ _ ↦ ?_⟩
    have hu : u' ∈ q := hIq (Ideal.subset_span (by simp))
    have hv : v' ∈ q := hIq (Ideal.subset_span (by simp))
    have hs' : algebraMap O R_M s ∈ q := by
      refine hq.mem_of_pow_mem M ?_
      rw [← map_pow, IsScalarTower.algebraMap_apply O (Node O (s ^ M)) R_M, ← u_mul_v,
        map_mul]
      exact q.mul_mem_right _ hu
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
    refine Ideal.span_le.mpr ?_
    rintro y (rfl | rfl | rfl)
    · exact hu
    · exact hv
    · rw [SetLike.mem_coe, Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
      exact hs'
  exact (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin).trans
    (by exact_mod_cast Finset.card_le_two)

omit [NeZero M] [(closedPoint s s).IsPrime] in
/-- A prime of `R_M` other than the closed point has height at most one. -/
theorem height_le_one_of_ne_maximalIdeal [IsNoetherianRing O] (𝔭 : Ideal R_M) [𝔭.IsPrime]
    (h : 𝔭 ≠ maximalIdeal R_M) : 𝔭.height ≤ 1 := by
  have hlt : 𝔭 < maximalIdeal R_M := lt_of_le_of_ne (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)) h
  have h1 := (Ideal.height_add_one_le_of_lt_of_isPrime hlt).trans
    (height_maximalIdeal_le_two s M)
  by_contra hc
  have : (2 : ℕ∞) ≤ 𝔭.height := Order.add_one_le_of_lt (not_le.mp hc)
  have : (3 : ℕ∞) ≤ 2 := by
    calc (3 : ℕ∞) = 2 + 1 := by norm_num
      _ ≤ 𝔭.height + 1 := by gcongr
      _ ≤ 2 := h1
  norm_num at this

end LocalKummer

section Fraction

variable {O : Type*} [CommRing O] [IsDomain O] (s : O) (M : ℕ) [NeZero M]
  [(closedPoint s (s ^ M)).IsPrime] [(closedPoint s s).IsPrime]

local notation "K" => FractionRing O
local notation "R_M" => Localization.AtPrime (closedPoint s (s ^ M))
local notation "R_1" => Localization.AtPrime (closedPoint s s)

omit [(closedPoint s s).IsPrime] in
/-- Elements outside the closed point map to units of `K(T ^ M)`. -/
lemma toAdjoinPow_isUnit (hs : s ≠ 0) (t : (closedPoint s (s ^ M)).primeCompl) :
    IsUnit (toAdjoinPow s M t) := by
  refine isUnit_iff_ne_zero.mpr fun h ↦ t.2 ?_
  have h' : toRatFunc (s ^ M) M t = toRatFunc (s ^ M) M 0 :=
    (congr_arg Subtype.val h).trans (map_zero _).symm
  rw [toRatFunc_injective (pow_ne_zero M hs) (Nat.pos_of_neZero M) h']
  exact zero_mem _

/-- Elements outside the closed point map to units of `K(T)`. -/
lemma toRatFunc_isUnit (hs : s ≠ 0) (t : (closedPoint s s).primeCompl) :
    IsUnit (toRatFunc s 1 t) := by
  refine isUnit_iff_ne_zero.mpr fun h ↦ t.2 ?_
  rw [toRatFunc_injective hs one_pos (h.trans (map_zero _).symm)]
  exact zero_mem _

omit [(closedPoint s s).IsPrime] in
/-- The map `R_M → K(T ^ M)` (`u ↦ T ^ M`, `v ↦ s ^ M / T ^ M`). -/
noncomputable def localToAdjoinPow (hs : s ≠ 0) : R_M →+* K⟮(RatFunc.X : RatFunc K) ^ M⟯ :=
  IsLocalization.lift (M := (closedPoint s (s ^ M)).primeCompl) (S := R_M)
    (toAdjoinPow_isUnit s M hs)

omit [NeZero M] [(closedPoint s (s ^ M)).IsPrime] in
/-- The map `R_1 → K(T)` (`u ↦ T`, `v ↦ s / T`). -/
noncomputable def localToRatFunc (hs : s ≠ 0) : R_1 →+* RatFunc K :=
  IsLocalization.lift (M := (closedPoint s s).primeCompl) (S := R_1) (toRatFunc_isUnit s hs)

omit [(closedPoint s s).IsPrime] in
/-- **`K(T ^ M)` is the fraction field of `R_M`.** -/
theorem isFractionRing_localToAdjoinPow (hs : s ≠ 0) :
    letI := (localToAdjoinPow s M hs).toAlgebra
    IsFractionRing R_M K⟮(RatFunc.X : RatFunc K) ^ M⟯ := by
  letI := adjoinPowAlgebra s M
  letI := (localToAdjoinPow s M hs).toAlgebra
  have : IsScalarTower (Node O (s ^ M)) R_M K⟮(RatFunc.X : RatFunc K) ^ M⟯ :=
    IsScalarTower.of_algebraMap_eq fun x ↦
      (IsLocalization.lift_eq (S := R_M) (toAdjoinPow_isUnit s M hs) x).symm
  have := isFractionRing_adjoin_pow hs (Nat.pos_of_neZero M)
  have := Node.isDomain (pow_ne_zero M hs)
  exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
    (closedPoint s (s ^ M)).primeCompl R_M _

omit [NeZero M] [(closedPoint s (s ^ M)).IsPrime] in
/-- **`K(T)` is the fraction field of `R_1`.** -/
theorem isFractionRing_localToRatFunc (hs : s ≠ 0) :
    letI := (localToRatFunc s hs).toAlgebra
    IsFractionRing R_1 (RatFunc K) := by
  letI := ratFuncAlgebra s
  letI := (localToRatFunc s hs).toAlgebra
  have : IsScalarTower (Node O s) R_1 (RatFunc K) :=
    IsScalarTower.of_algebraMap_eq fun x ↦
      (IsLocalization.lift_eq (S := R_1) (toRatFunc_isUnit s hs) x).symm
  have := isFractionRing_ratFunc hs
  have := Node.isDomain hs
  exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
    (closedPoint s s).primeCompl R_1 _

/-- Compatibility of the fraction fields: `R_M → K(T ^ M) ⊆ K(T)` equals `R_M → R_1 → K(T)`. -/
theorem localToRatFunc_comp (hs : s ≠ 0) :
    (algebraMap K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K)).comp (localToAdjoinPow s M hs) =
      (localToRatFunc s hs).comp (localKummer s M) := by
  refine IsLocalization.ringHom_ext (closedPoint s (s ^ M)).primeCompl (RingHom.ext fun x ↦ ?_)
  simp only [RingHom.comp_apply, localToAdjoinPow, localToRatFunc, IsLocalization.lift_eq,
    localKummer_algebraMap, algebraMap_toAdjoinPow]

/-- The scalar towers `R_M → R_1 → K(T)` and `R_M → K(T ^ M) → K(T)`, for the algebra structure
of `K(T)` over `R_M` through `K(T ^ M)`. -/
theorem isScalarTower_localToRatFunc (hs : s ≠ 0) :
    letI := localKummerAlgebra s M
    letI := (localToAdjoinPow s M hs).toAlgebra
    letI := (localToRatFunc s hs).toAlgebra
    letI : Algebra R_M (RatFunc K) :=
      ((algebraMap K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K)).comp
        (localToAdjoinPow s M hs)).toAlgebra
    IsScalarTower R_M K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K) ∧
      IsScalarTower R_M R_1 (RatFunc K) := by
  letI := localKummerAlgebra s M
  letI := (localToAdjoinPow s M hs).toAlgebra
  letI := (localToRatFunc s hs).toAlgebra
  letI : Algebra R_M (RatFunc K) :=
    ((algebraMap K⟮(RatFunc.X : RatFunc K) ^ M⟯ (RatFunc K)).comp
      (localToAdjoinPow s M hs)).toAlgebra
  exact ⟨IsScalarTower.of_algebraMap_eq fun _ ↦ rfl,
    IsScalarTower.of_algebraMap_eq fun x ↦ congr($(localToRatFunc_comp s M hs) x)⟩

end Fraction

end Node

namespace NodeCover

section Generic

/-- `Algebra.IsUnramifiedAt` in terms of the Kähler differentials: every differential is killed
by an element outside `q`. -/
theorem isUnramifiedAt_iff_forall_exists_smul_eq_zero (R S : Type*) [CommRing R] [CommRing S]
    [Algebra R S] (q : Ideal S) [q.IsPrime] :
    Algebra.IsUnramifiedAt R q ↔ ∀ m : Ω[S⁄R], ∃ r ∉ q, r • m = 0 := by
  change (⟨q, ‹_›⟩ : PrimeSpectrum S) ∈ Algebra.unramifiedLocus R S ↔ _
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.mem_compl_iff, Module.notMem_support_iff']

/-- **Unramifiedness of an algebra generated up to denominators by an unramified one.** Let
`A → A'` and `B → B₁` be compatible, `Q₁` a prime of `B₁` such that `B` is unramified over `A`
at `Q₁ ∩ B`, and suppose that every `x ∈ B₁` satisfies `t x ∈ A'[B]` for some `t ∈ A` with
`t ∉ Q₁`. Then `B₁` is unramified over `A'` at `Q₁`. -/
theorem isUnramifiedAt_of_forall_exists_mul_mem {A A' B B₁ : Type*} [CommRing A] [CommRing A']
    [CommRing B] [CommRing B₁] [Algebra A A'] [Algebra A B] [Algebra A' B₁] [Algebra B B₁]
    [Algebra A B₁] [IsScalarTower A A' B₁] [IsScalarTower A B B₁] (Q₁ : Ideal B₁) [Q₁.IsPrime]
    (hunr : Algebra.IsUnramifiedAt A (Q₁.comap (algebraMap B B₁)))
    (h : ∀ x : B₁, ∃ t : A, algebraMap A B₁ t ∉ Q₁ ∧
      algebraMap A B₁ t * x ∈ Algebra.adjoin A' (Set.range (algebraMap B B₁))) :
    Algebra.IsUnramifiedAt A' Q₁ := by
  rw [isUnramifiedAt_iff_forall_exists_smul_eq_zero] at hunr ⊢
  let N : Submodule B₁ Ω[B₁⁄A'] :=
    { carrier := {m | ∃ r ∉ Q₁, r • m = 0}
      add_mem' := by
        rintro a b ⟨r₁, hr₁, ha⟩ ⟨r₂, hr₂, hb⟩
        refine ⟨r₁ * r₂, Q₁.primeCompl.mul_mem hr₁ hr₂, ?_⟩
        rw [smul_add, mul_comm r₁ r₂, mul_smul, ha, mul_comm r₂ r₁, mul_smul, hb, smul_zero,
          smul_zero, add_zero]
      zero_mem' := ⟨1, Q₁.primeCompl.one_mem, smul_zero _⟩
      smul_mem' := by
        rintro c m ⟨r, hr, hm⟩
        exact ⟨r, hr, by rw [smul_comm, hm, smul_zero]⟩ }
  have hN : ∀ m, m ∈ N ↔ ∃ r ∉ Q₁, r • m = 0 := fun _ ↦ Iff.rfl
  have hB : ∀ b : B, KaehlerDifferential.D A' B₁ (algebraMap B B₁ b) ∈ N := by
    intro b
    obtain ⟨r, hr, hr0⟩ := hunr (KaehlerDifferential.D A B b)
    refine ⟨algebraMap B B₁ r, hr, ?_⟩
    have := congr_arg (KaehlerDifferential.map A A' B B₁) hr0
    rwa [map_smul, KaehlerDifferential.map_D, map_zero, ← algebraMap_smul B₁] at this
  have hC : ∀ c ∈ Algebra.adjoin A' (Set.range (algebraMap B B₁)),
      KaehlerDifferential.D A' B₁ c ∈ N := by
    intro c hc
    induction hc using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨b, rfl⟩ := hx
      exact hB b
    | algebraMap r => rw [Derivation.map_algebraMap]; exact N.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact N.add_mem hx hy
    | mul x y _ _ hx hy =>
      rw [Derivation.leibniz]; exact N.add_mem (N.smul_mem _ hy) (N.smul_mem _ hx)
  have hD : ∀ x : B₁, KaehlerDifferential.D A' B₁ x ∈ N := by
    intro x
    obtain ⟨t, ht, hmem⟩ := h x
    have h1 := hC _ hmem
    rw [Derivation.leibniz, IsScalarTower.algebraMap_apply A A' B₁, Derivation.map_algebraMap,
      smul_zero, add_zero] at h1
    obtain ⟨r, hr, hr0⟩ := h1
    refine ⟨r * algebraMap A' B₁ (algebraMap A A' t), Q₁.primeCompl.mul_mem hr ?_, ?_⟩
    · rwa [← IsScalarTower.algebraMap_apply]
    · rw [mul_smul, hr0]
  have htop : N = ⊤ := by
    rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation, Submodule.span_le]
    rintro _ ⟨x, rfl⟩
    exact hD x
  intro m
  exact (hN m).mp (htop ▸ Submodule.mem_top)

/-- **Lifting an integral element through a factor of a reduced Artinian ring.** Let
`φ : T → Y` be a surjection from a reduced Artinian `R`-algebra onto a field. Every `y ∈ Y`
integral over `R` lifts to an element of `T` integral over `R` (multiply any lift by the
idempotent of the factor `Y` of `T`). -/
theorem exists_isIntegral_lift {R T Y : Type*} [CommRing R] [CommRing T] [Field Y] [Algebra R T]
    [Algebra R Y] [IsArtinianRing T] [IsReduced T] (φ : T →ₐ[R] Y)
    (hφ : Function.Surjective φ) {y : Y} (hy : IsIntegral R y) :
    ∃ z : T, IsIntegral R z ∧ φ z = y := by
  classical
  have hmax : (RingHom.ker φ).IsMaximal := RingHom.ker_isMaximal_of_surjective φ hφ
  let m : MaximalSpectrum T := ⟨RingHom.ker φ, hmax⟩
  let e : T := (IsArtinianRing.equivPi T).symm (Pi.single m 1)
  have he : IsArtinianRing.equivPi T e = Pi.single m 1 := AlgEquiv.apply_symm_apply _ _
  have he1 : e - 1 ∈ RingHom.ker φ := by
    have h := congr_fun he m
    rw [IsArtinianRing.equivPi_apply, Pi.single_eq_same] at h
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, sub_eq_zero]
    exact h
  have hker : ∀ z ∈ RingHom.ker φ, e * z = 0 := by
    intro z hz
    apply (IsArtinianRing.equivPi T).injective
    rw [map_mul, map_zero, he]
    funext n
    by_cases hn : n = m
    · subst hn
      simpa [IsArtinianRing.equivPi_apply] using Ideal.Quotient.eq_zero_iff_mem.mpr hz
    · simp [Pi.single_eq_of_ne hn]
  have hidem : IsIdempotentElem e := by
    have := hker _ he1
    rwa [mul_sub, mul_one, sub_eq_zero] at this
  have hφe : φ e = 1 := by
    have := he1
    rwa [RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at this
  obtain ⟨y₀, rfl⟩ := hφ y
  obtain ⟨p, hpm, hp⟩ := hy
  have hpe : ∀ q : R[X], e * aeval (y₀ * e) q = e * aeval y₀ q := by
    intro q
    induction q using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add, map_add, mul_add, mul_add, hp, hq]
    | monomial n a =>
      rw [aeval_monomial, aeval_monomial, mul_pow]
      calc e * (algebraMap R T a * (y₀ ^ n * e ^ n))
          = algebraMap R T a * y₀ ^ n * e ^ (n + 1) := by ring
        _ = e * (algebraMap R T a * y₀ ^ n) := by rw [hidem.pow_succ_eq]; ring
  have h0 : aeval y₀ p ∈ RingHom.ker φ := by
    rw [RingHom.mem_ker, ← Polynomial.aeval_algHom_apply, aeval_def]
    exact hp
  refine ⟨y₀ * e, ⟨X * p, monic_X.mul hpm, ?_⟩, by rw [map_mul, hφe, mul_one]⟩
  rw [← aeval_def, map_mul, aeval_X, mul_assoc, hpe, hker _ h0, mul_zero]

/-- A localization at a prime of height at most one has dimension at most one. -/
theorem dimensionLEOne_localization {A : Type*} [CommRing A] [IsDomain A] (𝔭 : Ideal A)
    [𝔭.IsPrime] (h : 𝔭.height ≤ 1) : Ring.DimensionLEOne (Localization.AtPrime 𝔭) := by
  refine ⟨fun {P} hP hPp ↦ ?_⟩
  by_contra hmax
  have hlt : P < maximalIdeal (Localization.AtPrime 𝔭) :=
    lt_of_le_of_ne (le_maximalIdeal hPp.ne_top) fun h ↦ hmax (h ▸ maximalIdeal.isMaximal _)
  have h0 : (⊥ : Ideal (Localization.AtPrime 𝔭)) < P := bot_lt_iff_ne_bot.mpr hP
  have e0 := Ideal.height_add_one_le_of_lt_of_isPrime h0
  have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have hm : (maximalIdeal (Localization.AtPrime 𝔭)).height = 𝔭.height := by
    rw [← IsLocalization.height_under 𝔭.primeCompl,
      IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔭) 𝔭]
  have : (1 : ℕ∞) ≤ P.height := le_trans (by simp) e0
  have : (2 : ℕ∞) ≤ 1 := by
    calc (2 : ℕ∞) = 1 + 1 := by norm_num
      _ ≤ P.height + 1 := by gcongr
      _ ≤ _ := e1
      _ ≤ 1 := hm ▸ h
  norm_num at this

variable {A : Type*} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
  {A' : Type*} [CommRing A'] [IsIntegrallyClosed A'] [Algebra A A']
  [Algebra.IsIntegral A A']
  {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
  {K' : Type*} [Field K'] [Algebra A' K'] [IsFractionRing A' K'] [Algebra K K'] [Algebra A K']
  [IsScalarTower A K K'] [IsScalarTower A A' K']
  {L : Type*} [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]
  {B : Type*} [CommRing B] [Algebra A B] [Algebra B L] [IsScalarTower A B L]
  [IsIntegralClosure B A L]
  {L₁ : Type*} [Field L₁] [Algebra K L₁] [Algebra K' L₁] [Algebra L L₁] [IsScalarTower K K' L₁]
  [IsScalarTower K L L₁] [Algebra A' L₁] [IsScalarTower A' K' L₁]
  {B₁ : Type*} [CommRing B₁] [Algebra A' B₁] [Algebra B₁ L₁] [IsScalarTower A' B₁ L₁]
  [IsIntegralClosure B₁ A' L₁]
  (𝔭 : Ideal A) [𝔭.IsPrime]

local notation "Ap" => Localization.AtPrime 𝔭
local notation "Bp" => Localization (Algebra.algebraMapSubmonoid B 𝔭.primeCompl)

include 𝔭 in
/-- **The key step of the base change** (normalisation commutes with étale base change): under
the hypotheses of `NodeCover.isUnramifiedAt_of_baseChange`, every `x` in the normalisation `B₁`
of `A'` in `L₁` satisfies `t x ∈ A'[B]` (inside `L₁`) for some `t ∈ A ∖ 𝔭`. -/
theorem exists_mul_mem_adjoin [Algebra A L₁] [IsScalarTower A K L₁] [Algebra B L₁]
    [IsScalarTower B L L₁]
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K L L₁) (IsScalarTower.toAlgHom K K' L₁)))
    (h𝔭 : 𝔭.height ≤ 1)
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≤ 𝔭 →
      Algebra.IsUnramifiedAt A Q)
    (x : B₁) : ∃ t ∉ 𝔭, algebraMap A L₁ t * algebraMap B₁ L₁ x ∈
      Algebra.adjoin A' (Set.range (algebraMap B L₁)) := by
  classical
  -- scalar towers into `L₁`
  have : IsScalarTower A K' L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A K K', ← IsScalarTower.algebraMap_apply K K' L₁,
      ← IsScalarTower.algebraMap_apply A K L₁]
  have : IsScalarTower A A' L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A' K' L₁, ← IsScalarTower.algebraMap_apply A A' K',
      ← IsScalarTower.algebraMap_apply A K' L₁]
  have : IsScalarTower A L L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A K L, ← IsScalarTower.algebraMap_apply K L L₁,
      ← IsScalarTower.algebraMap_apply A K L₁]
  have : IsScalarTower A B L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply B L L₁, ← IsScalarTower.algebraMap_apply A B L,
      ← IsScalarTower.algebraMap_apply A L L₁]
  have hinjK' : Function.Injective (algebraMap A K') := by
    rw [IsScalarTower.algebraMap_eq A K K']
    exact (algebraMap K K').injective.comp (IsFractionRing.injective A K)
  have hinjL₁ : Function.Injective (algebraMap A L₁) := by
    rw [IsScalarTower.algebraMap_eq A K' L₁]
    exact (algebraMap K' L₁).injective.comp hinjK'
  have hne : ∀ t ∉ 𝔭, t ≠ 0 := fun t ht h ↦ ht (h ▸ 𝔭.zero_mem)
  -- the algebra structures on the localizations
  have hunitK' : ∀ t : 𝔭.primeCompl, IsUnit (algebraMap A K' t) := fun t ↦
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ hinjK').mpr (hne t t.2))
  letI : Algebra Ap K' := (IsLocalization.lift (S := Ap) hunitK').toAlgebra
  have : IsScalarTower A Ap K' :=
    IsScalarTower.of_algebraMap_eq fun a ↦ (IsLocalization.lift_eq hunitK' a).symm
  letI : Algebra Ap L₁ := ((algebraMap K' L₁).comp (algebraMap Ap K')).toAlgebra
  have : IsScalarTower Ap K' L₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower A Ap L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply Ap K' L₁, ← IsScalarTower.algebraMap_apply A Ap K',
      ← IsScalarTower.algebraMap_apply A K' L₁]
  have hunitB : ∀ t : Algebra.algebraMapSubmonoid B 𝔭.primeCompl,
      IsUnit (algebraMap B L₁ t) := by
    rintro ⟨_, t, ht, rfl⟩
    rw [← IsScalarTower.algebraMap_apply]
    exact isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ hinjL₁).mpr (hne t ht))
  letI : Algebra Bp L₁ := (IsLocalization.lift (S := Bp) hunitB).toAlgebra
  have : IsScalarTower B Bp L₁ :=
    IsScalarTower.of_algebraMap_eq fun b ↦ (IsLocalization.lift_eq hunitB b).symm
  have : IsScalarTower Ap Bp L₁ := IsScalarTower.of_algebraMap_eq' <|
    IsLocalization.ringHom_ext 𝔭.primeCompl <| RingHom.ext fun a ↦ by
      change algebraMap Ap L₁ (algebraMap A Ap a) =
        algebraMap Bp L₁ (algebraMap Ap Bp (algebraMap A Ap a))
      rw [← IsScalarTower.algebraMap_apply A Ap L₁, ← IsScalarTower.algebraMap_apply A Ap Bp,
        IsScalarTower.algebraMap_apply A B Bp, ← IsScalarTower.algebraMap_apply B Bp L₁,
        ← IsScalarTower.algebraMap_apply A B L₁]
  -- `Bp` is étale over `Ap`
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : IsDomain B := (IsIntegralClosure.algebraMap_injective B A L).isDomain _
  have : IsNoetherianRing Ap := IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance
  have : IsIntegrallyClosed Ap :=
    isIntegrallyClosed_of_isLocalization Ap 𝔭.primeCompl 𝔭.primeCompl_le_nonZeroDivisors
  have := dimensionLEOne_localization 𝔭 h𝔭
  have : IsDedekindRing Ap := {}
  have : IsDedekindDomain Ap := {}
  have hinjApL₁ : Function.Injective (algebraMap Ap L₁) := by
    refine (algebraMap K' L₁).injective.comp ?_
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl z
    change IsLocalization.lift hunitK' (IsLocalization.mk' Ap a t) = 0 at hz
    rw [IsLocalization.lift_mk'_spec, mul_zero, (map_eq_zero_iff _ hinjK')] at hz
    change IsLocalization.mk' Ap a t = 0
    rw [hz, IsLocalization.mk'_zero]
  have hinjB : Function.Injective (algebraMap A B) := by
    refine Function.Injective.of_comp (f := algebraMap B L) ?_
    rw [← RingHom.coe_comp, ← IsScalarTower.algebraMap_eq, IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have : IsDomain Bp := IsLocalization.isDomain_localization (by
    rintro _ ⟨t, ht, rfl⟩
    exact mem_nonZeroDivisors_of_ne_zero fun h ↦ hne t ht ((map_eq_zero_iff _ hinjB).mp h))
  have : Module.IsTorsionFree Ap Bp := Module.isTorsionFree_iff_algebraMap_injective.mpr <|
    Function.Injective.of_comp (f := algebraMap Bp L₁) <| by
      rw [← RingHom.coe_comp, ← IsScalarTower.algebraMap_eq]; exact hinjApL₁
  have : Algebra.FinitePresentation Ap Bp :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  have : Algebra.FormallyUnramified A Bp := by
    rw [Algebra.formallyUnramified_iff_forall]
    intro q
    have hQ : (q.asIdeal.comap (algebraMap B Bp)).comap (algebraMap A B) ≤ 𝔭 := by
      intro a ha
      by_contra ha'
      have hu := IsLocalization.map_units Bp
        (⟨algebraMap A B a, a, ha', rfl⟩ : Algebra.algebraMapSubmonoid B 𝔭.primeCompl)
      exact q.2.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hu)
    have := hunr _ hQ
    have := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Algebra.algebraMapSubmonoid B 𝔭.primeCompl) (Localization.AtPrime q.asIdeal) q.asIdeal
    exact Algebra.FormallyUnramified.of_equiv
      ((IsLocalization.algEquiv (q.asIdeal.comap (algebraMap B Bp)).primeCompl
        (Localization.AtPrime (q.asIdeal.comap (algebraMap B Bp)))
        (Localization.AtPrime q.asIdeal)).restrictScalars A)
  have : Algebra.FormallyUnramified Ap Bp := Algebra.FormallyUnramified.of_restrictScalars A _ _
  have : Algebra.Etale Ap Bp := Algebra.Etale.of_formallyUnramified_of_flat
  -- `Bp ⊗[Ap] K'` is reduced and Artinian
  have : IsArtinianRing (K' ⊗[Ap] Bp) := IsArtinianRing.of_finite K' _
  have : IsReduced (K' ⊗[Ap] Bp) := Algebra.FormallyUnramified.isReduced_of_field K' _
  have : IsArtinianRing (Bp ⊗[Ap] K') :=
    (Algebra.TensorProduct.comm Ap K' Bp).toRingEquiv.isArtinianRing
  have : IsReduced (Bp ⊗[Ap] K') :=
    isReduced_of_injective (Algebra.TensorProduct.comm Ap Bp K')
      (Algebra.TensorProduct.comm Ap Bp K').injective
  -- the surjection `Bp ⊗[Ap] K' → L₁`
  let φ : Bp ⊗[Ap] K' →ₐ[Ap] L₁ := Algebra.TensorProduct.productMap
    (IsScalarTower.toAlgHom Ap Bp L₁) (IsScalarTower.toAlgHom Ap K' L₁)
  have hφ : Function.Surjective φ := by
    intro l
    obtain ⟨w, rfl⟩ := hgen l
    induction w with
    | zero => exact ⟨0, by rw [map_zero, map_zero]⟩
    | add w₁ w₂ h₁ h₂ =>
      obtain ⟨z₁, hz₁⟩ := h₁
      obtain ⟨z₂, hz₂⟩ := h₂
      exact ⟨z₁ + z₂, by rw [map_add, map_add, hz₁, hz₂]⟩
    | tmul l k =>
      have := IsLocalization.isAlgebraic K (nonZeroDivisors A)
      have := Algebra.IsAlgebraic.trans A K L
      obtain ⟨a, ha, hint⟩ := (Algebra.IsAlgebraic.isAlgebraic (R := A) l).exists_integral_multiple
      obtain ⟨b, hb⟩ := (IsIntegralClosure.isIntegral_iff (A := B)).mp hint
      have ha' : algebraMap A L₁ a ≠ 0 := (map_ne_zero_iff _ hinjL₁).mpr ha
      refine ⟨algebraMap B Bp b ⊗ₜ ((algebraMap A K' a)⁻¹ * k), ?_⟩
      simp only [φ, Algebra.TensorProduct.productMap_apply_tmul, IsScalarTower.coe_toAlgHom',
        map_mul, map_inv₀]
      rw [← IsScalarTower.algebraMap_apply B Bp L₁, IsScalarTower.algebraMap_apply B L L₁, hb,
        ← IsScalarTower.algebraMap_apply A K' L₁, Algebra.smul_def, map_mul,
        ← IsScalarTower.algebraMap_apply A L L₁]
      field_simp
  -- lift `x` to an integral element of `Bp ⊗[Ap] K'`
  have hx : IsIntegral Ap (algebraMap B₁ L₁ x) :=
    (isIntegral_trans (R := A) _ (IsIntegralClosure.isIntegral A' L₁ x).algebraMap).tower_top
  obtain ⟨z, hz, hφz⟩ := exists_isIntegral_lift φ hφ hx
  obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := Ap) (S := Bp)
    (B := K')).2 ⟨z, hz.tower_top⟩
  have hzw : Algebra.TensorProduct.map (AlgHom.id Bp Bp) (integralClosure Ap K').val w = z :=
    congr_arg Subtype.val hw
  rw [← hφz, ← hzw]
  clear hw hzw hφz hz
  have hA : ∀ a : A, algebraMap A L₁ a ∈ Algebra.adjoin A' (Set.range (algebraMap B L₁)) :=
    fun a ↦ by
      rw [IsScalarTower.algebraMap_apply A A' L₁]
      exact Subalgebra.algebraMap_mem _ _
  induction w with
  | zero => exact ⟨1, 𝔭.primeCompl.one_mem, by rw [map_zero, map_zero, mul_zero]; exact zero_mem _⟩
  | add w₁ w₂ h₁ h₂ =>
    obtain ⟨t₁, ht₁, h₁⟩ := h₁
    obtain ⟨t₂, ht₂, h₂⟩ := h₂
    refine ⟨t₁ * t₂, 𝔭.primeCompl.mul_mem ht₁ ht₂, ?_⟩
    rw [map_add, map_add, mul_add, map_mul]
    refine add_mem ?_ ?_
    · rw [mul_comm (algebraMap A L₁ t₁), mul_assoc]
      exact Subalgebra.mul_mem _ (hA t₂) h₁
    · rw [mul_assoc]
      exact Subalgebra.mul_mem _ (hA t₁) h₂
  | tmul b k =>
    simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val, φ,
      Algebra.TensorProduct.productMap_apply_tmul, IsScalarTower.coe_toAlgHom']
    obtain ⟨⟨b₀, ⟨_, t₁, ht₁, rfl⟩⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid B 𝔭.primeCompl) b
    obtain ⟨⟨m, hm⟩, hmk⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization 𝔭.primeCompl (k : K') k.2
    obtain ⟨a', ha'⟩ := IsIntegrallyClosed.isIntegral_iff.mp (hmk.tower_top (A := A'))
    refine ⟨t₁ * m, 𝔭.primeCompl.mul_mem ht₁ hm, ?_⟩
    have e1 : algebraMap A L₁ t₁ * algebraMap Bp L₁ (IsLocalization.mk' Bp b₀
        (⟨algebraMap A B t₁, t₁, ht₁, rfl⟩ : Algebra.algebraMapSubmonoid B 𝔭.primeCompl)) =
        algebraMap B L₁ b₀ := by
      rw [IsScalarTower.algebraMap_apply A B L₁, IsScalarTower.algebraMap_apply B Bp L₁,
        ← map_mul, mul_comm, IsLocalization.mk'_spec, ← IsScalarTower.algebraMap_apply]
    have e2 : algebraMap A L₁ m * algebraMap K' L₁ k = algebraMap A' L₁ a' := by
      rw [IsScalarTower.algebraMap_apply A' K' L₁, ha', Submonoid.smul_def, Algebra.smul_def,
        map_mul, ← IsScalarTower.algebraMap_apply A K' L₁]
    rw [map_mul, mul_mul_mul_comm, e1, e2]
    exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨b₀, rfl⟩) (Subalgebra.algebraMap_mem _ a')

include 𝔭 in
/-- **Unramifiedness is preserved by normalised base change** (gap G1 of "S4-local"; the key
input is that normalisation commutes with étale base change, cf. [SGA 1], Exp. I, Cor. 9.10).

Let `A → A'` be an integral map of integrally closed domains (`A` Noetherian) with fraction
fields `K → K'`, `L / K` finite separable with normalisation `B` of `A`, and `L₁` a field
generated by compatible images of `L` and `K'` (i.e. a factor of `L ⊗_K K'`), with normalisation
`B₁` of `A'`. Let `𝔭` be a prime of `A` of height `≤ 1` such that `B` is unramified over `A` at
every prime lying over a prime contained in `𝔭`. Then `B₁` is unramified over `A'` at every
prime `Q₁` lying over `𝔭`. -/
theorem isUnramifiedAt_of_baseChange
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K L L₁) (IsScalarTower.toAlgHom K K' L₁)))
    (h𝔭 : 𝔭.height ≤ 1)
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≤ 𝔭 →
      Algebra.IsUnramifiedAt A Q)
    (Q₁ : Ideal B₁) [Q₁.IsPrime] (hQ₁ : (Q₁.comap (algebraMap A' B₁)).comap (algebraMap A A') = 𝔭) :
    Algebra.IsUnramifiedAt A' Q₁ := by
  letI : Algebra A L₁ := ((algebraMap K L₁).comp (algebraMap A K)).toAlgebra
  have : IsScalarTower A K L₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  letI : Algebra B L₁ := ((algebraMap L L₁).comp (algebraMap B L)).toAlgebra
  have : IsScalarTower B L L₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower A K' L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A K K', ← IsScalarTower.algebraMap_apply K K' L₁,
      ← IsScalarTower.algebraMap_apply A K L₁]
  have : IsScalarTower A A' L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A' K' L₁, ← IsScalarTower.algebraMap_apply A A' K',
      ← IsScalarTower.algebraMap_apply A K' L₁]
  have : IsScalarTower A L L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A K L, ← IsScalarTower.algebraMap_apply K L L₁,
      ← IsScalarTower.algebraMap_apply A K L₁]
  have : IsScalarTower A B L₁ := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply B L L₁, ← IsScalarTower.algebraMap_apply A B L,
      ← IsScalarTower.algebraMap_apply A L L₁]
  have hinj := IsIntegralClosure.algebraMap_injective B₁ A' L₁
  have hint : ∀ b : B, IsIntegral A' (algebraMap B L₁ b) := fun b ↦
    ((IsIntegralClosure.isIntegral A L b).algebraMap (B := L₁)).tower_top
  -- the map `B → B₁`
  let ι : B →+* B₁ :=
    { toFun := fun b ↦ IsIntegralClosure.mk' B₁ (algebraMap B L₁ b) (hint b)
      map_one' := hinj (by simp)
      map_mul' := fun x y ↦ hinj (by simp)
      map_zero' := hinj (by simp)
      map_add' := fun x y ↦ hinj (by simp) }
  letI : Algebra B B₁ := ι.toAlgebra
  have hι : ∀ b, algebraMap B₁ L₁ (algebraMap B B₁ b) = algebraMap B L₁ b := fun b ↦
    IsIntegralClosure.algebraMap_mk' B₁ _ (hint b)
  letI : Algebra A B₁ := ((algebraMap A' B₁).comp (algebraMap A A')).toAlgebra
  have : IsScalarTower A A' B₁ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hAB₁ : ∀ a, algebraMap B₁ L₁ (algebraMap A B₁ a) = algebraMap A L₁ a := fun a ↦ by
    change algebraMap B₁ L₁ (algebraMap A' B₁ (algebraMap A A' a)) = _
    rw [← IsScalarTower.algebraMap_apply A' B₁ L₁, ← IsScalarTower.algebraMap_apply A A' L₁]
  have : IsScalarTower A B B₁ := IsScalarTower.of_algebraMap_eq fun a ↦ hinj (by
    rw [hι, hAB₁, ← IsScalarTower.algebraMap_apply A B L₁])
  have hQ : (Q₁.comap (algebraMap B B₁)).comap (algebraMap A B) = 𝔭 := by
    rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, IsScalarTower.algebraMap_eq A A' B₁,
      ← Ideal.comap_comap, hQ₁]
  refine isUnramifiedAt_of_forall_exists_mul_mem Q₁ (hunr _ hQ.le) fun x ↦ ?_
  obtain ⟨t, ht, hmem⟩ := exists_mul_mem_adjoin (A' := A') 𝔭 hgen h𝔭 hunr x
  refine ⟨t, fun h ↦ ht ?_, ?_⟩
  · rw [← hQ₁, Ideal.mem_comap, Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
    exact h
  · have hmap : (Algebra.adjoin A' (Set.range (algebraMap B B₁))).map
        (IsScalarTower.toAlgHom A' B₁ L₁) = Algebra.adjoin A' (Set.range (algebraMap B L₁)) := by
      rw [AlgHom.map_adjoin, ← Set.range_comp]
      congr 2
      funext b
      exact hι b
    rw [← hmap, Subalgebra.mem_map] at hmem
    obtain ⟨c, hc, hc'⟩ := hmem
    convert hc
    apply hinj
    rw [IsScalarTower.coe_toAlgHom'] at hc'
    rw [hc', map_mul, hAB₁]

end Generic

section Node

open Node

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] {s : O} {M : ℕ}
  [NeZero M] [(closedPoint s (s ^ M)).IsPrime] [(closedPoint s s).IsPrime]

local notation "R_M" => Localization.AtPrime (closedPoint s (s ^ M))
local notation "R_1" => Localization.AtPrime (closedPoint s s)

attribute [local instance] Node.localKummerAlgebra

/-- **Gap G1 of "S4-local" for the node** (base change along the Kummer map `R_M → R_1`).
Let `L / Frac R_M` be finite separable whose normalisation `B` over `R_M` is unramified over the
punctured spectrum `W_M`, and let `L₁` be a field generated by `L` and `Frac R_1` (a factor of
`L ⊗ Frac R_1`) with normalisation `B₁` over `R_1`. Then `B₁` is unramified over the punctured
spectrum `W_1`: this is the hypothesis `hunr` of `NodeCover.etale_of_isUnramifiedAt`. -/
theorem isUnramifiedAt_of_baseChange_node (hs : Irreducible s)
    (K_M : Type*) [Field K_M] [Algebra R_M K_M] [IsFractionRing R_M K_M]
    (K_1 : Type*) [Field K_1] [Algebra R_1 K_1] [IsFractionRing R_1 K_1] [Algebra K_M K_1]
    [Algebra R_M K_1] [IsScalarTower R_M K_M K_1] [IsScalarTower R_M R_1 K_1]
    (L : Type*) [Field L] [Algebra K_M L] [Algebra R_M L] [IsScalarTower R_M K_M L]
    [FiniteDimensional K_M L] [Algebra.IsSeparable K_M L]
    (B : Type*) [CommRing B] [Algebra R_M B] [Algebra B L] [IsScalarTower R_M B L]
    [IsIntegralClosure B R_M L]
    (L₁ : Type*) [Field L₁] [Algebra K_M L₁] [Algebra K_1 L₁] [Algebra L L₁]
    [IsScalarTower K_M K_1 L₁] [IsScalarTower K_M L L₁] [Algebra R_1 L₁]
    [IsScalarTower R_1 K_1 L₁]
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K_M L L₁) (IsScalarTower.toAlgHom K_M K_1 L₁)))
    (B₁ : Type*) [CommRing B₁] [Algebra R_1 B₁] [Algebra B₁ L₁] [IsScalarTower R_1 B₁ L₁]
    [IsIntegralClosure B₁ R_1 L₁]
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap R_M B) ≠ maximalIdeal R_M →
      Algebra.IsUnramifiedAt R_M Q) :
    ∀ (Q₁ : Ideal B₁) [Q₁.IsPrime], Q₁.comap (algebraMap R_1 B₁) ≠ maximalIdeal R_1 →
      Algebra.IsUnramifiedAt R_1 Q₁ := by
  intro Q₁ _ hQ₁
  have := ThicknessOne.isMaximal_span hs
  have := Node.isDomain_localization s M hs.ne_zero
  have := Node.isNoetherianRing_localization s M
  have := Node.isIntegrallyClosed_localization s M hs.ne_zero
  have := ThicknessOne.isDomain R_1 hs.ne_zero
  have := ThicknessOne.isIntegrallyClosed R_1 hs.ne_zero
  have := Node.localKummer_finite s M
  have : Algebra.IsIntegral R_M R_1 := Algebra.IsIntegral.of_finite _ _
  have h𝔭 : (Q₁.comap (algebraMap R_1 B₁)).comap (algebraMap R_M R_1) ≠ maximalIdeal R_M :=
    Node.comap_localKummer_ne_maximalIdeal s M _ hQ₁
  exact isUnramifiedAt_of_baseChange (K := K_M) (K' := K_1) (L := L) (B := B) _ hgen
    (Node.height_le_one_of_ne_maximalIdeal s M _ h𝔭)
    (fun Q _ hQ ↦ hunr Q fun h ↦
      h𝔭 (le_antisymm (le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) (h ▸ hQ)))
    Q₁ rfl

/-- **Step (1) of "S4-local", base change and purity.** Under the hypotheses of
`NodeCover.isUnramifiedAt_of_baseChange_node`, if moreover `L₁ / Frac R_1` is finite separable,
the normalisation `B₁` of `R_1` in `L₁` is étale over `R_1` (purity on the regular node,
`NodeCover.etale_of_isUnramifiedAt`). -/
theorem etale_of_baseChange (hs : Irreducible s)
    (K_M : Type*) [Field K_M] [Algebra R_M K_M] [IsFractionRing R_M K_M]
    (K_1 : Type*) [Field K_1] [Algebra R_1 K_1] [IsFractionRing R_1 K_1] [Algebra K_M K_1]
    [Algebra R_M K_1] [IsScalarTower R_M K_M K_1] [IsScalarTower R_M R_1 K_1]
    (L : Type*) [Field L] [Algebra K_M L] [Algebra R_M L] [IsScalarTower R_M K_M L]
    [FiniteDimensional K_M L] [Algebra.IsSeparable K_M L]
    (B : Type*) [CommRing B] [Algebra R_M B] [Algebra B L] [IsScalarTower R_M B L]
    [IsIntegralClosure B R_M L]
    (L₁ : Type*) [Field L₁] [Algebra K_M L₁] [Algebra K_1 L₁] [Algebra L L₁]
    [IsScalarTower K_M K_1 L₁] [IsScalarTower K_M L L₁] [Algebra R_1 L₁]
    [IsScalarTower R_1 K_1 L₁] [FiniteDimensional K_1 L₁] [Algebra.IsSeparable K_1 L₁]
    (hgen : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom K_M L L₁) (IsScalarTower.toAlgHom K_M K_1 L₁)))
    (B₁ : Type*) [CommRing B₁] [Algebra R_1 B₁] [Algebra B₁ L₁] [IsScalarTower R_1 B₁ L₁]
    [IsIntegralClosure B₁ R_1 L₁]
    (hunr : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap R_M B) ≠ maximalIdeal R_M →
      Algebra.IsUnramifiedAt R_M Q) :
    Algebra.Etale R_1 B₁ :=
  etale_of_isUnramifiedAt hs R_1 K_1 L₁ B₁
    (isUnramifiedAt_of_baseChange_node hs K_M K_1 L B L₁ hgen B₁ hunr)

end Node

end NodeCover

end SemistableReduction
