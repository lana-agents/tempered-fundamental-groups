import TemperedFundamentalGroups.Andre.TateNodeConj
import TemperedFundamentalGroups.SemistableReduction.QuadraticEtale
import TemperedFundamentalGroups.SemistableReduction.NodeDeformation

/-!
# The Tate chart near the nodes is `A_D[S]/(S² + S − c)` (Blueprint §12.8, M2.3 (a'))

In the chart `x₀ ≠ 0` of the Tate model (`s = x₁/x₀`, `w = x₂/x₀`, a subring `chart 0` of the
function field `L`), with `π = ε ϖⁿ`, the node ring `A = O[u, v]/(uv − ϖⁿ)` maps to `L` by
`u ↦ w`, `v ↦ (s(s + 1) − b₆w²)/((1 + b₄w²)ε)` (`TateNormal.nodeToL`), and `s` is a root of
`S² + S − c`, `c = ε(1 + b₄u²)v + b₆u²` (`TateNormal.sL_sq_add_sL`). Here:

* **`TateNormal.nodeToL_injective`**: the node ring embeds into `L` (`w` is transcendental,
  `_root_.SemistableReduction.Node.lift_injective`);
* **`TateNormal.quadToL_injective`**: so does `Q = A[S]/(S² + S − c)` (`S ↦ s`): every element is
  `a + bS` (division by the monic quadratic), and `1, s` are independent over `A`
  (`eq_zero_of_nodeToL_add_mul_sL_eq_zero`, the conjugation argument);
* **`TateNormal.quadChartEquiv`**: `Q[1/D] ≃+* (chart 0)[1/D]` for `D = 1 + b₄u²` (resp.
  `1 + b₄w²`), compatible with the embeddings into `L` (`quadChartEquiv_spec`): both are the
  subring of `L` generated by `O`, `s`, `w` and `1/D` (the chart is `O[s, w]`, and `v` lies in
  `(chart 0)[1/D]`).

So the chart, localized at `1 + b₄w²` (which is a unit at both nodes `p`, `q`), is free of rank
two over the localized node ring; in particular flat over `A` (used for the formal patching at
the nodes, `KummerPatch`).

Generic helpers (`SemistableReduction.AwayField`): a localization `R[1/x]` of a ring `R` embedded
in a field `F` embeds into `F` (`lift_injective`) with image in any subring containing `R` and
`1/x` (`lift_mem`).
-/

universe u

open Polynomial

namespace SemistableReduction.AwayField

variable {R F : Type*} [CommRing R] [Field F] (φ : R →+* F) (x : R) (hx : φ x ≠ 0)

/-- The extension of `φ : R → F` to `R[1/x]`. -/
noncomputable abbrev lift : Localization.Away x →+* F :=
  IsLocalization.Away.lift x (isUnit_iff_ne_zero.2 hx)

lemma lift_eq_mul_inv_pow (z : Localization.Away x) :
    ∃ (r : R) (k : ℕ), lift φ x hx z = φ r * (φ x)⁻¹ ^ k := by
  obtain ⟨⟨r, _, k, rfl⟩, h⟩ := IsLocalization.surj (Submonoid.powers x) z
  refine ⟨r, k, ?_⟩
  have h' := congrArg (lift φ x hx) h
  simp only [map_mul, IsLocalization.Away.lift_eq, map_pow] at h'
  rw [inv_pow, ← h', mul_assoc, mul_inv_cancel₀ (pow_ne_zero k hx), mul_one]

/-- The image of `R[1/x] → F` lies in every subring containing `φ(R)` and `1/φ(x)`. -/
lemma lift_mem (S : Subring F) (hR : ∀ r, φ r ∈ S) (hinv : (φ x)⁻¹ ∈ S)
    (z : Localization.Away x) : lift φ x hx z ∈ S := by
  obtain ⟨r, k, h⟩ := lift_eq_mul_inv_pow φ x hx z
  rw [h]
  exact S.mul_mem (hR r) (S.pow_mem hinv k)

/-- `R[1/x] → F` is injective if `R → F` is. -/
lemma lift_injective (hφ : Function.Injective φ) : Function.Injective (lift φ x hx) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨⟨r, _, k, rfl⟩, h⟩ := IsLocalization.surj (Submonoid.powers x) z
  have h' := congrArg (lift φ x hx) h
  simp only [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at h'
  have hr : r = 0 := hφ (by rw [← h', map_zero])
  simp only [hr, map_zero] at h
  exact (IsUnit.mul_left_eq_zero (IsLocalization.map_units (Localization.Away x)
    (⟨x ^ k, k, rfl⟩ : Submonoid.powers x))).mp h

/-- `1/x` is in the image of `R[1/x] → F`. -/
lemma inv_mem_range : (φ x)⁻¹ ∈ (lift φ x hx).range :=
  ⟨IsLocalization.mk' (Localization.Away x) (1 : R)
    (⟨x, Submonoid.mem_powers x⟩ : Submonoid.powers x), by
    apply eq_inv_of_mul_eq_one_left
    rw [← IsLocalization.Away.lift_eq (S := Localization.Away x) x (isUnit_iff_ne_zero.2 hx) x,
      ← map_mul,
      IsLocalization.mk'_spec, map_one, map_one]⟩

lemma map_mem_range (r : R) : φ r ∈ (lift φ x hx).range :=
  ⟨algebraMap R _ r, IsLocalization.Away.lift_eq _ _ _⟩

end SemistableReduction.AwayField

namespace TemperedFundamentalGroups.TateNormal

open _root_.SemistableReduction (Node)

noncomputable section

variable {K : Type u} [Field K] {O : ValuationSubring K} [IsDiscreteValuationRing O]
  {π : O} (b₄ b₆ : O) [Fact (Squarefree (dpoly π b₄ b₆))]

local notation "L" => TateField π b₄ b₆

attribute [local instance] algK

/-- The quadratic polynomial `X² + X − c`. -/
local notation "qpoly" => _root_.SemistableReduction.QuadraticEtale.poly

variable {ϖ : O} {ε : Oˣ} {n : ℕ}

/-- **The node ring embeds into the function field** (`ϖ ≠ 0`; `w` is transcendental). -/
theorem nodeToL_injective (hϖ : ϖ ≠ 0) (hπε : π = ε * ϖ ^ n) :
    Function.Injective (nodeToL b₄ b₆ hπε) := by
  refine _root_.SemistableReduction.Node.lift_injective (pow_ne_zero n hϖ) _ fun P hP ↦ ?_
  have ht := transcendental_wL π b₄ b₆
  rw [← wL_eq] at ht
  by_contra hne
  refine ht ⟨P.map (algebraMap O K), (Polynomial.map_ne_zero_iff Subtype.val_injective).2 hne, ?_⟩
  rw [Polynomial.aeval_map_algebraMap]
  exact hP

variable (ϖ ε n) in
/-- `c = ε (1 + b₄ u²) v + b₆ u²` in the node ring `O[u, v]/(uv − ϖⁿ)`. -/
def cNode : Node O (ϖ ^ n) :=
  algebraMap O _ (ε : O) * (1 + algebraMap O _ b₄ * Node.u (ϖ ^ n) ^ 2) * Node.v (ϖ ^ n) +
    algebraMap O _ b₆ * Node.u (ϖ ^ n) ^ 2

variable (ϖ ε n) in
/-- `Q = A[S]/(S² + S − c)` over the node ring `A = O[u, v]/(uv − ϖⁿ)`. -/
abbrev Quad : Type u := AdjoinRoot (qpoly (cNode b₄ b₆ ϖ ε n))

lemma eval₂_poly_sL (hπε : π = ε * ϖ ^ n) :
    (qpoly (cNode b₄ b₆ ϖ ε n)).eval₂ (nodeToL b₄ b₆ hπε).toRingHom
      (sL π b₄ b₆) = 0 := by
  have h : sL π b₄ b₆ ^ 2 + sL π b₄ b₆ = nodeToL b₄ b₆ hπε (cNode b₄ b₆ ϖ ε n) :=
    sL_sq_add_sL b₄ b₆ hπε
  simp only [_root_.SemistableReduction.QuadraticEtale.poly, eval₂_sub, eval₂_add, eval₂_X_pow,
    eval₂_X, eval₂_C,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  rw [← h]
  ring

/-- **`Q → L`**, `S ↦ s`. -/
def quadToL (hπε : π = ε * ϖ ^ n) : Quad b₄ b₆ ϖ ε n →+* L :=
  AdjoinRoot.lift (nodeToL b₄ b₆ hπε).toRingHom (sL π b₄ b₆) (eval₂_poly_sL b₄ b₆ hπε)

lemma quadToL_of (hπε : π = ε * ϖ ^ n) (a : Node O (ϖ ^ n)) :
    quadToL b₄ b₆ hπε (AdjoinRoot.of _ a) = nodeToL b₄ b₆ hπε a :=
  AdjoinRoot.lift_of _

lemma quadToL_root (hπε : π = ε * ϖ ^ n) :
    quadToL b₄ b₆ hπε (AdjoinRoot.root _) = sL π b₄ b₆ :=
  AdjoinRoot.lift_root _

omit [IsDiscreteValuationRing O] in
lemma natDegree_poly (c : Node O (ϖ ^ n)) [Nontrivial (Node O (ϖ ^ n))] :
    (qpoly c).natDegree = 2 := by
  unfold _root_.SemistableReduction.QuadraticEtale.poly
  compute_degree!

/-- **`Q = A[S]/(S² + S − c)` embeds into the function field.** -/
theorem quadToL_injective (hϖ : ϖ ≠ 0) (hπε : π = ε * ϖ ^ n) :
    Function.Injective (quadToL b₄ b₆ hπε) := by
  haveI : IsDomain (Node O (ϖ ^ n)) := Node.isDomain (pow_ne_zero n hϖ)
  set g := qpoly (cNode b₄ b₆ ϖ ε n) with hg_def
  have hg : g.Monic := _root_.SemistableReduction.QuadraticEtale.monic_poly _
  have hdeg : g.natDegree = 2 := natDegree_poly _
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
  have hmk : AdjoinRoot.mk g p = AdjoinRoot.mk g (p %ₘ g) := by
    rw [AdjoinRoot.mk_eq_mk]
    exact ⟨p /ₘ g, by rw [sub_eq_iff_eq_add, add_comm]; exact (modByMonic_add_div p g).symm⟩
  have hg1 : g ≠ 1 := fun h ↦ by rw [h, natDegree_one] at hdeg; exact absurd hdeg (by norm_num)
  have hq : (p %ₘ g).natDegree ≤ 1 := by
    have := natDegree_modByMonic_lt p hg hg1
    omega
  set q := p %ₘ g
  rw [hmk, eq_X_add_C_of_natDegree_le_one hq] at hx ⊢
  rw [quadToL, AdjoinRoot.lift_mk] at hx
  simp only [eval₂_add, eval₂_mul, eval₂_C, eval₂_X, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe] at hx
  obtain ⟨h0, h1⟩ := eq_zero_of_nodeToL_add_mul_sL_eq_zero b₄ b₆ hπε
    (by rw [add_comm] at hx; exact hx)
  rw [← map_zero (nodeToL b₄ b₆ hπε)] at h0 h1
  rw [nodeToL_injective b₄ b₆ hϖ hπε h0, nodeToL_injective b₄ b₆ hϖ hπε h1]
  simp

/-! ### Localization at `D = 1 + b₄ u²` -/

variable (ϖ ε n) in
/-- `D = 1 + b₄ u²` in `Q`. -/
def DQ : Quad b₄ b₆ ϖ ε n :=
  AdjoinRoot.of _ (1 + algebraMap O _ b₄ * Node.u (ϖ ^ n) ^ 2)

/-- `D = 1 + b₄ w²` in the chart `x₀ ≠ 0`. -/
def Dchart : chart π b₄ b₆ 0 :=
  ⟨1 + algebraMap O L b₄ * wL π b₄ b₆ ^ 2,
    add_mem (one_mem _) (mul_mem (algebraMap_mem_chart π b₄ b₆ 0 b₄) (pow_mem (wL_mem π b₄ b₆) 2))⟩

lemma quadToL_DQ (hπε : π = ε * ϖ ^ n) :
    quadToL b₄ b₆ hπε (DQ b₄ b₆ ϖ ε n) = 1 + algebraMap O L b₄ * wL π b₄ b₆ ^ 2 := by
  rw [DQ, quadToL_of]
  simp only [map_add, map_one, map_mul, map_pow, AlgHom.commutes]
  rw [show nodeToL b₄ b₆ hπε (Node.u (ϖ ^ n)) = wL π b₄ b₆ from Node.lift_u ..]

lemma quadToL_DQ_ne_zero (hπε : π = ε * ϖ ^ n) : quadToL b₄ b₆ hπε (DQ b₄ b₆ ϖ ε n) ≠ 0 := by
  rw [quadToL_DQ]; exact one_add_b₄_wL_sq_ne_zero π b₄ b₆

lemma Dchart_ne_zero : (chart π b₄ b₆ 0).subtype (Dchart (π := π) b₄ b₆) ≠ 0 :=
  one_add_b₄_wL_sq_ne_zero π b₄ b₆

/-- `Q[1/D] → L`. -/
abbrev quadDToL (hπε : π = ε * ϖ ^ n) : Localization.Away (DQ b₄ b₆ ϖ ε n) →+* L :=
  _root_.SemistableReduction.AwayField.lift (quadToL b₄ b₆ hπε) _ (quadToL_DQ_ne_zero b₄ b₆ hπε)

/-- `(chart 0)[1/D] → L`. -/
abbrev chartDToL : Localization.Away (Dchart (π := π) b₄ b₆) →+* L :=
  _root_.SemistableReduction.AwayField.lift (chart π b₄ b₆ 0).subtype _ (Dchart_ne_zero b₄ b₆)

lemma quadDToL_injective (hϖ : ϖ ≠ 0) (hπε : π = ε * ϖ ^ n) :
    Function.Injective (quadDToL b₄ b₆ hπε) :=
  _root_.SemistableReduction.AwayField.lift_injective _ _ _ (quadToL_injective b₄ b₆ hϖ hπε)

lemma chartDToL_injective : Function.Injective (chartDToL (π := π) b₄ b₆) :=
  _root_.SemistableReduction.AwayField.lift_injective _ _ _ Subtype.val_injective

lemma mem_range_chartDToL {y : L} (hy : y ∈ chart π b₄ b₆ 0) :
    y ∈ (chartDToL (π := π) b₄ b₆).range :=
  _root_.SemistableReduction.AwayField.map_mem_range (chart π b₄ b₆ 0).subtype _ _ ⟨y, hy⟩

lemma nodeToL_mem_range (hπε : π = ε * ϖ ^ n) (a : Node O (ϖ ^ n)) :
    nodeToL b₄ b₆ hπε a ∈ (chartDToL (π := π) b₄ b₆).range := by
  set S := (chartDToL (π := π) b₄ b₆).range
  have hD := _root_.SemistableReduction.AwayField.inv_mem_range (chart π b₄ b₆ 0).subtype _
    (Dchart_ne_zero (π := π) b₄ b₆)
  have hO : ∀ o : O, algebraMap O L o ∈ S := fun o ↦
    mem_range_chartDToL b₄ b₆ (algebraMap_mem_chart π b₄ b₆ 0 o)
  have hw : wL π b₄ b₆ ∈ S := mem_range_chartDToL b₄ b₆ (wL_mem π b₄ b₆)
  have hs : sL π b₄ b₆ ∈ S := mem_range_chartDToL b₄ b₆ (sL_mem π b₄ b₆)
  have hv : vL (π := π) (b₄ := b₄) (b₆ := b₆) (ε : O) ∈ S := by
    have hε : algebraMap O L (ε : O) ≠ 0 := by
      rw [← algebraMap_K_coe]
      exact (map_ne_zero (algebraMap K L)).mpr fun h ↦ ε.ne_zero (Subtype.ext h)
    have hεinv : (algebraMap O L (ε : O))⁻¹ = algebraMap O L ((ε⁻¹ : Oˣ) : O) := by
      rw [eq_comm, ← mul_eq_one_iff_eq_inv₀ hε, ← map_mul, Units.inv_mul, map_one]
    rw [vL, div_eq_mul_inv, mul_inv, hεinv]
    refine S.mul_mem (S.sub_mem (S.mul_mem hs (S.add_mem hs (S.one_mem)))
      (S.mul_mem (hO b₆) (S.pow_mem hw 2))) (S.mul_mem hD (hO _))
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
  change MvPolynomial.aeval ![wL π b₄ b₆, vL (π := π) (b₄ := b₄) (b₆ := b₆) (ε : O)] P ∈ S
  induction P using MvPolynomial.induction_on with
  | C o => rw [MvPolynomial.aeval_C]; exact hO o
  | add p q hp hq => rw [map_add]; exact S.add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, MvPolynomial.aeval_X]
    refine S.mul_mem hp ?_
    fin_cases i
    · exact hw
    · exact hv

lemma quadToL_mem_range (hπε : π = ε * ϖ ^ n) (y : Quad b₄ b₆ ϖ ε n) :
    quadToL b₄ b₆ hπε y ∈ (chartDToL (π := π) b₄ b₆).range := by
  set S := (chartDToL (π := π) b₄ b₆).range
  have hs : sL π b₄ b₆ ∈ S := mem_range_chartDToL b₄ b₆ (sL_mem π b₄ b₆)
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective y
  rw [quadToL, AdjoinRoot.lift_mk]
  induction p using Polynomial.induction_on with
  | C a => rw [eval₂_C]; exact nodeToL_mem_range b₄ b₆ hπε a
  | add p q hp hq => rw [eval₂_add]; exact S.add_mem hp hq
  | monomial k a _ =>
    rw [eval₂_mul, eval₂_C, eval₂_X_pow]
    exact S.mul_mem (nodeToL_mem_range b₄ b₆ hπε a) (S.pow_mem hs _)

/-- **Both localizations have the same image in `L`.** -/
theorem range_quadDToL (hπε : π = ε * ϖ ^ n) :
    (quadDToL b₄ b₆ hπε).range = (chartDToL (π := π) b₄ b₆).range := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    refine _root_.SemistableReduction.AwayField.lift_mem _ _ _ _
      (quadToL_mem_range b₄ b₆ hπε) ?_ z
    rw [quadToL_DQ]
    exact _root_.SemistableReduction.AwayField.inv_mem_range (chart π b₄ b₆ 0).subtype _
      (Dchart_ne_zero (π := π) b₄ b₆)
  · rintro _ ⟨z, rfl⟩
    set T := (quadDToL b₄ b₆ hπε).range
    have hT : ∀ y : Quad b₄ b₆ ϖ ε n, quadToL b₄ b₆ hπε y ∈ T :=
      _root_.SemistableReduction.AwayField.map_mem_range _ _ _
    refine _root_.SemistableReduction.AwayField.lift_mem _ _ _ _ (fun r ↦ ?_) ?_ z
    · have hle : chart π b₄ b₆ 0 ≤ T := by
        refine SemistableReduction.projChart_le ?_ fun j ↦ ?_
        · rintro _ ⟨o, rfl⟩
          have := hT (algebraMap O _ o)
          rwa [IsScalarTower.algebraMap_apply O (Node O (ϖ ^ n)), AdjoinRoot.algebraMap_eq,
            quadToL_of,
            AlgHom.commutes] at this
        · fin_cases j
          · change aL π b₄ b₆ / aL π b₄ b₆ ∈ T
            rw [div_self (aL_ne_zero π b₄ b₆)]
            exact T.one_mem
          · change sL π b₄ b₆ ∈ T
            rw [← quadToL_root b₄ b₆ hπε]; exact hT _
          · change wL π b₄ b₆ ∈ T
            have := hT (AdjoinRoot.of _ (Node.u (ϖ ^ n)))
            rwa [quadToL_of, show nodeToL b₄ b₆ hπε (Node.u (ϖ ^ n)) = wL π b₄ b₆ from
              Node.lift_u ..] at this
      exact hle r.2
    · change (1 + algebraMap O L b₄ * wL π b₄ b₆ ^ 2)⁻¹ ∈ T
      rw [← quadToL_DQ b₄ b₆ hπε]
      exact _root_.SemistableReduction.AwayField.inv_mem_range _ _ _

/-- **`Q[1/D] ≅ (chart 0)[1/D]`**, compatibly with the embeddings into `L`. -/
def quadChartEquiv (hϖ : ϖ ≠ 0) (hπε : π = ε * ϖ ^ n) :
    Localization.Away (DQ b₄ b₆ ϖ ε n) ≃+* Localization.Away (Dchart (π := π) b₄ b₆) :=
  ((RingEquiv.ofBijective (quadDToL b₄ b₆ hπε).rangeRestrict
    ⟨fun _ _ h ↦ quadDToL_injective b₄ b₆ hϖ hπε (congrArg Subtype.val h),
      RingHom.rangeRestrict_surjective _⟩).trans
    (RingEquiv.subringCongr (range_quadDToL b₄ b₆ hπε))).trans
  (RingEquiv.ofBijective (chartDToL (π := π) b₄ b₆).rangeRestrict
    ⟨fun _ _ h ↦ chartDToL_injective b₄ b₆ (congrArg Subtype.val h),
      RingHom.rangeRestrict_surjective _⟩).symm

theorem quadChartEquiv_spec (hϖ : ϖ ≠ 0) (hπε : π = ε * ϖ ^ n)
    (z : Localization.Away (DQ b₄ b₆ ϖ ε n)) :
    chartDToL (π := π) b₄ b₆ (quadChartEquiv b₄ b₆ hϖ hπε z) = quadDToL b₄ b₆ hπε z := by
  set e := RingEquiv.ofBijective (chartDToL (π := π) b₄ b₆).rangeRestrict
    ⟨fun _ _ h ↦ chartDToL_injective b₄ b₆ (congrArg Subtype.val h),
      RingHom.rangeRestrict_surjective _⟩
  have h := congrArg Subtype.val (e.apply_symm_apply
    ((RingEquiv.subringCongr (range_quadDToL b₄ b₆ hπε))
      ((quadDToL b₄ b₆ hπε).rangeRestrict z)))
  exact h

end

end TemperedFundamentalGroups.TateNormal
